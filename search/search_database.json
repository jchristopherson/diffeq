_events ( nx , nstates , nevents , fcn , x , initcond , settings , & esettings , efcn , jac , mass , output , estats ) result ( rst ) & bind ( C , name = \"c_bdf_events\" ) !! Utilizes a variable order BDF integrator to solve a system of !! first order differential equations or index-1 differential !! algebraic equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nevents !! The number of event equations. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ode_event_solver_settings ), intent ( in ) :: esettings !! The event solver settings. type ( c_funptr ), intent ( in ), value :: efcn !! A pointer to the function containing the event equations. type ( c_funptr ), value , intent ( in ) :: jac !! A pointer to the routine for computing the Jacobian matrix. !! Pass NULL if no routine is necessary and allowing the integrator !! to use a finite-difference estimate is acceptable. type ( c_funptr ), value , intent ( in ) :: mass !! A pointer to the routine for computing the mass matrix.  Pass !! NULL if no routine is necessary. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. type ( c_ode_event_statistics ), intent ( out ) :: estats !! Event detection solver results and statistics. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr procedure ( c_ode_jacobian ), pointer :: jac_ptr procedure ( c_ode_mass_matrix ), pointer :: mass_ptr procedure ( c_ode_event_function ), pointer :: event_ptr logical :: use_jac , use_mass if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) use_jac = c_associated ( jac ) if ( use_jac ) call c_f_procpointer ( jac , jac_ptr ) use_mass = c_associated ( mass ) if ( use_mass ) call c_f_procpointer ( mass , mass_ptr ) if ( c_associated ( efcn )) then call c_f_procpointer ( efcn , event_ptr ) else event_ptr => null () end if if ( use_jac . and . use_mass ) then rst = c_integrate_ode_events ( C_BACKDIFF , nx , nstates , nevents , & fcn_ptr , x , initcond , settings , esettings , event_ptr , output , & estats , jac = jac_ptr , mass = mass_ptr ) else if ( use_jac . and . . not . use_mass ) then rst = c_integrate_ode_events ( C_BACKDIFF , nx , nstates , nevents , & fcn_ptr , x , initcond , settings , esettings , event_ptr , output , & estats , jac = jac_ptr ) else if (. not . use_jac . and . use_mass ) then rst = c_integrate_ode_events ( C_BACKDIFF , nx , nstates , nevents , & fcn_ptr , x , initcond , settings , esettings , event_ptr , output , & estats , mass = mass_ptr ) else rst = c_integrate_ode_events ( C_BACKDIFF , nx , nstates , nevents , & fcn_ptr , x , initcond , settings , esettings , event_ptr , output , & estats ) end if end function ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_c_integrators.f90.html"},{"title":"diffeq_singlestep.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_singlestep use iso_fortran_env use diffeq_base use diffeq_errors implicit none private public :: attempt_single_step public :: get_single_step_logical_parameter public :: single_step_post_step_routine public :: single_step_pre_step_routine public :: single_step_interpolate public :: single_step_integer_inquiry public :: single_step_integrator public :: ssi_ode_solver ! ------------------------------------------------------------------------------ type , abstract , extends ( ode_integrator ) :: single_step_integrator !! The most basic, single-step integrator object capable of integrating !! systems of ODE's. real ( real64 ), private , allocatable , dimension (:,:) :: m_denseState contains procedure , public :: compute_dense_output => ssi_dense_output procedure , private :: cache_dense_output => ssi_cache_dense procedure ( attempt_single_step ), public , pass , deferred :: attempt_step !! Attempts an integration step for a single-step integrator. procedure ( get_single_step_logical_parameter ), public , pass , & deferred :: get_is_fsal !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. procedure ( single_step_post_step_routine ), public , pass , deferred :: & post_step_action !! Performs actions such as setting up interpolation after !! completion of a successful integration step. procedure ( single_step_interpolate ), public , pass , deferred :: & interpolate !! Performs an interpolation to estimate the solution at the !! requested point. procedure ( single_step_pre_step_routine ), public , pass , deferred :: & pre_step_action !! Provides a routine for performing any actions, such as setting !! up Jacobian calculations. procedure ( single_step_integer_inquiry ), public , pass , deferred :: & get_stage_count !! Gets the number of stages used by the integrator. procedure , public :: solve => ssi_ode_solver !! Solves the supplied system of ODE's. end type interface subroutine attempt_single_step ( this , sys , h , x , y , f , yn , fn , yerr , k , args ) use iso_fortran_env import single_step_integrator import ode_container !! Attempts an integration step for a single-step integrator. class ( single_step_integrator ), intent ( inout ) :: this !! The single_step_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next !! solution estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: yerr !! An N-element array where this routine will write an estimate !! of the error in each equation. real ( real64 ), intent ( out ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each !! stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. end subroutine pure function get_single_step_logical_parameter ( this ) result ( rst ) !! Returns a logical parameter from a single_step_integrator object. import single_step_integrator class ( single_step_integrator ), intent ( in ) :: this !! The single_step_integrator object. logical :: rst !! The parameter. end function subroutine single_step_post_step_routine ( this , sys , dense , x , xn , y , & yn , f , fn , k , args ) !! Provides a routine for performing any actions, such as setting !! up interpolation, after successful completion of a step. use iso_fortran_env import single_step_integrator import ode_container class ( single_step_integrator ), intent ( inout ) :: this !! The single_step_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. logical , intent ( in ) :: dense !! Determines if dense output is requested (true); else, false. real ( real64 ), intent ( in ) :: x !! The previous value of the independent variable. real ( real64 ), intent ( in ) :: xn !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the derivatives at x. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( inout ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each !! stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. end subroutine subroutine single_step_interpolate ( this , x , xn , yn , fn , xn1 , yn1 , & fn1 , y ) !! Provides a routine for interpolation. use iso_fortran_env import single_step_integrator class ( single_step_integrator ), intent ( in ) :: this !! The single_step_integrator object. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at which to compute !! the interpolation. real ( real64 ), intent ( in ) :: xn !! The previous value of the independent variable at which the !! solution is computed. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( in ) :: xn1 !! The value of the independent variable at xn + h. real ( real64 ), intent ( in ), dimension (:) :: yn1 !! An N-element array containing the solution at xn + h. real ( real64 ), intent ( in ), dimension (:) :: fn1 !! An N-element array containing the derivatives at xn + h. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where this routine will write the !! solution values interpolated at x. end subroutine subroutine single_step_pre_step_routine ( this , prevs , sys , h , x , y , f , & args ) !! Provides a routine for performing any actions, such as setting !! up Jacobian calculations. use iso_fortran_env import single_step_integrator import ode_container class ( single_step_integrator ), intent ( inout ) :: this !! The single_step_integrator object. logical , intent ( in ) :: prevs !! Defines the status of the previous step.  The value is true !! if the previous step was successful; else, false if the !! previous step failed. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. end subroutine pure function single_step_integer_inquiry ( this ) result ( rst ) !! Gets an integer from the integrator. use iso_fortran_env import single_step_integrator class ( single_step_integrator ), intent ( in ) :: this !! The single_step_integrator object. integer :: rst !! The integer value. end function end interface contains ! ------------------------------------------------------------------------------ subroutine ssi_cache_dense ( this , x_start , x_end , y_start , y_end , f_start , f_end ) class ( single_step_integrator ), intent ( inout ) :: this real ( real64 ), intent ( in ) :: x_start , x_end real ( real64 ), intent ( in ) :: y_start (:), y_end (:), f_start (:), f_end (:) integer :: n n = size ( y_start ) if ( allocated ( this % m_denseState )) then if ( size ( this % m_denseState , 1 ) /= n ) deallocate ( this % m_denseState ) end if if (. not . allocated ( this % m_denseState )) allocate ( this % m_denseState ( n , 4 )) this % m_denseState (:, 1 ) = y_start this % m_denseState (:, 2 ) = f_start this % m_denseState (:, 3 ) = y_end this % m_denseState (:, 4 ) = f_end call this % set_dense_interval ( x_start , x_end , n ) end subroutine subroutine ssi_dense_output ( this , x , y ) class ( single_step_integrator ), intent ( in ) :: this real ( real64 ), intent ( in ) :: x real ( real64 ), intent ( out ) :: y (:) real ( real64 ) :: x_start , x_end call this % get_dense_interval ( x_start , x_end ) call this % interpolate ( x , x_start , this % m_denseState (:, 1 ), & this % m_denseState (:, 2 ), x_end , this % m_denseState (:, 3 ), & this % m_denseState (:, 4 ), y ) end subroutine ! ****************************************************************************** ! SINGLE-STEP INTEGRATOR ! ------------------------------------------------------------------------------ subroutine ssi_ode_solver ( this , sys , x , iv , store_iv , args ) !! Solves the supplied system of ODE's. class ( single_step_integrator ), intent ( inout ) :: this !! The single_step_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ), dimension (:) :: x !! An array of independent variable values at which to return the !! the solution to the ODE's. real ( real64 ), intent ( in ), dimension (:) :: iv !! An array containing the initial values for each ODE. logical , intent ( in ), optional :: store_iv !! An optional input that determines whether or not the !! initial values are stored as part of the output.  The !! default is true such that the initial values are stored; !! however, set to false to avoid storing the initial values. !! This can be useful in cases of event detection where a !! restart of the integrator is desired. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables logical :: dense , need_dense , success , forward , find_events , event_found integer :: i , j , n , neqn , nsteps , nstages , nevents real ( real64 ) :: h , xo , xn , xmax , ei , eold , xe real ( real64 ), allocatable , dimension (:) :: f , y , yn , fn , yerr , yi , ye real ( real64 ), allocatable , dimension (:,:) :: k ! Initialization n = size ( x ) success = . true . call this % invalidate_dense_output () nevents = sys % get_event_equation_count () find_events = sys % get_is_ode_event_function_defined () . and . nevents > 0 ! Input Checking if ( n < 2 ) error stop DIFFEQ_ARRAY_SIZE_ERROR if (. not . sys % get_is_ode_defined ()) error stop DIFFEQ_MISSING_ARGUMENT_ERROR ! Ensure interpolation is enabled if we're solving for events as well if ( find_events ) call this % set_dense_output_enabled (. true .) ! Additional Initialization neqn = size ( iv ) xo = x ( 1 ) xmax = x ( n ) forward = xmax >= xo j = 2 eold = 1.0d-4 dense = ( n > 2 ) nsteps = this % get_step_limit () nstages = this % get_stage_count () ! Memory Allocations allocate ( & f ( neqn ), & y ( neqn ), & yn ( neqn ), & fn ( neqn ), & yerr ( neqn ), & k ( neqn , nstages ), & yi ( neqn ) & ) if ( find_events ) allocate ( ye ( neqn )) ! Estimate an initial step size ! ! Outputs: ! - f: Value of the derivatives at xo ! - h: Initial step size estimate call this % estimate_inital_step_size ( sys , xo , xmax , iv , f , h , args ) ! Store the initial conditions if ( present ( store_iv )) then if ( store_iv ) call this % append_to_buffer ( x ( 1 ), iv ) else call this % append_to_buffer ( x ( 1 ), iv ) end if y = iv ! Cycle until integration is complete do i = 1 , nsteps call this % invalidate_dense_output () ! Perform any pre-step actions call this % pre_step_action ( success , sys , h , xo , y , f , args = args ) ! Attempt a step call this % attempt_step ( sys , h , xo , y , f , yn , fn , yerr , k , args ) xn = xo + h ! Compute a normalized error value.  A value < 1 indicates success ei = this % compute_error_norm ( y , yn , yerr ) ! Determine the next step size h = this % estimate_next_step_size ( ei , eold , h , xo ) ! Reject the step? success = ei <= 1.0d0 if (. not . success ) then call this % log_failed_step () cycle ! We failed.  Try again with a new step size end if ! If we're here, the step has been successful.  Take any post-step ! action such as setting up interpolation routines, etc. need_dense = dense . or . this % get_dense_output_enabled () . or . & (( xmax - x ( 1 )) * ( xn - xmax ) > 0.0d0 ) call this % post_step_action ( sys , need_dense , xo , xn , y , yn , f , fn , k , args ) if ( need_dense ) call this % cache_dense_output ( xo , xn , y , yn , f , fn ) call this % log_successful_step () ! Detect events if ( find_events ) then event_found = this % event_solver % find_event ( sys % event_function , & this , nevents , xo , y , xn , yn , xe , ye , args = args ) if ( event_found ) then if ( dense ) then interp_event : do while ( j <= n . and . & (( forward . and . x ( j ) < xe ) . or . & (. not . forward . and . x ( j ) > xe ))) call this % evaluate_dense ( x ( j ), yi ) call this % append_to_buffer ( x ( j ), yi ) j = j + 1 end do interp_event end if call this % append_to_buffer ( xe , ye ) go to 100 end if end if ! Do we need to interpolate for dense output, or can we just store ! values and move on if ( dense ) then ! Perform the interpolation as needed until a new step is required interp : do while ( j <= n . and . & (( forward . and . x ( j ) <= xn ) . or . & (. not . forward . and . x ( j ) >= xn ))) call this % evaluate_dense ( x ( j ), yi ) call this % append_to_buffer ( x ( j ), yi ) j = j + 1 if ( j > n ) exit interp end do interp else ! Store the values and move on call this % append_to_buffer ( xn , yn ) end if ! Are we done? if (( xmax - x ( 1 )) * ( xn - xmax ) >= 0.0d0 ) then ! Deal with the case where output is only returned at the ! integration points and the solver oversteps the endpoint. if (( xmax - x ( 1 )) * ( xn - xmax ) > 0.0d0 ) then ! Interpolate to get the solution at xmax if ( j <= n ) then call this % evaluate_dense ( xmax , yi ) call this % append_to_buffer ( xmax , yi ) end if end if ! We're done go to 100 end if ! Do we need to limit the step size to not overshoot the terminal value? if ( this % get_allow_overshoot () . and . & ( xmax - x ( 1 )) * ( xn + h - xmax ) > 0.0d0 ) then ! Limit the step size h = xmax - xn end if ! Update parameters xo = xn y = yn ! Is this an FSAL integrator?  If so, we already have the derivative ! values.  If not, we need to recompute the derivative values for the ! next iteration if ( this % get_is_fsal ()) then ! We have the derivative estimate already f = fn else ! Update the derivative estimates call sys % compute_rhs ( xn , yn , f , args ) ! write to f, not fn call this % log_function_evaluation () end if end do ! If we're here, the solver has run out of allowable steps error stop DIFFEQ_ITERATION_COUNT_EXCEEDED_ERROR ! End 100 continue return end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_singlestep.f90.html"},{"title":"diffeq_base.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_base !! A collection of base types for the DIFFEQ library. use iso_fortran_env use , intrinsic :: ieee_arithmetic , only : ieee_is_finite , ieee_value , & ieee_quiet_nan use diffeq_errors use diffeq_containers , only : ode_results use diffeq_auto_diff implicit none private public :: ode public :: ode_ad public :: ode_jacobian public :: ode_mass_matrix public :: ode_container public :: ode_integrator public :: ode_solver public :: ode_integer_inquiry public :: ode_dense_output public :: ode_event_function public :: ode_event_solver public :: ode_event_statistics ! ------------------------------------------------------------------------------ interface subroutine ode ( x , y , dydx , args ) !! An interface to a routine containing a system of first order !! ODE's to integrate. use iso_fortran_env , only : real64 real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current state vector. real ( real64 ), intent ( out ), dimension (:) :: dydx !! An N-element array where the derivative values will be !! written. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the routine. end subroutine subroutine ode_ad ( x , y , dydx , args ) !! An interface to a routine containing a system of first order !! ODE's to integrate leveraging automatic differentiation for !! Jacobian evaluations, where appropriate. use diffeq_auto_diff , only : real_ad type ( real_ad ), intent ( in ) :: x !! The current value of the independent variable. type ( real_ad ), intent ( in ), dimension (:) :: y !! An N-element array containing the current state vector. type ( real_ad ), intent ( out ), dimension (:) :: dydx !! An N-element array where the derivative values will be !! written. Assign both components of every element, using AD !! expressions or constant assignment rather than setting x alone. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the routine. Repeated evaluations at the same !! values must describe the same function, regardless of seeds. end subroutine subroutine ode_jacobian ( x , y , jac , args ) !! An interface to a routine capable of computing the Jacobian !! matrix of a system of first order ODE's. use iso_fortran_env , only : real64 real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current state vector. real ( real64 ), intent ( out ), dimension (:,:) :: jac !! An M-by-N matrix where the Jacobian will be written. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the routine. end subroutine subroutine ode_mass_matrix ( x , y , m , args ) !! An interface to a routine capable of computing a mass matrix !! for a system of differential equations. use iso_fortran_env , only : real64 real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current state vector. real ( real64 ), intent ( out ), dimension (:,:) :: m !! An N-by-N matrix where the class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the routine. end subroutine subroutine ode_event_function ( x , y , f , args ) !! A callback routine for evaluating event status. use iso_fortran_env , only : real64 real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current state vector. real ( real64 ), intent ( out ), dimension (:) :: f !! An M-element array containing the values of the event !! functions.  The solver attempts to find the situation !! where f equals zero thereby signaling an event.  Notice, M !! need not equal N (N is the number of state variables). class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the routine. end subroutine end interface ! ------------------------------------------------------------------------------ type ode_container !! Defines the callbacks and model options for an ODE problem. !! !! The required right-hand-side callback describes !!  y' = f(x,y) . Optional callbacks provide an analytical !! Jacobian  J = \\partial f / \\partial y  and a mass matrix for !! systems of the form  M(x,y)y' = f(x,y) . If no Jacobian is !! supplied, DIFFEQ uses AD when fcn_ad is assigned, or finite differences !! when fcn is assigned. Assign exactly one RHS callback. A null !! mass-matrix callback means that  M = I . logical , private :: m_massDependent = . false . ! A value determining if the mass matrix is state dependent such ! that it must be recomputed at each step. real ( real64 ), private , allocatable , dimension (:) :: m_jwork ! Jacobian calculation workspace array. real ( real64 ), private :: m_fdStep = sqrt ( epsilon ( 1.0d0 )) ! Finite difference step size. type ( real_ad ), private , allocatable :: m_ad_state (:), m_ad_rhs (:) !! Reusable AD input/output workspace, allocated only for AD models. integer , private :: m_jacobian_function_evaluations = 0 !! RHS callback calls made by the most recent compute_jacobian. procedure ( ode ), pointer , public , nopass :: fcn => null () !! A pointer to the routine containing the ODEs to integrate. procedure ( ode_ad ), pointer , public , nopass :: fcn_ad => null () !! A pointer to the routine containing the ODEs to integrate.  Use !! this pointer instead of [[fcn]] when automatic differentiation is !! desired for calculation of the Jacobian.  Do not use both !! pointers as this will produce an error.  If [[fcn]] is utilized, !! then the Jacobian will be computed by either a user-supplied !! Jacobian callback or by finite differences.  If this pointer !! is utilized, then the Jacobian will be computed by either a !! user-supplied Jacobian callback or automatic differentiation. !! In either case a user-supplied Jacobian callback is the preferred !! option falling back to either finite differences or automatic !! differentiation in its absence. procedure ( ode_jacobian ), pointer , public , nopass :: & jacobian => null () !! A pointer to the routine containing the analytical Jacobian. !! Takes precedence over AD and finite differences. If null, the !! selected RHS representation determines the differentiation method. procedure ( ode_mass_matrix ), pointer , public , nopass :: & mass_matrix => null () !! A pointer to the routine containing the mass matrix for the !! system.  If set to null (the default), an identity mass matrix !! will be assumed. procedure ( ode_event_function ), pointer , public , nopass :: & event_function => null () !! A pointer to the event function. integer , private :: m_nevents = 0 !! The number of event equations.  This number need not be equal !! to the number of ODE's. contains procedure , private :: allocate_workspace => oc_alloc_workspace procedure , private :: allocate_ad_workspace => oc_alloc_ad_workspace procedure , public :: get_finite_difference_step => oc_get_fd_step procedure , public :: set_finite_difference_step => oc_set_fd_step procedure , public :: get_is_mass_matrix_dependent => & oc_get_is_mass_dependent procedure , public :: set_is_mass_matrix_dependent => & oc_set_is_mass_dependent procedure , public :: compute_jacobian => oc_jacobian procedure , public :: get_jacobian_function_evaluations => oc_get_jacobian_calls procedure , public :: compute_time_derivative => oc_time_derivative procedure , public :: get_is_ode_defined => oc_get_is_ode_defined procedure , public :: use_finite_difference_jacobian => & oc_use_finite_difference_jacobian procedure , public :: compute_rhs => oc_eval_rhs procedure , public :: compute_mass_matrix => oc_eval_mass_matrix procedure , public :: has_mass_matrix => oc_has_mass_matrix procedure , public :: get_is_ode_event_function_defined => & oc_is_event_fcn_defined procedure , public :: get_event_equation_count => oc_get_event_eqn_count procedure , public :: set_event_equation_count => oc_set_event_eqn_count end type ! ------------------------------------------------------------------------------ type ode_event_statistics !! An ODE event solver statistics container. integer :: iteration_count = 0 !! The number of iterations taken by the solver. integer :: function_evaluations = 0 !! The number of event function evaluations. integer :: event_index = 0 !! The index of the event equation where an event was located. end type type ode_event_solver !! Provides a mechanism for event detection. integer , private :: m_maxIter = 1000 !! The maximum number of iterations allowed. real ( real64 ), private :: m_tol = 1.0d-12 !! The convergence tolerance. type ( ode_event_statistics ), public :: solver_statistics !! Event solver information. contains procedure , public :: get_max_allowed_iterations => oes_get_max_iter !! Gets the number of iterations the solver is allowed to take. procedure , public :: set_max_allowed_iterations => oes_set_max_iter !! Sets the number of iterations the solver is allowed to take. procedure , public :: get_solver_tolerance => oes_get_tol !! Gets the solver tolerance. procedure , public :: set_solver_tolerance => oes_set_tol !! Sets the solver tolerance. procedure , public :: is_event_suspected => oes_event_in_bracket !! Determines if an event is suspected to exist within the & !! specified bracket. procedure , public :: find_event => oes_find_event !! Attempts to find any events within a specified bracket. procedure , private :: find_channel_event => oes_find_single_channel_event end type ! ------------------------------------------------------------------------------ type , abstract :: ode_integrator !! Abstract base class for all DIFFEQ ODE integrators. !! !! Every concrete integrator accepts an `ode_container`, an array of !! output coordinates, and an initial state. Adaptive solvers use a !! scaled local error such as !!  \\mathrm{err}_i / (\\mathrm{atol} + \\mathrm{rtol}|y_i|)  !! to choose their step sizes. type ( ode_results ), private :: m_buffer ! The internal solution buffer. real ( real64 ), private :: m_abstol = 1.0d-6 ! The absolute tolerance value applied to each equation. real ( real64 ), private :: m_reltol = 1.0d-6 ! The relative tolerance value applied to each equation. real ( real64 ), private , allocatable , dimension (:) :: m_abstols ! Per-equation absolute tolerances, when defined. real ( real64 ), private , allocatable , dimension (:) :: m_reltols ! Per-equation relative tolerances, when defined. real ( real64 ), private :: m_minStep = 1.0d1 * epsilon ( 1.0d0 ) ! The minimum allowable step size. real ( real64 ), private :: m_maxStep = huge ( 1.0d0 ) ! The maximum allowable step size. real ( real64 ), private :: m_safetyFactor = 0.9d0 ! The step size safety factor. real ( real64 ), private :: m_beta = 0.0d0 ! PI step size controller exponent. logical , private :: m_reject = . false . ! Internal variable tracking step size acceptance. integer , private :: m_stepLimit = 1000000 ! A limit on the total number of integration steps.  Exceeding this ! value may indicate that a different integrator should be ! considered.  Either that, or this is a really large-sized ! problem that is being solved. logical , private :: m_allowOvershoot = . true . ! True if the solver is allowed to overshoot the final value and ! interpolate back.  False, if the solver must terminate on the ! final value. logical , private :: m_denseEnabled = . false . ! Dense output enabled? logical , private :: m_denseValid = . false . ! Is dense output valid for this solver type? real ( real64 ), private :: m_denseInterval ( 2 ) = 0.0d0 ! The interval over which the stored dense output interpolation ! is defined integer , private :: m_denseSize = 0 ! The number of dense output equations. type ( ode_event_solver ), public :: event_solver !! The ODE event solver.  Enable event detection by defining the !! event_function in the [[ode_container]] object. contains procedure , public :: set_dense_output_enabled => oi_set_dense_enabled !! Enables dense output on every accepted step (default: false). procedure , public :: get_dense_output_enabled => oi_get_dense_enabled !! Gets the explicit dense-output preparation setting. procedure , public :: has_dense_output => oi_has_dense_output !! Tests whether a prepared accepted-step interpolant is available. procedure , public :: get_dense_interval => oi_get_dense_interval !! Gets the prepared step's start and end in integration order. procedure , public :: evaluate_dense => oi_evaluate_dense !! Evaluates the prepared step without advancing integration. procedure ( ode_dense_output ), public , pass , deferred :: compute_dense_output !! Implementation hook for evaluating a validated dense-output query. procedure , public :: set_dense_interval => oi_set_dense_interval !! Implementation hook publishing a prepared accepted step. procedure , public :: invalidate_dense_output => oi_invalidate_dense !! Invalidates the prepared interpolant before stepping or resetting. procedure ( ode_solver ), public , pass , deferred :: solve !! Solves the supplied system of ODE's. procedure ( ode_integer_inquiry ), public , pass , deferred :: get_order !! Returns the order of the integrator. procedure , public :: append_to_buffer => oi_append_to_buffer !! Appends the supplied solution point to the internal solution !! buffer. procedure , public :: get_solution => oi_get_solution !! Returns the solution computed by the integrator. procedure , public :: get_ode_results => oi_get_ode_results !! Returns the solution stored within an [[ode_results]] object. procedure , public :: clear_buffer => oi_clear_buffer !! Clears the contents of the buffer. procedure , public :: get_absolute_tolerance => oi_get_abs_tol !! Gets the absolute error tolerance. procedure , private :: oi_set_abs_tol procedure , private :: oi_set_abs_tols generic , public :: set_absolute_tolerance => oi_set_abs_tol , & oi_set_abs_tols !! Sets the absolute error tolerance. procedure , public :: get_relative_tolerance => oi_get_rel_tol !! Gets the relative error tolerance. procedure , private :: oi_set_rel_tol procedure , private :: oi_set_rel_tols generic , public :: set_relative_tolerance => oi_set_rel_tol , & oi_set_rel_tols !! Sets the relative error tolerance. procedure , public :: compute_error_norm => oi_estimate_error !! Computes the norm of the scaled error estimate. procedure , public :: get_minimum_step_size => oi_get_min_step !! Gets the magnitude of the minimum allowed step size. procedure , public :: set_minimum_step_size => oi_set_min_step !! Sets the magnitude of the minimum allowed step size. procedure , public :: get_maximum_step_size => oi_get_max_step !! Gets the magnitude of the maximum allowed step size. procedure , public :: set_maximum_step_size => oi_set_max_step !! Sets the magnitude of the maximum allowed step size. procedure , public :: get_step_size_factor => oi_get_safety_factor !! Gets the step size safety factor. procedure , public :: set_step_size_factor => oi_set_safety_factor !! Sets the step size safety factor. procedure , public :: get_step_size_control_parameter => & oi_get_control_parameter !! Gets the step size PI control parameter. procedure , public :: set_step_size_control_parameter => & oi_set_control_parameter !! Sets the step size PI control parameter. procedure , public :: estimate_next_step_size => oi_next_step !! Estimates the next step size. procedure , public :: estimate_inital_step_size => oi_initial_step !! Computes an estimate of an initial step size. procedure , public :: get_step_limit => oi_get_step_limit !! Gets the limit on the number of integration steps. procedure , public :: set_step_limit => oi_set_step_limit !! Sets the limit on the number of integration steps. procedure , public :: get_allow_overshoot => oi_get_allow_overshoot !! Gets a value determining if the solver is allowed to overshoot !! the final value in the integration range. procedure , public :: set_allow_overshoot => oi_set_allow_overshoot !! Sets a value determining if the solver is allowed to overshoot !! the final value in the integration range. procedure , public :: log_failed_step => oi_log_failed_step !! Logs a failed integration step. procedure , public :: log_successful_step => oi_log_successful_step !! Logs a successful integration step. procedure , public :: log_jacobian_evaluation => oi_log_jacobian_eval !! Logs a Jacobian matrix evaluation. procedure , public :: log_function_evaluation => oi_log_function_eval !! Logs a function evaluation. procedure , public :: log_matrix_factorization => oi_log_matrix_factorization !! Logs a matrix factorization. end type abstract interface subroutine ode_dense_output ( this , x , y ) import ode_integrator , real64 class ( ode_integrator ), intent ( in ) :: this real ( real64 ), intent ( in ) :: x real ( real64 ), intent ( out ) :: y (:) end subroutine subroutine ode_solver ( this , sys , x , iv , store_iv , args ) !! Solves the supplied system of ODE's. use iso_fortran_env import ode_integrator import ode_container class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ), dimension (:) :: x !! An array, of at least 2 values, defining at a minimum !! the starting and ending values of the independent variable !! integration range.  If more than two values are specified, !! the integration results will be returned at the supplied !! values. real ( real64 ), intent ( in ), dimension (:) :: iv !! An array containing the initial values for each ODE. logical , intent ( in ), optional :: store_iv !! An optional input that determines whether or not the !! initial values are stored as part of the output.  The !! default is true such that the initial values are stored; !! however, set to false to avoid storing the initial values. !! This can be useful in cases of event detection where a !! restart of the integrator is desired. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. end subroutine pure function ode_integer_inquiry ( this ) result ( rst ) !! Returns an integer value from the ode_integrator object. use iso_fortran_env import ode_integrator class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. integer :: rst !! The requested value. end function end interface contains ! ****************************************************************************** ! ODE_CONTAINER ROUTINES ! ------------------------------------------------------------------------------ pure function oc_get_fd_step ( this ) result ( rst ) !! Gets the size of the step to use for the finite difference !! calculations used to estimate the Jacobian. class ( ode_container ), intent ( in ) :: this !! The ode_container object. real ( real64 ) :: rst !! The step size. rst = this % m_fdStep end function ! -------------------- subroutine oc_set_fd_step ( this , x ) !! Sets the size of the step to use for the finite difference !! calculations used to estimate the Jacobian. class ( ode_container ), intent ( inout ) :: this !! The ode_container object. real ( real64 ), intent ( in ) :: x !! The step size. this % m_fdStep = x end subroutine ! ------------------------------------------------------------------------------ pure function oc_get_is_mass_dependent ( this ) result ( rst ) !! Gets a value determining if the mass matrix is state-dependent !! such that it requires updating at every integration step. class ( ode_container ), intent ( in ) :: this !! The ode_container object. logical :: rst !! True if the mass matrix is state-dependent such that it !! requires updating at each integration step; else, false if the !! mass matrix is not state-dependent and can be treated as constant !! for all integration steps. rst = this % m_massDependent end function ! -------------------- subroutine oc_set_is_mass_dependent ( this , x ) !! Sets a value determining if the mass matrix is state-dependent !! such that it requires updating at every integration step. class ( ode_container ), intent ( inout ) :: this !! The ode_container object. logical :: x !! True if the mass matrix is state-dependent such that it !! requires updating at each integration step; else, false if the !! mass matrix is not state-dependent and can be treated as constant !! for all integration steps. this % m_massDependent = x end subroutine ! ------------------------------------------------------------------------------ subroutine oc_jacobian ( this , x , y , jac , args ) !! Computes df/dy, holding x fixed. Uses an explicit Jacobian if supplied, !! otherwise AD (N RHS calls) or forward differences (N+1 RHS calls). !! The most recent callback count is available through !! get_jacobian_function_evaluations. An explicit Jacobian counts as zero !! RHS calls; calls made inside user-owned Jacobian code are not tracked. class ( ode_container ), intent ( inout ) :: this !! The ode_container object. real ( real64 ), intent ( in ) :: x !! The current independent variable value. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current dependent !! variable values. real ( real64 ), intent ( out ), dimension (:,:) :: jac !! An N-by-N matrix where the Jacobian will be written. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: i , ndof real ( real64 ) :: h ! Initialization ndof = size ( y ) h = this % get_finite_difference_step () ! Input Checking if ( size ( jac , 1 ) /= ndof . or . size ( jac , 2 ) /= ndof ) & error stop DIFFEQ_MATRIX_SIZE_ERROR this % m_jacobian_function_evaluations = 0 if ( associated ( this % fcn_ad )) then if (. not . this % get_is_ode_defined ()) error stop DIFFEQ_NULL_POINTER_ERROR end if ! Use a user-defined routine, and then be done if ( associated ( this % jacobian )) then call this % jacobian ( x , y , jac , args ) return end if if ( associated ( this % fcn_ad )) then call this % allocate_ad_workspace ( ndof ) this % m_ad_state = y do i = 1 , ndof this % m_ad_state ( i )% dx = 1.0d0 call this % fcn_ad ( real_ad ( x , 0.0d0 ), this % m_ad_state , this % m_ad_rhs , args ) this % m_jacobian_function_evaluations = this % m_jacobian_function_evaluations + 1 jac (:, i ) = this % m_ad_rhs % dx this % m_ad_state ( i )% dx = 0.0d0 end do return end if ! Allocate workspace.  No action is taken if the proper workspace is ! already allocated. call this % allocate_workspace ( ndof ) ! Finite Difference Approximation ! J(i,j) = df(i) / dy(j) this % m_jwork ( 1 : ndof ) = y call this % compute_rhs ( x , y , this % m_jwork ( ndof + 1 :), args ) this % m_jacobian_function_evaluations = 1 do i = 1 , ndof this % m_jwork ( i ) = this % m_jwork ( i ) + h call this % compute_rhs ( x , this % m_jwork ( 1 : ndof ), jac (:, i ), args ) this % m_jacobian_function_evaluations = this % m_jacobian_function_evaluations + 1 jac (:, i ) = ( jac (:, i ) - this % m_jwork ( ndof + 1 :)) / h this % m_jwork ( i ) = y ( i ) end do end subroutine ! ------------------------------------------------------------------------------ function oc_get_jacobian_calls ( this ) result ( rst ) !! Returns RHS calls made by the last compute_jacobian (initially zero). !! Solvers use this count for both AD and finite-difference statistics. !! Extensions overriding compute_jacobian should override this query if !! their implementation makes additional RHS calls. class ( ode_container ), intent ( in ) :: this !! The model whose most recent Jacobian work is queried. integer :: rst !! Number of RHS calls, excluding the explicit Jacobian callback. rst = this % m_jacobian_function_evaluations end function ! ------------------------------------------------------------------------------ function oc_use_finite_difference_jacobian ( this ) result ( rst ) !! States if a finite difference approximation to the Jacobian is utilized. class ( ode_container ), intent ( in ) :: this !! The [[ode_container]] object. logical :: rst !! True if a finite difference approximation is being utilized; else, !! false. rst = . not . associated ( this % jacobian ) . and . . not . associated ( this % fcn_ad ) end function ! ------------------------------------------------------------------------------ subroutine oc_alloc_ad_workspace ( this , ndof ) !! Allocates or resizes AD buffers only when the number of states changes. class ( ode_container ), intent ( inout ) :: this !! The model owning the reusable workspace. integer , intent ( in ) :: ndof !! Required state and RHS length. if ( allocated ( this % m_ad_state )) then if ( size ( this % m_ad_state ) == ndof ) return deallocate ( this % m_ad_state , this % m_ad_rhs ) end if allocate ( this % m_ad_state ( ndof ), this % m_ad_rhs ( ndof )) end subroutine ! ------------------------------------------------------------------------------ subroutine oc_time_derivative ( this , x , y , f , dfdx , args ) !! Computes partial df/dx with y fixed, using one RHS callback evaluation. !! AD seeds x only. Real callbacks use a forward difference with the !! supplied unperturbed RHS f. Mass-matrix derivatives are not included. class ( ode_container ), intent ( inout ) :: this !! The model to differentiate. real ( real64 ), intent ( in ) :: x !! Independent-variable value. real ( real64 ), intent ( in ) :: y (:), f (:) !! State and the previously computed RHS at (x,y). real ( real64 ), intent ( out ) :: dfdx (:) !! Partial time derivative, with the same length as y. class ( * ), intent ( inout ), optional :: args !! User-owned callback data, forwarded unchanged. real ( real64 ) :: h if ( size ( f ) /= size ( y ) . or . size ( dfdx ) /= size ( y )) error stop DIFFEQ_ARRAY_SIZE_ERROR if (. not . this % get_is_ode_defined ()) error stop DIFFEQ_NULL_POINTER_ERROR if ( associated ( this % fcn_ad )) then call this % allocate_ad_workspace ( size ( y )) this % m_ad_state = y call this % fcn_ad ( real_ad ( x , 1.0d0 ), this % m_ad_state , this % m_ad_rhs , args ) dfdx = this % m_ad_rhs % dx else h = this % get_finite_difference_step () call this % compute_rhs ( x + h , y , dfdx , args ) dfdx = ( dfdx - f ) / h end if end subroutine ! ------------------------------------------------------------------------------ subroutine oc_alloc_workspace ( this , ndof ) ! Use to allocate internal workspaces.  This routine only takes action ! if the workspace array(s) are not sized properly for the application. class ( ode_container ), intent ( inout ) :: this ! The ode_container object. integer , intent ( in ) :: ndof ! The number of degrees of freedom. ! Jacobian Workspace Allocation if ( allocated ( this % m_jwork )) then if ( size ( this % m_jwork ) /= 2 * ndof ) then deallocate ( this % m_jwork ) allocate ( this % m_jwork ( 2 * ndof ), source = 0.0d0 ) end if else allocate ( this % m_jwork ( 2 * ndof ), source = 0.0d0 ) end if end subroutine ! ------------------------------------------------------------------------------ function oc_get_is_ode_defined ( this ) result ( rst ) !! Gets a logical value determining if the ODE routine has been defined. !! This function also ensures that only either fcn or fcn_ad has been !! defined.  If both have been defined a DIFFEQ_INVALID_OPERATION_ERROR !! is thrown. class ( ode_container ), intent ( in ) :: this !! The ode_container object. logical :: rst !! True if the ODE routine has been defined; else, false. if ( associated ( this % fcn ) . and . associated ( this % fcn_ad )) then error stop DIFFEQ_INVALID_OPERATION_ERROR end if rst = associated ( this % fcn ) . or . associated ( this % fcn_ad ) end function ! ------------------------------------------------------------------------------ subroutine oc_eval_rhs ( this , x , y , dydx , args ) !! Evaluates fcn or fcn_ad. AD inputs have zero seeds and only output values !! are extracted. Missing callbacks cause DIFFEQ_NULL_POINTER_ERROR; !! assigning both representations causes DIFFEQ_INVALID_OPERATION_ERROR. class ( ode_container ), intent ( inout ) :: this !! The [[ode_container]] object. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current values of the !! dependent variables. real ( real64 ), intent ( out ), dimension (:) :: dydx !! An N-element array where the derivative values will be !! written. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the routine. if ( size ( dydx ) /= size ( y )) error stop DIFFEQ_ARRAY_SIZE_ERROR if (. not . this % get_is_ode_defined ()) error stop DIFFEQ_NULL_POINTER_ERROR if ( associated ( this % fcn_ad )) then call this % allocate_ad_workspace ( size ( y )) this % m_ad_state = y call this % fcn_ad ( real_ad ( x , 0.0d0 ), this % m_ad_state , this % m_ad_rhs , args ) dydx = this % m_ad_rhs % x else call this % fcn ( x , y , dydx , args = args ) end if end subroutine ! ------------------------------------------------------------------------------ function oc_has_mass_matrix ( this ) result ( rst ) !! Returns true if the problem utilizes a mass matrix. class ( ode_container ), intent ( in ) :: this !! The [[ode_container]] object. logical :: rst !! True if a mass matrix is utilized; else, false. rst = associated ( this % mass_matrix ) end function ! ------------------------------------------------------------------------------ subroutine oc_eval_mass_matrix ( this , x , y , m , args ) use linalg , only : identity !! Evaluates the mass matrix defined by the function pointer 'mass_matrix'. !! If no function is assigned to 'mass_matrix' this routine returns an !! appropriately sized identity matrix. class ( ode_container ), intent ( inout ) :: this !! The [[ode_container]] object. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current values of the !! dependent variables. real ( real64 ), intent ( out ), dimension (:,:) :: m !! An N-by-N matrix where the class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the routine. integer :: n n = size ( y ) if ( associated ( this % mass_matrix )) then call this % mass_matrix ( x , y , m , args = args ) else m = identity ( n ) end if end subroutine ! ------------------------------------------------------------------------------ function oc_is_event_fcn_defined ( this ) result ( rst ) !! Tests to see if the event function has been defined. class ( ode_container ), intent ( in ) :: this !! The [[ode_container]] object. logical :: rst !! True if the event function has been defined; else, false. rst = associated ( this % event_function ) end function ! ------------------------------------------------------------------------------ pure function oc_get_event_eqn_count ( this ) result ( rst ) !! Gets the number of event functions. class ( ode_container ), intent ( in ) :: this !! The [[ode_container]] object. integer :: rst !! The equation count. rst = this % m_nevents end function ! -------------------- subroutine oc_set_event_eqn_count ( this , x ) !! Sets the number of event functions. class ( ode_container ), intent ( inout ) :: this !! The [[ode_container]] object. integer , intent ( in ) :: x !! The equation count. this % m_nevents = x end subroutine ! ****************************************************************************** ! ODE_INTEGRATOR ROUTINES ! ------------------------------------------------------------------------------ subroutine oi_append_to_buffer ( this , x , y ) !! Appends the supplied solution point to the internal solution buffer. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ) :: x !! The independent variable value. real ( real64 ), intent ( in ), dimension (:) :: y !! The values of the dependent variables corresponding to x. call this % m_buffer % push ( x , y ) end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_solution ( this ) result ( rst ) !! Returns the solution computed by the integrator stored as a matrix with !! the first column containing the values of the independent variable at !! which the solution was computed.  The remaining columns contain the !! solutions for each of the integrated equations in the order in which they !! appear in the source routine.  Notice, the solve routine must be called !! before this routine. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. real ( real64 ), allocatable , dimension (:,:) :: rst !! The resulting solution matrix. if ( this % m_buffer % count () == 0 ) then allocate ( rst ( 0 , 0 )) else rst = this % m_buffer % to_matrix () end if end function ! ------------------------------------------------------------------------------ pure function oi_get_ode_results ( this ) result ( rst ) !! Returns a copy of the solution computed as a [[ode_results]] container. !! The integrator retains the original copy. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. type ( ode_results ) :: rst !! The [[ode_results]] container. rst = this % m_buffer end function ! ------------------------------------------------------------------------------ subroutine oi_clear_buffer ( this ) !! Clears the contents of the buffer. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. call this % invalidate_dense_output () call this % m_buffer % clear_all () this % m_buffer % statistics % failed_steps = 0 this % m_buffer % statistics % successful_steps = 0 this % m_buffer % statistics % jacobian_evaluations = 0 this % m_buffer % statistics % function_evaluations = 0 this % m_buffer % statistics % matrix_factorizations = 0 end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_abs_tol ( this , equation ) result ( rst ) !! Gets the absolute error tolerance. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. integer , intent ( in ), optional :: equation !! The equation index. If omitted, the scalar tolerance is returned. real ( real64 ) :: rst !! The tolerance value. if ( present ( equation ) . and . allocated ( this % m_abstols )) then rst = this % m_abstols ( equation ) else rst = this % m_abstol end if end function ! -------------------- subroutine oi_set_abs_tol ( this , x ) !! Sets the absolute error tolerance. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ) :: x !! The tolerance value. this % m_abstol = x if ( allocated ( this % m_abstols )) deallocate ( this % m_abstols ) end subroutine ! -------------------- subroutine oi_set_abs_tols ( this , x ) !! Sets the absolute error tolerance for each equation. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ), dimension (:) :: x !! The tolerance values. this % m_abstols = x end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_rel_tol ( this , equation ) result ( rst ) !! Gets the relative error tolerance. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. integer , intent ( in ), optional :: equation !! The equation index. If omitted, the scalar tolerance is returned. real ( real64 ) :: rst !! The tolerance value. if ( present ( equation ) . and . allocated ( this % m_reltols )) then rst = this % m_reltols ( equation ) else rst = this % m_reltol end if end function ! -------------------- subroutine oi_set_rel_tol ( this , x ) !! Sets the relative error tolerance. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ) :: x !! The tolerance value. this % m_reltol = x if ( allocated ( this % m_reltols )) deallocate ( this % m_reltols ) end subroutine ! -------------------- subroutine oi_set_rel_tols ( this , x ) !! Sets the relative error tolerance for each equation. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ), dimension (:) :: x !! The tolerance values. this % m_reltols = x end subroutine ! ------------------------------------------------------------------------------ pure function oi_estimate_error ( this , y , yest , yerr ) result ( rst ) !! Computes the norm of the scaled error estimate.  A value less than one !! indicates a successful step.  A value greater than one suggests that the !! results do not meet the requested tolerances. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ), dimension (:) :: y !! The previously accepted solution array (N-element). real ( real64 ), intent ( in ), dimension ( size ( y )) :: yest !! An N-element array containing the next solution point estimate. real ( real64 ), intent ( in ), dimension ( size ( y )) :: yerr !! An N-element array containing the estimate of error for each !! equation. real ( real64 ) :: rst !! The norm of the scaled error. ! Local Variables integer :: i , n real ( real64 ) :: sf , atol , rtol ! Initialization n = size ( y ) if ( allocated ( this % m_abstols )) then if ( size ( this % m_abstols ) /= n ) error stop DIFFEQ_ARRAY_SIZE_ERROR end if if ( allocated ( this % m_reltols )) then if ( size ( this % m_reltols ) /= n ) error stop DIFFEQ_ARRAY_SIZE_ERROR end if ! Process rst = 0.0d0 do i = 1 , n atol = this % get_absolute_tolerance ( i ) rtol = this % get_relative_tolerance ( i ) sf = atol + rtol * max ( abs ( y ( i )), abs ( yest ( i ))) rst = rst + ( yerr ( i ) / sf ) ** 2 end do rst = sqrt ( rst / n ) end function ! ------------------------------------------------------------------------------ pure function oi_get_min_step ( this ) result ( rst ) !! Gets the magnitude of the minimum allowed step size. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. real ( real64 ) :: rst !! The step size limit. rst = this % m_minStep end function ! -------------------- subroutine oi_set_min_step ( this , x ) !! Sets the magnitude of the minimum allowed step size. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ) :: x !! The step size limit. this % m_minStep = abs ( x ) end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_max_step ( this ) result ( rst ) !! Gets the magnitude of the maximum allowed step size. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. real ( real64 ) :: rst !! The step size limit. rst = this % m_maxStep end function ! -------------------- subroutine oi_set_max_step ( this , x ) !! Sets the magnitude of the maximum allowed step size. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ) :: x !! The step size limit. this % m_maxStep = abs ( x ) end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_safety_factor ( this ) result ( rst ) !! Gets the safety factor (step size multiplier) used to provide a measure !! of control to the step size estimate such that  h_{new} = f_{s} h , !! where  f_{s}  is this safety factor. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. real ( real64 ) :: rst !! The safety factor. rst = this % m_safetyFactor end function ! -------------------- subroutine oi_set_safety_factor ( this , x ) !! Sets the safety factor (step size multiplier) used to provide a measure !! of control to the step size estimate such that  h_{new} = f_{s} h , !! where  f_{s}  is this safety factor. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ) :: x !! The safety factor. this % m_safetyFactor = x end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_control_parameter ( this ) result ( rst ) !! Gets the step size control parameter  \\beta  used for PI control of !! the step size.  A value of 0 provides a default step size controller !! (non-PI); however, a nonzero value of  \\beta  provides PI control !! that improves stability, but comes with a potential for efficiency loss. !! A good estimate for a starting point for this parameter is  \\beta = !! \\frac{0.4}{k}  where  k  is the order of the integrator. !! !! The PI controller for step size is defined as follows. !!  h_{n+1} = f_{s} h_{n} e_{n}&#94;{-\\alpha} e_{n-1}&#94;{\\beta}  class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. real ( real64 ) :: rst !! The control parameter. rst = this % m_beta end function ! -------------------- subroutine oi_set_control_parameter ( this , x ) !! Sets the step size control parameter  \\beta  used for PI control of !! the step size.  A value of 0 provides a default step size controller !! (non-PI); however, a nonzero value of  \\beta  provides PI control !! that improves stability, but comes with a potential for efficiency loss. !! A good estimate for a starting point for this parameter is  \\beta = !! \\frac{0.4}{k}  where  k  is the order of the integrator. !! !! The PI controller for step size is defined as follows. !!  h_{n+1} = f_{s} h_{n} e_{n}&#94;{-\\alpha} e_{n-1}&#94;{\\beta}  class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ) :: x !! The control parameter this % m_beta = x end subroutine ! ------------------------------------------------------------------------------ function oi_next_step ( this , e , eold , h , x ) result ( rst ) !! Estimates the next step size based upon the current and previous error !! estimates. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. real ( real64 ), intent ( in ) :: e !! The norm of the current scaled error estimate. real ( real64 ), intent ( inout ) :: eold !! The norm of the previous step's scaled error estimate.  On output, !! this variable is updated. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current independent variable value. real ( real64 ) :: rst !! The new step size estimate. ! Parameters real ( real64 ), parameter :: minscale = 2.0d-1 real ( real64 ), parameter :: maxscale = 1.0d1 ! Local Variables integer :: k real ( real64 ) :: alpha , beta , fs , maxstep , minstep , scale ! Initialization k = this % get_order () beta = this % get_step_size_control_parameter () alpha = 1.0d0 / k - 0.75d0 * beta maxstep = this % get_maximum_step_size () minstep = this % get_minimum_step_size () fs = this % get_step_size_factor () ! Process if ( e <= 1.0d0 ) then ! The step met error tolerances and is acceptable if ( e == 0.0d0 ) then scale = maxscale else scale = fs * e ** ( - alpha ) * eold ** beta if ( scale < minscale ) scale = minscale if ( scale > maxscale ) scale = maxscale end if if ( this % m_reject ) then ! Don't let the step size increase if the last step was rejected rst = h * min ( scale , 1.0d0 ) else rst = h * scale end if eold = max ( e , 1.0d-4 ) this % m_reject = . false . else ! The step is rejected, reduce the step size scale = fs * e ** ( - alpha ) scale = max ( scale , minscale ) this % m_reject = . true . rst = h * scale end if ! Check the step size against limits if ( abs ( rst ) > maxstep ) then rst = sign ( maxstep , h ) end if if ( abs ( rst ) < minstep ) error stop DIFFEQ_STEP_SIZE_TOO_SMALL_ERROR end function ! ------------------------------------------------------------------------------ subroutine oi_initial_step ( this , sys , xo , xf , yo , fo , h , args ) !! Computes an estimate of an initial step size. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: xo !! The initial value of the independent variable. real ( real64 ), intent ( in ) :: xf !! The final value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: yo !! The initial values of the dependent variables (N-element). real ( real64 ), intent ( out ), dimension ( size ( yo )) :: fo !! An N-element array where the function values at xo will be written. real ( real64 ), intent ( out ) :: h !! The initial step size estimate. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: i , n real ( real64 ) :: dx , derivative_norm real ( real64 ), dimension ( size ( yo )) :: tol ! Use a very basic estimate of an initial step size.  The catch is that a ! single function evaluation must be made; however, this is likely needed ! in the first place, so no real extra work is necessary. n = size ( yo ) if ( allocated ( this % m_abstols )) then if ( size ( this % m_abstols ) /= n ) error stop DIFFEQ_ARRAY_SIZE_ERROR end if if ( allocated ( this % m_reltols )) then if ( size ( this % m_reltols ) /= n ) error stop DIFFEQ_ARRAY_SIZE_ERROR end if dx = 0.1d0 * ( xf - xo ) do i = 1 , n tol ( i ) = max ( this % get_absolute_tolerance ( i ), & this % get_relative_tolerance ( i )) end do call sys % compute_rhs ( xo , yo , fo , args ) derivative_norm = norm2 ( fo / tol ) if ( derivative_norm > 0.0d0 ) then h = min ( abs ( dx ), 2.0d0 / derivative_norm ) else h = abs ( dx ) end if h = min ( h , this % get_maximum_step_size ()) h = sign ( h , dx ) call this % log_function_evaluation () end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_step_limit ( this ) result ( rst ) !! Gets the limit on the number of integration steps that may be taken !! before the solver terminates. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. integer :: rst !! The step limit. rst = this % m_stepLimit end function ! -------------------- subroutine oi_set_step_limit ( this , x ) !! Sets the limit on the number of integration steps that may be taken !! before the solver terminates. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. integer , intent ( in ) :: x !! The step limit. this % m_stepLimit = x end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_allow_overshoot ( this ) result ( rst ) !! Gets a value determining if the solver is allowed to overshoot the final !! value in the integration range. class ( ode_integrator ), intent ( in ) :: this !! The ode_integrator object. logical :: rst !! True if the solver can overshoot, and then interpolate to achieve the !! required final value; else, false thereby indicating the solver !! cannot overshoot. rst = this % m_allowOvershoot end function ! -------------------- subroutine oi_set_allow_overshoot ( this , x ) !! Sets a value determining if the solver is allowed to overshoot the final !! value in the integration range. class ( ode_integrator ), intent ( inout ) :: this !! The ode_integrator object. logical , intent ( in ) :: x !! True if the solver can overshoot, and then interpolate to achieve the !! required final value; else, false thereby indicating the solver !! cannot overshoot. this % m_allowOvershoot = x end subroutine ! ------------------------------------------------------------------------------ subroutine oi_log_failed_step ( this , n ) !! Logs a failed integration step. class ( ode_integrator ), intent ( inout ) :: this !! The [[ode_integrator]] object. integer , intent ( in ), optional :: n !! An optional input useful for logging more than one step.  If not !! supplied, this routine will log a single step. if ( present ( n )) then this % m_buffer % statistics % failed_steps = & this % m_buffer % statistics % failed_steps + n else this % m_buffer % statistics % failed_steps = & this % m_buffer % statistics % failed_steps + 1 end if end subroutine ! ------------------------------------------------------------------------------ subroutine oi_log_successful_step ( this , n ) !! Logs a successful integration step. class ( ode_integrator ), intent ( inout ) :: this !! The [[ode_integrator]] object. integer , intent ( in ), optional :: n !! An optional input useful for logging more than one step.  If not !! supplied, this routine will log a single step. if ( present ( n )) then this % m_buffer % statistics % successful_steps = & this % m_buffer % statistics % successful_steps + n else this % m_buffer % statistics % successful_steps = & this % m_buffer % statistics % successful_steps + 1 end if end subroutine ! ------------------------------------------------------------------------------ subroutine oi_log_jacobian_eval ( this , n ) !! Logs a Jacobian matrix evaluation. class ( ode_integrator ), intent ( inout ) :: this !! The [[ode_integrator]] object. integer , intent ( in ), optional :: n !! An optional input useful for logging more than one Jacobian matrix !! evaluation.  If not supplied, this routine will log a single !! Jacobian evaluation. if ( present ( n )) then this % m_buffer % statistics % jacobian_evaluations = & this % m_buffer % statistics % jacobian_evaluations + n else this % m_buffer % statistics % jacobian_evaluations = & this % m_buffer % statistics % jacobian_evaluations + 1 end if end subroutine ! ------------------------------------------------------------------------------ subroutine oi_log_function_eval ( this , n ) !! Logs a function evaluation, or evaluations. class ( ode_integrator ), intent ( inout ) :: this !! The [[ode_integrator]] object. integer , intent ( in ), optional :: n !! An optional input useful for logging more than one function !! evaluation.  If not supplied, this routine will log a single !! function evaluation. if ( present ( n )) then this % m_buffer % statistics % function_evaluations = & this % m_buffer % statistics % function_evaluations + n else this % m_buffer % statistics % function_evaluations = & this % m_buffer % statistics % function_evaluations + 1 end if end subroutine ! ------------------------------------------------------------------------------ subroutine oi_log_matrix_factorization ( this , n ) !! Logs a matrix factorization. class ( ode_integrator ), intent ( inout ) :: this !! The [[ode_integrator]] object. integer , intent ( in ), optional :: n !! An optional input useful for logging more than one matrix !! factorization.  If not supplied, this routine will log a single !! factorization. if ( present ( n )) then this % m_buffer % statistics % matrix_factorizations = & this % m_buffer % statistics % matrix_factorizations + n else this % m_buffer % statistics % matrix_factorizations = & this % m_buffer % statistics % matrix_factorizations + 1 end if end subroutine ! ------------------------------------------------------------------------------ subroutine oi_set_dense_enabled ( this , enabled ) !! Enables or disables explicit dense-output preparation. !! When enabled, the integrator prepares dense output for each accepted !! step independently of whether the requested output grid requires it. !! Disabling this setting does not prevent dense output needed to produce !! requested solution values. Any previously prepared step is invalidated. class ( ode_integrator ), intent ( inout ) :: this !! The ODE integrator. logical , intent ( in ) :: enabled !! True to enable explicit dense-output preparation; false to disable it. this % m_denseEnabled = enabled call this % invalidate_dense_output () end subroutine ! ------------------------------------------------------------------------------ pure function oi_get_dense_enabled ( this ) result ( rst ) !! Gets the explicit dense-output preparation setting. class ( ode_integrator ), intent ( in ) :: this !! The ODE integrator. logical :: rst !! True if explicit dense-output preparation is enabled; otherwise, !! false. This setting is independent of preparation required to !! produce values on a requested output grid. rst = this % m_denseEnabled end function ! ------------------------------------------------------------------------------ pure function oi_has_dense_output ( this ) result ( rst ) !! Determines whether a prepared accepted-step interpolant is available. class ( ode_integrator ), intent ( in ) :: this !! The ODE integrator. logical :: rst !! True if dense output is currently valid; otherwise, false. rst = this % m_denseValid end function ! ------------------------------------------------------------------------------ subroutine oi_invalidate_dense ( this ) !! Marks any prepared dense-output interpolant as unavailable. class ( ode_integrator ), intent ( inout ) :: this !! The ODE integrator. this % m_denseValid = . false . end subroutine ! ------------------------------------------------------------------------------ subroutine oi_set_dense_interval ( this , x_start , x_end , n ) !! Publishes the interval covered by retained dense-output interpolation !! data for one accepted step. The endpoints are recorded in integration !! order, which may be increasing or decreasing. The interpolant is marked !! valid after the interval and state dimension have been recorded. !! An error stop occurs if either endpoint is non-finite, the endpoints !! are equal, or the state dimension is less than one. class ( ode_integrator ), intent ( inout ) :: this !! The ODE integrator. real ( real64 ), intent ( in ) :: x_start !! The first endpoint of the accepted step in integration order. real ( real64 ), intent ( in ) :: x_end !! The second endpoint of the accepted step in integration order. integer , intent ( in ) :: n !! The number of dependent variables represented by the interpolant. if (. not . ieee_is_finite ( x_start ) . or . . not . ieee_is_finite ( x_end )) & error stop DIFFEQ_INVALID_INPUT_ERROR if ( x_start == x_end . or . n < 1 ) error stop DIFFEQ_INVALID_INPUT_ERROR this % m_denseInterval = [ x_start , x_end ] this % m_denseSize = n this % m_denseValid = . true . end subroutine ! ------------------------------------------------------------------------------ subroutine oi_get_dense_interval ( this , x_start , x_end ) !! Gets the endpoints of the currently prepared dense-output interval. !! An error stop occurs if no valid interpolant is available. class ( ode_integrator ), intent ( in ) :: this !! The ODE integrator. real ( real64 ), intent ( out ) :: x_start !! Receives the first endpoint in integration order. real ( real64 ), intent ( out ) :: x_end !! Receives the second endpoint in integration order. if (. not . this % m_denseValid ) error stop DIFFEQ_INVALID_OPERATION_ERROR x_start = this % m_denseInterval ( 1 ) x_end = this % m_denseInterval ( 2 ) end subroutine ! ------------------------------------------------------------------------------ subroutine oi_evaluate_dense ( this , x , y ) !! Evaluates the interpolant for the last prepared accepted step at a !! requested independent-variable value. The query must be finite and !! within the step interval, including either endpoint. This operation !! does not advance or otherwise change solver state and does not evaluate !! the ODE function. An error stop occurs if no valid interpolant is !! available, the output array has the wrong size, or the query is !! non-finite or outside the interval. class ( ode_integrator ), intent ( in ) :: this !! The ODE integrator containing the prepared interpolant. real ( real64 ), intent ( in ) :: x !! The independent-variable value at which to evaluate the solution. real ( real64 ), intent ( out ) :: y (:) !! Receives the interpolated dependent-variable values. Its size must !! equal the number of dependent variables in the prepared step. if (. not . this % m_denseValid ) error stop DIFFEQ_INVALID_OPERATION_ERROR if ( size ( y ) /= this % m_denseSize ) error stop DIFFEQ_ARRAY_SIZE_ERROR if (. not . ieee_is_finite ( x )) error stop DIFFEQ_INVALID_INPUT_ERROR if ( x < minval ( this % m_denseInterval ) . or . x > maxval ( this % m_denseInterval )) & error stop DIFFEQ_INVALID_INPUT_ERROR call this % compute_dense_output ( x , y ) end subroutine ! ****************************************************************************** ! ODE_EVENT_SOLVER_ROUTINES ! ------------------------------------------------------------------------------ pure function oes_get_max_iter ( this ) result ( rst ) !! Gets the maximum number of iterations allowed for the root-finding solver. class ( ode_event_solver ), intent ( in ) :: this !! The [[ode_event_solver]] object. integer :: rst !! The iteration count limit. rst = this % m_maxIter end function ! -------------------- subroutine oes_set_max_iter ( this , x ) !! Sets the maximum number of iterations allowed for the root-finding solver. class ( ode_event_solver ), intent ( inout ) :: this !! The [[ode_event_solver]] object. integer , intent ( in ) :: x !! The iteration count limit. this % m_maxIter = x end subroutine ! ------------------------------------------------------------------------------ pure function oes_get_tol ( this ) result ( rst ) !! Gets the root-finding solver tolerance. class ( ode_event_solver ), intent ( in ) :: this !! The [[ode_event_solver]] object. real ( real64 ) :: rst !! The tolerance value. rst = this % m_tol end function ! -------------------- subroutine oes_set_tol ( this , x ) !! Sets the root-finding solver tolerance. class ( ode_event_solver ), intent ( inout ) :: this !! The [[ode_event_solver]] object. real ( real64 ), intent ( in ) :: x !! The tolerance value. this % m_tol = x end subroutine ! ------------------------------------------------------------------------------ function oes_find_event ( this , fcn , integrator , neqn , x1 , y1 , x2 , y2 , x , y , & args ) result ( rst ) !! Attempts to find an event via Brent's method for root finding for each !! of the M event equations (M does not have to be equal to the number !! of state equations).  If no events are found, this function simply !! returns false.  If a root, or roots, are found, the first occurring !! root is returned, and iteration statistics are updated in the !! [[ode_event_solver]]. A root at the initial bound is ignored so an !! integration restarted at an event can advance; a root at the terminal !! bound is still reported. !! !! If no event function has been defined a DIFFEQ_NULL_POINTER_ERROR is !! thrown. class ( ode_event_solver ), intent ( inout ) :: this !! The [[ode_event_solver]] object. procedure ( ode_event_function ), intent ( in ), pointer :: fcn !! The [[ode_event_function]]. class ( ode_integrator ), intent ( in ) :: integrator !! The [[ode_integrator]] being used to integrate the ODE's. integer , intent ( in ) :: neqn !! The number of event equations.  This value must be at least 1; else, !! a DIFFEQ_INVALID_INPUT_ERROR is thrown. real ( real64 ), intent ( in ) :: x1 !! The initial bound of the search region. real ( real64 ), intent ( in ), dimension (:) :: y1 !! The N-element state vector at x1. real ( real64 ), intent ( in ) :: x2 !! The terminal bound of the search region.  This value must be !! different than x2 by an amount larger than machine epsilon; else, !! a DIFFEQ_INVALID_OPERATION_ERROR is thrown. real ( real64 ), intent ( in ), dimension (:) :: y2 !! The N-element state vector at x2.  This array must be sized to match !! x1; else, a DIFFEQ_ARRAY_SIZE_ERROR is thrown. real ( real64 ), intent ( out ) :: x !! The value of the independent variable at which the root is found. !! If no root is found, this value is returned as a NaN. real ( real64 ), intent ( out ), dimension (:) :: y !! The N-element array containing the state vector at x.  If no root !! is found, this array is populated with NaN.  This array must be !! sized to match x1; else, a DIFFEQ_ARRAY_SIZE_ERROR is thrown. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information in and out !! of the routine. logical :: rst !! True if the process converged to a root; else, false. ! Local Variables integer :: i , nstates , ind integer , allocatable :: niter (:), neval (:) real ( real64 ) :: eps real ( real64 ), allocatable , dimension (:) :: xs real ( real64 ), allocatable , dimension (:,:) :: ys logical , allocatable , dimension (:) :: found_event ! Input Validation nstates = size ( y1 ) eps = epsilon ( eps ) if ( size ( y2 ) /= nstates . or . size ( y ) /= nstates ) error stop DIFFEQ_ARRAY_SIZE_ERROR if ( abs ( x2 - x1 ) <= eps ) error stop DIFFEQ_INVALID_OPERATION_ERROR if ( neqn < 1 ) error stop DIFFEQ_INVALID_INPUT_ERROR ! Initialization allocate ( & xs ( neqn ), & ys ( nstates , neqn ), & found_event ( neqn ), & niter ( neqn ), & neval ( neqn ) & ) x = ieee_value ( 0.0d0 , ieee_quiet_nan ) y = ieee_value ( 0.0d0 , ieee_quiet_nan ) rst = . false . ! Reset the iteration statistics information this % solver_statistics % event_index = 0 this % solver_statistics % function_evaluations = 0 this % solver_statistics % iteration_count = 0 ! Locate events do i = 1 , neqn found_event ( i ) = this % find_channel_event ( fcn , integrator , i , neqn , & x1 , y1 , x2 , y2 , xs ( i ), ys (:, i ), niter ( i ), neval ( i ), args = args ) end do rst = any ( found_event ) if (. not . rst ) return ! If any events were found, find the first event ind = 0 do i = 1 , neqn if (. not . found_event ( i )) cycle if ( ind == 0 ) then ind = i else if ( x1 < x2 . and . xs ( i ) < xs ( ind )) then ind = i else if ( x1 > x2 . and . xs ( i ) > xs ( ind )) then ind = i end if end do x = xs ( ind ) y = ys (:, ind ) ! Store the iteration statistics information this % solver_statistics % function_evaluations = neval ( ind ) this % solver_statistics % iteration_count = niter ( ind ) this % solver_statistics % event_index = ind end function ! ------------------------------------------------------------------------------ function oes_find_single_channel_event ( this , fcn , integrator , index , nevents , & x1 , y1 , x2 , y2 , x , y , niter , neval , args ) result ( rst ) !! Performs the root finding iteration process via Brent's method for a !! single channel.  As this routine is intended to stay private, there is !! no error checking that is performed.  However, there is a call to other !! type-bound procedures that do check their inputs courtesy of their public !! interface; therefore, it is still possible that this routine would !! trigger an 'error stop' condition.  For this reason, be sure of the !! inputs supplied to this routine. class ( ode_event_solver ), intent ( in ) :: this !! The [[ode_event_solver]] object. procedure ( ode_event_function ), intent ( in ), pointer :: fcn !! The [[ode_event_function]]. class ( ode_integrator ), intent ( in ) :: integrator !! The [[ode_integrator]] being used to integrate the ODE's. integer , intent ( in ) :: index !! The index of the channel on which to operate. integer , intent ( in ) :: nevents !! The number of event equations. real ( real64 ), intent ( in ) :: x1 !! The initial bound of the search region. real ( real64 ), intent ( in ), dimension (:) :: y1 !! The N-element state vector at x1. real ( real64 ), intent ( in ) :: x2 !! The terminal bound of the search region. real ( real64 ), intent ( in ), dimension (:) :: y2 !! The N-element state vector at x2. real ( real64 ), intent ( out ) :: x !! The value of the independent variable at which the root is found. !! If no root is found, this value is returned as a NaN. real ( real64 ), intent ( out ), dimension (:) :: y !! The N-element array containing the state vector at x.  If no root !! is found, this array is populated with NaN. integer , intent ( out ) :: niter !! The number of iterations taken. integer , intent ( out ) :: neval !! The number of event function evaluations taken. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information in and out !! of the routine. logical :: rst !! True if the process converged to a root; else, false. ! Local Variables integer :: maxiter , nstates real ( real64 ), allocatable , dimension (:) :: g1 , g2 , g , yinterp real ( real64 ) :: a , b , c , d , e , fa , fb , fc , p , q , r , s , eps , tol , tol1 , xm , & min1 , min2 , mn , endpoint_tol ! Initialization rst = . false . x = ieee_value ( 0.0d0 , ieee_quiet_nan ) y = ieee_value ( 0.0d0 , ieee_quiet_nan ) niter = 0 maxiter = this % get_max_allowed_iterations () eps = epsilon ( eps ) tol = this % get_solver_tolerance () nstates = size ( y ) allocate ( & g1 ( nevents ), & g2 ( nevents ), & g ( nevents ), & yinterp ( nstates ) & ) ! Evaluate the event functions. call fcn ( x1 , y1 , g1 , args = args ) call fcn ( x2 , y2 , g2 , args = args ) neval = 2 ! Test to see if a root exists within this range for this index if (. not . this % is_event_suspected ( g1 , g2 , index )) then ! No root is expected in this bracket, for this channel - return rst = . false . return end if ! Iteration Process a = x1 b = x2 c = x2 fa = g1 ( index ) fb = g2 ( index ) fc = fb do niter = 1 , maxiter ! Adjust the bounding interval if (( fb > 0.0d0 . and . fc > 0.0d0 ) . or . & ( fb < 0.0d0 . and . fc < 0.0d0 )) & then c = a fc = fa e = b - a d = e end if if ( abs ( fc ) < abs ( fb )) then a = b b = c c = a fa = fb fb = fc fc = fa end if ! Convergence Check tol1 = 2.0d0 * eps * abs ( b ) + 0.5d0 * tol xm = 0.5d0 * ( c - b ) if ( abs ( xm ) <= tol1 . or . fb == 0.0d0 ) then ! b is the root rst = . true . x = b call integrator % evaluate_dense ( x , y ) exit end if if ( abs ( e ) >= tol1 . and . abs ( fa ) > abs ( fb )) then ! Attempt interpolation s = fb / fa if ( a == c ) then p = 2.0d0 * xm * s q = 1.0d0 - s else q = fa / fc r = fb / fc p = s * ( 2.0d0 * xm * q * ( q - r ) - ( b - a ) * ( r - 1.0d0 )) q = ( q - 1.0d0 ) * ( r - 1.0d0 ) * ( s - 1.0d0 ) end if ! Bounds checking if ( p > 0.0d0 ) q = - q p = abs ( p ) min1 = 3.0d0 * xm * q - abs ( tol1 * q ) min2 = abs ( e * q ) if ( min1 < min2 ) then mn = min1 else mn = min2 end if if ( 2.0d0 * p < mn ) then ! Accept the interpolation e = d d = p / q else ! The interpolation failed, use bisection d = xm e = d end if else ! The bounds are decreasing too slowly, use bisection d = xm e = d end if ! Update a = b fa = fb ! Evaluate the new trial root if ( abs ( d ) > tol1 ) then b = b + d else b = b + sign ( tol1 , xm ) end if call integrator % evaluate_dense ( b , yinterp ) call fcn ( b , yinterp , g , args = args ) fb = g ( index ) neval = neval + 1 end do if ( rst ) then endpoint_tol = tol + 4.0d0 * eps * max ( abs ( x1 ), abs ( x )) if ( abs ( x - x1 ) <= endpoint_tol ) then rst = . false . x = ieee_value ( 0.0d0 , ieee_quiet_nan ) y = ieee_value ( 0.0d0 , ieee_quiet_nan ) end if end if end function ! ------------------------------------------------------------------------------ pure function oes_event_in_bracket ( this , f1 , f2 , index ) result ( rst ) !! Tests to see if a root is likely to exist in the given bracket. class ( ode_event_solver ), intent ( in ) :: this !! The [[ode_event_solver]] object. real ( real64 ), intent ( in ), dimension (:) :: f1 !! An M-element array containing the values of the M event functions at !! the initial interval point. real ( real64 ), intent ( in ), dimension (:) :: f2 !! An M-element array containing the values of the M event functions at !! the terminal interval point.  An DIFFEQ_ARRAY_SIZE_ERROR is thrown !! if this array is not the same size as f1. integer ( int32 ), intent ( in ) :: index !! The index of the event function to validate.  The index must exist !! on the interval [1, M], where M is the number of event functions.  A !! DIFFEQ_INVALID_INPUT_ERROR is thrown if index is outside this !! interval. logical :: rst !! True if an event is suspected to exist within the bracket; else, !! false. ! Input Checking if ( size ( f1 ) /= size ( f2 )) error stop DIFFEQ_ARRAY_SIZE_ERROR if ( index < 1 . or . index > size ( f1 )) error stop DIFFEQ_INVALID_INPUT_ERROR ! Process rst = f1 ( index ) * f2 ( index ) <= 0.0d0 end function ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_base.f90.html"},{"title":"diffeq_c_function_pointers.f90 – DIFFEQ","text":"Source Code module diffeq_c_function_pointers use iso_c_binding implicit none abstract interface subroutine c_ode ( n , x , y , dydx ) bind ( C ) !! ODE callback routine. use iso_c_binding , only : c_int , c_double integer ( c_int ), intent ( in ), value :: n !! The number of state variables. real ( c_double ), intent ( in ), value :: x !! The current value of the independent variable. real ( c_double ), intent ( in ) :: y ( n ) !! The current state vector. real ( c_double ), intent ( out ) :: dydx ( n ) !! The state vector derivatives. end subroutine subroutine c_ode_jacobian ( m , n , x , y , jac , ldj ) bind ( C ) !! ODE Jacobian callback routine. use iso_c_binding , only : c_int , c_double integer ( c_int ), intent ( in ), value :: m !! The number of equations. integer ( c_int ), intent ( in ), value :: n !! The state vector length. real ( c_double ), intent ( in ), value :: x !! The current value of the independent variable. real ( c_double ), intent ( in ) :: y ( n ) !! The current state vector. real ( c_double ), intent ( out ) :: jac ( ldj , n ) !! The M-by-N Jacobian matrix. integer ( c_int ), intent ( in ), value :: ldj !! The leading dimension of the Jacobian matrix. end subroutine subroutine c_ode_mass_matrix ( n , x , y , m , ldm ) bind ( C ) !! ODE mass matrix callback routine. use iso_c_binding , only : c_int , c_double integer ( c_int ), intent ( in ), value :: n !! The number of state variables. real ( c_double ), intent ( in ), value :: x !! The current value of the independent variable. real ( c_double ), intent ( in ) :: y ( n ) !! The current state vector. real ( c_double ), intent ( out ) :: m ( ldm , n ) !! The mass matrix. integer ( c_int ), intent ( in ), value :: ldm !! The leading dimension of the mass matrix. end subroutine subroutine c_dae_algebraic_constraints ( nconstraints , nstates , x , y , g ) & bind ( C ) !! Evaluates algebraic constraint residuals g(x,y). !! !! For N input state components and M constraints, !! the callback represents a mapping !!  !! g : \\mathbb{R}\\times\\mathbb{R}&#94;{N} !! \\longrightarrow \\mathbb{R}&#94;{M}. !!  !! A consistent state satisfies g(x,y)=0. Return the !! residuals themselves, not their derivatives, a Boolean result, !! or a projected state. A nonzero residual is a valid evaluation !! at an inconsistent state, rather than a callback failure. !! !! The caller supplies the input and output array sizes. The !! implementation must interpret the same state ordering as its !! model and write every output element. This interface performs !! no dimension, rank, or initial-consistency checks. Residual !! ordering and physical units are defined by the model; any !! subsequent consistency tolerance must respect that scaling. use iso_c_binding , only : c_int , c_double integer ( c_int ), intent ( in ), value :: nconstraints !! The number of constraint equations. integer ( c_int ), intent ( in ), value :: nstates !! The number of state variables. real ( c_double ), intent ( in ), value :: x !! The current value of the independent variable. real ( c_double ), intent ( in ) :: y ( nstates ) !! The current state vector. real ( c_double ), intent ( out ) :: g ( nconstraints ) !! The constraint vector. end subroutine subroutine c_dae_constraint_curvature ( nconstraints , ncoord , x , q , & direction , v , curvature ) bind ( C ) !! Evaluates DG(q)[\\mathrm{direction}]v, without including !! G\\dot v. Each component is !! \\mathrm{direction}&#94;T\\nabla&#94;2 g_i(q)v. !! Assign every output element. For linear constraints return !! zeros. The callback must support off-manifold coordinates and !! arbitrary directions used during nonlinear/Jacobian evaluation. use iso_c_binding , only : c_int , c_double integer ( c_int ), intent ( in ), value :: nconstraints !! The number of constraint equations. integer ( c_int ), intent ( in ), value :: ncoord !! The number of coordinate variables. real ( c_double ), intent ( in ), value :: x !! The current value of the independent variable. real ( c_double ), intent ( in ) :: q ( ncoord ) !! The current coordinate vector. real ( c_double ), intent ( in ) :: direction ( ncoord ) !! The coordinate derivative \\dot q, including the !! kinematic multiplier correction. real ( c_double ), intent ( in ) :: v ( ncoord ) !! The physical velocity components. real ( c_double ), intent ( out ) :: curvature ( nconstraints ) !! The curvature terms in the order of teh constraint callback. end subroutine subroutine c_ode_event_function ( neqn , nstates , x , y , f ) bind ( C ) !! Evaluates event functions for ODE event detection.  The solver !! seeks to locate roots for each equation. use iso_c_binding , only : c_int , c_double integer ( c_int ), intent ( in ), value :: neqn !! The number of event equations. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations. real ( c_double ), intent ( in ), value :: x !! The current value of the independent variable. real ( c_double ), intent ( in ) :: y ( nstates ) !! The current state vector. real ( c_double ), intent ( out ) :: f ( neqn ) !! The event function values. end subroutine end interface end module","tags":"","url":"sourcefile\\diffeq_c_function_pointers.f90.html"},{"title":"diffeq_bdf.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_bdf !! Implicit BDF solvers. !! !! Backward differentiation formulae replace the derivative in !!  !! M(x,y) y' = f(x,y) !!  !! with the derivative, evaluated at x_{n+1}, of the polynomial that !! interpolates the new solution point together with the k points !! preceding it.  The resulting formula !!  !! M(x_{n+1},y_{n+1}) \\sum_{j=0}&#94;{k} c_j y_{n+1-j} = f(x_{n+1},y_{n+1}) !!  !! is implicit in y_{n+1} and is solved by Newton iteration.  Because !! the coefficients are derived from the actual spacing of the stored !! points, a change of step size is handled exactly rather than by !! interpolating the history onto a uniform grid. use iso_fortran_env use diffeq_base use diffeq_errors use diffeq_multistep implicit none private public :: bdf integer , parameter :: bdf_order_limit = 5 ! BDF formulae are only zero-stable through order six, and the sixth ! order formula has so small a region of stability as to be of little ! practical use.  The order is therefore capped at five. type , extends ( newton_multistep_integrator ) :: bdf !! A variable step-size, variable order (1-5) BDF integrator for stiff !! systems and index-1 differential-algebraic equations. !! !! The iteration matrix formed for the Newton corrector is !!  !! A = \\frac{\\alpha_0}{h_n} M - J, \\qquad !! J = \\frac{\\partial f}{\\partial y}, !!  !! which is assembled and factored rather than requiring M to be !! inverted.  A singular mass matrix is therefore permitted: rows of !! M that are identically zero impose algebraic constraints, and !! the problem becomes a differential-algebraic equation.  So long as !! that system is of index one, A remains nonsingular and the !! solver proceeds normally. !! !! The method restarts at first order, so it does not require a !! consistent initial derivative.  Initial conditions that satisfy the !! algebraic constraints are still recommended, as the first step must !! otherwise absorb the inconsistency. real ( real64 ), private :: m_c0 = 0.0d0 ! The leading BDF coefficient, alpha_0 / h, for the current step. real ( real64 ), private , allocatable , dimension (:) :: m_histTerm ! The contribution of the stored solution history to the formula. real ( real64 ), private , allocatable , dimension (:,:) :: m_jac ! The Jacobian matrix. real ( real64 ), private , allocatable , dimension (:,:) :: m_mass ! The mass matrix. real ( real64 ), private , allocatable , dimension (:) :: m_rhs ! The value of f(x,y). real ( real64 ), private , allocatable , dimension (:) :: m_ydot ! The BDF approximation of the derivative at x + h. logical , private :: m_massComputed = . false . ! True if the mass matrix has been computed for this step. contains procedure , public :: predictor => bdf_predictor !! Evaluates the predictor and forms the coefficients of the step. procedure , public :: build_linear_system => bdf_build_linear_system !! Builds the linearized system for the implicit corrector. procedure , public :: prepare_for_solve => bdf_prepare_for_solve procedure , public :: get_maximum_supported_order => bdf_max_order !! Gets the highest order the method is permitted to use. procedure , public :: get_error_constant => bdf_error_constant !! Gets the error constant for the requested order. procedure , public :: get_truncation_constant => bdf_error_constant !! Gets the truncation error constant for the requested order. procedure , private :: initialize_workspace => bdf_init_workspace !! Allocates the internal workspace arrays. end type contains ! ------------------------------------------------------------------------------ pure function bdf_max_order ( this ) result ( rst ) !! Gets the highest order this integrator is permitted to use. class ( bdf ), intent ( in ) :: this !! The bdf object. integer :: rst !! The order limit. rst = bdf_order_limit end function ! ------------------------------------------------------------------------------ pure function bdf_error_constant ( this , k ) result ( rst ) !! Gets the constant relating the difference between the corrected and !! predicted solutions to the local truncation error of the formula. !! !! The predictor of order k and the corrector of order k differ by !! a quantity proportional to the leading error term of the formula, and !! for a BDF method that constant of proportionality is 1/(k+1). !! !! For a BDF method the predictor is precisely the extrapolation of the !! solution history, so that same constant also relates the (k+1)-th !! difference of the solution to the truncation error.  One routine !! therefore serves as both the error and the truncation constant. class ( bdf ), intent ( in ) :: this !! The bdf object. integer , intent ( in ) :: k !! The order of interest. real ( real64 ) :: rst !! The error constant. rst = 1.0d0 / ( k + 1.0d0 ) end function ! ------------------------------------------------------------------------------ subroutine bdf_init_workspace ( this , n ) !! Allocates the internal workspace arrays. class ( bdf ), intent ( inout ) :: this !! The bdf object. integer , intent ( in ) :: n !! The number of equations being integrated. ! Process if ( allocated ( this % m_jac )) then if ( size ( this % m_jac , 1 ) == n ) return deallocate ( this % m_jac ) deallocate ( this % m_mass ) deallocate ( this % m_rhs ) deallocate ( this % m_ydot ) deallocate ( this % m_histTerm ) end if allocate ( & this % m_jac ( n , n ), & this % m_mass ( n , n ), & this % m_rhs ( n ), & this % m_ydot ( n ), & this % m_histTerm ( n ) & ) this % m_massComputed = . false . end subroutine ! ------------------------------------------------------------------------------ subroutine bdf_prepare_for_solve ( this ) class ( bdf ), intent ( inout ) :: this this % m_massComputed = . false . end subroutine ! ------------------------------------------------------------------------------ subroutine bdf_predictor ( this , sys , h , x , y , f , yn , fn , args ) !! Evaluates the predictor and forms the coefficients for the step. !! !! The prediction is the extrapolation to x + h of the polynomial !! passing through the stored solution history.  This routine also builds !! the BDF coefficients for the step and collapses the history into the !! single vector the corrector requires, both of which are fixed for the !! duration of the step and so are computed only once here rather than on !! every Newton iteration. class ( bdf ), intent ( inout ) :: this !! The bdf object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! The current value(s) of the dependent variable(s). real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next solution !! estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information in and out !! of the differential equation subroutine. ! Local Variables integer :: i , k , n , nc , np real ( real64 ), allocatable , dimension (:) :: xv , c , nodes real ( real64 ), allocatable , dimension (:,:) :: yv , dd ! Initialization n = size ( y ) nc = this % get_stored_step_count () k = max ( 1 , min ( this % get_order (), nc )) call this % initialize_workspace ( n ) ! Gather the solution history, most recent point first np = min ( k + 1 , nc ) allocate ( xv ( np ), yv ( n , np ), dd ( n , np )) do i = 1 , np xv ( i ) = this % get_stored_variable ( i ) yv (:, i ) = this % get_stored_solution ( i ) end do ! Extrapolate the history to the end of the step.  On the very first step ! only the initial condition is available, so the prediction reduces to ! the current solution. if ( np == 1 ) then yn = yv (:, 1 ) else call newton_divided_differences ( xv , yv , dd ) call evaluate_newton_polynomial ( xv , dd , x + h , yn ) end if call sys % compute_rhs ( x + h , yn , fn , args ) call this % log_function_evaluation () ! Form the coefficients of the formula from the actual node locations allocate ( nodes ( k + 1 ), c ( k + 1 )) nodes ( 1 ) = x + h nodes ( 2 : k + 1 ) = xv ( 1 : k ) call bdf_coefficients ( nodes , c ) ! Collapse the history into the term the corrector residual requires this % m_c0 = c ( 1 ) this % m_histTerm = 0.0d0 do i = 1 , k this % m_histTerm = this % m_histTerm + c ( i + 1 ) * yv (:, i ) end do end subroutine ! ------------------------------------------------------------------------------ pure subroutine bdf_coefficients ( t , c ) !! Computes the coefficients of the BDF formula for the supplied nodes. !! !! The coefficients are the derivatives, evaluated at the newest node, of !! the Lagrange basis polynomials belonging to the supplied nodes, so that !!  P'(t_1) = \\sum_j c_j y_j .  Deriving them from the node locations !! in this way accommodates an arbitrary distribution of step sizes. real ( real64 ), intent ( in ), dimension (:) :: t !! The interpolation nodes, the first of which is the new point. real ( real64 ), intent ( out ), dimension (:) :: c !! An array where the coefficients will be written. ! Local Variables integer :: j , m , np real ( real64 ) :: p ! Process np = size ( t ) c ( 1 ) = 0.0d0 do m = 2 , np c ( 1 ) = c ( 1 ) + 1.0d0 / ( t ( 1 ) - t ( m )) end do do j = 2 , np p = 1.0d0 do m = 2 , np if ( m == j ) cycle p = p * ( t ( 1 ) - t ( m )) / ( t ( j ) - t ( m )) end do c ( j ) = p / ( t ( j ) - t ( 1 )) end do end subroutine ! ------------------------------------------------------------------------------ subroutine bdf_build_linear_system ( this , sys , h , x , y , A , b , args ) !! Builds the linearized system used to compute the solution for the !! implicit step via Newton iteration. !! !! The corrector residual is !!  !! R = M \\left( c_0 y + s \\right) - f(x,y), !!  !! where s collects the contribution of the stored history, and its !! Jacobian is  c_0 M - J .  The mass matrix appears only as a factor !! and is never inverted, which is what allows a singular M to be used. class ( bdf ), intent ( inout ) :: this !! The bdf object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size.  The step size is already carried by the !! coefficients formed by the predictor, so it is not used here. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! The current value(s) of the dependent variable(s). real ( real64 ), intent ( out ), dimension (:,:) :: A !! The N-by-N matrix A, where A = \\frac{\\alpha_o}{h_n} M - J. real ( real64 ), intent ( out ), dimension (:) :: b !! The N-element right-hand-side vector for the linear system. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information in and out !! of the differential equation subroutine. ! Local Variables integer :: i , n ! Initialization n = size ( y ) call this % initialize_workspace ( n ) ! Input Checking if ( size ( A , 1 ) /= n . or . size ( A , 2 ) /= n ) error stop DIFFEQ_MATRIX_SIZE_ERROR if ( size ( b ) /= n ) error stop DIFFEQ_ARRAY_SIZE_ERROR ! Evaluate the model call sys % compute_jacobian ( x , y , this % m_jac , args ) call sys % compute_rhs ( x , y , this % m_rhs , args ) this % m_ydot = this % m_c0 * y + this % m_histTerm call this % log_jacobian_evaluation () call this % log_function_evaluation () call this % log_function_evaluation ( sys % get_jacobian_function_evaluations ()) ! Form the system.  Only the derivative of f contributes to the iteration ! matrix; the dependence of a state-dependent mass matrix upon y is ! neglected, which affects the rate of convergence but not the solution ! the iteration converges upon. if ( sys % has_mass_matrix ()) then if (. not . this % m_massComputed . or . & sys % get_is_mass_matrix_dependent ()) & then call sys % compute_mass_matrix ( x , y , this % m_mass , args ) this % m_massComputed = . true . end if A = this % m_c0 * this % m_mass - this % m_jac b = this % m_rhs - matmul ( this % m_mass , this % m_ydot ) else A = - this % m_jac do i = 1 , n A ( i , i ) = A ( i , i ) + this % m_c0 end do b = this % m_rhs - this % m_ydot end if end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_bdf.f90.html"},{"title":"diffeq_dprk45_constants.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_dprk45_constants use iso_fortran_env implicit none ! Dormand-Prince 4th/5th Order Model Coefficients real ( real64 ), parameter :: a21 = 1.0d0 / 5.0d0 real ( real64 ), parameter :: a31 = 3.0d0 / 4 0.0d0 real ( real64 ), parameter :: a32 = 9.0d0 / 4 0.0d0 real ( real64 ), parameter :: a41 = 4 4.0d0 / 4 5.0d0 real ( real64 ), parameter :: a42 = - 5 6.0d0 / 1 5.0d0 real ( real64 ), parameter :: a43 = 3 2.0d0 / 9.0d0 real ( real64 ), parameter :: a51 = 1.9372d4 / 6.561d3 real ( real64 ), parameter :: a52 = - 2.536d4 / 2.187d3 real ( real64 ), parameter :: a53 = 6.4448d4 / 6.561d3 real ( real64 ), parameter :: a54 = - 2.12d2 / 7.29d2 real ( real64 ), parameter :: a61 = 9.017d3 / 3.168d3 real ( real64 ), parameter :: a62 = - 3.55d2 / 3 3.0d0 real ( real64 ), parameter :: a63 = 4.6732d4 / 5.247d3 real ( real64 ), parameter :: a64 = 4 9.0d0 / 1.76d2 real ( real64 ), parameter :: a65 = - 5.103d3 / 1.8656d4 real ( real64 ), parameter :: a71 = 3 5.0d0 / 3.84d2 real ( real64 ), parameter :: a72 = 0.0d0 real ( real64 ), parameter :: a73 = 5.0d2 / 1.113d3 real ( real64 ), parameter :: a74 = 1.25d2 / 1.92d2 real ( real64 ), parameter :: a75 = - 2.187d3 / 6.784d3 real ( real64 ), parameter :: a76 = 1 1.0d0 / 8 4.0d0 real ( real64 ), parameter :: e1 = - 7 1.0d0 / 5.76d4 real ( real64 ), parameter :: e2 = 0.0d0 real ( real64 ), parameter :: e3 = 7 1.0d0 / 1.6695d4 real ( real64 ), parameter :: e4 = - 7 1.0d0 / 1.92d3 real ( real64 ), parameter :: e5 = 1.7253d4 / 3.392d5 real ( real64 ), parameter :: e6 = - 2 2.0d0 / 5.25d2 real ( real64 ), parameter :: e7 = 1.0d0 / 4.0d1 real ( real64 ), parameter :: c2 = 1.0d0 / 5.0d0 real ( real64 ), parameter :: c3 = 3.0d0 / 1.0d1 real ( real64 ), parameter :: c4 = 4.0d0 / 5.0d0 real ( real64 ), parameter :: c5 = 8.0d0 / 9.0d0 real ( real64 ), parameter :: c6 = 1.0d0 real ( real64 ), parameter :: c7 = 1.0d0 ! Interpolation Parameters real ( real64 ), parameter :: d1 = - 1.2715105075d10 / 1.1282082432d10 real ( real64 ), parameter :: d3 = 8.74874797d10 / 3.2700410799d10 real ( real64 ), parameter :: d4 = - 1.0690763975d10 / 1.880347072d9 real ( real64 ), parameter :: d5 = 7.01980252875d11 / 1.99316789632d11 real ( real64 ), parameter :: d6 = - 1.453857185d9 / 8.22651844d8 real ( real64 ), parameter :: d7 = 6.9997945d7 / 2.9380423d7 end module","tags":"","url":"sourcefile\\diffeq_dprk45_constants.f90.html"},{"title":"diffeq_kennedy_carpenter.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_kennedy_carpenter use iso_fortran_env use diffeq_base use diffeq_singlestep use diffeq_errors use linalg implicit none private public :: kennedy_carpenter public :: kennedy_carpenter_4 public :: kennedy_carpenter_5 real ( real64 ), parameter :: kc_jacobian_refresh_rate = 3.0d-2 ! A Newton contraction rate above this value marks the Jacobian as ! stale, so it is re-evaluated before the next step. type , abstract , extends ( single_step_integrator ) :: kennedy_carpenter !! Shared implementation for Kennedy--Carpenter ESDIRK methods. !! !! The stage equations are solved with a simplified Newton iteration. !! A supplied mass matrix is incorporated in each stage system as !! M-h \\gamma J, while the embedded tableau supplies the error !! estimate used by the inherited adaptive driver.  These solvers use !! the inherited configurable PI step-size controller. !! !! Every implicit stage shares the diagonal coefficient \\gamma, so !! a single factorization of M-h \\gamma J serves every stage and !! Newton iteration within a step.  The factorization is retained !! until the step size changes, and the Jacobian is retained across !! steps until the Newton iteration converges slowly or fails.  A !! failed iteration first refreshes any stale Jacobian or !! factorization; if the iteration still fails, the step is rejected !! and retried with a smaller step size. !! !! The Newton iteration is governed by a user-defined iteration limit !! and convergence tolerance.  The applied tolerance never exceeds one !! percent of the smallest positive integration tolerance. real ( real64 ), private , allocatable , dimension (:,:) :: m_mass real ( real64 ), private , allocatable , dimension (:) :: m_startDerivative logical , private :: m_massComputed = . false . integer , private :: m_newtonIterLimit = 12 ! The limit on the number of Newton iterations per stage. real ( real64 ), private :: m_newtonTolerance = 1.0d-8 ! The convergence tolerance for the Newton iteration. real ( real64 ), private , allocatable , dimension (:,:) :: m_jac ! The Jacobian, less any mass-matrix state derivative, used in ! the iteration matrix. real ( real64 ), private , allocatable , dimension (:,:) :: m_qr ! The QR factored iteration matrix. real ( real64 ), private , allocatable , dimension (:) :: m_tau ! The QR factorization scalar factors. integer , private , allocatable , dimension (:) :: m_pivot ! The QR factorization column pivots. real ( real64 ), private :: m_factorStep = 0.0d0 ! The value of h * gamma used to form the factored matrix. logical , private :: m_haveFactor = . false . ! True if a usable factorization is stored. logical , private :: m_jacCurrent = . false . ! True if the Jacobian was evaluated at the current step start. logical , private :: m_refreshJac = . true . ! True if the Jacobian must be re-evaluated before the next step. contains procedure , public :: solve => kc_solve procedure , public :: get_newton_step_limit => kc_get_newton_step_limit !! Gets the maximum number of Newton iterations allowed per stage. procedure , public :: set_newton_step_limit => kc_set_newton_step_limit !! Sets the maximum number of Newton iterations allowed per stage. procedure , public :: get_newton_tolerance => kc_get_newton_tolerance !! Gets the Newton iteration convergence tolerance. procedure , public :: set_newton_tolerance => kc_set_newton_tolerance !! Sets the Newton iteration convergence tolerance. procedure , public :: pre_step_action => kc_pre_step !! Performs any pre-step actions. procedure , public :: attempt_step => kc_attempt_step !! Attempts an integration step for this integrator. procedure , public :: post_step_action => kc_post_step !! Performs any post-step actions. procedure , public :: interpolate => kc_interpolate !! Performs the interpolation. procedure , public :: get_is_fsal => kc_get_is_fsal !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. procedure , public :: get_stage_count => kc_get_stage_count !! Gets the stage count for this integrator. end type type , extends ( kennedy_carpenter ) :: kennedy_carpenter_4 !! Fourth-order ARK4(3)6L[2]SA ESDIRK method. !! The inherited PI step-size controller uses the embedded error !! estimate to select the next step size. contains procedure , public :: get_order => kc4_get_order !! Gets the order of the integrator. end type type , extends ( kennedy_carpenter ) :: kennedy_carpenter_5 !! Fifth-order ARK5(4)8L[2]SA ESDIRK method. !! The inherited PI step-size controller uses the embedded error !! estimate to select the next step size. contains procedure , public :: get_order => kc5_get_order !! Gets the order of the integrator. end type contains ! ------------------------------------------------------------------------------ subroutine kc_solve ( this , sys , x , iv , store_iv , args ) class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ), dimension (:) :: x !! An array of independent variable values at which to return the !! the solution to the ODE's. real ( real64 ), intent ( in ), dimension (:) :: iv !! An array containing the initial values for each ODE. logical , intent ( in ), optional :: store_iv !! An optional input that determines whether or not the !! initial values are stored as part of the output.  The !! default is true such that the initial values are stored; !! however, set to false to avoid storing the initial values. !! This can be useful in cases of event detection where a !! restart of the integrator is desired. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. this % m_massComputed = . false . this % m_haveFactor = . false . this % m_jacCurrent = . false . this % m_refreshJac = . true . this % m_factorStep = 0.0d0 if ( allocated ( this % m_mass )) deallocate ( this % m_mass ) if ( allocated ( this % m_startDerivative )) deallocate ( this % m_startDerivative ) call ssi_ode_solver ( this , sys , x , iv , store_iv = store_iv , args = args ) end subroutine ! ------------------------------------------------------------------------------ pure function kc_get_newton_step_limit ( this ) result ( rst ) !! Gets the maximum number of Newton iterations allowed per stage. class ( kennedy_carpenter ), intent ( in ) :: this !! The kennedy_carpenter object. integer :: rst !! The iteration limit. rst = this % m_newtonIterLimit end function ! -------------------- subroutine kc_set_newton_step_limit ( this , x ) !! Sets the maximum number of Newton iterations allowed per stage.  A !! value less than one causes DIFFEQ_INVALID_INPUT_ERROR. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. integer , intent ( in ) :: x !! The iteration limit. if ( x < 1 ) error stop DIFFEQ_INVALID_INPUT_ERROR this % m_newtonIterLimit = x end subroutine ! ------------------------------------------------------------------------------ pure function kc_get_newton_tolerance ( this ) result ( rst ) !! Gets the convergence tolerance on the estimated Newton iteration error, !! relative to the larger of one and the norm of the stage state.  The !! tolerance applied during integration is the lesser of this value and !! one percent of the smallest positive integration tolerance. class ( kennedy_carpenter ), intent ( in ) :: this !! The kennedy_carpenter object. real ( real64 ) :: rst !! The convergence tolerance. rst = this % m_newtonTolerance end function ! -------------------- subroutine kc_set_newton_tolerance ( this , x ) !! Sets the convergence tolerance on the estimated Newton iteration error, !! relative to the larger of one and the norm of the stage state.  The !! tolerance applied during integration is the lesser of this value and !! one percent of the smallest positive integration tolerance.  A value !! that is not positive and finite causes DIFFEQ_INVALID_INPUT_ERROR. use ieee_arithmetic , only : ieee_is_finite class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. real ( real64 ), intent ( in ) :: x !! The convergence tolerance. if (. not . ieee_is_finite ( x )) error stop DIFFEQ_INVALID_INPUT_ERROR if ( x <= 0.0d0 ) error stop DIFFEQ_INVALID_INPUT_ERROR this % m_newtonTolerance = x end subroutine ! ------------------------------------------------------------------------------ subroutine kc_pre_step ( this , prevs , sys , h , x , y , f , args ) !! Marks the stored Jacobian as belonging to an earlier step once the !! solution has advanced. !! !! The Jacobian itself is formed lazily by the step attempt, as it is only !! re-evaluated when the Newton iteration requires it. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. logical , intent ( in ) :: prevs !! Defines the status of the previous step.  The value is true !! if the previous step was successful; else, false if the !! previous step failed. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Process if ( prevs ) this % m_jacCurrent = . false . end subroutine ! ------------------------------------------------------------------------------ subroutine kc_post_step ( this , sys , dense , x , xn , y , yn , f , fn , k , args ) !! Retains the first-stage derivative for cubic Hermite interpolation. !! !! For a mass-matrix problem, the driver's f is a raw RHS rather than a !! derivative. The first stage supplies the consistent left-end slope; !! the stiffly accurate final stage already supplies the right-end slope. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. logical , intent ( in ) :: dense !! Determines if dense output is requested (true); else, false. real ( real64 ), intent ( in ) :: x !! The previous value of the independent variable. real ( real64 ), intent ( in ) :: xn !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the derivatives at x. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( inout ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. this % m_startDerivative = k (:, 1 ) end subroutine ! ------------------------------------------------------------------------------ pure function kc_get_is_fsal ( this ) result ( rst ) !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. class ( kennedy_carpenter ), intent ( in ) :: this !! The kennedy_carpenter object. logical :: rst !! True for a FSAL integrator; else, false. rst = . false . end function ! ------------------------------------------------------------------------------ pure function kc_get_stage_count ( this ) result ( rst ) !! Gets the stage count for this integrator. class ( kennedy_carpenter ), intent ( in ) :: this !! The kennedy_carpenter object. integer :: rst !! The stage count. select type ( this ) type is ( kennedy_carpenter_4 ) rst = 6 type is ( kennedy_carpenter_5 ) rst = 8 class default rst = 0 end select end function ! ------------------------------------------------------------------------------ pure function kc4_get_order ( this ) result ( rst ) !! Gets the order of the integrator. class ( kennedy_carpenter_4 ), intent ( in ) :: this !! The kennedy_carpenter_4 object. integer :: rst !! The order. rst = 4 end function ! ------------------------------------------------------------------------------ pure function kc5_get_order ( this ) result ( rst ) !! Gets the order of the integrator. class ( kennedy_carpenter_5 ), intent ( in ) :: this !! The kennedy_carpenter_5 object. integer :: rst !! The order. rst = 5 end function ! ------------------------------------------------------------------------------ subroutine kc_attempt_step ( this , sys , h , x , y , f , yn , fn , yerr , k , args ) !! Attempts an integration step for this integrator. !! !! The state at each stage is solved from !!  !! M(Y_i-Y_i&#94;*)-h a_{ii}f(x+c_i h,Y_i)=0, !!  !! using Newton iteration.  The high- and embedded-order solutions are !! y_{n+1}=y_n+h\\sum b_i k_i and !! \\widehat y_{n+1}=y_n+h\\sum d_i k_i, respectively. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next !! solution estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: yerr !! An N-element array where this routine will write an estimate !! of the error in each equation. real ( real64 ), intent ( out ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: i , j , n , stages logical :: usemass , massDependent , converged real ( real64 ) :: a ( 8 , 8 ), b ( 8 ), d ( 8 ), c ( 8 ), hg , theta , thetaMax real ( real64 ), allocatable , dimension (:) :: base , embedded ! Initialization n = size ( y ) usemass = sys % has_mass_matrix () massDependent = sys % get_is_mass_matrix_dependent () call kc_table ( this , a , b , d , c , stages ) hg = h * a ( 2 , 2 ) call kc_init_workspace ( this , n ) allocate ( base ( n ), embedded ( n )) ! Process ! The first stage of an ESDIRK method is explicit k = 0.0d0 if ( usemass ) then if ( allocated ( this % m_mass )) then if ( size ( this % m_mass , 1 ) /= n ) then deallocate ( this % m_mass ) this % m_massComputed = . false . end if end if if (. not . allocated ( this % m_mass )) allocate ( this % m_mass ( n , n )) if (. not . this % m_massComputed . or . massDependent ) then call sys % compute_mass_matrix ( x , y , this % m_mass , args ) this % m_massComputed = . true . if ( massDependent ) this % m_haveFactor = . false . end if call kc_consistent_derivative ( this , sys , x , y , f , massDependent , & k (:, 1 ), args ) else k (:, 1 ) = f end if ! Every implicit stage shares the diagonal coefficient, so one factored ! iteration matrix serves the entire step.  A Newton failure computed with ! a Jacobian from an earlier step refreshes the Jacobian and retries; a ! failure with a current Jacobian rejects the step. do if ( this % m_refreshJac . and . . not . this % m_jacCurrent ) then call kc_update_jacobian ( this , sys , x , y , k (:, 1 ), usemass , & massDependent , args ) end if if (. not . this % m_haveFactor . or . this % m_factorStep /= hg ) then call kc_factor ( this , hg , usemass ) end if thetaMax = 0.0d0 converged = . true . do i = 2 , stages ! Accumulate the contributions from the previously computed stages base = y do j = 1 , i - 1 base = base + h * a ( i , j ) * k (:, j ) end do call kc_newton_stage ( this , sys , x + c ( i ) * h , base , hg , & k (:, i - 1 ), usemass , massDependent , k (:, i ), converged , & theta , args ) thetaMax = max ( thetaMax , theta ) if (. not . converged ) exit end do if ( converged ) exit if ( this % m_jacCurrent ) then call kc_reject_step ( this , y , yn , yerr ) fn = k (:, 1 ) return end if this % m_refreshJac = . true . end do ! Slow convergence indicates the Jacobian no longer represents the ! problem well, so refresh it before the next step if ( thetaMax > kc_jacobian_refresh_rate ) this % m_refreshJac = . true . ! Form the solution estimate and the embedded solution estimate yn = y embedded = y do i = 1 , stages yn = yn + h * b ( i ) * k (:, i ) embedded = embedded + h * d ( i ) * k (:, i ) end do yerr = yn - embedded ! Both tableaus are stiffly accurate.  The final stage derivative is ! therefore the derivative at the accepted state, even when M is singular. fn = k (:, stages ) end subroutine ! ------------------------------------------------------------------------------ subroutine kc_init_workspace ( this , n ) !! Allocates the Jacobian and factorization workspace. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. integer , intent ( in ) :: n !! The number of equations. if ( allocated ( this % m_jac )) then if ( size ( this % m_jac , 1 ) == n ) return deallocate ( this % m_jac , this % m_qr , this % m_tau , this % m_pivot ) end if allocate ( this % m_jac ( n , n ), this % m_qr ( n , n ), this % m_tau ( n ), this % m_pivot ( n )) this % m_haveFactor = . false . this % m_jacCurrent = . false . this % m_refreshJac = . true . end subroutine ! ------------------------------------------------------------------------------ subroutine kc_update_jacobian ( this , sys , x , y , derivative , usemass , & massDependent , args ) !! Evaluates the Jacobian at the start of the current step. !! !! For a state-dependent mass matrix, the linearization of !! M(Y)(Y-Y&#94;*) contributes \\partial (M y')/\\partial y, which is !! approximated with the step-start derivative and subtracted from the !! stored Jacobian. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at the start of the step. real ( real64 ), intent ( in ), dimension (:) :: y !! The solution at the start of the step. real ( real64 ), intent ( in ), dimension (:) :: derivative !! The derivative at the start of the step. logical , intent ( in ) :: usemass , massDependent !! Mass-matrix configuration flags. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: i , n real ( real64 ) :: fdstep real ( real64 ), allocatable :: mass_perturbed (:,:), state (:) n = size ( y ) call sys % compute_jacobian ( x , y , this % m_jac , args ) call this % log_jacobian_evaluation () call this % log_function_evaluation ( sys % get_jacobian_function_evaluations ()) if ( usemass . and . massDependent ) then fdstep = sys % get_finite_difference_step () allocate ( mass_perturbed ( n , n ), state ( n )) do i = 1 , n state = y state ( i ) = state ( i ) + fdstep call sys % compute_mass_matrix ( x , state , mass_perturbed , args ) this % m_jac (:, i ) = this % m_jac (:, i ) - & matmul (( mass_perturbed - this % m_mass ) / fdstep , derivative ) end do end if this % m_jacCurrent = . true . this % m_refreshJac = . false . this % m_haveFactor = . false . end subroutine ! ------------------------------------------------------------------------------ subroutine kc_factor ( this , hg , usemass ) !! Forms and factors the iteration matrix M - h \\gamma J. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. real ( real64 ), intent ( in ) :: hg !! The product of the step size and the diagonal coefficient. logical , intent ( in ) :: usemass !! True if a mass matrix is used; else, false. ! Local Variables integer :: i , n real ( real64 ), allocatable :: system (:,:) n = size ( this % m_jac , 1 ) if ( usemass ) then system = this % m_mass - hg * this % m_jac else system = - hg * this % m_jac do i = 1 , n system ( i , i ) = system ( i , i ) + 1.0d0 end do end if this % m_pivot = 0 call qr_factor ( system , this % m_pivot , tau = this % m_tau , qr = this % m_qr ) call this % log_matrix_factorization () this % m_factorStep = hg this % m_haveFactor = . true . end subroutine ! ------------------------------------------------------------------------------ subroutine kc_newton_stage ( this , sys , x , base , hg , guess , usemass , & massDependent , derivative , converged , thetaMax , args ) !! Solves one stage equation !! M(Y_i-Y_i&#94;*)-h \\gamma f(x+c_i h,Y_i)=0 !! by simplified Newton iteration using the stored factorization. !! !! The iteration converges linearly at a rate \\theta, so the error !! remaining after an update \\Delta is estimated as !! \\eta\\|\\Delta\\|, with \\eta=\\theta/(1-\\theta).  The iteration !! has converged once this estimate falls below the Newton tolerance, !! relative to the larger of one and the norm of the stage state.  No !! contraction rate is available after the first iteration, so the update !! itself must then satisfy the tolerance.  The Newton tolerance is capped !! at one percent of the smallest positive integration tolerance. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at the stage. real ( real64 ), intent ( in ), dimension (:) :: base !! The explicit portion of the stage state, Y_i&#94;*. real ( real64 ), intent ( in ) :: hg !! The product of the step size and the diagonal coefficient. real ( real64 ), intent ( in ), dimension (:) :: guess !! The derivative used to predict the stage state. logical , intent ( in ) :: usemass , massDependent !! Mass-matrix configuration flags. real ( real64 ), intent ( out ), dimension (:) :: derivative !! The stage derivative, (Y_i-Y_i&#94;*)/(h \\gamma). logical , intent ( out ) :: converged !! True if the iteration converged; else, false. real ( real64 ), intent ( out ) :: thetaMax !! The largest observed contraction rate of the iteration. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: iteration real ( real64 ) :: tol , dnorm , dold , theta , eta real ( real64 ), dimension ( size ( base )) :: state , f , residual , delta real ( real64 ), allocatable :: mass (:,:) tol = kc_effective_newton_tolerance ( this , size ( base )) if ( massDependent ) allocate ( mass ( size ( base ), size ( base ))) state = base + hg * guess converged = . false . thetaMax = 0.0d0 dold = 0.0d0 eta = 1.0d0 do iteration = 1 , this % get_newton_step_limit () call sys % compute_rhs ( x , state , f , args ) call this % log_function_evaluation () if (. not . usemass ) then residual = state - base - hg * f else if ( massDependent ) then call sys % compute_mass_matrix ( x , state , mass , args ) residual = matmul ( mass , state - base ) - hg * f else residual = matmul ( this % m_mass , state - base ) - hg * f end if delta = solve_qr ( this % m_qr , this % m_tau , this % m_pivot , - residual ) state = state + delta dnorm = norm2 ( delta ) if ( iteration > 1 ) then theta = dnorm / dold thetaMax = max ( thetaMax , theta ) if ( theta >= 1.0d0 ) exit eta = theta / ( 1.0d0 - theta ) end if if ( eta * dnorm <= tol * max ( 1.0d0 , norm2 ( state ))) then converged = . true . exit end if dold = dnorm end do derivative = ( state - base ) / hg end subroutine ! ------------------------------------------------------------------------------ function kc_effective_newton_tolerance ( this , n ) result ( rst ) !! Gets the Newton tolerance actually applied, which is the lesser of the !! user-defined Newton tolerance and one percent of the smallest positive !! integration tolerance.  Iteration error larger than the integration !! tolerance would otherwise leave algebraic constraints inconsistent by !! an amount no step size reduction can remove. class ( kennedy_carpenter ), intent ( in ) :: this !! The kennedy_carpenter object. integer , intent ( in ) :: n !! The number of equations. real ( real64 ) :: rst !! The tolerance. ! Local Variables integer :: i real ( real64 ) :: atol , rtol rst = this % get_newton_tolerance () do i = 1 , n atol = this % get_absolute_tolerance ( i ) rtol = this % get_relative_tolerance ( i ) if ( atol > 0.0d0 ) rst = min ( rst , 1.0d-2 * atol ) if ( rtol > 0.0d0 ) rst = min ( rst , 1.0d-2 * rtol ) end do end function ! ------------------------------------------------------------------------------ subroutine kc_reject_step ( this , y , yn , yerr ) !! Produces an error estimate that forces the driver to reject the step !! and reduce the step size by roughly one half, following a Newton !! iteration failure. class ( kennedy_carpenter ), intent ( in ) :: this !! The kennedy_carpenter object. real ( real64 ), intent ( in ), dimension (:) :: y !! The solution at the start of the step. real ( real64 ), intent ( out ), dimension (:) :: yn !! The solution estimate, set to y. real ( real64 ), intent ( out ), dimension (:) :: yerr !! The error estimate. ! Local Variables integer :: i real ( real64 ) :: alpha , e ! The inherited controller scales the step by fs * e**(-alpha) alpha = 1.0d0 / this % get_order () - & 0.75d0 * this % get_step_size_control_parameter () if ( alpha > 0.0d0 ) then e = min ( max ( 2.0d0 , & ( 2.0d0 * this % get_step_size_factor ()) ** ( 1.0d0 / alpha )), 1.0d10 ) else e = 1.0d4 end if yn = y do i = 1 , size ( y ) yerr ( i ) = e * ( this % get_absolute_tolerance ( i ) + & this % get_relative_tolerance ( i ) * abs ( y ( i ))) end do end subroutine ! ------------------------------------------------------------------------------ subroutine kc_consistent_derivative ( this , sys , x , y , f , massDependent , & derivative , args ) !! Computes a consistent initial derivative for an index-1 DAE. class ( kennedy_carpenter ), intent ( inout ) :: this !! The kennedy_carpenter object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: x , y (:), f (:) !! The step-start point and right-hand side. logical , intent ( in ) :: massDependent !! True if the mass matrix depends upon the state. real ( real64 ), intent ( out ) :: derivative (:) !! The consistent derivative. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables real ( real64 ), allocatable :: singular_values (:), left_vectors (:,:), & jac (:,:), fplus (:), augmented (:,:), rhs (:) real ( real64 ) :: rank_tolerance , scale integer :: n , rank , nullity , i n = size ( y ) call svd ( this % m_mass , singular_values , left_vectors ) scale = max ( 1.0d0 , singular_values ( 1 )) rank_tolerance = 10 0.0d0 * epsilon ( 1.0d0 ) * scale rank = count ( singular_values > rank_tolerance ) call this % log_matrix_factorization () if ( rank == n ) then derivative = solve_kc_system ( this % m_mass , f ) return end if ! The algebraic rows require the true Jacobian at the step start.  For a ! constant mass matrix, the stored Jacobian is that matrix, so it is ! evaluated here once and shared with the stage iteration. nullity = n - rank allocate ( jac ( n , n ), fplus ( n ), augmented ( n , n ), rhs ( n )) if ( massDependent ) then call sys % compute_jacobian ( x , y , jac , args ) call this % log_jacobian_evaluation () call this % log_function_evaluation ( sys % get_jacobian_function_evaluations ()) else if (. not . this % m_jacCurrent ) then call kc_update_jacobian ( this , sys , x , y , f , . true ., . false ., args ) end if jac = this % m_jac end if call sys % compute_time_derivative ( x , y , f , fplus , args ) call this % log_function_evaluation () augmented = 0.0d0 rhs = 0.0d0 augmented ( 1 : rank ,:) = matmul ( transpose ( left_vectors (:, 1 : rank )), this % m_mass ) rhs ( 1 : rank ) = matmul ( transpose ( left_vectors (:, 1 : rank )), f ) do i = 1 , nullity augmented ( rank + i ,:) = matmul ( left_vectors (:, rank + i ), jac ) rhs ( rank + i ) = - dot_product ( left_vectors (:, rank + i ), fplus ) end do derivative = solve_kc_system ( augmented , rhs ) end subroutine subroutine kc_table ( this , a , b , d , c , stages ) !! Populates the Butcher tableau for the requested integrator. class ( kennedy_carpenter ), intent ( in ) :: this !! The kennedy_carpenter object. real ( real64 ), intent ( out ) :: a ( 8 , 8 ) !! The matrix of stage coefficients.  Only the leading !! stages-by-stages block is populated. real ( real64 ), intent ( out ) :: b ( 8 ) !! The array of weights defining the higher-order solution. real ( real64 ), intent ( out ) :: d ( 8 ) !! The array of weights defining the embedded solution. real ( real64 ), intent ( out ) :: c ( 8 ) !! The array of nodes at which each stage is evaluated. integer , intent ( out ) :: stages !! The number of stages used by the integrator. ! Initialization a = 0.0d0 b = 0.0d0 d = 0.0d0 c = 0.0d0 ! Process select type ( this ) type is ( kennedy_carpenter_4 ) ! ARK4(3)6L[2]SA stages = 6 a ( 2 , 1 ) = 1.0d0 / 4.0d0 a ( 2 , 2 ) = 1.0d0 / 4.0d0 a ( 3 , 1 ) = 861 1.0d0 / 6250 0.0d0 a ( 3 , 2 ) = - 174 3.0d0 / 3125 0.0d0 a ( 3 , 3 ) = 1.0d0 / 4.0d0 a ( 4 , 1 ) = 501202 9.0d0 / 3465250 0.0d0 a ( 4 , 2 ) = - 65444 1.0d0 / 292250 0.0d0 a ( 4 , 3 ) = 17437 5.0d0 / 38810 8.0d0 a ( 4 , 4 ) = 1.0d0 / 4.0d0 a ( 5 , 1 ) = 1526708280 9.0d0 / 15537626560 0.0d0 a ( 5 , 2 ) = - 7144340 1.0d0 / 12077440 0.0d0 a ( 5 , 3 ) = 73087887 5.0d0 / 90218476 8.0d0 a ( 5 , 4 ) = 228539 5.0d0 / 807091 2.0d0 a ( 5 , 5 ) = 1.0d0 / 4.0d0 a ( 6 , 1 ) = 8288 9.0d0 / 52489 2.0d0 a ( 6 , 3 ) = 1562 5.0d0 / 8366 4.0d0 a ( 6 , 4 ) = 6987 5.0d0 / 10267 2.0d0 a ( 6 , 5 ) = - 226 0.0d0 / 821 1.0d0 a ( 6 , 6 ) = 1.0d0 / 4.0d0 ! The method is stiffly accurate, so the weights match the last stage b ( 1 ) = a ( 6 , 1 ) b ( 3 ) = a ( 6 , 3 ) b ( 4 ) = a ( 6 , 4 ) b ( 5 ) = a ( 6 , 5 ) b ( 6 ) = a ( 6 , 6 ) d ( 1 ) = 458657059 9.0d0 / 2964590016 0.0d0 d ( 3 ) = 17881187 5.0d0 / 94506854 4.0d0 d ( 4 ) = 81422022 5.0d0 / 115978291 2.0d0 d ( 5 ) = - 370063 7.0d0 / 1159393 2.0d0 d ( 6 ) = 6172 7.0d0 / 22592 0.0d0 c ( 2 ) = 0.5d0 c ( 3 ) = 8 3.0d0 / 25 0.0d0 c ( 4 ) = 3 1.0d0 / 5 0.0d0 c ( 5 ) = 1 7.0d0 / 2 0.0d0 c ( 6 ) = 1.0d0 type is ( kennedy_carpenter_5 ) ! ARK5(4)8L[2]SA stages = 8 a ( 2 , 1 ) = 4 1.0d0 / 20 0.0d0 a ( 2 , 2 ) = 4 1.0d0 / 20 0.0d0 a ( 3 , 1 ) = 4 1.0d0 / 40 0.0d0 a ( 3 , 2 ) = - 56760340676 6.0d0 / 1193185723067 9.0d0 a ( 3 , 3 ) = 4 1.0d0 / 20 0.0d0 a ( 4 , 1 ) = 68378563643 1.0d0 / 925292030768 6.0d0 a ( 4 , 3 ) = - 11038504710 3.0d0 / 136701519337 3.0d0 a ( 4 , 4 ) = 4 1.0d0 / 20 0.0d0 a ( 5 , 1 ) = 301652022415 4.0d0 / 1008134213667 1.0d0 a ( 5 , 3 ) = 3058625980665 9.0d0 / 1241415831408 7.0d0 a ( 5 , 4 ) = - 2276050940435 6.0d0 / 1111331952181 7.0d0 a ( 5 , 5 ) = 4 1.0d0 / 20 0.0d0 a ( 6 , 1 ) = 21886647902 9.0d0 / 148997839391 1.0d0 a ( 6 , 3 ) = 63825689466 8.0d0 / 543644631884 1.0d0 a ( 6 , 4 ) = - 117971047455 5.0d0 / 532115472489 6.0d0 a ( 6 , 5 ) = - 6092811917 2.0d0 / 802346106767 1.0d0 a ( 6 , 6 ) = 4 1.0d0 / 20 0.0d0 a ( 7 , 1 ) = 102000423063 3.0d0 / 571567683565 6.0d0 a ( 7 , 3 ) = 2576282094681 7.0d0 / 2526394035340 7.0d0 a ( 7 , 4 ) = - 216137590914 5.0d0 / 975590733590 9.0d0 a ( 7 , 5 ) = - 21121730959 3.0d0 / 584685950253 4.0d0 a ( 7 , 6 ) = - 426992505957 3.0d0 / 782705904074 9.0d0 a ( 7 , 7 ) = 4 1.0d0 / 20 0.0d0 a ( 8 , 1 ) = - 87270058746 7.0d0 / 913357923061 3.0d0 a ( 8 , 4 ) = 2234821806326 1.0d0 / 955585873753 1.0d0 a ( 8 , 5 ) = - 114336951899 2.0d0 / 814181600293 1.0d0 a ( 8 , 6 ) = - 3937952678962 9.0d0 / 1901852630454 0.0d0 a ( 8 , 7 ) = 3272738232438 8.0d0 / 4290004486579 9.0d0 a ( 8 , 8 ) = 4 1.0d0 / 20 0.0d0 ! The method is stiffly accurate, so the weights match the last stage b ( 1 ) = a ( 8 , 1 ) b ( 4 ) = a ( 8 , 4 ) b ( 5 ) = a ( 8 , 5 ) b ( 6 ) = a ( 8 , 6 ) b ( 7 ) = a ( 8 , 7 ) b ( 8 ) = a ( 8 , 8 ) d ( 1 ) = - 97546191856 5.0d0 / 979605996703 3.0d0 d ( 4 ) = 7807052710429 5.0d0 / 3243259014707 9.0d0 d ( 5 ) = - 54838258083 8.0d0 / 342421980863 3.0d0 d ( 6 ) = - 3343884032128 5.0d0 / 1559475310547 9.0d0 d ( 7 ) = 362980080159 4.0d0 / 465618377360 3.0d0 d ( 8 ) = 403532287375 1.0d0 / 1857599158520 0.0d0 c ( 2 ) = 4 1.0d0 / 10 0.0d0 c ( 3 ) = 293534731067 7.0d0 / 1129285578210 1.0d0 c ( 4 ) = 142601639135 8.0d0 / 719663330209 7.0d0 c ( 5 ) = 0.92d0 c ( 6 ) = 0.24d0 c ( 7 ) = 0.6d0 c ( 8 ) = 1.0d0 end select end subroutine ! ------------------------------------------------------------------------------ function solve_kc_system ( a , b ) result ( x ) !! Solves the linear system  A x = b  by means of a QR factorization !! with column pivoting. real ( real64 ), intent ( in ), dimension (:,:) :: a !! The N-by-N system matrix. real ( real64 ), intent ( in ), dimension (:) :: b !! An N-element array containing the right-hand side. real ( real64 ), allocatable , dimension (:) :: x !! An N-element array containing the solution. ! Process x = solve_least_squares_full ( a , b ) end function ! ------------------------------------------------------------------------------ subroutine kc_interpolate ( this , x , xn , yn , fn , xn1 , yn1 , fn1 , y ) !! Performs the interpolation. !! !! A cubic Hermite polynomial is constructed from the solution and !! derivative values at each end of the step. class ( kennedy_carpenter ), intent ( in ) :: this !! The kennedy_carpenter object. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at which to compute !! the interpolation. real ( real64 ), intent ( in ) :: xn !! The previous value of the independent variable at which the !! solution is computed. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( in ) :: xn1 !! The value of the independent variable at xn + h. real ( real64 ), intent ( in ), dimension (:) :: yn1 !! An N-element array containing the solution at xn + h. real ( real64 ), intent ( in ), dimension (:) :: fn1 !! An N-element array containing the derivatives at xn + h. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where this routine will write the !! solution values interpolated at x. ! Local Variables real ( real64 ) :: h , s ! Initialization h = xn1 - xn s = ( x - xn ) / h ! Process y = ( 2.0d0 * s ** 3 - 3.0d0 * s ** 2 + 1.0d0 ) * yn + & ( - 2.0d0 * s ** 3 + 3.0d0 * s ** 2 ) * yn1 + & ( s ** 3 - s ** 2 ) * h * fn1 if ( allocated ( this % m_startDerivative )) then y = y + ( s ** 3 - 2.0d0 * s ** 2 + s ) * h * this % m_startDerivative else y = y + ( s ** 3 - 2.0d0 * s ** 2 + s ) * h * fn end if end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_kennedy_carpenter.f90.html"},{"title":"diffeq_containers.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_containers use iso_fortran_env use diffeq_errors implicit none private public :: ode_results_statistics public :: ode_results public :: size integer , parameter :: BUFFER_CAPACITY = 1000 type ode_results_statistics !! A container of performance statistics for an !! integrator. integer :: successful_steps = 0 !! The number of successful steps taken by the integrator. integer :: failed_steps = 0 !! The number of unsuccessful steps taken by the integrator. integer :: jacobian_evaluations = 0 !! The number of Jacobian matrix evaluations. integer :: function_evaluations = 0 !! The number of RHS callback evaluations, including calls used for !! finite differences, AD Jacobian columns, and time derivatives. !! Explicit Jacobian callbacks are counted separately; any RHS !! calls made internally by user-owned Jacobian code are not tracked. integer :: matrix_factorizations = 0 !! The number of matrix factorizations. end type type ode_results !! A container for ODE results. real ( real64 ), private , allocatable , dimension (:,:) :: m_buffer !! An M-by-N+1 matrix containing the values of the independent !! variable at which the solution is computed in column 1.  The !! remaining N columns contain the state variables.  Notice, M !! may be greater than the actual number of values stored as !! this is a buffer or values and is typically kept larger than !! actually needed to minimize the number of reallocations. integer , private :: m_count = 0 !! The number of solution points actually stored in the solution !! buffers. integer , private :: m_state_count = 0 !! The number of state variables. type ( ode_results_statistics ), public :: statistics !! Statistical information regarding the integration process. contains procedure , public :: state_variable_count => or_get_state_count procedure , public :: count => or_get_count procedure , public :: get_capacity => or_get_capacity procedure , public :: set_capacity => or_set_capacity generic , public :: state => or_whole_state , or_state_vector procedure , private :: or_whole_state procedure , private :: or_state_vector procedure , public :: selected_state => or_state_by_index procedure , public :: solution_point => or_solution_point_by_index procedure , public :: push => or_push_state procedure , public :: to_matrix => or_to_matrix procedure , public :: clear_all => or_clear_all procedure , public :: solution_points => or_solution_points end type interface ode_results module procedure :: or_init_empty end interface interface size module procedure :: or_size end interface contains ! ------------------------------------------------------------------------------ pure function or_size ( x , dim ) result ( rst ) !! Returns the size of the requested dimension of a [[ode_results]] object. class ( ode_results ), intent ( in ) :: x !! The [[ode_results]] object. integer , intent ( in ) :: dim !! The dimension.  A value of 1 returns the number of solution points, !! while a value of 2 returns the number of state variables.  Any other !! input is disregarded, and a value of 0 is returned. integer :: rst !! The requested size. select case ( dim ) case ( 1 ) rst = x % count () case ( 2 ) rst = x % state_variable_count () case default rst = 0 end select end function ! ****************************************************************************** ! ODE_RESULTS MEMBERS ! ------------------------------------------------------------------------------ pure function or_init_empty ( n , capacity ) result ( rst ) !! Initializes an empty [[ode_results]] container. integer , intent ( in ) :: n !! The number of state variables.  A DIFFEQ_INVALID_INPUT_ERROR is !! thrown if this value is less than 1. integer , intent ( in ), optional :: capacity !! An optional input that sets the initial buffer capacity.  If !! supplied, this value must be at least one or a !! DIFFEQ_INVALID_INPUT_ERROR is thrown. type ( ode_results ) :: rst !! The [[ode_results]] object. if ( n < 1 ) error stop DIFFEQ_INVALID_INPUT_ERROR if ( present ( capacity )) then if ( capacity < 1 ) error stop DIFFEQ_INVALID_INPUT_ERROR allocate ( rst % m_buffer ( capacity , n + 1 )) else allocate ( rst % m_buffer ( BUFFER_CAPACITY , n + 1 )) end if rst % m_count = 0 rst % m_state_count = n end function ! ------------------------------------------------------------------------------ pure function or_get_count ( this ) result ( rst ) !! Gets the number of solution points. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. integer :: rst !! The number of solution points. rst = this % m_count end function ! ------------------------------------------------------------------------------ pure function or_get_state_count ( this ) result ( rst ) !! Gets the number of state variables. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. integer :: rst !! The number of state variables. if ( allocated ( this % m_buffer )) then rst = this % m_state_count else rst = 0 end if end function ! ------------------------------------------------------------------------------ pure function or_get_capacity ( this ) result ( rst ) !! Gets the current capacity of the container. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. integer :: rst !! The current capacity. if ( allocated ( this % m_buffer )) then rst = size ( this % m_buffer , 1 ) else rst = 0 end if end function ! ------------------------------------------------------------------------------ subroutine or_set_capacity ( this , n ) !! Adjusts the capacity of the container.  If the container is not yet !! initialized a DIFFEQ_INVALID_OPERATION_ERROR is thrown. !! When shrinking below count(), only the first n solution points are kept. class ( ode_results ), intent ( inout ) :: this !! The [[ode_results]] object. integer , intent ( in ) :: n !! The new capacity.  This value must be at least one or a !! DIFFEQ_INVALID_INPUT_ERROR is thrown. ! Local Variables integer :: nrows , ncols real ( real64 ), allocatable , dimension (:,:) :: temp ! Input Checking if ( n < 1 ) error stop DIFFEQ_INVALID_INPUT_ERROR if (. not . allocated ( this % m_buffer )) error stop DIFFEQ_INVALID_OPERATION_ERROR ! Process if ( n == this % get_capacity ()) return nrows = min ( n , this % m_count ) ncols = size ( this % m_buffer , 2 ) allocate ( temp ( n , ncols )) temp ( 1 : nrows ,:) = this % m_buffer ( 1 : nrows ,:) call move_alloc ( temp , this % m_buffer ) this % m_count = nrows end subroutine ! ------------------------------------------------------------------------------ pure function or_state_by_index ( this , index ) result ( rst ) !! Gets the requested state variables by index.  If this routine is called !! on an uninitialized container a DIFFEQ_INVALID_OPERATION_ERROR is thrown. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. integer , intent ( in ) :: index !! The one-based index for the state to return.  The index value must !! lie within the range [1, count()], else a DIFFEQ_INVALID_INPUT_ERROR !! is thrown. real ( real64 ), allocatable , dimension (:) :: rst !! The state vector. if (. not . allocated ( this % m_buffer )) error stop DIFFEQ_INVALID_OPERATION_ERROR if ( index < 1 . or . index > this % count ()) error stop DIFFEQ_INVALID_INPUT_ERROR rst = this % m_buffer ( index , 2 :) end function ! ------------------------------------------------------------------------------ pure function or_solution_point_by_index ( this , index ) result ( rst ) !! Gets the requested solution point by index.  If this routine is called !! on an uninitialized container a DIFFEQ_INVALID_OPERATION_ERROR is thrown. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. integer , intent ( in ) :: index !! The one-based index for the state to return.  The index value must !! lie within the range [1, count()], else a DIFFEQ_INVALID_INPUT_ERROR !! is thrown. real ( real64 ) :: rst !! The solution point. if (. not . allocated ( this % m_buffer )) error stop DIFFEQ_INVALID_OPERATION_ERROR if ( index < 1 . or . index > this % count ()) error stop DIFFEQ_INVALID_INPUT_ERROR rst = this % m_buffer ( index , 1 ) end function ! ------------------------------------------------------------------------------ pure function or_whole_state ( this ) result ( rst ) !! Gets the entire contents of the container.  If this routine is called !! on an uninitialized container a DIFFEQ_INVALID_OPERATION_ERROR is thrown. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. real ( real64 ), allocatable , dimension (:,:) :: rst !! An M-by-N element matrix where the state variable values are !! returned.  M is equal to count(), and N is equal to !! state_variable_count(). if (. not . allocated ( this % m_buffer )) error stop DIFFEQ_INVALID_OPERATION_ERROR rst = this % m_buffer ( 1 : this % count (), 2 : this % state_variable_count () + 1 ) end function ! ------------------------------------------------------------------------------ pure function or_state_vector ( this , index ) result ( rst ) !! Gets an entire state vector.   If this routine is called on an !! uninitialized container a DIFFEQ_INVALID_OPERATION_ERROR is thrown. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. integer , intent ( in ) :: index !! The one-based index for the state vector to return.  The index value !! must lie within the range [1, state_variable_count()], else a !! DIFFEQ_INVALID_INPUT_ERROR is thrown. real ( real64 ), allocatable , dimension (:) :: rst !! An M-element array where the state vector will be returned.  M is !! equal to count(). if (. not . allocated ( this % m_buffer )) error stop DIFFEQ_INVALID_OPERATION_ERROR if ( index < 1 . or . index > this % state_variable_count ()) error stop DIFFEQ_INVALID_INPUT_ERROR rst = this % m_buffer ( 1 : this % m_count , index + 1 ) end function ! ------------------------------------------------------------------------------ subroutine or_push_state ( this , x , y ) !! Pushes a new state vector into the back of the container. class ( ode_results ), intent ( inout ) :: this !! The [[ode_results]] object. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! The current state vector.  The dimensions of this vector must match !! the value returned by state_variable_count(); else, a !! DIFFEQ_ARRAY_SIZE_ERROR will be thrown.  If the container is not !! yet initialized, the size of this vector will set the expected !! number of state variables.  The same applies after clear_all(). integer :: capacity if (. not . allocated ( this % m_buffer )) then !! This is brand new.  Initialize the collection allocate ( this % m_buffer ( BUFFER_CAPACITY , size ( y ) + 1 )) this % m_count = 0 this % m_state_count = size ( y ) else if ( this % m_state_count == 0 ) then if ( size ( this % m_buffer , 2 ) /= size ( y ) + 1 ) then capacity = this % get_capacity () deallocate ( this % m_buffer ) allocate ( this % m_buffer ( capacity , size ( y ) + 1 )) end if this % m_state_count = size ( y ) else if ( size ( y ) /= this % state_variable_count ()) error stop DIFFEQ_ARRAY_SIZE_ERROR end if if ( this % m_count == this % get_capacity ()) then call this % set_capacity ( this % get_capacity () + BUFFER_CAPACITY ) end if this % m_count = this % m_count + 1 this % m_buffer ( this % m_count , 1 ) = x this % m_buffer ( this % m_count , 2 :) = y end subroutine ! ------------------------------------------------------------------------------ pure function or_to_matrix ( this ) result ( rst ) !! Returns a copy of the contents of this container as a matrix with the !! first column containing the independent variable values at which the !! solution was computed and the remaining columns containing the state !! vectors.  If this routine is called on an uninitialized container a !! DIFFEQ_INVALID_OPERATION_ERROR is thrown. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. real ( real64 ), allocatable , dimension (:,:) :: rst !! The matrix. if (. not . allocated ( this % m_buffer )) error stop DIFFEQ_INVALID_OPERATION_ERROR rst = this % m_buffer ( 1 : this % count (), 1 : this % state_variable_count () + 1 ) end function ! ------------------------------------------------------------------------------ subroutine or_clear_all ( this ) !! Clears the contents of this container, but does not alter its capacity. !! The state variable count is reset; the next push sets the new count. class ( ode_results ), intent ( inout ) :: this !! The [[ode_results]] object. this % m_count = 0 this % m_state_count = 0 end subroutine ! ------------------------------------------------------------------------------ pure function or_solution_points ( this ) result ( rst ) !! Gets a vector containing the independent variable values at which the !! solution was computed.  If this routine is called on an uninitialized !! container a DIFFEQ_INVALID_OPERATION_ERROR is thrown. class ( ode_results ), intent ( in ) :: this !! The [[ode_results]] object. real ( real64 ), allocatable , dimension (:) :: rst !! An M-element array where the solution points will be written.  M is !! equal to count(). if (. not . allocated ( this % m_buffer )) error stop DIFFEQ_INVALID_OPERATION_ERROR rst = this % m_buffer ( 1 : this % count (), 1 ) end function ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_containers.f90.html"},{"title":"diffeq_rk853.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_rk853 use iso_fortran_env use diffeq_base use diffeq_singlestep use diffeq_errors implicit none private public :: runge_kutta_853 type , extends ( single_step_integrator ) :: runge_kutta_853 !! The Fehlberg RK8(5,3) integrator. !! !! This method computes an eighth-order solution together with fifth- !! and third-order embedded solutions.  Its error estimate is !!  e_{n+1} = y_{n+1}&#94;{[5]} - y_{n+1}&#94;{[3]} , while the accepted !! solution is the eighth-order result.  The higher order is useful !! for smooth, non-stiff problems over long integration intervals. real ( real64 ), private , allocatable , dimension (:) :: yerr2 real ( real64 ), private , allocatable , dimension (:) :: rc1 real ( real64 ), private , allocatable , dimension (:) :: rc2 real ( real64 ), private , allocatable , dimension (:) :: rc3 real ( real64 ), private , allocatable , dimension (:) :: rc4 real ( real64 ), private , allocatable , dimension (:) :: rc5 real ( real64 ), private , allocatable , dimension (:) :: rc6 real ( real64 ), private , allocatable , dimension (:) :: rc7 real ( real64 ), private , allocatable , dimension (:) :: rc8 real ( real64 ), private , allocatable , dimension (:) :: work real ( real64 ), private :: m_stepSize contains procedure , public :: pre_step_action => rk853_pre_step !! Performs any pre-step actions. ! procedure, private :: initialize => rk853_init !! Initializes private storage arrays for the integrator. procedure , private :: initialize_interp => rk853_init_interp !! Allocates storage for the interpolation process. procedure , public :: get_order => rk853_get_order !! Gets the order of the integrator. procedure , public :: get_is_fsal => rk853_get_is_fsal !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. procedure , public :: get_stage_count => rk853_get_stage_count !! Gets the stage count for this integrator. procedure , public :: attempt_step => rk853_attempt_step !! Attempts an integration step for this integrator. procedure , public :: post_step_action => rk853_set_up_interp !! Sets up the interpolation process as the post-step action. procedure , public :: interpolate => rk853_interp !! Performs the interpolation. procedure , public :: compute_error_norm => rk853_estimate_error !! Computes the norm of the scaled error estimate. end type contains ! ------------------------------------------------------------------------------ subroutine rk853_pre_step ( this , prevs , sys , h , x , y , f , args ) !! Placeholder routine for any pre-step actions. class ( runge_kutta_853 ), intent ( inout ) :: this !! The runge_kutta_853 object. logical , intent ( in ) :: prevs !! Defines the status of the previous step.  The value is true !! if the previous step was successful; else, false if the !! previous step failed. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Process return end subroutine ! ------------------------------------------------------------------------------ subroutine rk853_init_interp ( this , neqn ) !! Allocates storage for the interpolation process. class ( runge_kutta_853 ), intent ( inout ) :: this !! The runge_kutta_853 object. integer , intent ( in ) :: neqn !! The number of equations being integrated. ! Process if ( allocated ( this % rc1 )) then if ( size ( this % rc1 ) == neqn ) then ! All is good return else deallocate ( this % rc1 ) deallocate ( this % rc2 ) deallocate ( this % rc3 ) deallocate ( this % rc4 ) deallocate ( this % rc5 ) deallocate ( this % rc6 ) deallocate ( this % rc7 ) deallocate ( this % rc8 ) deallocate ( this % work ) end if end if allocate ( & this % rc1 ( neqn ), & this % rc2 ( neqn ), & this % rc3 ( neqn ), & this % rc4 ( neqn ), & this % rc5 ( neqn ), & this % rc6 ( neqn ), & this % rc7 ( neqn ), & this % rc8 ( neqn ), & this % work ( neqn ) & ) end subroutine ! ------------------------------------------------------------------------------ pure function rk853_get_order ( this ) result ( rst ) !! Gets the order of the integrator. class ( runge_kutta_853 ), intent ( in ) :: this !! The runge_kutta_853 object. integer :: rst !! The order. rst = 8 end function ! ------------------------------------------------------------------------------ pure function rk853_get_is_fsal ( this ) result ( rst ) !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. class ( runge_kutta_853 ), intent ( in ) :: this !! The runge_kutta_853 object. logical :: rst !! True for a FSAL integrator; else, false. rst = . true . end function ! ------------------------------------------------------------------------------ pure function rk853_get_stage_count ( this ) result ( rst ) !! Gets the stage count for this integrator. class ( runge_kutta_853 ), intent ( in ) :: this !! The runge_kutta_853 object. integer :: rst !! The stage count. rst = 12 end function ! ------------------------------------------------------------------------------ subroutine rk853_attempt_step ( this , sys , h , x , y , f , yn , fn , yerr , k , args ) use diffeq_rk853_constants !! Attempts an integration step for this integrator. class ( runge_kutta_853 ), intent ( inout ) :: this !! The runge_kutta_853 object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next !! solution estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: yerr !! An N-element array where this routine will write an estimate !! of the error in each equation. real ( real64 ), intent ( out ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: n ! Initialization n = size ( y ) if (. not . allocated ( this % yerr2 )) allocate ( this % yerr2 ( n )) ! Process ! k1 = f as the derivatives were computed outside of this routine k (:, 1 ) = f yn = y + h * a21 call sys % compute_rhs ( x + c2 * h , yn , k (:, 2 ), args ) yn = y + h * ( a31 * f + a32 * k (:, 2 )) call sys % compute_rhs ( x + c3 * h , yn , k (:, 3 ), args ) yn = y + h * ( a41 * f + a43 * k (:, 3 )) call sys % compute_rhs ( x + c4 * h , yn , k (:, 4 ), args ) yn = y + h * ( a51 * f + a53 * k (:, 3 ) + a54 * k (:, 4 )) call sys % compute_rhs ( x + c5 * h , yn , k (:, 5 ), args ) yn = y + h * ( a61 * f + a64 * k (:, 4 ) + a65 * k (:, 5 )) call sys % compute_rhs ( x + c6 * h , yn , k (:, 6 ), args ) yn = y + h * ( a71 * f + a74 * k (:, 4 ) + a75 * k (:, 5 ) + a76 * k (:, 6 )) call sys % compute_rhs ( x + c7 * h , yn , k (:, 7 ), args ) yn = y + h * ( a81 * f + a84 * k (:, 4 ) + a85 * k (:, 5 ) + a86 * k (:, 6 ) + & a87 * k (:, 7 )) call sys % compute_rhs ( x + c8 * h , yn , k (:, 8 ), args ) yn = y + h * ( a91 * f + a94 * k (:, 4 ) + a95 * k (:, 5 ) + a96 * k (:, 6 ) + & a97 * k (:, 7 ) + a98 * k (:, 8 )) call sys % compute_rhs ( x + c9 * h , yn , k (:, 9 ), args ) yn = y + h * ( a101 * f + a104 * k (:, 4 ) + a105 * k (:, 5 ) + & a106 * k (:, 6 ) + a107 * k (:, 7 ) + a108 * k (:, 8 ) + a109 * k (:, 9 )) call sys % compute_rhs ( x + c10 * h , yn , k (:, 10 ), args ) yn = y + h * ( a111 * f + a114 * k (:, 4 ) + a115 * k (:, 5 ) + & a116 * k (:, 6 ) + a117 * k (:, 7 ) + a118 * k (:, 8 ) + a119 * k (:, 9 ) + & a1110 * k (:, 10 )) call sys % compute_rhs ( x + c11 * h , yn , k (:, 2 ), args ) yn = y + h * ( a121 * f + a124 * k (:, 4 ) + a125 * k (:, 5 ) + & a126 * k (:, 6 ) + a127 * k (:, 7 ) + a128 * k (:, 8 ) + a129 * k (:, 9 ) + & a1210 * k (:, 10 ) + a1211 * k (:, 2 )) call sys % compute_rhs ( x + h , yn , k (:, 3 ), args ) k (:, 4 ) = b1 * f + b6 * k (:, 6 ) + b7 * k (:, 7 ) + b8 * k (:, 8 ) + & b9 * k (:, 9 ) + b10 * k (:, 10 ) + b11 * k (:, 2 ) + b12 * k (:, 3 ) yn = y + h * k (:, 4 ) call sys % compute_rhs ( x + h , yn , fn , args ) call this % log_function_evaluation ( 12 ) yerr = k (:, 4 ) - bhh1 * f - bhh2 * k (:, 9 ) - bhh3 * k (:, 3 ) this % yerr2 = er1 * f + er6 * k (:, 6 ) + er7 * k (:, 7 ) + er8 * k (:, 8 ) + & er9 * k (:, 9 ) + er10 * k (:, 10 ) + er11 * k (:, 2 ) + er12 * k (:, 3 ) this % m_stepSize = h end subroutine ! ------------------------------------------------------------------------------ subroutine rk853_set_up_interp ( this , sys , dense , x , xn , y , yn , f , fn , k , args ) use diffeq_rk853_constants !! Sets up the interpolation process. class ( runge_kutta_853 ), intent ( inout ) :: this !! The runge_kutta_853 object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. logical , intent ( in ) :: dense !! Determines if dense output is requested (true); else, false. real ( real64 ), intent ( in ) :: x !! The previous value of the independent variable. real ( real64 ), intent ( in ) :: xn !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the derivatives at x. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( inout ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: i , n real ( real64 ) :: ydiff , bspl , h ! Quick Return if (. not . dense ) return ! Initialization n = size ( y ) h = xn - x call this % initialize_interp ( n ) ! Process do i = 1 , n this % rc1 ( i ) = y ( i ) ydiff = yn ( i ) - y ( i ) this % rc2 ( i ) = ydiff bspl = h * f ( i ) - ydiff this % rc3 ( i ) = bspl this % rc4 ( i ) = ydiff - h * fn ( i ) - bspl this % rc5 ( i ) = d41 * f ( i ) + d46 * k ( i , 6 ) + d47 * k ( i , 7 ) + & d48 * k ( i , 8 ) + d49 * k ( i , 9 ) + d410 * k ( i , 10 ) + & d411 * k ( i , 2 ) + d412 * k ( i , 3 ) this % rc6 ( i ) = d51 * f ( i ) + d56 * k ( i , 6 ) + d57 * k ( i , 7 ) + & d58 * k ( i , 8 ) + d59 * k ( i , 9 ) + d510 * k ( i , 10 ) + & d511 * k ( i , 2 ) + d512 * k ( i , 3 ) this % rc7 ( i ) = d61 * f ( i ) + d66 * k ( i , 6 ) + d67 * k ( i , 7 ) + & d68 * k ( i , 8 ) + d69 * k ( i , 9 ) + d610 * k ( i , 10 ) + & d611 * k ( i , 2 ) + d612 * k ( i , 3 ) this % rc8 ( i ) = d71 * f ( i ) + d76 * k ( i , 6 ) + d77 * k ( i , 7 ) + & d78 * k ( i , 8 ) + d79 * k ( i , 9 ) + d710 * k ( i , 10 ) + & d711 * k ( i , 2 ) + d712 * k ( i , 3 ) end do this % work = y + h * ( a141 * f + a147 * k (:, 7 ) + a148 * k (:, 8 ) + & a149 * k (:, 9 ) + a1410 * k (:, 10 ) + a1411 * k (:, 2 ) + & a1412 * k (:, 3 ) + a1413 * fn ) call sys % compute_rhs ( x + c14 * h , this % work , k (:, 10 ), args ) this % work = y + h * ( a151 * f + a156 * k (:, 6 ) + a157 * k (:, 7 ) + & a158 * k (:, 8 ) + a1511 * k (:, 2 ) + a1512 * k (:, 3 ) + a1513 * fn + & a1514 * k (:, 10 )) call sys % compute_rhs ( x + c15 * h , this % work , k (:, 2 ), args ) this % work = y + h * ( a161 * f + a166 * k (:, 6 ) + a167 * k (:, 7 ) + & a168 * k (:, 8 ) + a169 * k (:, 9 ) + a1613 * fn + a1614 * k (:, 10 ) + & a1615 * k (:, 2 )) call sys % compute_rhs ( x + c16 * h , this % work , k (:, 3 ), args ) call this % log_function_evaluation ( 3 ) do i = 1 , n this % rc5 ( i ) = h * ( this % rc5 ( i ) + d413 * fn ( i ) + d414 * k ( i , 10 ) + & d415 * k ( i , 2 ) + d416 * k ( i , 3 )) this % rc6 ( i ) = h * ( this % rc6 ( i ) + d513 * fn ( i ) + d514 * k ( i , 10 ) + & d515 * k ( i , 2 ) + d516 * k ( i , 3 )) this % rc7 ( i ) = h * ( this % rc7 ( i ) + d613 * fn ( i ) + d614 * k ( i , 10 ) + & d615 * k ( i , 2 ) + d616 * k ( i , 3 )) this % rc8 ( i ) = h * ( this % rc8 ( i ) + d713 * fn ( i ) + d714 * k ( i , 10 ) + & d715 * k ( i , 2 ) + d716 * k ( i , 3 )) end do end subroutine ! ------------------------------------------------------------------------------ subroutine rk853_interp ( this , x , xn , yn , fn , xn1 , yn1 , fn1 , y ) !! Performs the interpolation. class ( runge_kutta_853 ), intent ( in ) :: this !! The runge_kutta_853 object. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at which to compute !! the interpolation. real ( real64 ), intent ( in ) :: xn !! The previous value of the independent variable at which the !! solution is computed. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( in ) :: xn1 !! The value of the independent variable at xn + h. real ( real64 ), intent ( in ), dimension (:) :: yn1 !! An N-element array containing the solution at xn + h. real ( real64 ), intent ( in ), dimension (:) :: fn1 !! An N-element array containing the derivatives at xn + h. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where this routine will write the !! solution values interpolated at x. ! Local Variables real ( real64 ) :: h , s , s1 ! Process h = xn1 - xn s = ( x - xn ) / h s1 = 1.0d0 - s y = this % rc1 + s * ( this % rc2 + s1 * ( this % rc3 + s * ( this % rc4 + s1 * & ( this % rc5 + s * ( this % rc6 + s1 * ( this % rc7 + s * this % rc8 )))))) end subroutine ! ------------------------------------------------------------------------------ pure function rk853_estimate_error ( this , y , yest , yerr ) result ( rst ) !! Computes the norm of the scaled error estimate.  A value less than one !! indicates a successful step.  A value greater than one suggests that the !! results do not meet the requested tolerances. class ( runge_kutta_853 ), intent ( in ) :: this !! The runge_kutta_853 object. real ( real64 ), intent ( in ), dimension (:) :: y !! The previously accepted solution array (N-element). real ( real64 ), intent ( in ), dimension ( size ( y )) :: yest !! An N-element array containing the next solution point estimate. real ( real64 ), intent ( in ), dimension ( size ( y )) :: yerr !! An N-element array containing the estimate of error for each !! equation. real ( real64 ) :: rst !! The norm of the scaled error. ! Local Variables integer :: i , n real ( real64 ) :: err , err2 , sf , denom , atol , rtol ! Initialization n = size ( y ) err = 0.0d0 err2 = 0.0d0 ! Process do i = 1 , n atol = this % get_absolute_tolerance ( i ) rtol = this % get_relative_tolerance ( i ) sf = atol + rtol * max ( abs ( y ( i )), abs ( yest ( i ))) err2 = err2 + ( yerr ( i ) / sf ) ** 2 err = err + ( this % yerr2 ( i ) / sf ) ** 2 end do denom = err + 1.0d-2 * err2 if ( denom <= 0.0d0 ) denom = 1.0d0 rst = err * sqrt ( 1.0d0 / ( n * denom )) * abs ( this % m_stepSize ) end function ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_rk853.f90.html"},{"title":"diffeq_bsrk32_constants.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_bsrk32_constants use iso_fortran_env implicit none real ( real64 ), parameter :: a21 = 0.5d0 real ( real64 ), parameter :: a31 = 0.0d0 real ( real64 ), parameter :: a32 = 0.75d0 real ( real64 ), parameter :: a41 = 2.0d0 / 9.0d0 real ( real64 ), parameter :: a42 = 1.0d0 / 3.0d0 real ( real64 ), parameter :: a43 = 4.0d0 / 9.0d0 real ( real64 ), parameter :: b1 = 2.0d0 / 9.0d0 real ( real64 ), parameter :: b2 = 1.0d0 / 3.0d0 real ( real64 ), parameter :: b3 = 4.0d0 / 9.0d0 real ( real64 ), parameter :: b4 = 0.0d0 real ( real64 ), parameter :: b1a = 7.0d0 / 2 4.0d0 real ( real64 ), parameter :: b2a = 1.0d0 / 4.0d0 real ( real64 ), parameter :: b3a = 1.0d0 / 3.0d0 real ( real64 ), parameter :: b4a = 1.0d0 / 8.0d0 real ( real64 ), parameter :: c1 = 0.0d0 real ( real64 ), parameter :: c2 = 0.5d0 real ( real64 ), parameter :: c3 = 0.75d0 real ( real64 ), parameter :: c4 = 1.0d0 real ( real64 ), parameter :: e1 = b1a - b1 real ( real64 ), parameter :: e2 = b2a - b2 real ( real64 ), parameter :: e3 = b3a - b3 real ( real64 ), parameter :: e4 = b4a - b4 end module","tags":"","url":"sourcefile\\diffeq_bsrk32_constants.f90.html"},{"title":"diffeq_c_helpers.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_c_helpers use iso_c_binding implicit none private public :: c_strlen public :: c_to_f_string contains ! ------------------------------------------------------------------------------ pure function c_strlen ( cstr ) result ( rst ) !! Returns the length of a C-style null-terminated string. character ( kind = c_char ), intent ( in ) :: cstr ( * ) !! The C string. integer :: rst !! The length of the string, not including the null character. rst = 0 do while ( cstr ( rst + 1 ) /= C_NULL_CHAR ) rst = rst + 1 end do end function ! ------------------------------------------------------------------------------ pure function c_to_f_string ( cstr ) result ( rst ) !! Converts a null-terminated C-style string to a Fortran string. character ( kind = c_char ), intent ( in ) :: cstr ( * ) !! The C string. character ( len = :), allocatable :: rst !! The resulting Fortran string. integer :: i , n n = c_strlen ( cstr ) allocate ( character ( len = n ) :: rst ) do i = 1 , n rst ( i : i ) = cstr ( i ) end do end function ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_c_helpers.f90.html"},{"title":"diffeq_errors.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_errors !! A collection of routines for handling errors in the DIFFEQ library. use iso_fortran_env implicit none ! ------------------------------------------------------------------------------ ! Error Flags integer , parameter :: DIFFEQ_MEMORY_ALLOCATION_ERROR = 10000 integer , parameter :: DIFFEQ_NULL_POINTER_ERROR = 10001 integer , parameter :: DIFFEQ_MATRIX_SIZE_ERROR = 10002 integer , parameter :: DIFFEQ_ARRAY_SIZE_ERROR = 10003 integer , parameter :: DIFFEQ_INVALID_INPUT_ERROR = 10004 integer , parameter :: DIFFEQ_MISSING_ARGUMENT_ERROR = 10005 integer , parameter :: DIFFEQ_STEP_SIZE_TOO_SMALL_ERROR = 10006 integer , parameter :: DIFFEQ_ITERATION_COUNT_EXCEEDED_ERROR = 10007 integer , parameter :: DIFFEQ_INVALID_OPERATION_ERROR = 10008 integer , parameter :: DIFFEQ_TOLERANCE_TOO_SMALL = 10009 integer , parameter :: DIFFEQ_CONVERGENCE_ERROR = 10010 integer , parameter :: DIFFEQ_ERROR_TEST_FAILURE = 10011 integer , parameter :: DIFFEQ_SINGULAR_MATRIX_ERROR = 10012 end module","tags":"","url":"sourcefile\\diffeq_errors.f90.html"},{"title":"diffeq_c_index_reduction.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_c_index_reduction use iso_c_binding use iso_fortran_env use diffeq_c_function_pointers use diffeq_index_reduction use diffeq_c_errors use diffeq_base implicit none private public :: c_ggl_container type , bind ( C ) :: c_ggl_container !! C-interoperable description of a holonomically constrained !! mechanical model to be solved with the stabilized index-1 !! Gear-Gupta-Leimkuhler (GGL) formulation of [[ggl_container]]. !! !! For N coordinates and M constraints the integrated state is !!  !! z=[q_N,v_N,\\lambda_M,\\mu_M]&#94;T, !!  !! so the state count supplied to the DAE integrators must equal !! 2(N+M), and the initial conditions must use this ordering. !! The model is !!  !! \\dot q = v + G&#94;T\\mu, \\qquad M(q)\\dot v = F(x,q,v) - G&#94;T\\lambda, !!  !!  !! 0 = G\\dot q + \\alpha g, \\qquad !! 0 = DG(q)[\\dot q]v + GM&#94;{-1}(F-G&#94;T\\lambda) + \\beta Gv, !!  !! where g(q) are the position constraints and !! G=\\partial g/\\partial q. Every callback must accept perturbed, !! off-manifold states, and the constraint callbacks must not depend !! on the independent variable. type ( c_funptr ) :: force !! Required [[c_ode]] callback computing the applied force !! F(x,q,v), excluding multiplier forces. It is called with !! n = 2N and receives the 2N-element vector [q, v], but must !! write only the N-element force vector. type ( c_funptr ) :: jacobian !! Optional callback for computing the Jacobian matrix of the !! complete system, including the constraints.  If not supplied, !! the Jacobian will be estimated with finite differences. type ( c_funptr ) :: mass !! Optional [[c_ode_mass_matrix]] callback receiving the !! N-element coordinate vector q and writing the N-by-N !! symmetric positive-definite physical mass matrix. Set to !! C_NULL_FUNPTR to use the identity matrix. Set the !! mass_matrix_constant setting to false whenever this matrix !! varies with x or q. type ( c_funptr ) :: constraints !! Required [[c_dae_algebraic_constraints]] callback receiving !! the N-element coordinate vector q and writing the M position !! constraint residuals g(q). type ( c_funptr ) :: gradient !! Required [[c_ode_jacobian]] callback receiving the N-element !! coordinate vector q and writing the M-by-N constraint !! Jacobian G=\\partial g/\\partial q in column-major order. !! The rows of G must be linearly independent. type ( c_funptr ) :: curvature !! Required [[c_dae_constraint_curvature]] callback computing the !! M curvature terms DG(q)[\\dot q]v. Return zeros for linear !! constraints. type ( c_funptr ) :: events !! Optional [[c_ode_event_function]] for enabling event detection. !! To fully enable event detection, event_equation_count must be !! greater than zero as well. real ( c_double ) :: alpha = 0.0d0 !! Nonnegative, finite position-constraint decay rate, in inverse !! independent-variable units. Zero disables position damping. real ( c_double ) :: beta = 0.0d0 !! Nonnegative, finite velocity-constraint decay rate, in inverse !! independent-variable units. Zero disables velocity damping. integer ( c_int ) :: constraint_count = 0 !! The number M of independent constraints, with !! 1 \\le M \\le N. integer ( c_int ) :: event_equation_count = 0 !! The number of event equations in events. end type end module","tags":"","url":"sourcefile\\diffeq_c_index_reduction.f90.html"},{"title":"diffeq_pece.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_pece !! Explicit predictor, implicit corrector (PECE) multi-step solvers. !! !! An Adams method advances the solution by integrating an interpolating !! polynomial fitted to the derivative history, !!  !! y_{n+1} = y_n + \\int_{x_n}&#94;{x_{n+1}} P(t) \\, dt. !!  !! The predictor fits that polynomial to derivatives already known, giving !! an explicit Adams-Bashforth formula, while the corrector includes the !! derivative at the new point as well, giving an implicit Adams-Moulton !! formula of the same order.  Evaluating the two in sequence, and taking !! their difference as a measure of the local error, is the classical PECE !! cycle.  Each step therefore costs exactly two derivative evaluations and !! requires neither a Jacobian nor the solution of a linear system. use iso_fortran_env use diffeq_base use diffeq_errors use diffeq_multistep use lapack , only : DGETRF , DGETRS implicit none private public :: adams integer , parameter :: adams_order_limit = 12 ! The order is capped at twelve so that the tabulated error constants ! below span every order the method is permitted to select. type , extends ( multistep_integrator ) :: adams !! A variable step-size, variable order (1-12) Adams-Bashforth-Moulton !! integrator operating in predictor-corrector (PECE) mode. !! !! The corrector is applied once rather than iterated to convergence, !! which is what distinguishes PECE from a fully implicit method.  A !! single correction is only contractive while h L < 1, where !! L bounds the Lipschitz constant of the problem, so this !! integrator is intended for non-stiff systems.  Applied to a stiff !! problem it holds its accuracy only by driving the step size down to !! what stability permits, which can cost orders of magnitude more !! steps than an implicit method requires; such a problem belongs to !! bdf or to one of the implicit Runge-Kutta integrators. !! !! A system carrying a mass matrix is supported, but the matrix must be !! nonsingular.  The method needs y' itself, so the mass matrix is !! factored and resolved rather than merely appearing as a factor, and !! a singular matrix is reported as an error.  A differential-algebraic !! problem must therefore be given to bdf. real ( real64 ), private , allocatable , dimension (:) :: m_fpred ! The derivative evaluated at the predicted solution. real ( real64 ), private , allocatable , dimension (:,:) :: m_lu ! The LU factorization of the mass matrix. integer , private , allocatable , dimension (:) :: m_pivot ! The pivot array of the mass matrix factorization. logical , private :: m_massFactored = . false . ! True if the mass matrix factorization is current. contains procedure , public :: predictor => adams_predictor !! Evaluates the Adams-Bashforth predictor. procedure , public :: correct => adams_correct !! Applies the Adams-Moulton corrector. procedure , public :: evaluate_derivative => adams_evaluate_derivative !! Evaluates the derivative, resolving any mass matrix. procedure , public :: prepare_for_solve => adams_prepare_for_solve !! Discards the cached mass matrix factorization. procedure , public :: get_maximum_supported_order => adams_max_order !! Gets the highest order the method is permitted to use. procedure , public :: get_error_constant => adams_error_constant !! Gets the error constant for the requested order. procedure , public :: get_truncation_constant => adams_truncation_constant !! Gets the truncation error constant for the requested order. procedure , private :: initialize_workspace => adams_init_workspace !! Allocates the internal workspace arrays. end type contains ! ------------------------------------------------------------------------------ pure function adams_max_order ( this ) result ( rst ) !! Gets the highest order this integrator is permitted to use. class ( adams ), intent ( in ) :: this !! The adams object. integer :: rst !! The order limit. rst = adams_order_limit end function ! ------------------------------------------------------------------------------ pure function adams_error_constant ( this , k ) result ( rst ) !! Gets the constant relating the difference between the corrected and !! predicted solutions to the local truncation error of the formula. !! !! Writing the errors of the two formulae as C_p h&#94;{k+1} y&#94;{(k+1)} and !! C_c h&#94;{k+1} y&#94;{(k+1)}, their difference eliminates the derivative !! and leaves the corrector error as !! \\frac{C_c}{C_p - C_c}\\left(y&#94;c - y&#94;p\\right).  This is the Milne !! device, and the values returned here are those ratios. !! !! In terms of the Adams coefficients the ratio is !! \\left|\\gamma_k&#94;*\\right| / \\gamma_{k-1}, the denominator following !! from \\gamma_k&#94;* = \\gamma_k - \\gamma_{k-1}. class ( adams ), intent ( in ) :: this !! The adams object. integer , intent ( in ) :: k !! The order of interest. real ( real64 ) :: rst !! The error constant. real ( real64 ), parameter :: c ( adams_order_limit ) = [ & 1.0d0 / 2.0d0 , & 1.0d0 / 6.0d0 , & 1.0d0 / 1.0d1 , & 1.9d1 / 2.7d2 , & 2.7d1 / 5.02d2 , & 8.63d2 / 1.995d4 , & 1.375d3 / 3.8174d4 , & 3.3953d4 / 1.10397d6 , & 5.7281d4 / 2.140034d6 , & 3.250433d6 / 1.37461698d8 , & 1.135053d6 / 5.3684506d7 , & 1.3695779093d10 / 7.1730003345d11 & ] rst = c ( min ( max ( k , 1 ), adams_order_limit )) end function ! ------------------------------------------------------------------------------ pure function adams_truncation_constant ( this , k ) result ( rst ) !! Gets the constant relating the (k+1)-th difference of the solution !! to the local truncation error of the corrector. !! !! These are the error constants of the Adams-Moulton formulae themselves, !! written \\gamma_k&#94;*, and they differ from those returned by !! get_error_constant because the Adams predictor is not an extrapolation !! of the solution history. class ( adams ), intent ( in ) :: this !! The adams object. integer , intent ( in ) :: k !! The order of interest. real ( real64 ) :: rst !! The truncation error constant. real ( real64 ), parameter :: c ( adams_order_limit ) = [ & 1.0d0 / 2.0d0 , & 1.0d0 / 1.2d1 , & 1.0d0 / 2.4d1 , & 1.9d1 / 7.2d2 , & 3.0d0 / 1.6d2 , & 8.63d2 / 6.048d4 , & 2.75d2 / 2.4192d4 , & 3.3953d4 / 3.6288d6 , & 8.183d3 / 1.0368d6 , & 3.250433d6 / 4.790016d8 , & 4.671d3 / 7.8848d5 , & 1.3695779093d10 / 2.615348736d12 & ] rst = c ( min ( max ( k , 1 ), adams_order_limit )) end function ! ------------------------------------------------------------------------------ subroutine adams_init_workspace ( this , n ) !! Allocates the internal workspace arrays. class ( adams ), intent ( inout ) :: this !! The adams object. integer , intent ( in ) :: n !! The number of equations being integrated. ! Process if ( allocated ( this % m_fpred )) then if ( size ( this % m_fpred ) == n ) return deallocate ( this % m_fpred ) deallocate ( this % m_lu ) deallocate ( this % m_pivot ) this % m_massFactored = . false . end if allocate ( this % m_fpred ( n ), source = 0.0d0 ) allocate ( this % m_lu ( n , n ), source = 0.0d0 ) allocate ( this % m_pivot ( n ), source = 0 ) end subroutine ! ------------------------------------------------------------------------------ subroutine adams_prepare_for_solve ( this ) !! Discards the cached mass matrix factorization. class ( adams ), intent ( inout ) :: this !! The adams object. this % m_massFactored = . false . end subroutine ! ------------------------------------------------------------------------------ subroutine adams_evaluate_derivative ( this , sys , x , y , dydx , args ) !! Evaluates the derivative, resolving any mass matrix. !! !! An Adams method integrates the derivative itself, so a system written as !! M y' = f requires that the mass matrix be resolved rather than !! simply carried along.  The matrix is factored once and reused for as !! long as it remains valid, and a factorization that proves to be singular !! is reported rather than resolved in some least-squares sense, since a !! singular mass matrix places the problem beyond what this method can !! represent. class ( adams ), intent ( inout ) :: this !! The adams object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: x !! The value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( out ), dimension (:) :: dydx !! An N-element array where the derivative will be written. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information in and out !! of the differential equation subroutine. ! Local Variables integer :: i , n , flag real ( real64 ) :: dmax , dmin ! Initialization n = size ( y ) call this % initialize_workspace ( n ) ! Evaluate the right-hand side call sys % compute_rhs ( x , y , dydx , args ) call this % log_function_evaluation () if (. not . sys % has_mass_matrix ()) return ! Factor the mass matrix if (. not . this % m_massFactored . or . sys % get_is_mass_matrix_dependent ()) then call sys % compute_mass_matrix ( x , y , this % m_lu , args ) call DGETRF ( n , n , this % m_lu , n , this % m_pivot , flag ) if ( flag /= 0 ) error stop DIFFEQ_SINGULAR_MATRIX_ERROR ! A vanishing pivot relative to the largest indicates that the matrix ! is singular to within the precision available dmax = 0.0d0 dmin = huge ( 1.0d0 ) do i = 1 , n dmax = max ( dmax , abs ( this % m_lu ( i , i ))) dmin = min ( dmin , abs ( this % m_lu ( i , i ))) end do if ( dmin <= n * epsilon ( 1.0d0 ) * dmax ) then error stop DIFFEQ_SINGULAR_MATRIX_ERROR end if this % m_massFactored = . true . end if ! Resolve the mass matrix call DGETRS ( 'N' , n , 1 , this % m_lu , n , this % m_pivot , dydx , n , flag ) if ( flag /= 0 ) error stop DIFFEQ_SINGULAR_MATRIX_ERROR end subroutine ! ------------------------------------------------------------------------------ subroutine adams_predictor ( this , sys , h , x , y , f , yn , fn , args ) !! Evaluates the Adams-Bashforth predictor. !! !! The predictor integrates the polynomial fitted to the k most recent !! derivatives across the step.  The derivative is then evaluated at the !! predicted solution, which is the first evaluation of the PECE cycle and !! is retained for the corrector. class ( adams ), intent ( inout ) :: this !! The adams object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! The current value(s) of the dependent variable(s). real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next solution !! estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information in and out !! of the differential equation subroutine. ! Local Variables integer :: i , k , n real ( real64 ), allocatable , dimension (:) :: xv real ( real64 ), allocatable , dimension (:,:) :: fv , dd ! Initialization n = size ( y ) k = max ( 1 , min ( this % get_order (), this % get_stored_step_count ())) call this % initialize_workspace ( n ) ! Gather the derivative history, most recent point first allocate ( xv ( k ), fv ( n , k ), dd ( n , k )) do i = 1 , k xv ( i ) = this % get_stored_variable ( i ) fv (:, i ) = this % get_stored_derivative ( i ) end do ! Integrate the fitted polynomial across the step call newton_divided_differences ( xv , fv , dd ) call integrate_newton_polynomial ( xv , dd , x , x + h , yn ) yn = y + yn ! Evaluate the derivative at the prediction and retain it call this % evaluate_derivative ( sys , x + h , yn , fn , args ) this % m_fpred = fn end subroutine ! ------------------------------------------------------------------------------ subroutine adams_correct ( this , sys , h , x , ypred , ynew , converged , args ) !! Applies the Adams-Moulton corrector. !! !! The corrector repeats the integration with the derivative at the new !! point included among the interpolation nodes, raising the degree of the !! fitted polynomial by one over the predictor at no additional cost, as !! that derivative was already evaluated.  It is applied exactly once; a !! step for which one correction does not suffice is rejected by the error !! test and retried on a shorter step. class ( adams ), intent ( inout ) :: this !! The adams object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: ypred !! The N-element array containing the predicted values at x + h. real ( real64 ), intent ( out ), dimension (:) :: ynew !! The new estimate of the dependent variables. logical , intent ( out ) :: converged !! True if the corrector succeeded; else, false. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information in and out !! of the differential equation subroutine. ! Local Variables integer :: i , k , n real ( real64 ), allocatable , dimension (:) :: xv real ( real64 ), allocatable , dimension (:,:) :: fv , dd ! Initialization n = size ( ypred ) k = max ( 1 , min ( this % get_order (), this % get_stored_step_count ())) ! The corrector interpolates the new point together with the k - 1 most ! recent stored points allocate ( xv ( k ), fv ( n , k ), dd ( n , k )) xv ( 1 ) = x + h fv (:, 1 ) = this % m_fpred do i = 2 , k xv ( i ) = this % get_stored_variable ( i - 1 ) fv (:, i ) = this % get_stored_derivative ( i - 1 ) end do ! Integrate the fitted polynomial across the step call newton_divided_differences ( xv , fv , dd ) call integrate_newton_polynomial ( xv , dd , x , x + h , ynew ) ynew = this % get_stored_solution ( 1 ) + ynew ! A correction that has ceased to be finite indicates that the step size ! has outrun the stability of the fixed-point iteration converged = all ( abs ( ynew ) <= huge ( 1.0d0 )) end subroutine ! ------------------------------------------------------------------------------ pure subroutine integrate_newton_polynomial ( x , d , a , b , y ) !! Integrates a polynomial stored in Newton divided-difference form. real ( real64 ), intent ( in ), dimension (:) :: x !! An M-element array containing the interpolation nodes. real ( real64 ), intent ( in ), dimension (:,:) :: d !! An N-by-M matrix containing the divided-difference coefficients. real ( real64 ), intent ( in ) :: a !! The lower limit of integration. real ( real64 ), intent ( in ) :: b !! The upper limit of integration. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where the result will be written. ! Gauss-Legendre quadrature is exact through degree fifteen, whereas the ! highest supported order produces a polynomial of degree eleven, so the ! integration introduces no error of its own. real ( real64 ), parameter :: gp ( 8 ) = [ & - 9.602898564975363d-1 , - 7.966664774136267d-1 , & - 5.255324099163290d-1 , - 1.834346424956498d-1 , & 1.834346424956498d-1 , 5.255324099163290d-1 , & 7.966664774136267d-1 , 9.602898564975363d-1 ] real ( real64 ), parameter :: gw ( 8 ) = [ & 1.012285362903763d-1 , 2.223810344533745d-1 , & 3.137066458778873d-1 , 3.626837833783620d-1 , & 3.626837833783620d-1 , 3.137066458778873d-1 , & 2.223810344533745d-1 , 1.012285362903763d-1 ] ! Local Variables integer :: i real ( real64 ) :: c , hw real ( real64 ), dimension ( size ( y )) :: p ! Process c = 0.5d0 * ( a + b ) hw = 0.5d0 * ( b - a ) y = 0.0d0 do i = 1 , size ( gp ) call evaluate_newton_polynomial ( x , d , c + hw * gp ( i ), p ) y = y + gw ( i ) * p end do y = hw * y end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_pece.f90.html"}]}