se, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nevents !! The number of event equations. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ode_event_solver_settings ), intent ( in ) :: esettings !! The event solver settings. type ( c_funptr ), intent ( in ), value :: efcn !! A pointer to the function containing the event equations. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. type ( c_ode_event_statistics ), intent ( out ) :: estats !! Event detection solver results and statistics. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr procedure ( c_ode_event_function ), pointer :: event_ptr if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) if ( c_associated ( efcn )) then call c_f_procpointer ( efcn , event_ptr ) else event_ptr => null () end if rst = c_integrate_ode_events ( C_RK23 , nx , nstates , nevents , fcn_ptr , x , & initcond , settings , esettings , event_ptr , output , estats ) end function ! ------------------------------------------------------------------------------ function c_runge_kutta_45_events ( nx , nstates , nevents , fcn , x , initcond , & settings , esettings , efcn , output , estats ) result ( rst ) & bind ( C , name = \"c_runge_kutta_45_events\" ) !! Utilizes the 5th order Dormand-Prince Runge-Kutta integrator to !! solve a system of first order differential equations. integer ( c_int ), intent ( in ), value :: nx !! Th