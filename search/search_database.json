terations allowed per stage. private  subroutine kc_set_newton_step_limit(this, x) Sets the maximum number of Newton iterations allowed per stage.  A\nvalue less than one causes DIFFEQ_INVALID_INPUT_ERROR. Arguments Type Intent Optional Attributes Name class( kennedy_carpenter ), intent(inout) :: this The kennedy_carpenter object. integer, intent(in) :: x The iteration limit. procedure, public :: set_newton_tolerance => kc_set_newton_tolerance Sets the Newton iteration convergence tolerance. private  subroutine kc_set_newton_tolerance(this, x) Sets the convergence tolerance on the estimated Newton iteration error,\nrelative to the larger of one and the norm of the stage state.  The\ntolerance applied during integration is the lesser of this value and\none percent of the smallest positive integration tolerance.  A value\nthat is not positive and finite causes DIFFEQ_INVALID_INPUT_ERROR. Arguments Type Intent Optional Attributes Name class( kennedy_carpenter ), intent(inout) :: this The kennedy_carpenter object. real(kind=real64), intent(in) :: x The convergence tolerance. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols private  subroutine oi_set_rel_tol(this, x) Sets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_rel_tols(this, x) Sets the relative error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. private  subroutine oi_set_step_limit(this, x) Sets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in) :: x The step limit. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. private  subroutine oi_set_control_parameter(this, x) Sets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The control parameter procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. private  subroutine oi_set_safety_factor(this, x) Sets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The safety factor. procedure, public :: solve => kc_solve private  subroutine kc_solve(this, sys, x, iv, store_iv, args) Arguments Type Intent Optional Attributes Name class( kennedy_carpenter ), intent(inout) :: this The kennedy_carpenter object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array of independent variable values at which to return the \nthe solution to the ODE's. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An 