string.","tags":"","url":"module\\diffeq_c_helpers.html"},{"title":"diffeq_errors – DIFFEQ","text":"A collection of routines for handling errors in the DIFFEQ library. Uses iso_fortran_env Variables Type Visibility Attributes Name Initial integer, public, parameter :: DIFFEQ_ARRAY_SIZE_ERROR = 10003 integer, public, parameter :: DIFFEQ_CONVERGENCE_ERROR = 10010 integer, public, parameter :: DIFFEQ_ERROR_TEST_FAILURE = 10011 integer, public, parameter :: DIFFEQ_INVALID_INPUT_ERROR = 10004 integer, public, parameter :: DIFFEQ_INVALID_OPERATION_ERROR = 10008 integer, public, parameter :: DIFFEQ_ITERATION_COUNT_EXCEEDED_ERROR = 10007 integer, public, parameter :: DIFFEQ_MATRIX_SIZE_ERROR = 10002 integer, public, parameter :: DIFFEQ_MEMORY_ALLOCATION_ERROR = 10000 integer, public, parameter :: DIFFEQ_MISSING_ARGUMENT_ERROR = 10005 integer, public, parameter :: DIFFEQ_NULL_POINTER_ERROR = 10001 integer, public, parameter :: DIFFEQ_SINGULAR_MATRIX_ERROR = 10012 integer, public, parameter :: DIFFEQ_STEP_SIZE_TOO_SMALL_ERROR = 10006 integer, public, parameter :: DIFFEQ_TOLERANCE_TOO_SMALL = 10009","tags":"","url":"module\\diffeq_errors.html"},{"title":"diffeq_c_index_reduction – DIFFEQ","text":"Uses diffeq_base diffeq_c_function_pointers iso_fortran_env iso_c_binding diffeq_c_errors diffeq_index_reduction Derived Types type, public, bind(C) :: c_ggl_container C-interoperable description of a holonomically constrained\nmechanical model to be solved with the stabilized index-1\nGear-Gupta-Leimkuhler (GGL) formulation of ggl_container . Read more… Components Type Visibility Attributes Name Initial real(kind=c_double), public :: alpha = 0.0d0 Nonnegative, finite position-constraint decay rate, in inverse\nindependent-variable units. Zero disables position damping. real(kind=c_double), public :: beta = 0.0d0 Nonnegative, finite velocity-constraint decay rate, in inverse\nindependent-variable units. Zero disables velocity damping. integer(kind=c_int), public :: constraint_count = 0 The number M of independent constraints, with . type(c_funptr), public :: constraints Required c_dae_algebraic_constraints callback receiving\nthe N-element coordinate vector q and writing the M position\nconstraint residuals . type(c_funptr), public :: curvature Required c_dae_constraint_curvature callback computing the\nM curvature terms . Return zeros for linear\nconstraints. integer(kind=c_int), public :: event_equation_count = 0 The number of event equations in events. type(c_funptr), public :: events Optional c_ode_event_function for enabling event detection.\nTo fully enable event detection, event_equation_count must be\ngreater than zero as well. type(c_funptr), public :: force Required c_ode callback computing the applied force , excluding multiplier forces. It is called with\nn = 2N and receives the 2N-element vector [q, v], but must\nwrite only the N-element force vector. type(c_funptr), public :: gradient Required c_ode_jacobian callback receiving the N-element\ncoordinate vector q and writing the M-by-N constraint\nJacobian in column-major order.\nThe rows of must be linearly independent. type(c_funptr), public :: jacobian Optional callback for computing the Jacobian matrix of the \ncomplete system, including the constraints.  If not supplied, \nthe Jacobian will be estimated with finite differences. type(c_funptr), public :: mass Optional c_ode_mass_matrix callback receiving the\nN-element coordinate vector q and writing the N-by-N\nsymmetric positive-definite physical mass matrix. Set to\nC_NULL_FUNPTR to use the identity matrix. Set the\nmass_matrix_constant setting to false whenever this matrix\nvaries with x or q.","tags":"","url":"module\\diffeq_c_index_reduction.html"},{"title":"diffeq_pece – DIFFEQ","text":"Explicit predictor, implicit corrector (PECE) multi-step solvers. An Adams method advances the solution by integrating an interpolating\npolynomial fitted to the derivative history, The predictor fits that polynomial to derivatives already known, giving\nan explicit Adams-Bashforth formula, while the corrector includes the\nderivative at the new point as well, giving an implicit Adams-Moulton\nformula of the same order.  Evaluating the two in sequence, and taking\ntheir difference as a measure of the local error, is the classical PECE\ncycle.  Each step therefore costs exactly two derivative evaluations and\nrequires neither a Jacobian nor the solution of a linear system. Uses diffeq_base diffeq_multistep iso_fortran_env diffeq_errors lapack Derived Types type, public, extends( multistep_integrator ) :: adams A variable step-size, variable order (1-12) Adams-Bashforth-Moulton\nintegrator operating in predictor-corrector (PECE) mode. Read more… Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. procedure, public :: compute_dense_output => mi_dense_output procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. procedure, public :: correct => adams_correct Applies the Adams-Moulton corrector. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. procedure, public :: evaluate_derivative => adams_evaluate_derivative Evaluates the derivative, resolving any mass matrix. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. procedure, public :: get_error_constant => adams_error_constant Gets the error constant for the requested order. procedure, public :: get_maximum_order => mi_get_max_order Gets the upper limit on the order of the method. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. procedure, public :: get_maximum_supported_order => adams_max_order Gets the highest order the method is permitted to use. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. procedure, public :: get_order => mi_get_order Gets the order currently in use. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. procedure, public :: get_stored_derivative => mi_get_stored_f Gets a stored derivative vector. procedure, public :: get_stored_solution => mi_get_stored_y Gets a stored solution vector. procedure, public :: get_stored_step_count => mi_get_stored_count Gets the number of solution points held in the history. procedure, public :: get_stored_variable => mi_get_stored_x Gets a stored independent variable value. procedure, public :: get_truncation_constant => adams_truncation_constant Gets the truncation error constant for the requested order. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. procedure, public :: interpolate => mi_interpolate Interpolates the solution history to the requested point. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. procedure, public :: predictor => adams_predictor Evaluates the Adams-Bashforth predictor. procedure, public :: prepare_for_solve => adams_prepare_for_solve Discards the cached mass matrix factorization. procedure, public :: reset_history => mi_reset_history Clears the stored solution history. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols Sets the absolute error tolerance. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). procedure, public :: set_maximum_order => mi_set_max_order Sets the upper limit on the order of the method. procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols Sets the relative error tolerance. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. procedure, public :: solve => mi_ode_solver Solves the supplied system of ODE's.","tags":"","url":"module\\diffeq_pece.html"},{"title":"diffeq_rosenbrock_constants.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_rosenbrock_constants use iso_fortran_env implicit none real ( real64 ), parameter :: c2 = 0.386d0 ; real ( real64 ), parameter :: c3 = 0.21d0 ; real ( real64 ), parameter :: c4 = 0.63d0 ; real ( real64 ), parameter :: bet2p = 0.0317d0 ; real ( real64 ), parameter :: bet3p = 0.0635d0 ; real ( real64 ), parameter :: bet4p = 0.3438d0 ; real ( real64 ), parameter :: d1 = 0.25d0 ; real ( real64 ), parameter :: d2 = - 0.1043d0 ; real ( real64 ), parameter :: d3 = 0.1035d0 ; real ( real64 ), parameter :: d4 = - 0.3620000000000023d-1 ; real ( real64 ), parameter :: a21 = 0.1544d1 ; real ( real64 ), parameter :: a31 = 0.9466785280815826d0 ; real ( real64 ), parameter :: a32 = 0.2557011698983284d0 ; real ( real64 ), parameter :: a41 = 0.3314825187068521d1 ; real ( real64 ), parameter :: a42 = 0.2896124015972201d1 ; real ( real64 ), parameter :: a43 = 0.9986419139977817d0 ; real ( real64 ), parameter :: a51 = 0.1221224509226641d1 ; real ( real64 ), parameter :: a52 = 0.6019134481288629d1 ; real ( real64 ), parameter :: a53 = 0.1253708332932087d2 ; real ( real64 ), parameter :: a54 = - 0.6878860361058950d0 ; real ( real64 ), parameter :: c21 = - 0.5668800000000000d1 ; real ( real64 ), parameter :: c31 = - 0.2430093356833875d1 ; real ( real64 ), parameter :: c32 = - 0.2063599157091915d0 ; real ( real64 ), parameter :: c41 = - 0.1073529058151375d0 ; real ( real64 ), parameter :: c42 = - 0.9594562251023355d1 ; real ( real64 ), parameter :: c43 = - 0.2047028614809616d2 ; real ( real64 ), parameter :: c51 = 0.7496443313967647d1 ; real ( real64 ), parameter :: c52 = - 0.1024680431464352d2 ; real ( real64 ), parameter :: c53 = - 0.3399990352819905d2 ; real ( real64 ), parameter :: c54 = 0.1170890893206160d2 ; real ( real64 ), parameter :: c61 = 0.8083246795921522d1 ; real ( real64 ), parameter :: c62 = - 0.7981132988064893d1 ; real ( real64 ), parameter :: c63 = - 0.3152159432874371d2 ; real ( real64 ), parameter :: c64 = 0.1631930543123136d2 ; real ( real64 ), parameter :: c65 = - 0.6058818238834054d1 ; real ( real64 ), parameter :: gam = 0.25d0 ; real ( real64 ), parameter :: d21 = 0.1012623508344586d2 ; real ( real64 ), parameter :: d22 = - 0.7487995877610167d1 ; real ( real64 ), parameter :: d23 = - 0.3480091861555747d2 ; real ( real64 ), parameter :: d24 = - 0.7992771707568823d1 ; real ( real64 ), parameter :: d25 = 0.1025137723295662d1 ; real ( real64 ), parameter :: d31 = - 0.6762803392801253d0 ; real ( real64 ), parameter :: d32 = 0.6087714651680015d1 ; real ( real64 ), parameter :: d33 = 0.1643084320892478d2 ; real ( real64 ), parameter :: d34 = 0.2476722511418386d2 ; real ( real64 ), parameter :: d35 = - 0.6594389125716872d1 ; end module","tags":"","url":"sourcefile\\diffeq_rosenbrock_constants.f90.html"},{"title":"diffeq_rosenbrock.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_rosenbrock use iso_fortran_env use diffeq_base use diffeq_singlestep use diffeq_errors use linalg implicit none private public :: rosenbrock type , extends ( single_step_integrator ) :: rosenbrock !! A fourth-order Rosenbrock integrator for stiff systems. !! !! Instead of solving a nonlinear equation at every stage, the method !! reuses one factored linear system based on the Jacobian !!  J = \\partial f / \\partial y .  Without a mass matrix, the !! factored matrix is !!  !! A = \\frac{1}{\\gamma h}I - J, !!  !! while a user-supplied mass matrix produces !!  !! A = \\frac{1}{\\gamma h}M - J. !!  !! The method is appropriate for stiff problems where explicit !! Runge--Kutta methods would require prohibitively small steps. !! A mass matrix may be constant or state-dependent; state-dependent !! matrices are recomputed as needed.  Step sizes are selected by the !! Rosenbrock-specific controller rather than the inherited PI !! controller. real ( real64 ), private , allocatable , dimension (:,:) :: jac ! The Jacobian matrix. real ( real64 ), private , allocatable , dimension (:,:) :: mass ! The mass matrix. integer , private , allocatable , dimension (:) :: pivot ! QR factorization pivot tracking array real ( real64 ), private , allocatable , dimension (:) :: tau ! QR factorization scalar factors array logical , private :: m_massComputed = . false . ! True if the mass matrix has been computed; else, false. real ( real64 ), private , allocatable , dimension (:) :: dfdx ! N-element array of df/dx real ( real64 ), private , allocatable , dimension (:,:) :: a ! System matrix. real ( real64 ), private , allocatable , dimension (:,:) :: qr ! QR factored matrix real ( real64 ), private , allocatable , dimension (:) :: rc1 ! Interpolation coefficient array. real ( real64 ), private , allocatable , dimension (:) :: rc2 ! Interpolation coefficient array. real ( real64 ), private , allocatable , dimension (:) :: rc3 ! Interpolation coefficient array. real ( real64 ), private , allocatable , dimension (:) :: rc4 ! Interpolation coefficient array. logical , private :: m_firstStep = . true . ! True if the integrator is on its first step; else, false. logical , private :: m_rejectStep = . false . ! True if the previous step was rejected; else, false. real ( real64 ), private :: m_hOld = 0.0d0 ! The previous step size. contains procedure , public :: solve => rbrk_solve procedure , private :: initialize_matrices => rbrk_init_matrices !! Allocates internal storage for the system matrices. procedure , private :: initialize_interp => rbrk_init_interp !! Initializes private storage for the interpolation process. procedure , public :: pre_step_action => rbrk_form_matrix !! Constructs the system matrix. procedure , public :: attempt_step => rbrk_attempt_step !! Attempts an integration step for this integrator. procedure , public :: post_step_action => rbrk_set_up_interp !! Sets up the interpolation process as the post-step action. procedure , public :: interpolate => rbrk_interp !! Performs the interpolation. procedure , public :: get_order => rbrk_get_order !! Gets the order of the integrator. procedure , public :: get_is_fsal => rbrk_get_is_fsal !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. procedure , public :: get_stage_count => rbrk_get_stage_count !! Gets the stage count for this integrator. procedure , public :: estimate_next_step_size => rbrk_next_step !! Estimates the next step size. end type contains ! ------------------------------------------------------------------------------ subroutine rbrk_solve ( this , sys , x , iv , store_iv , args ) class ( rosenbrock ), intent ( inout ) :: this !! The rosenbrock object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ), dimension (:) :: x !! An array of independent variable values at which to return the !! the solution to the ODE's. real ( real64 ), intent ( in ), dimension (:) :: iv !! An array containing the initial values for each ODE. logical , intent ( in ), optional :: store_iv !! An optional input that determines whether or not the !! initial values are stored as part of the output.  The !! default is true such that the initial values are stored; !! however, set to false to avoid storing the initial values. !! This can be useful in cases of event detection where a !! restart of the integrator is desired. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. this % m_massComputed = . false . this % m_firstStep = . true . this % m_rejectStep = . false . this % m_hOld = 0.0d0 call ssi_ode_solver ( this , sys , x , iv , store_iv = store_iv , args = args ) end subroutine ! ------------------------------------------------------------------------------ subroutine rbrk_form_matrix ( this , prevs , sys , h , x , y , f , args ) use diffeq_rosenbrock_constants !! Constructs the system matrix of the form !!  A = \\frac{1}{\\gamma h} M - J , and then computes its QR !! factorization.  The QR-factored form of A is stored internally. class ( rosenbrock ), intent ( inout ) :: this !! The rosenbrock object. logical , intent ( in ) :: prevs !! Defines the status of the previous step.  The value is true if the !! previous step was successful; else, false if the previous step !! failed. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives at x. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: i , n , flag logical :: usemass , massDependent real ( real64 ) :: fac real ( real64 ), allocatable , dimension (:,:) :: lu , mass_perturbed real ( real64 ), allocatable , dimension (:) :: derivative , state ! Initialization n = size ( y ) usemass = sys % has_mass_matrix () massDependent = sys % get_is_mass_matrix_dependent () call this % initialize_matrices ( n , usemass ) ! Compute the Jacobian matrix - only need to update if the previous step ! was successful if ( prevs ) then call sys % compute_jacobian ( x , y , this % jac , args = args ) call this % log_jacobian_evaluation () call this % log_function_evaluation ( sys % get_jacobian_function_evaluations ()) ! Compute the mass matrix if ( usemass ) then if (. not . this % m_massComputed . or . & massDependent ) & then call sys % compute_mass_matrix ( x , y , this % mass , args ) this % m_massComputed = . true . end if end if end if if ( usemass . and . massDependent ) then fac = sys % get_finite_difference_step () allocate ( mass_perturbed ( n , n )) derivative = solve_least_squares_full ( this % mass , f ) if ( prevs ) then allocate ( state ( n )) do i = 1 , n state = y state ( i ) = state ( i ) + fac call sys % compute_mass_matrix ( x , state , mass_perturbed , args ) this % jac (:, i ) = this % jac (:, i ) - & matmul (( mass_perturbed - this % mass ) / fac , derivative ) end do end if end if ! Form the system matrix, and then factor it accordingly fac = 1.0d0 / ( gam * h ) if ( usemass ) then this % a = fac * this % mass - this % jac else this % a = - this % jac do i = 1 , n this % a ( i , i ) = this % a ( i , i ) + fac end do end if ! Factor the equations this % pivot = 0 call qr_factor ( this % a , this % pivot , tau = this % tau , qr = this % qr ) call this % log_matrix_factorization () ! Compute df/dx fac = sys % get_finite_difference_step () call sys % compute_time_derivative ( x , y , f , this % dfdx , args ) call this % log_function_evaluation () if ( usemass . and . massDependent ) then call sys % compute_mass_matrix ( x + fac , y , mass_perturbed , args ) this % dfdx = this % dfdx - & matmul (( mass_perturbed - this % mass ) / fac , derivative ) end if end subroutine ! ------------------------------------------------------------------------------ subroutine rbrk_init_matrices ( this , n , usemass ) !! Allocates internal storage for the system matrices. class ( rosenbrock ), intent ( inout ) :: this !! The rosenbrock object. integer , intent ( in ) :: n !! The number of equations being integrated. logical , intent ( in ) :: usemass !! True if a mass matrix is used; else, false. ! Process if ( allocated ( this % jac )) then if ( size ( this % jac , 1 ) == n . and . size ( this % jac , 2 ) == n ) then if ( usemass . and . . not . allocated ( this % mass )) then allocate ( this % mass ( n , n )) this % m_massComputed = . false . else if (. not . usemass . and . allocated ( this % mass )) then deallocate ( this % mass ) this % m_massComputed = . false . end if ! All is good return else deallocate ( this % jac ) if ( allocated ( this % mass )) deallocate ( this % mass ) deallocate ( this % pivot ) deallocate ( this % tau ) deallocate ( this % dfdx ) deallocate ( this % a ) deallocate ( this % qr ) end if end if if ( usemass ) then allocate ( & this % jac ( n , n ), & this % mass ( n , n ), & this % pivot ( n ), & this % tau ( n ), & this % dfdx ( n ), & this % a ( n , n ), & this % qr ( n , n ) & ) else allocate ( & this % jac ( n , n ), & this % pivot ( n ), & this % tau ( n ), & this % dfdx ( n ), & this % a ( n , n ), & this % qr ( n , n ) & ) end if end subroutine ! ------------------------------------------------------------------------------ subroutine rbrk_attempt_step ( this , sys , h , x , y , f , yn , fn , yerr , k , args ) use diffeq_rosenbrock_constants !! Attempts an integration step for this integrator. class ( rosenbrock ), intent ( inout ) :: this !! The rosenbrock object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next !! solution estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: yerr !! An N-element array where this routine will write an estimate !! of the error in each equation. real ( real64 ), intent ( out ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: n real ( real64 ), allocatable , dimension (:) :: rhs ! Initialization n = size ( y ) allocate ( rhs ( n )) ! Process rhs = f + h * d1 * this % dfdx k (:, 1 ) = solve_qr ( this % qr , this % tau , this % pivot , rhs ) yn = y + a21 * k (:, 1 ) call sys % compute_rhs ( x + c2 * h , yn , fn , args ) rhs = c21 * k (:, 1 ) / h if ( allocated ( this % mass )) rhs = matmul ( this % mass , rhs ) rhs = fn + h * d2 * this % dfdx + rhs k (:, 2 ) = solve_qr ( this % qr , this % tau , this % pivot , rhs ) yn = y + a31 * k (:, 1 ) + a32 * k (:, 2 ) call sys % compute_rhs ( x + c3 * h , yn , fn , args ) rhs = ( c31 * k (:, 1 ) + c32 * k (:, 2 )) / h if ( allocated ( this % mass )) rhs = matmul ( this % mass , rhs ) rhs = fn + h * d3 * this % dfdx + rhs k (:, 3 ) = solve_qr ( this % qr , this % tau , this % pivot , rhs ) yn = y + a41 * k (:, 1 ) + a42 * k (:, 2 ) + a43 * k (:, 3 ) call sys % compute_rhs ( x + c4 * h , yn , fn , args ) rhs = ( c41 * k (:, 1 ) + c42 * k (:, 2 ) + c43 * k (:, 3 )) / h if ( allocated ( this % mass )) rhs = matmul ( this % mass , rhs ) rhs = fn + h * d4 * this % dfdx + rhs k (:, 4 ) = solve_qr ( this % qr , this % tau , this % pivot , rhs ) yn = y + a51 * k (:, 1 ) + a52 * k (:, 2 ) + a53 * k (:, 3 ) + a54 * k (:, 4 ) call sys % compute_rhs ( x + h , yn , fn , args ) rhs = ( c51 * k (:, 1 ) + c52 * k (:, 2 ) + c53 * k (:, 3 ) + & c54 * k (:, 4 )) / h if ( allocated ( this % mass )) rhs = matmul ( this % mass , rhs ) rhs = fn + rhs k (:, 5 ) = solve_qr ( this % qr , this % tau , this % pivot , rhs ) yn = yn + k (:, 5 ) call sys % compute_rhs ( x + h , yn , fn , args ) ! updated derivative call this % log_function_evaluation ( 5 ) rhs = ( c61 * k (:, 1 ) + c62 * k (:, 2 ) + c63 * k (:, 3 ) + & c64 * k (:, 4 ) + c65 * k (:, 5 )) / h if ( allocated ( this % mass )) rhs = matmul ( this % mass , rhs ) yerr = fn + rhs yerr = solve_qr ( this % qr , this % tau , this % pivot , yerr ) yn = yn + yerr call sys % compute_rhs ( x + h , yn , fn , args ) call this % log_function_evaluation () end subroutine ! ------------------------------------------------------------------------------ subroutine rbrk_init_interp ( this , neqn ) !! Allocates storage for the interpolation process. class ( rosenbrock ), intent ( inout ) :: this !! The rosenbrock object. integer , intent ( in ) :: neqn !! The number of equations being integrated. ! Process if ( allocated ( this % rc1 )) then if ( size ( this % rc1 ) == neqn ) then ! All is good return else deallocate ( this % rc1 ) deallocate ( this % rc2 ) deallocate ( this % rc3 ) deallocate ( this % rc4 ) end if end if allocate ( & this % rc1 ( neqn ), & this % rc2 ( neqn ), & this % rc3 ( neqn ), & this % rc4 ( neqn ) & ) end subroutine ! ------------------------------------------------------------------------------ subroutine rbrk_set_up_interp ( this , sys , dense , x , xn , y , yn , f , fn , k , args ) use diffeq_rosenbrock_constants !! Sets up the interpolation process. class ( rosenbrock ), intent ( inout ) :: this !! The rosenbrock object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. logical , intent ( in ) :: dense !! Determines if dense output is requested (true); else, false. real ( real64 ), intent ( in ) :: x !! The previous value of the independent variable. real ( real64 ), intent ( in ) :: xn !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the derivatives at x. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( inout ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: i , n ! Quick Return if (. not . dense ) return ! Initialization n = size ( y ) call this % initialize_interp ( n ) ! Process do i = 1 , n this % rc1 ( i ) = y ( i ) this % rc2 ( i ) = yn ( i ) this % rc3 ( i ) = d21 * k ( i , 1 ) + d22 * k ( i , 2 ) + d23 * k ( i , 3 ) + & d24 * k ( i , 4 ) + d25 * k ( i , 5 ) this % rc4 ( i ) = d31 * k ( i , 1 ) + d32 * k ( i , 2 ) + d33 * k ( i , 3 ) + & d34 * k ( i , 4 ) + d35 * k ( i , 5 ) end do end subroutine ! ------------------------------------------------------------------------------ subroutine rbrk_interp ( this , x , xn , yn , fn , xn1 , yn1 , fn1 , y ) !! Performs the interpolation. class ( rosenbrock ), intent ( in ) :: this !! The rosenbrock object. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at which to compute !! the interpolation. real ( real64 ), intent ( in ) :: xn !! The previous value of the independent variable at which the !! solution is computed. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( in ) :: xn1 !! The value of the independent variable at xn + h. real ( real64 ), intent ( in ), dimension (:) :: yn1 !! An N-element array containing the solution at xn + h. real ( real64 ), intent ( in ), dimension (:) :: fn1 !! An N-element array containing the derivatives at xn + h. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where this routine will write the !! solution values interpolated at x. ! Local Variables real ( real64 ) :: h , s , s1 ! Process h = xn1 - xn s = ( x - xn ) / h s1 = 1.0d0 - s y = this % rc1 * s1 + s * ( this % rc2 + s1 * ( this % rc3 + s * this % rc4 )) end subroutine ! ------------------------------------------------------------------------------ pure function rbrk_get_order ( this ) result ( rst ) !! Gets the order of the integrator. class ( rosenbrock ), intent ( in ) :: this !! The rosenbrock object. integer :: rst !! The order. rst = 4 end function ! ------------------------------------------------------------------------------ pure function rbrk_get_is_fsal ( this ) result ( rst ) !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. class ( rosenbrock ), intent ( in ) :: this !! The rosenbrock object. logical :: rst !! True for a FSAL integrator; else, false. rst = . true . end function ! ------------------------------------------------------------------------------ pure function rbrk_get_stage_count ( this ) result ( rst ) !! Gets the stage count for this integrator. class ( rosenbrock ), intent ( in ) :: this !! The rosenbrock object. integer :: rst !! The stage count. rst = 6 end function ! ------------------------------------------------------------------------------ function rbrk_next_step ( this , e , eold , h , x ) result ( rst ) !! Estimates the next step size based upon the current and previous error !! estimates. class ( rosenbrock ), intent ( inout ) :: this !! The rosenbrock object. real ( real64 ), intent ( in ) :: e !! The norm of the current scaled error estimate. real ( real64 ), intent ( inout ) :: eold !! The norm of the previous step's scaled error estimate.  On output, !! this variable is updated. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current independent variable value. real ( real64 ) :: rst !! The new step size estimate. ! Parameters real ( real64 ), parameter :: fac1 = 5.0d0 real ( real64 ), parameter :: fac2 = 1.0d0 / 6.0d0 ! Local Variables real ( real64 ) :: safe , fac , facpred , maxstep , minstep ! Initialization safe = this % get_step_size_factor () maxstep = this % get_maximum_step_size () minstep = this % get_minimum_step_size () fac = max ( fac2 , min ( fac1 , e ** ( 0.25d0 ) / safe )) rst = h / fac ! Process if ( e <= 1.0d0 ) then ! The step met error tolerances and is acceptable if (. not . this % m_firstStep ) then facpred = ( this % m_hOld / h ) * ( e * e / eold ) ** ( 0.25d00 ) / safe facpred = max ( fac2 , min ( fac1 , facpred )) fac = max ( fac , facpred ) rst = h / fac end if this % m_firstStep = . false . this % m_hOld = h eold = max ( 1.0d-2 , e ) if ( this % m_rejectStep ) then ! Don't let the step size increase if the last step was rejected if ( abs ( h ) >= 0.0d0 ) then rst = min ( abs ( rst ), abs ( h )) else rst = max ( abs ( rst ), abs ( h )) end if rst = sign ( rst , h ) end if this % m_rejectStep = . false . else ! The step is rejected, reduce the step size - already computed this % m_rejectStep = . true . end if if ( abs ( rst ) > maxstep ) rst = sign ( maxstep , h ) if ( abs ( rst ) < minstep ) error stop DIFFEQ_STEP_SIZE_TOO_SMALL_ERROR end function ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_rosenbrock.f90.html"},{"title":"diffeq_c_errors.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_c_errors use iso_c_binding integer ( c_int ), parameter :: C_NO_ERROR = 0 integer ( c_int ), parameter :: C_NULL_POINTER_ERROR = 1 integer ( c_int ), parameter :: C_MATRIX_ROW_SIZE_ERROR = 2 integer ( c_int ), parameter :: C_MATRIX_COLUMN_SIZE_ERROR = 3 integer ( c_int ), parameter :: C_MATRIX_STRIDE_ERROR = 4 integer ( c_int ), parameter :: C_INVALID_INPUT_ERROR = 5 end module","tags":"","url":"sourcefile\\diffeq_c_errors.f90.html"},{"title":"diffeq_rk23.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_rk23 use iso_fortran_env use diffeq_base use diffeq_singlestep use diffeq_errors implicit none private public :: runge_kutta_23 type , extends ( single_step_integrator ) :: runge_kutta_23 !! The Bogacki--Shampine RK23 integrator. !! !! A third-order solution is paired with an embedded second-order !! solution, giving the local estimate !!  e_{n+1} = y_{n+1}&#94;{[3]} - y_{n+1}&#94;{[2]} .  The method has four !! stages and FSAL reuse.  Its lower order reduces the cost per step !! and is useful when high accuracy is not required. real ( real64 ), private , allocatable , dimension (:) :: rc1 real ( real64 ), private , allocatable , dimension (:) :: rc2 real ( real64 ), private , allocatable , dimension (:) :: rc3 contains procedure , public :: pre_step_action => rk23_pre_step !! Performs any pre-step actions. procedure , private :: initialize_interp => rk23_init_interp !! Allocates storage for the interpolation process. procedure , public :: get_order => rk23_get_order !! Gets the order of the integrator. procedure , public :: get_is_fsal => rk23_get_is_fsal !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. procedure , public :: get_stage_count => rk23_get_stage_count !! Gets the stage count for this integrator. procedure , public :: attempt_step => rk23_attempt_step !! Attempts an integration step for this integrator. procedure , public :: post_step_action => rk23_set_up_interp !! Sets up the interpolation process as the post-step action. procedure , public :: interpolate => rk23_interp !! Performs the interpolation. end type contains ! ------------------------------------------------------------------------------ subroutine rk23_pre_step ( this , prevs , sys , h , x , y , f , args ) !! Placeholder routine for any pre-step actions. class ( runge_kutta_23 ), intent ( inout ) :: this !! The runge_kutta_23 object. logical , intent ( in ) :: prevs !! Defines the status of the previous step.  The value is true !! if the previous step was successful; else, false if the !! previous step failed. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Process return end subroutine ! ------------------------------------------------------------------------------ pure function rk23_get_order ( this ) result ( rst ) !! Gets the order of the integrator. class ( runge_kutta_23 ), intent ( in ) :: this !! The runge_kutta_23 object. integer :: rst !! The order. rst = 3 end function ! ------------------------------------------------------------------------------ pure function rk23_get_is_fsal ( this ) result ( rst ) !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. class ( runge_kutta_23 ), intent ( in ) :: this !! The runge_kutta_23 object. logical :: rst !! True for a FSAL integrator; else, false. rst = . true . end function ! ------------------------------------------------------------------------------ pure function rk23_get_stage_count ( this ) result ( rst ) !! Gets the stage count for this integrator. class ( runge_kutta_23 ), intent ( in ) :: this !! The runge_kutta_23 object. integer :: rst !! The stage count. rst = 4 end function ! ------------------------------------------------------------------------------ subroutine rk23_init_interp ( this , neqn ) !! Allocates storage for the interpolation process. class ( runge_kutta_23 ), intent ( inout ) :: this !! The runge_kutta_23 object. integer , intent ( in ) :: neqn !! The number of equations being integrated. ! Process if ( allocated ( this % rc1 )) then if ( size ( this % rc1 ) == neqn ) then ! All is good return else deallocate ( this % rc1 ) deallocate ( this % rc2 ) deallocate ( this % rc3 ) end if end if allocate ( & this % rc1 ( neqn ), & this % rc2 ( neqn ), & this % rc3 ( neqn ) & ) end subroutine ! ------------------------------------------------------------------------------ subroutine rk23_attempt_step ( this , sys , h , x , y , f , yn , fn , yerr , k , args ) use diffeq_bsrk32_constants !! Attempts an integration step for this integrator. class ( runge_kutta_23 ), intent ( inout ) :: this !! The runge_kutta_23 object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next !! solution estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: yerr !! An N-element array where this routine will write an estimate !! of the error in each equation. real ( real64 ), intent ( out ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: n ! Initialization n = size ( y ) ! Process ! k1 = f as the derivatives were computed from the previous step k (:, 1 ) = f yn = y + h * a21 * f call sys % compute_rhs ( x + h * c2 , yn , k (:, 2 ), args ) yn = y + h * ( a31 * f + a32 * k (:, 2 )) call sys % compute_rhs ( x + h * c3 , yn , k (:, 3 ), args ) yn = y + h * ( a41 * f + a42 * k (:, 2 ) + a43 * k (:, 3 )) call sys % compute_rhs ( x + h * c4 , yn , fn , args ) call this % log_function_evaluation ( 3 ) ! Compute the error estimate yerr = h * ( e1 * f + e2 * k (:, 2 ) + e3 * k (:, 3 ) + e4 * fn ) end subroutine ! ------------------------------------------------------------------------------ subroutine rk23_set_up_interp ( this , sys , dense , x , xn , y , yn , f , fn , k , args ) use diffeq_bsrk32_constants !! Sets up the interpolation process. class ( runge_kutta_23 ), intent ( inout ) :: this !! The runge_kutta_23 object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. logical , intent ( in ) :: dense !! Determines if dense output is requested (true); else, false. real ( real64 ), intent ( in ) :: x !! The previous value of the independent variable. real ( real64 ), intent ( in ) :: xn !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the derivatives at x. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( inout ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: n real ( real64 ) :: h ! Quick Return if (. not . dense ) return ! Initialization h = xn - x n = size ( y ) call this % initialize_interp ( n ) ! Process this % rc1 = - ( y - yn + f * h ) / h ** 2 this % rc2 = f - 2.0d0 * x * this % rc1 this % rc3 = y - this % rc1 * x ** 2 - this % rc2 * x end subroutine ! ------------------------------------------------------------------------------ subroutine rk23_interp ( this , x , xn , yn , fn , xn1 , yn1 , fn1 , y ) !! Performs the interpolation. class ( runge_kutta_23 ), intent ( in ) :: this !! The runge_kutta_23 object. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at which to compute !! the interpolation. real ( real64 ), intent ( in ) :: xn !! The previous value of the independent variable at which the !! solution is computed. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( in ) :: xn1 !! The value of the independent variable at xn + h. real ( real64 ), intent ( in ), dimension (:) :: yn1 !! An N-element array containing the solution at xn + h. real ( real64 ), intent ( in ), dimension (:) :: fn1 !! An N-element array containing the derivatives at xn + h. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where this routine will write the !! solution values interpolated at x. ! Process y = this % rc1 * x ** 2 + this % rc2 * x + this % rc3 end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_rk23.f90.html"},{"title":"diffeq_rk45.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_rk45 use iso_fortran_env use diffeq_base use diffeq_singlestep use diffeq_errors implicit none private public :: runge_kutta_45 type , extends ( single_step_integrator ) :: runge_kutta_45 !! The Dormand--Prince RK45 integrator. !! !! A fifth-order solution is paired with an embedded fourth-order !! solution.  The estimated local defect is !!  e_{n+1} = y_{n+1}&#94;{[5]} - y_{n+1}&#94;{[4]} , and the method uses !! the fifth-order result after an accepted step.  The method has !! seven stages and FSAL (first-same-as-last) reuse, so the final !! stage derivative becomes the first derivative of the next step. !! It is a general-purpose choice for moderate-to-high accuracy on !! non-stiff problems. real ( real64 ), private , allocatable , dimension (:) :: rc1 real ( real64 ), private , allocatable , dimension (:) :: rc2 real ( real64 ), private , allocatable , dimension (:) :: rc3 real ( real64 ), private , allocatable , dimension (:) :: rc4 real ( real64 ), private , allocatable , dimension (:) :: rc5 contains procedure , public :: pre_step_action => rk45_pre_step !! Performs any pre-step actions. procedure , public :: get_order => rk45_get_order !! Gets the order of the integrator. procedure , public :: get_is_fsal => rk45_get_is_fsal !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. procedure , public :: get_stage_count => rk45_get_stage_count !! Gets the stage count for this integrator. procedure , private :: initialize_interp => rk45_init_interp !! Allocates storage for the interpolation process. procedure , public :: attempt_step => rk45_attempt_step !! Attempts an integration step for this integrator. procedure , public :: post_step_action => rk45_set_up_interp !! Sets up the interpolation process as the post-step action. procedure , public :: interpolate => rk45_interp !! Performs the interpolation. end type contains ! ------------------------------------------------------------------------------ subroutine rk45_pre_step ( this , prevs , sys , h , x , y , f , args ) !! Placeholder routine for any pre-step actions. class ( runge_kutta_45 ), intent ( inout ) :: this !! The runge_kutta_45 object. logical , intent ( in ) :: prevs !! Defines the status of the previous step.  The value is true !! if the previous step was successful; else, false if the !! previous step failed. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Process return end subroutine ! ------------------------------------------------------------------------------ pure function rk45_get_order ( this ) result ( rst ) !! Gets the order of the integrator. class ( runge_kutta_45 ), intent ( in ) :: this !! The runge_kutta_45 object. integer :: rst !! The order. rst = 5 end function ! ------------------------------------------------------------------------------ pure function rk45_get_is_fsal ( this ) result ( rst ) !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. class ( runge_kutta_45 ), intent ( in ) :: this !! The runge_kutta_45 object. logical :: rst !! True for a FSAL integrator; else, false. rst = . true . end function ! ------------------------------------------------------------------------------ pure function rk45_get_stage_count ( this ) result ( rst ) !! Gets the stage count for this integrator. class ( runge_kutta_45 ), intent ( in ) :: this !! The runge_kutta_45 object. integer :: rst !! The stage count. rst = 7 end function ! ------------------------------------------------------------------------------ subroutine rk45_init_interp ( this , neqn ) !! Allocates storage for the interpolation process. class ( runge_kutta_45 ), intent ( inout ) :: this !! The runge_kutta_45 object. integer , intent ( in ) :: neqn !! The number of equations being integrated. ! Process if ( allocated ( this % rc1 )) then if ( size ( this % rc1 ) == neqn ) then ! All is good return else deallocate ( this % rc1 ) deallocate ( this % rc2 ) deallocate ( this % rc3 ) deallocate ( this % rc4 ) deallocate ( this % rc5 ) end if end if allocate ( & this % rc1 ( neqn ), & this % rc2 ( neqn ), & this % rc3 ( neqn ), & this % rc4 ( neqn ), & this % rc5 ( neqn ) & ) end subroutine ! ------------------------------------------------------------------------------ subroutine rk45_attempt_step ( this , sys , h , x , y , f , yn , fn , yerr , k , args ) use diffeq_dprk45_constants !! Attempts an integration step for this integrator. class ( runge_kutta_45 ), intent ( inout ) :: this !! The runge_kutta_45 object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next !! solution estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: yerr !! An N-element array where this routine will write an estimate !! of the error in each equation. real ( real64 ), intent ( out ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: n ! Initialization n = size ( y ) ! Process ! k1 = f as the derivatives were computed from the previous step k (:, 1 ) = f yn = y + h * a21 * f call sys % compute_rhs ( x + h * c2 , yn , k (:, 2 ), args ) yn = y + h * ( a31 * f + a32 * k (:, 2 )) call sys % compute_rhs ( x + h * c3 , yn , k (:, 3 ), args ) yn = y + h * ( a41 * f + a42 * k (:, 2 ) + a43 * k (:, 3 )) call sys % compute_rhs ( x + h * c4 , yn , k (:, 4 ), args ) yn = y + h * ( a51 * f + a52 * k (:, 2 ) + a53 * k (:, 3 ) + a54 * k (:, 4 )) call sys % compute_rhs ( x + h * c5 , yn , k (:, 5 ), args ) yn = y + h * ( a61 * f + a62 * k (:, 2 ) + a63 * k (:, 3 ) + a64 * k (:, 4 ) + & a65 * k (:, 5 )) call sys % compute_rhs ( x + h * c6 , yn , k (:, 6 ), args ) yn = y + h * ( a71 * f + a73 * k (:, 3 ) + a74 * k (:, 4 ) + a75 * k (:, 5 ) + a76 * k (:, 6 )) call sys % compute_rhs ( x + h * c7 , yn , fn , args ) call this % log_function_evaluation ( 6 ) ! Compute the error estimate yerr = h * ( e1 * f + e2 * k (:, 2 ) + e3 * k (:, 3 ) + e4 * k (:, 4 ) + & e5 * k (:, 5 ) + e6 * k (:, 6 ) + e7 * fn ) end subroutine ! ------------------------------------------------------------------------------ subroutine rk45_set_up_interp ( this , sys , dense , x , xn , y , yn , f , fn , k , args ) use diffeq_dprk45_constants !! Sets up the interpolation process. class ( runge_kutta_45 ), intent ( inout ) :: this !! The runge_kutta_45 object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. logical , intent ( in ) :: dense !! Determines if dense output is requested (true); else, false. real ( real64 ), intent ( in ) :: x !! The previous value of the independent variable. real ( real64 ), intent ( in ) :: xn !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the derivatives at x. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( inout ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables integer :: i , n real ( real64 ) :: h , ydiff , bspl ! Quick Return if (. not . dense ) return ! Initialization n = size ( y ) call this % initialize_interp ( n ) h = xn - x ! Process do i = 1 , n this % rc1 ( i ) = y ( i ) ydiff = yn ( i ) - y ( i ) this % rc2 ( i ) = ydiff bspl = h * f ( i ) - ydiff this % rc3 ( i ) = bspl this % rc4 ( i ) = ydiff - h * fn ( i ) - bspl this % rc5 ( i ) = h * ( d1 * f ( i ) + d3 * k ( i , 3 ) + d4 * k ( i , 4 ) + & d5 * k ( i , 5 ) + d6 * k ( i , 6 ) + d7 * fn ( i )) end do end subroutine ! ------------------------------------------------------------------------------ subroutine rk45_interp ( this , x , xn , yn , fn , xn1 , yn1 , fn1 , y ) !! Performs the interpolation. class ( runge_kutta_45 ), intent ( in ) :: this !! The runge_kutta_45 object. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at which to compute !! the interpolation. real ( real64 ), intent ( in ) :: xn !! The previous value of the independent variable at which the !! solution is computed. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( in ) :: xn1 !! The value of the independent variable at xn + h. real ( real64 ), intent ( in ), dimension (:) :: yn1 !! An N-element array containing the solution at xn + h. real ( real64 ), intent ( in ), dimension (:) :: fn1 !! An N-element array containing the derivatives at xn + h. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where this routine will write the !! solution values interpolated at x. ! Local Variables real ( real64 ) :: h , s , s1 ! Process h = xn1 - xn s = ( x - xn ) / h s1 = 1.0d0 - s y = this % rc1 + s * ( this % rc2 + s1 * ( this % rc3 + & s * ( this % rc4 + s1 * this % rc5 ))) end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_rk45.f90.html"},{"title":"diffeq_auto_diff.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_auto_diff !! First-order forward automatic differentiation for Jacobian expressions. !! !! Each real_ad stores one value and one directional derivative. Reevaluate !! an expression with one independent variable seeded at a time to obtain !! Jacobian columns. All overloads are elemental and preserve scalar expansion. !! Arithmetic and comparisons accept real_ad, real(real64), and default !! integer operands; binary intrinsics accept real_ad and real(real64). !! !! Comparisons ignore derivatives. ABS uses derivative zero at zero; MIN/MAX !! are binary and retain the first argument on ties. SIGN differentiates only !! its magnitude argument. These are branch conventions, not derivatives at !! discontinuities. Other domain errors and singular derivatives follow the !! underlying real intrinsics and the caller's floating-point error settings. !! !! In the procedures below, a/b (or y/x for ATAN2) are input operands, c is !! the result, and dx is propagated by the chain rule. Real and integer !! operands are constants with derivative zero. use iso_fortran_env implicit none private public :: real_ad public :: assignment ( = ) public :: operator ( + ), operator ( - ), operator ( * ), operator ( / ), operator ( ** ) public :: operator ( == ), operator ( /= ), operator ( < ), operator ( <= ) public :: operator ( > ), operator ( >= ) public :: abs , sqrt , exp , log , log10 , sin , cos , tan , asin , acos , atan public :: atan2 , sinh , cosh , tanh , asinh , acosh , atanh , erf , erfc public :: min , max , sign type real_ad !! A value and its directional derivative. Seed dx with one for an !! independent variable and zero for constants. real ( real64 ) :: x !! Function or independent-variable value. real ( real64 ) :: dx !! Directional derivative with respect to the current seed. end type interface assignment ( = ) !! Copy AD data, assign a constant (clearing dx), or extract a real value. module procedure :: ad_assign_1 module procedure :: ad_assign_2 module procedure :: ad_assign_3 module procedure :: ad_assign_integer end interface interface operator ( + ) !! Unary identity and addition, including constant operands in either order. module procedure :: ad_add , ad_add_real , real_add_ad module procedure :: ad_add_integer , integer_add_ad , ad_positive end interface interface operator ( - ) !! Unary negation and subtraction, including constant operands. module procedure :: ad_subtract , ad_subtract_real , real_subtract_ad module procedure :: ad_subtract_integer , integer_subtract_ad , ad_negative end interface interface operator ( * ) !! Multiplication using the product rule. module procedure :: ad_multiply , ad_multiply_real , real_multiply_ad module procedure :: ad_multiply_integer , integer_multiply_ad end interface interface operator ( / ) !! Division using the quotient rule; the denominator must be nonzero. module procedure :: ad_divide , ad_divide_real , real_divide_ad module procedure :: ad_divide_integer , integer_divide_ad end interface interface operator ( ** ) !! Exponentiation with constant or variable base/exponent. !! Variable exponents require a positive base, except that a zero constant !! base with a positive exponent has zero derivative. Constant integral !! exponents also support negative bases. module procedure :: ad_power , ad_power_real , real_power_ad module procedure :: ad_power_integer , integer_power_ad end interface interface operator ( == ) !! Equality of values, independent of derivative seeds. module procedure :: ad_equal , ad_equal_real , real_equal_ad module procedure :: ad_equal_integer , integer_equal_ad end interface interface operator ( /= ) !! Inequality of values, independent of derivative seeds. module procedure :: ad_not_equal , ad_not_equal_real , real_not_equal_ad module procedure :: ad_not_equal_integer , integer_not_equal_ad end interface interface operator ( < ) !! Strict less-than comparison of values. module procedure :: ad_less , ad_less_real , real_less_ad module procedure :: ad_less_integer , integer_less_ad end interface interface operator ( <= ) !! Less-than-or-equal comparison of values. module procedure :: ad_less_equal , ad_less_equal_real , real_less_equal_ad module procedure :: ad_less_equal_integer , integer_less_equal_ad end interface interface operator ( > ) !! Strict greater-than comparison of values. module procedure :: ad_greater , ad_greater_real , real_greater_ad module procedure :: ad_greater_integer , integer_greater_ad end interface interface operator ( >= ) !! Greater-than-or-equal comparison of values. module procedure :: ad_greater_equal , ad_greater_equal_real , real_greater_equal_ad module procedure :: ad_greater_equal_integer , integer_greater_equal_ad end interface interface abs !! Absolute value; the derivative at zero is defined to be zero. module procedure :: ad_abs end interface interface sqrt !! Square root for nonnegative values; its active derivative is singular at zero. module procedure :: ad_sqrt end interface interface exp !! Natural exponential. module procedure :: ad_exp end interface interface log !! Natural logarithm for positive values. module procedure :: ad_log end interface interface log10 !! Base-ten logarithm for positive values. module procedure :: ad_log10 end interface interface sin !! Sine, with arguments in radians. module procedure :: ad_sin end interface interface cos !! Cosine, with arguments in radians. module procedure :: ad_cos end interface interface tan !! Tangent, with arguments in radians and away from its poles. module procedure :: ad_tan end interface interface asin !! Inverse sine in radians; the active derivative is singular at +/-1. module procedure :: ad_asin end interface interface acos !! Inverse cosine in radians; the active derivative is singular at +/-1. module procedure :: ad_acos end interface interface atan !! One- or two-argument inverse tangent in radians. module procedure :: ad_atan , ad_atan2 , ad_atan2_real , real_atan2_ad end interface interface atan2 !! Quadrant-aware inverse tangent ATAN2(y,x); not defined at the origin. module procedure :: ad_atan2 , ad_atan2_real , real_atan2_ad end interface interface sinh !! Hyperbolic sine. module procedure :: ad_sinh end interface interface cosh !! Hyperbolic cosine. module procedure :: ad_cosh end interface interface tanh !! Hyperbolic tangent. module procedure :: ad_tanh end interface interface asinh !! Inverse hyperbolic sine. module procedure :: ad_asinh end interface interface acosh !! Inverse hyperbolic cosine for values >= 1; active derivative singular at 1. module procedure :: ad_acosh end interface interface atanh !! Inverse hyperbolic tangent for values strictly between -1 and 1. module procedure :: ad_atanh end interface interface erf !! Error function. module procedure :: ad_erf end interface interface erfc !! Complementary error function. module procedure :: ad_erfc end interface interface min !! Binary minimum, carrying the selected derivative; first argument wins ties. module procedure :: ad_min , ad_min_real , real_min_ad end interface interface max !! Binary maximum, carrying the selected derivative; first argument wins ties. module procedure :: ad_max , ad_max_real , real_max_ad end interface interface sign !! Magnitude of a with the sign of b; ignores the derivative of b. module procedure :: ad_sign , ad_sign_real , real_sign_ad end interface contains ! ****************************************************************************** ! ASSIGNMENT OPERATORS ! ------------------------------------------------------------------------------ elemental subroutine ad_assign_1 ( lhs , rhs ) !! Copy the value and derivative of rhs to lhs. type ( real_ad ), intent ( out ) :: lhs type ( real_ad ), intent ( in ) :: rhs lhs % x = rhs % x lhs % dx = rhs % dx end subroutine elemental subroutine ad_assign_2 ( lhs , rhs ) !! Assign a real64 constant rhs to lhs and clear its derivative. type ( real_ad ), intent ( out ) :: lhs real ( real64 ), intent ( in ) :: rhs lhs % x = rhs lhs % dx = 0.0d0 end subroutine elemental subroutine ad_assign_3 ( lhs , rhs ) !! Extract the value of rhs into real64 lhs, discarding the derivative. real ( real64 ), intent ( out ) :: lhs type ( real_ad ), intent ( in ) :: rhs lhs = rhs % x end subroutine elemental subroutine ad_assign_integer ( lhs , rhs ) !! Assign a default-integer constant rhs to lhs and clear its derivative. type ( real_ad ), intent ( out ) :: lhs integer , intent ( in ) :: rhs lhs % x = real ( rhs , real64 ) lhs % dx = 0.0d0 end subroutine ! ****************************************************************************** ! MATHEMATICAL OPERATORS ! ------------------------------------------------------------------------------ elemental function ad_positive ( a ) result ( c ) !! Unary plus preserves both components. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = a end function elemental function ad_negative ( a ) result ( c ) !! Unary minus negates both components. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( - a % x , - a % dx ) end function elemental function ad_add ( a , b ) result ( c ) !! Add values and directional derivatives. type ( real_ad ), intent ( in ) :: a , b type ( real_ad ) :: c c = real_ad ( a % x + b % x , a % dx + b % dx ) end function elemental function ad_add_real ( a , b ) result ( c ) !! Add a real64 constant without changing the derivative. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( real_ad ) :: c c = real_ad ( a % x + b , a % dx ) end function elemental function real_add_ad ( a , b ) result ( c ) !! Add an AD operand to a real64 constant. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = b + a end function elemental function ad_add_integer ( a , b ) result ( c ) !! Add a default-integer constant using real64 arithmetic. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b type ( real_ad ) :: c c = a + real ( b , real64 ) end function elemental function integer_add_ad ( a , b ) result ( c ) !! Add an AD operand to a default-integer constant. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = real ( a , real64 ) + b end function elemental function ad_subtract ( a , b ) result ( c ) !! Subtract values and directional derivatives. type ( real_ad ), intent ( in ) :: a , b type ( real_ad ) :: c c = real_ad ( a % x - b % x , a % dx - b % dx ) end function elemental function ad_subtract_real ( a , b ) result ( c ) !! Subtract a real64 constant without changing the derivative. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( real_ad ) :: c c = real_ad ( a % x - b , a % dx ) end function elemental function real_subtract_ad ( a , b ) result ( c ) !! Subtract an AD operand from a real64 constant, negating its derivative. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = real_ad ( a - b % x , - b % dx ) end function elemental function ad_subtract_integer ( a , b ) result ( c ) !! Subtract a default-integer constant using real64 arithmetic. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b type ( real_ad ) :: c c = a - real ( b , real64 ) end function elemental function integer_subtract_ad ( a , b ) result ( c ) !! Subtract an AD operand from a default-integer constant. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = real ( a , real64 ) - b end function elemental function ad_multiply ( a , b ) result ( c ) !! Apply the product rule: d(a*b) = da*b + a*db. type ( real_ad ), intent ( in ) :: a , b type ( real_ad ) :: c c = real_ad ( a % x * b % x , a % dx * b % x + a % x * b % dx ) end function elemental function ad_multiply_real ( a , b ) result ( c ) !! Scale the value and derivative by a real64 constant. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( real_ad ) :: c c = real_ad ( a % x * b , a % dx * b ) end function elemental function real_multiply_ad ( a , b ) result ( c ) !! Multiply a real64 constant by an AD operand. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = b * a end function elemental function ad_multiply_integer ( a , b ) result ( c ) !! Scale an AD operand by a default-integer constant. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b type ( real_ad ) :: c c = a * real ( b , real64 ) end function elemental function integer_multiply_ad ( a , b ) result ( c ) !! Multiply a default-integer constant by an AD operand. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = real ( a , real64 ) * b end function elemental function ad_divide ( a , b ) result ( c ) !! Apply the quotient rule as d(a/b) = (da - (a/b)*db)/b. type ( real_ad ), intent ( in ) :: a , b type ( real_ad ) :: c c % x = a % x / b % x c % dx = ( a % dx - c % x * b % dx ) / b % x end function elemental function ad_divide_real ( a , b ) result ( c ) !! Divide the value and derivative by a nonzero real64 constant. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( real_ad ) :: c c = real_ad ( a % x / b , a % dx / b ) end function elemental function real_divide_ad ( a , b ) result ( c ) !! Divide a real64 constant by AD b, with derivative -a*db/b**2. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c % x = a / b % x c % dx = - c % x * ( b % dx / b % x ) end function elemental function ad_divide_integer ( a , b ) result ( c ) !! Divide an AD operand by a nonzero default-integer constant. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b type ( real_ad ) :: c c = a / real ( b , real64 ) end function elemental function integer_divide_ad ( a , b ) result ( c ) !! Divide a default-integer constant by an AD operand. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = real ( a , real64 ) / b end function elemental function ad_power ( a , b ) result ( c ) !! Apply d(a**b) = b*a**(b-1)*da + a**b*log(a)*db. !! Omit inactive terms so constant powers work at zero and negative bases. type ( real_ad ), intent ( in ) :: a , b type ( real_ad ) :: c c = a ** b % x ! A constant exponent must not introduce log(a), which would exclude ! negative bases even for integral powers. if ( b % dx /= 0.0d0 ) then if ( a % x /= 0.0d0 . or . b % x <= 0.0d0 ) then c % dx = c % dx + c % x * log ( a % x ) * b % dx end if end if end function elemental function ad_power_real ( a , b ) result ( c ) !! Raise AD a to constant b with derivative b*a**(b-1)*da. !! Exponents zero and one are handled without singular intermediate powers. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( real_ad ) :: c c % x = a % x ** b if ( b == 0.0d0 . or . a % dx == 0.0d0 ) then c % dx = 0.0d0 else if ( b == 1.0d0 ) then c % dx = a % dx else c % dx = b * ( a % x ** ( b - 1.0d0 )) * a % dx end if end function elemental function real_power_ad ( a , b ) result ( c ) !! Raise constant a to AD b with derivative a**b*log(a)*db. !! A zero base and positive exponent give zero for both components. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c % x = a ** b % x if ( b % dx == 0.0d0 ) then c % dx = 0.0d0 else if ( a == 0.0d0 . and . b % x > 0.0d0 ) then c % dx = 0.0d0 else c % dx = c % x * log ( a ) * b % dx end if end function elemental function ad_power_integer ( a , b ) result ( c ) !! Evaluate an integer power, preserving negative-base and zero-base behavior. !! Negative exponents avoid b-1, which could overflow the integer range. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b type ( real_ad ) :: c c % x = a % x ** b if ( b == 0 . or . a % dx == 0.0d0 ) then c % dx = 0.0d0 else if ( b > 0 ) then c % dx = real ( b , real64 ) * ( a % x ** ( b - 1 )) * a % dx else c % dx = real ( b , real64 ) * ( c % x / a % x ) * a % dx end if end function elemental function integer_power_ad ( a , b ) result ( c ) !! Raise a default-integer constant to an AD exponent using real64 arithmetic. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = real ( a , real64 ) ** b end function ! ****************************************************************************** ! COMPARISON OPERATORS ! ------------------------------------------------------------------------------ elemental logical function ad_equal ( a , b ) result ( c ) !! Compare only the values of two AD operands for equality. type ( real_ad ), intent ( in ) :: a , b c = a % x == b % x end function elemental logical function ad_equal_real ( a , b ) result ( c ) !! Compare an AD value with a real64 constant for equality. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b c = a % x == b end function elemental logical function real_equal_ad ( a , b ) result ( c ) !! Compare a real64 constant with an AD value for equality. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = a == b % x end function elemental logical function ad_equal_integer ( a , b ) result ( c ) !! Compare an AD value with a default integer for equality. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b c = a % x == real ( b , real64 ) end function elemental logical function integer_equal_ad ( a , b ) result ( c ) !! Compare a default integer with an AD value for equality. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = real ( a , real64 ) == b % x end function elemental logical function ad_not_equal ( a , b ) result ( c ) !! Compare only the values of two AD operands for inequality. type ( real_ad ), intent ( in ) :: a , b c = a % x /= b % x end function elemental logical function ad_not_equal_real ( a , b ) result ( c ) !! Compare an AD value with a real64 constant for inequality. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b c = a % x /= b end function elemental logical function real_not_equal_ad ( a , b ) result ( c ) !! Compare a real64 constant with an AD value for inequality. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = a /= b % x end function elemental logical function ad_not_equal_integer ( a , b ) result ( c ) !! Compare an AD value with a default integer for inequality. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b c = a % x /= real ( b , real64 ) end function elemental logical function integer_not_equal_ad ( a , b ) result ( c ) !! Compare a default integer with an AD value for inequality. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = real ( a , real64 ) /= b % x end function elemental logical function ad_less ( a , b ) result ( c ) !! Test whether AD a's value is strictly less than AD b's. type ( real_ad ), intent ( in ) :: a , b c = a % x < b % x end function elemental logical function ad_less_real ( a , b ) result ( c ) !! Test whether an AD value is less than a real64 constant. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b c = a % x < b end function elemental logical function real_less_ad ( a , b ) result ( c ) !! Test whether a real64 constant is less than an AD value. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = a < b % x end function elemental logical function ad_less_integer ( a , b ) result ( c ) !! Test whether an AD value is less than a default integer. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b c = a % x < real ( b , real64 ) end function elemental logical function integer_less_ad ( a , b ) result ( c ) !! Test whether a default integer is less than an AD value. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = real ( a , real64 ) < b % x end function elemental logical function ad_less_equal ( a , b ) result ( c ) !! Test whether AD a's value is less than or equal to AD b's. type ( real_ad ), intent ( in ) :: a , b c = a % x <= b % x end function elemental logical function ad_less_equal_real ( a , b ) result ( c ) !! Test whether an AD value is at most a real64 constant. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b c = a % x <= b end function elemental logical function real_less_equal_ad ( a , b ) result ( c ) !! Test whether a real64 constant is at most an AD value. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = a <= b % x end function elemental logical function ad_less_equal_integer ( a , b ) result ( c ) !! Test whether an AD value is at most a default integer. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b c = a % x <= real ( b , real64 ) end function elemental logical function integer_less_equal_ad ( a , b ) result ( c ) !! Test whether a default integer is at most an AD value. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = real ( a , real64 ) <= b % x end function elemental logical function ad_greater ( a , b ) result ( c ) !! Test whether AD a's value is strictly greater than AD b's. type ( real_ad ), intent ( in ) :: a , b c = a % x > b % x end function elemental logical function ad_greater_real ( a , b ) result ( c ) !! Test whether an AD value exceeds a real64 constant. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b c = a % x > b end function elemental logical function real_greater_ad ( a , b ) result ( c ) !! Test whether a real64 constant exceeds an AD value. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = a > b % x end function elemental logical function ad_greater_integer ( a , b ) result ( c ) !! Test whether an AD value exceeds a default integer. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b c = a % x > real ( b , real64 ) end function elemental logical function integer_greater_ad ( a , b ) result ( c ) !! Test whether a default integer exceeds an AD value. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = real ( a , real64 ) > b % x end function elemental logical function ad_greater_equal ( a , b ) result ( c ) !! Test whether AD a's value is greater than or equal to AD b's. type ( real_ad ), intent ( in ) :: a , b c = a % x >= b % x end function elemental logical function ad_greater_equal_real ( a , b ) result ( c ) !! Test whether an AD value is at least a real64 constant. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b c = a % x >= b end function elemental logical function real_greater_equal_ad ( a , b ) result ( c ) !! Test whether a real64 constant is at least an AD value. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = a >= b % x end function elemental logical function ad_greater_equal_integer ( a , b ) result ( c ) !! Test whether an AD value is at least a default integer. type ( real_ad ), intent ( in ) :: a integer , intent ( in ) :: b c = a % x >= real ( b , real64 ) end function elemental logical function integer_greater_equal_ad ( a , b ) result ( c ) !! Test whether a default integer is at least an AD value. integer , intent ( in ) :: a type ( real_ad ), intent ( in ) :: b c = real ( a , real64 ) >= b % x end function ! ****************************************************************************** ! INTRINSIC FUNCTIONS ! ------------------------------------------------------------------------------ elemental function ad_abs ( a ) result ( c ) !! Propagate sign(a)*da, choosing derivative zero at a = 0. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c % x = abs ( a % x ) if ( a % x == 0.0d0 ) then c % dx = 0.0d0 else c % dx = sign ( 1.0d0 , a % x ) * a % dx end if end function elemental function ad_sqrt ( a ) result ( c ) !! Propagate da/(2*sqrt(a)); inactive seeds remain zero at a = 0. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c % x = sqrt ( a % x ) c % dx = 0.0d0 if ( a % dx /= 0.0d0 ) c % dx = 0.5d0 * a % dx / c % x end function elemental function ad_exp ( a ) result ( c ) !! Propagate exp(a)*da. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c % x = exp ( a % x ) c % dx = c % x * a % dx end function elemental function ad_log ( a ) result ( c ) !! Propagate da/a for the natural logarithm. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( log ( a % x ), a % dx / a % x ) end function elemental function ad_log10 ( a ) result ( c ) !! Propagate da/(a*log(10)) for the base-ten logarithm. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( log10 ( a % x ), ( a % dx / a % x ) / log ( 1 0.0d0 )) end function elemental function ad_sin ( a ) result ( c ) !! Propagate cos(a)*da. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( sin ( a % x ), cos ( a % x ) * a % dx ) end function elemental function ad_cos ( a ) result ( c ) !! Propagate -sin(a)*da. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( cos ( a % x ), - sin ( a % x ) * a % dx ) end function elemental function ad_tan ( a ) result ( c ) !! Propagate da/cos(a)**2. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( tan ( a % x ), a % dx / cos ( a % x ) ** 2 ) end function elemental function ad_asin ( a ) result ( c ) !! Propagate da/sqrt(1-a**2), omitting the singular term for inactive seeds. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c % x = asin ( a % x ) c % dx = 0.0d0 if ( a % dx /= 0.0d0 ) c % dx = a % dx / sqrt (( 1.0d0 - a % x ) * ( 1.0d0 + a % x )) end function elemental function ad_acos ( a ) result ( c ) !! Propagate -da/sqrt(1-a**2) using the inverse-sine derivative. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = asin ( a ) c % x = acos ( a % x ) c % dx = - c % dx end function elemental function ad_atan ( a ) result ( c ) !! Propagate da/(1+a**2), using HYPOT to avoid squaring large a. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( atan ( a % x ), ( a % dx / hypot ( 1.0d0 , a % x )) / hypot ( 1.0d0 , a % x )) end function elemental function ad_atan2 ( y , x ) result ( c ) !! Propagate (x*dy-y*dx)/(x**2+y**2) using a scaled radius. type ( real_ad ), intent ( in ) :: y , x type ( real_ad ) :: c real ( real64 ) :: radius radius = hypot ( x % x , y % x ) c % x = atan2 ( y % x , x % x ) c % dx = (( x % x / radius ) * y % dx - ( y % x / radius ) * x % dx ) / radius end function elemental function ad_atan2_real ( y , x ) result ( c ) !! Evaluate ATAN2 with AD ordinate y and constant abscissa x. type ( real_ad ), intent ( in ) :: y real ( real64 ), intent ( in ) :: x type ( real_ad ) :: c c = atan2 ( y , real_ad ( x , 0.0d0 )) end function elemental function real_atan2_ad ( y , x ) result ( c ) !! Evaluate ATAN2 with constant ordinate y and AD abscissa x. real ( real64 ), intent ( in ) :: y type ( real_ad ), intent ( in ) :: x type ( real_ad ) :: c c = atan2 ( real_ad ( y , 0.0d0 ), x ) end function elemental function ad_sinh ( a ) result ( c ) !! Propagate cosh(a)*da. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( sinh ( a % x ), cosh ( a % x ) * a % dx ) end function elemental function ad_cosh ( a ) result ( c ) !! Propagate sinh(a)*da. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( cosh ( a % x ), sinh ( a % x ) * a % dx ) end function elemental function ad_tanh ( a ) result ( c ) !! Propagate da/cosh(a)**2 using exp(-abs(a)) to avoid hyperbolic overflow. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c real ( real64 ) :: t , sech t = exp ( - abs ( a % x )) sech = 2.0d0 * t / ( 1.0d0 + t * t ) c % x = tanh ( a % x ) c % dx = ( a % dx * sech ) * sech end function elemental function ad_asinh ( a ) result ( c ) !! Propagate da/sqrt(a**2+1), using HYPOT to avoid overflow. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( asinh ( a % x ), a % dx / hypot ( a % x , 1.0d0 )) end function elemental function ad_acosh ( a ) result ( c ) !! Propagate da/(sqrt(a-1)*sqrt(a+1)); inactive seeds stay zero at a = 1. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c % x = acosh ( a % x ) c % dx = 0.0d0 if ( a % dx /= 0.0d0 ) c % dx = ( a % dx / sqrt ( a % x - 1.0d0 )) / sqrt ( a % x + 1.0d0 ) end function elemental function ad_atanh ( a ) result ( c ) !! Propagate da/(1-a**2) using factored divisions. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( atanh ( a % x ), ( a % dx / ( 1.0d0 - a % x )) / ( 1.0d0 + a % x )) end function elemental function ad_erf ( a ) result ( c ) !! Propagate 2/sqrt(pi)*exp(-a**2)*da. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = real_ad ( erf ( a % x ), 2.0d0 / sqrt ( acos ( - 1.0d0 )) * exp ( - a % x ** 2 ) * a % dx ) end function elemental function ad_erfc ( a ) result ( c ) !! Negate the error-function derivative for the complementary error function. type ( real_ad ), intent ( in ) :: a type ( real_ad ) :: c c = erf ( a ) c % x = erfc ( a % x ) c % dx = - c % dx end function elemental function ad_min ( a , b ) result ( c ) !! Return the lower-valued operand with its derivative, choosing a on a tie. type ( real_ad ), intent ( in ) :: a , b type ( real_ad ) :: c if ( a % x <= b % x ) then c = a else c = b end if end function elemental function ad_min_real ( a , b ) result ( c ) !! Select the minimum of AD a and constant b; selecting b clears the derivative. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( real_ad ) :: c c = min ( a , real_ad ( b , 0.0d0 )) end function elemental function real_min_ad ( a , b ) result ( c ) !! Select the minimum of constant a and AD b; selecting a clears the derivative. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = min ( real_ad ( a , 0.0d0 ), b ) end function elemental function ad_max ( a , b ) result ( c ) !! Return the higher-valued operand with its derivative, choosing a on a tie. type ( real_ad ), intent ( in ) :: a , b type ( real_ad ) :: c if ( a % x >= b % x ) then c = a else c = b end if end function elemental function ad_max_real ( a , b ) result ( c ) !! Select the maximum of AD a and constant b; selecting b clears the derivative. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( real_ad ) :: c c = max ( a , real_ad ( b , 0.0d0 )) end function elemental function real_max_ad ( a , b ) result ( c ) !! Select the maximum of constant a and AD b; selecting a clears the derivative. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = max ( real_ad ( a , 0.0d0 ), b ) end function elemental function ad_sign ( a , b ) result ( c ) !! Propagate sign(1,b)*d(abs(a)), treating the sign selection as constant. type ( real_ad ), intent ( in ) :: a , b type ( real_ad ) :: c c = abs ( a ) c % x = sign ( a % x , b % x ) c % dx = sign ( 1.0d0 , b % x ) * c % dx end function elemental function ad_sign_real ( a , b ) result ( c ) !! Apply a constant sign to AD a and its absolute-value derivative. type ( real_ad ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( real_ad ) :: c c = sign ( a , real_ad ( b , 0.0d0 )) end function elemental function real_sign_ad ( a , b ) result ( c ) !! Apply AD b's sign to a constant magnitude, returning derivative zero. real ( real64 ), intent ( in ) :: a type ( real_ad ), intent ( in ) :: b type ( real_ad ) :: c c = real_ad ( sign ( a , b % x ), 0.0d0 ) end function end module","tags":"","url":"sourcefile\\diffeq_auto_diff.f90.html"},{"title":"diffeq_container_io.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_container_io use iso_fortran_env use diffeq_containers use diffeq_errors , only : DIFFEQ_INVALID_INPUT_ERROR , DIFFEQ_INVALID_OPERATION_ERROR implicit none private public :: write_ode_results contains ! ------------------------------------------------------------------------------ subroutine write_ode_results ( fname , rst , delimiter ) !! Writes the contents of a [[ode_results]] container to a delimited text !! file, replacing any existing file.  Each row contains the independent !! variable followed by the state variables, without a header.  An !! initialized empty container produces an empty file.  Invalid delimiters !! cause DIFFEQ_INVALID_INPUT_ERROR; uninitialized containers and file I/O !! failures cause DIFFEQ_INVALID_OPERATION_ERROR. character ( len = * ), intent ( in ) :: fname !! The name of the file to write. class ( ode_results ), intent ( in ) :: rst !! The [[ode_results]] container to write. character , intent ( in ), optional :: delimiter !! The field delimiter.  The default is a comma.  The delimiter !! must not be a double quote, carriage return, or line feed. ! Local Variables character :: delim character ( len = 512 ) :: message integer :: unit , flag , close_flag , index , column real ( real64 ), allocatable , dimension (:) :: row ! Initialization delim = \",\" if ( present ( delimiter )) delim = delimiter if ( delim == '\"' . or . delim == achar ( 13 ) . or . delim == achar ( 10 )) & error stop DIFFEQ_INVALID_INPUT_ERROR if ( rst % get_capacity () == 0 ) error stop DIFFEQ_INVALID_OPERATION_ERROR allocate ( row ( rst % state_variable_count () + 1 )) open ( newunit = unit , file = fname , status = \"replace\" , action = \"write\" , & form = \"formatted\" , decimal = \"point\" , round = \"nearest\" , & iostat = flag , iomsg = message ) if ( flag /= 0 ) then write ( error_unit , \"(A)\" ) trim ( message ) error stop DIFFEQ_INVALID_OPERATION_ERROR end if do index = 1 , rst % count () row ( 1 ) = rst % solution_point ( index ) row ( 2 :) = rst % selected_state ( index ) write ( unit , \"(ES24.16E3,*(A,ES24.16E3))\" , iostat = flag , iomsg = message ) & row ( 1 ), ( delim , row ( column ), column = 2 , size ( row )) if ( flag /= 0 ) then close ( unit , iostat = close_flag ) write ( error_unit , \"(A)\" ) trim ( message ) error stop DIFFEQ_INVALID_OPERATION_ERROR end if end do close ( unit , iostat = flag , iomsg = message ) if ( flag /= 0 ) then write ( error_unit , \"(A)\" ) trim ( message ) error stop DIFFEQ_INVALID_OPERATION_ERROR end if end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_container_io.f90.html"},{"title":"diffeq_c_containers.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_c_containers use iso_c_binding use diffeq_containers use diffeq_container_io use diffeq_c_errors use diffeq_c_helpers use diffeq_base implicit none private public :: assignment ( = ) public :: c_ode_results_statistics public :: c_create_ode_results public :: c_free_ode_results public :: c_get_ode_results_statistics public :: c_get_ode_results_size public :: c_get_ode_results public :: c_write_ode_results public :: c_ode_event_statistics public :: c_ode_event_solver_settings public :: c_default_ode_event_solver_settings interface assignment ( = ) module procedure :: c_ode_results_stats_assign module procedure :: ode_results_stats_to_c_assign module procedure :: c_ode_event_stats_assign module procedure :: ode_event_stats_to_c_assign end interface type , bind ( C ) :: c_ode_results_statistics !! A container of performance statistics for an !! integrator. integer ( c_int ) :: successful_steps = 0 !! The number of successful steps taken by the integrator. integer ( c_int ) :: failed_steps = 0 !! The number of unsuccessful steps taken by the integrator. integer ( c_int ) :: jacobian_evaluations = 0 !! The number of Jacobian matrix evaluations. integer ( c_int ) :: function_evaluations = 0 !! The number of function evaluations. integer ( c_int ) :: matrix_factorizations = 0 !! The number of matrix factorizations. end type type , bind ( C ) :: c_ode_event_statistics !! An ODE event solver statistics container. integer ( c_int ) :: iteration_count = 0 !! The number of iterations taken by the solver. integer ( c_int ) :: function_evaluations = 0 !! The number of event function evaluations. integer ( c_int ) :: event_index = - 1 !! The zero-based index of the event equation where an event was !! located.  If no event was found, this value is set to -1. end type type , bind ( C ) :: c_ode_event_solver_settings !! A container for ODE event solver settings. integer ( c_int ) :: max_allowed_iterations = 1000 !! The maximum number of allowed iterations. real ( c_double ) :: tolerance = 1.0d-12 !! The iteration convergence tolerance. end type contains ! ------------------------------------------------------------------------------ subroutine c_ode_results_stats_assign ( lhs , rhs ) type ( c_ode_results_statistics ), intent ( out ) :: lhs type ( ode_results_statistics ) :: rhs lhs % successful_steps = int ( rhs % successful_steps , c_int ) lhs % failed_steps = int ( rhs % failed_steps , c_int ) lhs % jacobian_evaluations = int ( rhs % jacobian_evaluations , c_int ) lhs % function_evaluations = int ( rhs % function_evaluations , c_int ) lhs % matrix_factorizations = int ( rhs % matrix_factorizations , c_int ) end subroutine ! ------------------------------------------------------------------------------ subroutine ode_results_stats_to_c_assign ( lhs , rhs ) type ( ode_results_statistics ), intent ( out ) :: lhs type ( c_ode_results_statistics ), intent ( in ) :: rhs lhs % successful_steps = rhs % successful_steps lhs % failed_steps = rhs % failed_steps lhs % jacobian_evaluations = rhs % jacobian_evaluations lhs % function_evaluations = rhs % function_evaluations lhs % matrix_factorizations = rhs % matrix_factorizations end subroutine ! ------------------------------------------------------------------------------ subroutine c_create_ode_results ( c_obj , src ) !! Constructs a new [[ode_results]] pointer and returns its address to !! the supplied C pointer.  Be sure to call c_free_ode_results once !! finished with this object. type ( c_ptr ), intent ( out ) :: c_obj !! A pointer to the newly created [[ode_results]] object. type ( ode_results ), intent ( in ) :: src !! The source [[ode_results]] object. type ( ode_results ), pointer :: obj allocate ( obj , source = src ) c_obj = c_loc ( obj ) end subroutine ! ------------------------------------------------------------------------------ subroutine c_free_ode_results ( c_obj ) bind ( C , name = \"c_free_ode_results\" ) !! Frees memory allocated by c_create_ode_results. type ( c_ptr ), value , intent ( in ) :: c_obj !! A pointer to the [[ode_results]] object to free. type ( ode_results ), pointer :: obj if (. not . c_associated ( c_obj )) return call c_f_pointer ( c_obj , obj ) if ( associated ( obj )) deallocate ( obj ) end subroutine ! ------------------------------------------------------------------------------ function c_get_ode_results_statistics ( c_obj , stats ) result ( rst ) & bind ( C , name = \"c_get_ode_results_statistics\" ) !! Gets the integrator performance statistics from an [[ode_results]] !! object. type ( c_ptr ), value , intent ( in ) :: c_obj !! The pointer to the [[ode_results]] object. type ( c_ode_results_statistics ), intent ( out ) :: stats !! A [[c_ode_results_statistics]] container for the results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. type ( ode_results ), pointer :: obj rst = C_NO_ERROR if (. not . c_associated ( c_obj )) then rst = C_NULL_POINTER_ERROR return end if call c_f_pointer ( c_obj , obj ) stats = obj % statistics end function ! ------------------------------------------------------------------------------ function c_get_ode_results_size ( c_obj , rows , cols ) result ( rst ) & bind ( C , name = \"c_get_ode_results_size\" ) !! Gets the size of the matrix required to hold the integration results. type ( c_ptr ), value , intent ( in ) :: c_obj !! The pointer to the [[ode_results]] object. integer ( c_int ), intent ( out ) :: rows !! The number of rows in the matrix. integer ( c_int ), intent ( out ) :: cols !! The number of columns in the matrix. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. type ( ode_results ), pointer :: obj rst = C_NO_ERROR rows = 0 cols = 0 if (. not . c_associated ( c_obj )) then rst = C_NULL_POINTER_ERROR return end if call c_f_pointer ( c_obj , obj ) rows = obj % count () cols = obj % state_variable_count () + 1 end function ! ------------------------------------------------------------------------------ function c_get_ode_results ( c_obj , m , n , x , ldx ) result ( rst ) & bind ( C , name = \"c_get_ode_results\" ) !! Returns the contents of the [[ode_results]] object as a matrix. type ( c_ptr ), value , intent ( in ) :: c_obj !! The pointer to the [[ode_results]] object. integer ( c_int ), intent ( in ), value :: m !! The number of rows in x. integer ( c_int ), intent ( in ), value :: n !! The number of columns in x. real ( c_double ), intent ( out ) :: x ( ldx , n ) !! The matrix where the results are written.  The matrix is stored !! in column-major format with the first column containing the !! independent variable values at which the integrator returned !! a solution point.  The remaining columns each contain a state !! variable. integer ( c_int ), intent ( in ), value :: ldx !! The leading dimension of matrix x.  This value must be at least !! m. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. type ( ode_results ), pointer :: obj rst = C_NO_ERROR if (. not . c_associated ( c_obj )) then rst = C_NULL_POINTER_ERROR return end if call c_f_pointer ( c_obj , obj ) if ( m /= obj % count ()) then rst = C_MATRIX_ROW_SIZE_ERROR return end if if ( n /= obj % state_variable_count () + 1 ) then rst = C_MATRIX_COLUMN_SIZE_ERROR return end if if ( ldx < m ) then rst = C_MATRIX_STRIDE_ERROR return end if x ( 1 : m , 1 : n ) = obj % to_matrix () end function ! ------------------------------------------------------------------------------ function c_write_ode_results ( fname , c_obj , delimiter ) result ( rst ) & bind ( C , name = \"c_write_ode_results\" ) !! Writes the contents of an [[ode_results]] container to a !! delimited text file. character ( kind = c_char ), intent ( in ) :: fname ( * ) !! The filename. type ( c_ptr ), value , intent ( in ) :: c_obj !! The pointer to the [[ode_results]] object. character ( kind = c_char ), intent ( in ), value :: delimiter !! The delimiter character. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. type ( ode_results ), pointer :: obj character ( len = :), allocatable :: filename rst = C_NO_ERROR if (. not . c_associated ( c_obj )) then rst = C_NULL_POINTER_ERROR return end if call c_f_pointer ( c_obj , obj ) filename = c_to_f_string ( fname ) call write_ode_results ( filename , obj , delimiter = delimiter ) end function ! ------------------------------------------------------------------------------ subroutine c_ode_event_stats_assign ( lhs , rhs ) type ( c_ode_event_statistics ), intent ( out ) :: lhs type ( ode_event_statistics ), intent ( in ) :: rhs lhs % iteration_count = int ( rhs % iteration_count , c_int ) lhs % function_evaluations = int ( rhs % function_evaluations ) lhs % event_index = int ( rhs % event_index - 1 , c_int ) ! -1 for zero-based indexing end subroutine ! ------------------------------------------------------------------------------ subroutine ode_event_stats_to_c_assign ( lhs , rhs ) type ( ode_event_statistics ), intent ( out ) :: lhs type ( c_ode_event_statistics ), intent ( in ) :: rhs lhs % iteration_count = rhs % iteration_count lhs % function_evaluations = rhs % function_evaluations lhs % event_index = rhs % event_index + 1 end subroutine ! ------------------------------------------------------------------------------ subroutine c_default_ode_event_solver_settings ( settings ) & bind ( C , name = \"c_default_ode_event_solver_settings\" ) !! Populates a [[c_ode_event_solver_settings]] object with default !! values. type ( c_ode_event_solver_settings ), intent ( out ) :: settings !! The [[c_ode_event_solver_settings]] object. settings % max_allowed_iterations = 1000 settings % tolerance = 1.0d-12 end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_c_containers.f90.html"},{"title":"diffeq_rk853_constants.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_rk853_constants use iso_fortran_env implicit none real ( real64 ), parameter :: a21 = 5.26001519587677318785587544488d-2 real ( real64 ), parameter :: a31 = 1.97250569845378994544595329183d-2 real ( real64 ), parameter :: a32 = 5.91751709536136983633785987549d-2 real ( real64 ), parameter :: a41 = 2.95875854768068491816892993775d-2 real ( real64 ), parameter :: a43 = 8.87627564304205475450678981324d-2 real ( real64 ), parameter :: a51 = 2.41365134159266685502369798665d-1 real ( real64 ), parameter :: a53 = - 8.84549479328286085344864962717d-1 real ( real64 ), parameter :: a54 = 9.24834003261792003115737966543d-1 real ( real64 ), parameter :: a61 = 3.7037037037037037037037037037d-2 real ( real64 ), parameter :: a64 = 1.70828608729473871279604482173d-1 real ( real64 ), parameter :: a65 = 1.25467687566822425016691814123d-1 real ( real64 ), parameter :: a71 = 3.7109375d-2 real ( real64 ), parameter :: a74 = 1.70252211019544039314978060272d-1 real ( real64 ), parameter :: a75 = 6.02165389804559606850219397283d-2 real ( real64 ), parameter :: a76 = - 1.7578125d-2 real ( real64 ), parameter :: a81 = 3.70920001185047927108779319836d-2 real ( real64 ), parameter :: a84 = 1.70383925712239993810214054705d-1 real ( real64 ), parameter :: a85 = 1.07262030446373284651809199168d-1 real ( real64 ), parameter :: a86 = - 1.53194377486244017527936158236d-2 real ( real64 ), parameter :: a87 = 8.27378916381402288758473766002d-3 real ( real64 ), parameter :: a91 = 6.24110958716075717114429577812d-1 real ( real64 ), parameter :: a94 = - 3.36089262944694129406857109825d0 real ( real64 ), parameter :: a95 = - 8.68219346841726006818189891453d-1 real ( real64 ), parameter :: a96 = 2.75920996994467083049415600797d1 real ( real64 ), parameter :: a97 = 2.01540675504778934086186788979d1 real ( real64 ), parameter :: a98 =