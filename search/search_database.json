real ( real64 ), parameter :: d410 = - 0.87139158377797299206789907490d0 real ( real64 ), parameter :: d411 = 0.22404374302607882758541771650d1 real ( real64 ), parameter :: d412 = 0.63157877876946881815570249290d0 real ( real64 ), parameter :: d413 = - 0.88990336451333310820698117400d-1 real ( real64 ), parameter :: d414 = 0.18148505520854727256656404962d2 real ( real64 ), parameter :: d415 = - 0.91946323924783554000451984436d1 real ( real64 ), parameter :: d416 = - 0.44360363875948939664310572000d1 real ( real64 ), parameter :: d51 = 0.10427508642579134603413151009d2 real ( real64 ), parameter :: d56 = 0.24228349177525818288430175319d3 real ( real64 ), parameter :: d57 = 0.16520045171727028198505394887d3 real ( real64 ), parameter :: d58 = - 0.37454675472269020279518312152d3 real ( real64 ), parameter :: d59 = - 0.22113666853125306036270938578d2 real ( real64 ), parameter :: d510 = 0.77334326684722638389603898808d1 real ( real64 ), parameter :: d511 = - 0.30674084731089398182061213626d2 real ( real64 ), parameter :: d512 = - 0.93321305264302278729567221706d1 real ( real64 ), parameter :: d513 = 0.15697238121770843886131091075d2 real ( real64 ), parameter :: d514 = - 0.31139403219565177677282850411d2 real ( real64 ), parameter :: d515 = - 0.93529243588444783865713862664d1 real ( real64 ), parameter :: d516 = 0.35816841486394083752465898540d2 real ( real64 ), parameter :: d61 = 0.19985053242002433820987653617d2 real ( real64 ), parameter :: d66 = - 0.38703730874935176555105901742d3 real ( real64 ), parameter :: d67 = - 0.18917813819516756882830838328d3 real ( real64 ), parameter :: d68 = 0.52780815920542364900561016686d3 real ( real64 ), parameter :: d69 = - 0.11573902539959630126141871134d2 real ( real64 ), parameter :: d610 = 0.68812326946963000169666922661d1 real ( real64 ), parameter :: d611 = - 0.10006050966910838403183860980d1 real ( real64 ), parameter :: d612 = 0.77771377980534432092869265740d0 real ( real64 ), parameter :: d613 = - 0.27782057523535084065932004339d1 real ( real64 ), parameter :: d614 = - 0.60196695231264120758267380846d2 real ( real64 ), parameter :: d615 = 0.84320405506677161018159903784d2 real ( real64 ), parameter :: d616 = 0.11992291136182789328035130030d2 real ( real64 ), parameter :: d71 = - 0.25693933462703749003312586129d2 real ( real64 ), parameter :: d76 = - 0.15418974869023643374053993627d3 real ( real64 ), parameter :: d77 = - 0.23152937917604549567536039109d3 real ( real64 ), parameter :: d78 = 0.35763911791061412378285349910d3 real ( real64 ), parameter :: d79 = 0.93405324183624310003907691704d2 real ( real64 ), parameter :: d710 = - 0.37458323136451633156875139351d2 real ( real64 ), parameter :: d711 = 0.10409964950896230045147246184d3 real ( real64 ), parameter :: d712 = 0.29840293426660503123344363579d2 real ( real64 ), parameter :: d713 = - 0.43533456590011143754432175058d2 real ( real64 ), parameter :: d714 = 0.96324553959188282948394950600d2 real ( real64 ), parameter :: d715 = - 0.39177261675615439165231486172d2 real ( real64 ), parameter :: d716 = - 0.14972683625798562581422125276d3 end module","tags":"","url":"sourcefile\\diffeq_rk853_constants.f90.html"},{"title":"diffeq_tsitouras.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_tsitouras use iso_fortran_env use diffeq_base use diffeq_singlestep use diffeq_errors implicit none private public :: tsitouras_54 type , extends ( single_step_integrator ) :: tsitouras_54 !! The Tsitouras fifth-order Runge--Kutta method with an embedded !! fourth-order estimator. !! !! The seven-stage FSAL tableau is designed for efficient adaptive !! integration of non-stiff systems. contains procedure , public :: pre_step_action => tsit_pre_step !! Performs any pre-step actions. procedure , public :: get_order => tsit_get_order !! Gets the order of the integrator. procedure , public :: get_is_fsal => tsit_get_is_fsal !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. procedure , public :: get_stage_count => tsit_get_stage_count !! Gets the stage count for this integrator. procedure , public :: attempt_step => tsit_attempt_step !! Attempts an integration step for this integrator. procedure , public :: post_step_action => tsit_post_step !! Performs any post-step actions. procedure , public :: interpolate => tsit_interpolate !! Performs the interpolation. end type contains ! ------------------------------------------------------------------------------ subroutine tsit_pre_step ( this , prevs , sys , h , x , y , f , args ) !! Placeholder routine for any pre-step actions. class ( tsitouras_54 ), intent ( inout ) :: this !! The tsitouras_54 object. logical , intent ( in ) :: prevs !! Defines the status of the previous step.  The value is true !! if the previous step was successful; else, false if the !! previous step failed. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Process return end subroutine ! ------------------------------------------------------------------------------ pure function tsit_get_order ( this ) result ( rst ) !! Gets the order of the integrator. class ( tsitouras_54 ), intent ( in ) :: this !! The tsitouras_54 object. integer :: rst !! The order. rst = 5 end function ! ------------------------------------------------------------------------------ pure function tsit_get_is_fsal ( this ) result ( rst ) !! Gets a logical parameter stating if this is a first-same-as-last !! (FSAL) integrator. class ( tsitouras_54 ), intent ( in ) :: this !! The tsitouras_54 object. logical :: rst !! True for a FSAL integrator; else, false. rst = . true . end function ! ------------------------------------------------------------------------------ pure function tsit_get_stage_count ( this ) result ( rst ) !! Gets the stage count for this integrator. class ( tsitouras_54 ), intent ( in ) :: this !! The tsitouras_54 object. integer :: rst !! The stage count. rst = 7 end function ! ------------------------------------------------------------------------------ subroutine tsit_attempt_step ( this , sys , h , x , y , f , yn , fn , yerr , k , args ) use diffeq_tsit45_constants !! Attempts an integration step for this integrator. !! !! The final stage is evaluated at the endpoint and is reused as the first !! stage of the next accepted step.  The fifth-order solution is paired !! with an embedded fourth-order solution; their difference supplies the !! local error estimate. class ( tsitouras_54 ), intent ( inout ) :: this !! The tsitouras_54 object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the current solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next !! solution estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: yerr !! An N-element array where this routine will write an estimate !! of the error in each equation. real ( real64 ), intent ( out ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Parameters integer , parameter :: nstages = 7 ! Local Variables integer :: i , j real ( real64 ) :: stage ( size ( y )) ! Process ! k1 = f as the derivatives were computed from the previous step k (:, 1 ) = f ! Compute the remaining stages do i = 2 , nstages stage = y do j = 1 , i - 1 stage = stage + h * tsit_a ( i , j ) * k (:, j ) end do call sys % compute_rhs ( x + tsit_c ( i ) * h , stage , k (:, i ), args ) call this % log_function_evaluation () end do ! Form the solution estimate and the error estimate yn = y yerr = 0.0d0 do i = 1 , nstages yn = yn + h * tsit_b ( i ) * k (:, i ) yerr = yerr + h * tsit_e ( i ) * k (:, i ) end do ! The FSAL stage supplies the derivatives at the end of the step call sys % compute_rhs ( x + h , yn , fn , args ) call this % log_function_evaluation () end subroutine ! ------------------------------------------------------------------------------ subroutine tsit_post_step ( this , sys , dense , x , xn , y , yn , f , fn , k , args ) !! Placeholder routine for any post-step actions. !! !! The interpolation for this integrator requires only the solution and !! derivative values at each end of the step, so no additional storage is !! required here. class ( tsitouras_54 ), intent ( inout ) :: this !! The tsitouras_54 object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. logical , intent ( in ) :: dense !! Determines if dense output is requested (true); else, false. real ( real64 ), intent ( in ) :: x !! The previous value of the independent variable. real ( real64 ), intent ( in ) :: xn !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the derivatives at x. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( inout ), dimension (:,:) :: k !! An N-by-NSTAGES matrix containing the derivatives at each stage. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Process return end subroutine ! ------------------------------------------------------------------------------ subroutine tsit_interpolate ( this , x , xn , yn , fn , xn1 , yn1 , fn1 , y ) !! Performs the interpolation. !! !! A cubic Hermite polynomial is constructed from the solution and !! derivative values at each end of the step. class ( tsitouras_54 ), intent ( in ) :: this !! The tsitouras_54 object. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at which to compute !! the interpolation. real ( real64 ), intent ( in ) :: xn !! The previous value of the independent variable at which the !! solution is computed. real ( real64 ), intent ( in ), dimension (:) :: yn !! An N-element array containing the solution at xn. real ( real64 ), intent ( in ), dimension (:) :: fn !! An N-element array containing the derivatives at xn. real ( real64 ), intent ( in ) :: xn1 !! The value of the independent variable at xn + h. real ( real64 ), intent ( in ), dimension (:) :: yn1 !! An N-element array containing the solution at xn + h. real ( real64 ), intent ( in ), dimension (:) :: fn1 !! An N-element array containing the derivatives at xn + h. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where this routine will write the !! solution values interpolated at x. ! Local Variables real ( real64 ) :: h , s ! Initialization h = xn1 - xn s = ( x - xn ) / h ! Process y = ( 2.0d0 * s ** 3 - 3.0d0 * s ** 2 + 1.0d0 ) * yn + & ( s ** 3 - 2.0d0 * s ** 2 + s ) * h * fn + & ( - 2.0d0 * s ** 3 + 3.0d0 * s ** 2 ) * yn1 + & ( s ** 3 - s ** 2 ) * h * fn1 end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_tsitouras.f90.html"},{"title":"diffeq_multistep.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_multistep !! Provides the base structure for implicit, variable step-size, variable !! order, multi-step integrators. !! !! A multi-step method advances a system written as !!  !! M(x,y) y' = f(x,y) !!  !! by relating the solution at x_{n+1} to several previously accepted !! solution points rather than to intermediate stage values.  The routines !! collected here supply the machinery common to such methods: storage and !! management of the solution history, Newton iteration on the implicit !! corrector equation, polynomial interpolation of the history for both !! prediction and dense output, and the adaptive step-size and order !! controller. !! !! A concrete integrator supplies only the method-specific pieces by !! implementing predictor, correct, get_maximum_supported_order, !! get_error_constant, and get_truncation_constant.  Methods whose !! corrector equation is solved by Newton iteration should extend !! newton_multistep_integrator, which supplies that corrector. use iso_fortran_env use diffeq_base use diffeq_errors use linalg , only : solve_least_squares_full implicit none private public :: multistep_integrator public :: newton_multistep_integrator public :: build_linearized_system public :: predictor_step public :: multistep_corrector public :: multistep_integer_inquiry public :: multistep_error_constant public :: newton_divided_differences public :: evaluate_newton_polynomial real ( real64 ), parameter :: min_error = 1.0d-10 ! A floor applied to scaled error norms so that step size ratios remain ! finite when a step is essentially exact. type , extends ( ode_integrator ), abstract :: multistep_integrator !! Defines the structure of a multi-step integrator. integer , private :: m_maxOrder = 0 ! The user-requested upper limit on the order of the method.  A ! value below one deprives the request of meaning and is taken to ! mean that the limit of the method itself should govern. integer , private :: m_order = 1 ! The order currently in use. integer , private :: m_stepsAtOrder = 0 ! The number of consecutive successful steps taken at m_order. integer , private :: m_nHist = 0 ! The number of solution points currently stored in the history. real ( real64 ), private , allocatable , dimension (:) :: m_xHist ! Independent variable history, most recent value first. real ( real64 ), private , allocatable , dimension (:,:) :: m_yHist ! Solution history, most recent value in column one. real ( real64 ), private , allocatable , dimension (:,:) :: m_fHist ! Derivative history, most recent value in column one. real ( real64 ), private , allocatable , dimension (:) :: m_denseNodes real ( real64 ), private , allocatable , dimension (:,:) :: m_denseDifferences contains procedure , public :: compute_dense_output => mi_dense_output procedure , private :: cache_dense_output => mi_cache_dense procedure ( predictor_step ), public , pass , deferred :: predictor !! Evaluates the predictor. procedure ( multistep_corrector ), public , pass , deferred :: correct !! Refines the prediction by applying the implicit formula. procedure ( multistep_integer_inquiry ), public , pass , deferred :: & get_maximum_supported_order !! Gets the highest order the method is permitted to use. procedure ( multistep_error_constant ), public , pass , deferred :: & get_error_constant !! Gets the error constant for the requested order. procedure ( multistep_error_constant ), public , pass , deferred :: & get_truncation_constant !! Gets the truncation error constant for the requested order. procedure , public :: evaluate_derivative => mi_evaluate_derivative !! Evaluates the derivative stored in the solution history. procedure , public :: prepare_for_solve => mi_prepare_for_solve !! Prepares internal state for the beginning of an integration. procedure , public :: get_order => mi_get_order !! Gets the order currently in use. procedure , public :: get_maximum_order => mi_get_max_order !! Gets the upper limit on the order of the method. procedure , public :: set_maximum_order => mi_set_max_order !! Sets the upper limit on the order of the method. procedure , public :: get_stored_step_count => mi_get_stored_count !! Gets the number of solution points held in the history. procedure , public :: get_stored_variable => mi_get_stored_x !! Gets a stored independent variable value. procedure , public :: get_stored_solution => mi_get_stored_y !! Gets a stored solution vector. procedure , public :: get_stored_derivative => mi_get_stored_f !! Gets a stored derivative vector. procedure , public :: reset_history => mi_reset_history !! Clears the stored solution history. procedure , public :: interpolate => mi_interpolate !! Interpolates the solution history to the requested point. procedure , public :: solve => mi_ode_solver !! Solves the supplied system of ODE's. procedure , private :: initialize_history => mi_init_history !! Allocates storage for the solution history. procedure , private :: push_history => mi_push_history !! Stores a newly accepted solution point. procedure , private :: effective_max_order => mi_effective_max_order !! Gets the order limit honoring both user and method limits. procedure , private :: adjust_order_and_step => mi_adjust_order_step !! Selects the order and step size for the next step. end type type , extends ( multistep_integrator ), abstract :: newton_multistep_integrator !! Defines the structure of a multi-step integrator whose corrector !! equation is solved by Newton iteration. !! !! Solving the corrector by Newton iteration requires a Jacobian, but !! in return it places no restriction upon the stiffness of the problem !! and permits a singular mass matrix, as the mass matrix then appears !! only as a factor within the iteration matrix. integer , private :: m_newtonIterLimit = 12 ! The limit on the number of Newton iterations allowed. real ( real64 ), private :: m_newtonTolerance = 1.0d-8 ! The convergence tolerance on the Euclidean norm of the residual ! for the Newton iteration process. contains procedure ( build_linearized_system ), public , pass , deferred :: & build_linear_system !! Builds the linearized system for the implicit corrector. procedure , public :: correct => mi_newton_iteration !! Performs the Newton iteration process. procedure , public :: newton_iteration => mi_newton_iteration !! Performs the Newton iteration process. procedure , public :: get_newton_step_limit => mi_get_newton_step_limit !! Gets the maximum number of Newton iterations allowed. procedure , public :: set_newton_step_limit => mi_set_newton_step_limit !! Sets the maximum number of Newton iterations allowed. procedure , public :: get_newton_tolerance => mi_get_newton_tolerance !! Gets the Newton iteration convergence tolerance. procedure , public :: set_newton_tolerance => mi_set_newton_tolerance !! Sets the Newton iteration convergence tolerance. end type interface subroutine build_linearized_system ( this , sys , h , x , y , A , b , args ) !! Builds the linearized system used to compute the solution for the !! implicit step via Newton iteration.  This routine forms matrices !! A and b of the system A \\delta = b. use iso_fortran_env , only : real64 import newton_multistep_integrator import ode_container class ( newton_multistep_integrator ), intent ( inout ) :: this !! The newton_multistep_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! The current value(s) of the dependent variable(s). real ( real64 ), intent ( out ), dimension (:,:) :: A !! The N-by-N matrix A, where, for BDF methods at least, !! A = \\frac{\\alpha_o}{h_n} M - J. real ( real64 ), intent ( out ), dimension (:) :: b !! The N-element right-hand-side vector for the linear system. !! This vector is the negative of the corrector residual so !! that the Newton update is y \\leftarrow y + \\delta. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. end subroutine subroutine predictor_step ( this , sys , h , x , y , f , yn , fn , args ) !! Evaluates the predictor. !! !! Besides supplying the initial estimate for the Newton iteration, !! this routine is the natural place for a concrete integrator to !! compute any step-dependent quantities, such as method !! coefficients, that the corrector requires.  It is called exactly !! once per step attempt. use iso_fortran_env , only : real64 import multistep_integrator import ode_container class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! The current value(s) of the dependent variable(s). real ( real64 ), intent ( in ), dimension (:) :: f !! An N-element array containing the values of the derivatives !! at x.  For a system carrying a mass matrix these are the !! values of y' rather than of f. real ( real64 ), intent ( out ), dimension (:) :: yn !! An N-element array where this routine will write the next !! solution estimate at x + h. real ( real64 ), intent ( out ), dimension (:) :: fn !! An N-element array where this routine will write the next !! derivative estimate at x + h. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. end subroutine subroutine multistep_corrector ( this , sys , h , x , ypred , ynew , & converged , args ) !! Refines the prediction by applying the implicit formula. use iso_fortran_env , only : real64 import multistep_integrator import ode_container class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: ypred !! The N-element array containing the predicted values at x + h. real ( real64 ), intent ( out ), dimension (:) :: ynew !! The new estimate of the dependent variables. logical , intent ( out ) :: converged !! True if the corrector succeeded; else, false, in which case !! the step is retried on a shorter step size. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. end subroutine pure function multistep_integer_inquiry ( this ) result ( rst ) !! Returns an integer value from the multistep_integrator object. use iso_fortran_env , only : int32 import multistep_integrator class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer :: rst !! The requested value. end function pure function multistep_error_constant ( this , k ) result ( rst ) !! Returns the constant relating the difference between the !! corrected and predicted solutions to the local truncation error !! of the method at the requested order. use iso_fortran_env , only : int32 , real64 import multistep_integrator class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer , intent ( in ) :: k !! The order of interest. real ( real64 ) :: rst !! The error constant. end function end interface contains ! ------------------------------------------------------------------------------ pure function mi_get_newton_step_limit ( this ) result ( rst ) !! Gets the maximum number of Newton iterations allowed. class ( newton_multistep_integrator ), intent ( in ) :: this !! The newton_multistep_integrator object. integer :: rst !! The iteration limit. rst = this % m_newtonIterLimit end function ! -------------------- subroutine mi_set_newton_step_limit ( this , x ) !! Sets the maximum number of Newton iterations allowed. class ( newton_multistep_integrator ), intent ( inout ) :: this !! The newton_multistep_integrator object. integer , intent ( in ) :: x !! The iteration limit. this % m_newtonIterLimit = x end subroutine ! ------------------------------------------------------------------------------ pure function mi_get_newton_tolerance ( this ) result ( rst ) !! Gets the convergence tolerance on the Euclidean norm of the residual !! for the Newton iteration process. class ( newton_multistep_integrator ), intent ( in ) :: this !! The newton_multistep_integrator object. real ( real64 ) :: rst !! The convergence tolerance. rst = this % m_newtonTolerance end function ! -------------------- subroutine mi_set_newton_tolerance ( this , x ) !! Sets the convergence tolerance on the Euclidean norm of the residual !! for the Newton iteration process. class ( newton_multistep_integrator ), intent ( inout ) :: this !! The newton_multistep_integrator object. real ( real64 ), intent ( in ) :: x !! The convergence tolerance. this % m_newtonTolerance = x end subroutine ! ------------------------------------------------------------------------------ subroutine mi_newton_iteration ( this , sys , h , x , ypred , ynew , converged , args ) !! Performs the Newton iteration process. !! !! The iteration solves the implicit corrector equation supplied by !! build_linear_system.  That system is solved by means of a !! rank-revealing orthogonal factorization, so a singular mass matrix is !! tolerated provided the iteration matrix itself remains nonsingular, as !! is the case for an index-1 problem. class ( newton_multistep_integrator ), intent ( inout ) :: this !! The newton_multistep_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: h !! The current step size. real ( real64 ), intent ( in ) :: x !! The current value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: ypred !! The N-element array containing the predicted values at x + h. real ( real64 ), intent ( out ), dimension (:) :: ynew !! The new estimate of the dependent variables. logical , intent ( out ) :: converged !! True if the Newton iteration process converged; else, false. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information in and !! out of the differential equation subroutine. ! Local Variables integer :: i , n , nmax real ( real64 ) :: tol real ( real64 ), allocatable , dimension (:,:) :: A real ( real64 ), allocatable , dimension (:) :: b , delta ! Initialization converged = . false . n = size ( ypred ) allocate ( A ( n , n ), b ( n )) nmax = this % get_newton_step_limit () tol = this % get_newton_tolerance () ynew = ypred ! Input Check if ( size ( ynew ) /= n ) error stop DIFFEQ_ARRAY_SIZE_ERROR ! Process do i = 1 , nmax ! Create the system matrices call this % build_linear_system ( sys , h , x + h , ynew , A , b , args ) ! Solve the system delta = solve_least_squares_full ( A , b ) call this % log_matrix_factorization () ! Update the solution and test for convergence.  The tolerance is ! applied relative to the size of the solution so that the test ! behaves consistently across problems of differing scale. ynew = ynew + delta if ( norm2 ( delta ) <= tol * max ( 1.0d0 , norm2 ( ynew ))) then converged = . true . exit end if end do end subroutine ! ------------------------------------------------------------------------------ subroutine mi_evaluate_derivative ( this , sys , x , y , dydx , args ) !! Evaluates the derivative that the solution history stores. !! !! The default implementation simply evaluates the right-hand side, which !! is correct whenever the mass matrix is the identity.  An integrator that !! requires y' itself, rather than f, overrides this routine to !! resolve the mass matrix. class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ) :: x !! The value of the independent variable. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element array containing the solution at x. real ( real64 ), intent ( out ), dimension (:) :: dydx !! An N-element array where the derivative will be written. class ( * ), intent ( inout ), optional :: args !! An optional argument that can be used to pass information in and out !! of the differential equation subroutine. call sys % compute_rhs ( x , y , dydx , args ) call this % log_function_evaluation () end subroutine ! ------------------------------------------------------------------------------ subroutine mi_prepare_for_solve ( this ) !! Performs whatever preparation the integrator requires at the beginning !! of an integration. !! !! The default implementation does nothing.  An integrator that caches a !! matrix factorization between steps overrides this routine to discard it, !! so that reusing the object with a different model cannot pick up stale !! information. class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. end subroutine ! ------------------------------------------------------------------------------ pure function mi_get_order ( this ) result ( rst ) !! Gets the order of the integrator currently in use. !! !! A variable-order method changes this value as the integration proceeds, !! so it reports the order of the most recently attempted step. class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer :: rst !! The order. rst = this % m_order end function ! ------------------------------------------------------------------------------ pure function mi_get_max_order ( this ) result ( rst ) !! Gets the upper limit on the order of the method. !! !! The value reported is the limit actually in force, which is the lesser !! of any limit requested by the caller and the highest order the method !! supports. class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer :: rst !! The order limit. rst = this % effective_max_order () end function ! -------------------- subroutine mi_set_max_order ( this , x ) !! Sets the upper limit on the order of the method. !! !! The value is constrained to the range supported by the method. class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. integer , intent ( in ) :: x !! The order limit. if ( x < 1 ) error stop DIFFEQ_INVALID_INPUT_ERROR this % m_maxOrder = min ( x , this % get_maximum_supported_order ()) end subroutine ! -------------------- pure function mi_effective_max_order ( this ) result ( rst ) !! Gets the order limit honoring both the user-requested limit and the !! highest order the method itself supports. class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer :: rst !! The order limit. if ( this % m_maxOrder < 1 ) then rst = this % get_maximum_supported_order () else rst = min ( this % m_maxOrder , this % get_maximum_supported_order ()) end if rst = max ( 1 , rst ) end function ! ------------------------------------------------------------------------------ pure function mi_get_stored_count ( this ) result ( rst ) !! Gets the number of previously accepted solution points currently held in !! the history. class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer :: rst !! The number of stored points. rst = this % m_nHist end function ! -------------------- pure function mi_get_stored_x ( this , i ) result ( rst ) !! Gets a stored value of the independent variable, where an index of one !! denotes the most recently accepted point. class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer , intent ( in ) :: i !! The one-based index into the history. real ( real64 ) :: rst !! The stored value. rst = this % m_xHist ( i ) end function ! -------------------- pure function mi_get_stored_y ( this , i ) result ( rst ) !! Gets a stored solution vector, where an index of one denotes the most !! recently accepted point. class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer , intent ( in ) :: i !! The one-based index into the history. real ( real64 ), allocatable , dimension (:) :: rst !! The stored solution. rst = this % m_yHist (:, i ) end function ! -------------------- pure function mi_get_stored_f ( this , i ) result ( rst ) !! Gets a stored derivative vector, where an index of one denotes the most !! recently accepted point. class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. integer , intent ( in ) :: i !! The one-based index into the history. real ( real64 ), allocatable , dimension (:) :: rst !! The stored derivative. rst = this % m_fHist (:, i ) end function ! ------------------------------------------------------------------------------ subroutine mi_reset_history ( this ) !! Clears the stored solution history. !! !! The integrator restarts at first order the next time it is used. class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. call this % invalidate_dense_output () this % m_nHist = 0 this % m_order = 1 this % m_stepsAtOrder = 0 end subroutine ! -------------------- subroutine mi_init_history ( this , neqn ) !! Allocates storage for the solution history. class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. integer , intent ( in ) :: neqn !! The number of equations being integrated. ! Local Variables integer :: nmax ! Room is required for the highest usable order plus the additional points ! the order controller needs in order to test one order higher. nmax = this % effective_max_order () + 3 if ( allocated ( this % m_xHist )) then if ( size ( this % m_yHist , 1 ) == neqn . and . & size ( this % m_xHist ) == nmax ) return deallocate ( this % m_xHist ) deallocate ( this % m_yHist ) deallocate ( this % m_fHist ) end if allocate ( this % m_xHist ( nmax ), source = 0.0d0 ) allocate ( this % m_yHist ( neqn , nmax ), source = 0.0d0 ) allocate ( this % m_fHist ( neqn , nmax ), source = 0.0d0 ) end subroutine ! -------------------- subroutine mi_push_history ( this , x , y , f ) !! Stores a newly accepted solution point at the front of the history. class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. real ( real64 ), intent ( in ) :: x !! The independent variable value. real ( real64 ), intent ( in ), dimension (:) :: y !! The solution at x. real ( real64 ), intent ( in ), dimension (:) :: f !! The derivative at x. ! Local Variables integer :: i , nmax ! Process nmax = size ( this % m_xHist ) do i = min ( this % m_nHist , nmax - 1 ), 1 , - 1 this % m_xHist ( i + 1 ) = this % m_xHist ( i ) this % m_yHist (:, i + 1 ) = this % m_yHist (:, i ) this % m_fHist (:, i + 1 ) = this % m_fHist (:, i ) end do this % m_xHist ( 1 ) = x this % m_yHist (:, 1 ) = y this % m_fHist (:, 1 ) = f this % m_nHist = min ( this % m_nHist + 1 , nmax ) end subroutine ! ------------------------------------------------------------------------------ subroutine mi_interpolate ( this , x , y ) !! Interpolates the stored solution history to the requested value of the !! independent variable. !! !! The polynomial passing through the most recently accepted points is the !! same polynomial on which the method itself is based, so dense output !! carries the accuracy of the current order and costs no additional !! function evaluations. class ( multistep_integrator ), intent ( in ) :: this !! The multistep_integrator object. real ( real64 ), intent ( in ) :: x !! The value of the independent variable at which to compute the !! interpolation. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where the interpolated solution is written. ! Local Variables integer :: np real ( real64 ), allocatable , dimension (:,:) :: dd ! Input Checking if ( this % m_nHist < 1 ) error stop DIFFEQ_INVALID_OPERATION_ERROR if ( size ( y ) /= size ( this % m_yHist , 1 )) error stop DIFFEQ_ARRAY_SIZE_ERROR ! Process np = min ( this % m_order + 1 , this % m_nHist ) if ( np == 1 ) then y = this % m_yHist (:, 1 ) return end if allocate ( dd ( size ( y ), np )) call newton_divided_differences ( this % m_xHist ( 1 : np ), & this % m_yHist (:, 1 : np ), dd ) call evaluate_newton_polynomial ( this % m_xHist ( 1 : np ), dd , x , y ) end subroutine ! ------------------------------------------------------------------------------ subroutine mi_cache_dense ( this , x_start , x_end ) class ( multistep_integrator ), intent ( inout ) :: this real ( real64 ), intent ( in ) :: x_start , x_end integer :: np , n np = min ( this % m_order + 1 , this % m_nHist ) n = size ( this % m_yHist , 1 ) this % m_denseNodes = this % m_xHist ( 1 : np ) if ( allocated ( this % m_denseDifferences )) then if ( size ( this % m_denseDifferences , 1 ) /= n . or . & size ( this % m_denseDifferences , 2 ) /= np ) deallocate ( this % m_denseDifferences ) end if if (. not . allocated ( this % m_denseDifferences )) allocate ( this % m_denseDifferences ( n , np )) call newton_divided_differences ( this % m_denseNodes , & this % m_yHist (:, 1 : np ), this % m_denseDifferences ) call this % set_dense_interval ( x_start , x_end , n ) end subroutine subroutine mi_dense_output ( this , x , y ) class ( multistep_integrator ), intent ( in ) :: this real ( real64 ), intent ( in ) :: x real ( real64 ), intent ( out ) :: y (:) call evaluate_newton_polynomial ( this % m_denseNodes , this % m_denseDifferences , x , y ) end subroutine ! ------------------------------------------------------------------------------ pure subroutine newton_divided_differences ( x , y , d ) !! Computes the Newton divided-difference coefficients of the polynomial !! interpolating the supplied points. !! !! The resulting coefficients define !!  !! P(t) = d_1 + d_2 (t - x_1) + d_3 (t - x_1)(t - x_2) + \\cdots !!  !! Divided differences are symmetric in their arguments, so the nodes need !! not be sorted.  Storing them most-recent-first keeps the terms of the !! extrapolation in decreasing order of significance. real ( real64 ), intent ( in ), dimension (:) :: x !! An M-element array containing the interpolation nodes. real ( real64 ), intent ( in ), dimension (:,:) :: y !! An N-by-M matrix whose columns contain the values at each node. real ( real64 ), intent ( out ), dimension (:,:) :: d !! An N-by-M matrix where the coefficients will be written. ! Local Variables integer :: i , j , m ! Process m = size ( x ) d (:, 1 : m ) = y (:, 1 : m ) do j = 1 , m - 1 do i = m , j + 1 , - 1 d (:, i ) = ( d (:, i ) - d (:, i - 1 )) / ( x ( i ) - x ( i - j )) end do end do end subroutine ! -------------------- pure subroutine evaluate_newton_polynomial ( x , d , xi , y ) !! Evaluates a polynomial stored in Newton divided-difference form. real ( real64 ), intent ( in ), dimension (:) :: x !! An M-element array containing the interpolation nodes. real ( real64 ), intent ( in ), dimension (:,:) :: d !! An N-by-M matrix containing the divided-difference coefficients. real ( real64 ), intent ( in ) :: xi !! The value at which to evaluate the polynomial. real ( real64 ), intent ( out ), dimension (:) :: y !! An N-element array where the result will be written. ! Local Variables integer :: i , m ! Process m = size ( x ) y = d (:, m ) do i = m - 1 , 1 , - 1 y = d (:, i ) + ( xi - x ( i )) * y end do end subroutine ! ------------------------------------------------------------------------------ subroutine mi_adjust_order_step ( this , yprev , ynew , ek , h ) !! Selects the order and step size to use for the next step. !! !! The order is chosen by asking which of the neighboring orders would !! permit the largest step, and the step size then follows from the error !! estimate belonging to the order selected. class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. real ( real64 ), intent ( in ), dimension (:) :: yprev !! The solution at the beginning of the step just accepted. real ( real64 ), intent ( in ), dimension (:) :: ynew !! The solution at the end of the step just accepted. real ( real64 ), intent ( in ) :: ek !! The scaled error norm of the step just accepted. real ( real64 ), intent ( inout ) :: h !! On input, the step size just used.  On output, the step size to !! attempt next. ! Local Variables integer :: k , kmax , kbest , mmax , n real ( real64 ) :: ekc , ekm1 , ekp1 , r , rbest , safe real ( real64 ), allocatable , dimension (:) :: errv real ( real64 ), allocatable , dimension (:,:) :: dd ! Initialization n = size ( ynew ) k = this % m_order kmax = this % effective_max_order () safe = this % get_step_size_factor () ekc = ek ekm1 = - 1.0d0 ekp1 = - 1.0d0 ! Build the divided-difference table over the accepted history.  The table ! supplies the local error the method would have committed had a ! neighboring order been used, and that is what drives the order selection. ! Every candidate is measured the same way so that the comparison between ! them is not distorted by the differing constants of each order. mmax = min ( this % m_nHist , k + 3 ) if ( mmax >= 2 ) then allocate ( dd ( n , mmax )) call newton_divided_differences ( this % m_xHist ( 1 : mmax ), & this % m_yHist (:, 1 : mmax ), dd ) if ( mmax >= k + 2 ) then errv = this % get_truncation_constant ( k ) * & history_difference ( this % m_xHist , dd , k + 1 ) ekc = this % compute_error_norm ( yprev , ynew , errv ) end if if ( k > 1 . and . mmax >= k + 1 ) then errv = this % get_truncation_constant ( k - 1 ) * & history_difference ( this % m_xHist , dd , k ) ekm1 = this % compute_error_norm ( yprev , ynew , errv ) end if if ( k < kmax . and . mmax >= k + 3 ) then errv = this % get_truncation_constant ( k + 1 ) * & history_difference ( this % m_xHist , dd , k + 2 ) ekp1 = this % compute_error_norm ( yprev , ynew , errv ) end if end if ! Select whichever order permits the largest step kbest = k rbest = step_ratio ( ekc , k ) if ( ekm1 >= 0.0d0 ) then r = step_ratio ( ekm1 , k - 1 ) if ( r > rbest ) then rbest = r kbest = k - 1 end if end if ! An increase in order is considered only once the current order has proven ! itself, which keeps the method from chasing transients. if ( ekp1 >= 0.0d0 . and . this % m_stepsAtOrder >= k + 1 ) then r = step_ratio ( ekp1 , k + 1 ) if ( r > rbest ) then rbest = r kbest = k + 1 end if end if ! A formula of order k relates k + 1 points, and the predictor that ! accompanies it must extrapolate an equal number, so the order is held to ! one less than the number of points on hand. kbest = max ( 1 , min ( kbest , kmax , this % m_nHist - 1 )) if ( kbest == this % m_order ) then this % m_stepsAtOrder = this % m_stepsAtOrder + 1 else this % m_order = kbest this % m_stepsAtOrder = 0 end if ! Apply the step size ratio.  Modest changes are suppressed because the ! stability of a multi-step formula degrades when the spacing of the ! history it interpolates is disturbed without cause. r = safe * rbest if ( r < 1.0d0 ) then r = max ( r , 1.0d-1 ) else if ( r < 2.0d0 ) then r = 1.0d0 else r = min ( r , 1.0d1 ) end if h = r * h contains pure function step_ratio ( e , korder ) result ( rst ) !! Estimates the factor by which the step size could change were the !! given order used. real ( real64 ), intent ( in ) :: e integer , intent ( in ) :: korder real ( real64 ) :: rst rst = ( 1.0d0 / max ( e , min_error )) ** ( 1.0d0 / ( korder + 1.0d0 )) end function pure function history_difference ( xh , dtab , m ) result ( rst ) !! Forms the difference between the accepted solution and the value a !! degree m-1 extrapolation of the preceding points would have given. real ( real64 ), intent ( in ), dimension (:) :: xh real ( real64 ), intent ( in ), dimension (:,:) :: dtab integer , intent ( in ) :: m real ( real64 ), allocatable , dimension (:) :: rst integer :: i real ( real64 ) :: p p = 1.0d0 do i = 2 , m + 1 p = p * ( xh ( 1 ) - xh ( i )) end do rst = dtab (:, m + 1 ) * p end function end subroutine ! ------------------------------------------------------------------------------ subroutine mi_ode_solver ( this , sys , x , iv , store_iv , args ) !! Solves the supplied system of ODE's. !! !! The integration is driven by a predictor-corrector cycle.  Each step !! extrapolates the solution history to form a prediction, refines that !! prediction with Newton iteration on the implicit formula, and compares !! the two to estimate the local error.  A step whose error satisfies the !! requested tolerances is accepted and appended to the history; otherwise !! it is retried on a shorter step. class ( multistep_integrator ), intent ( inout ) :: this !! The multistep_integrator object. class ( ode_container ), intent ( inout ) :: sys !! The ode_container object containing the ODE's to integrate. real ( real64 ), intent ( in ), dimension (:) :: x !! An array of independent variable values at which to return the !! solution to the ODE's.  If only two values are supplied, the !! solution is returned at every successful integration step. real ( real64 ), intent ( in ), dimension (:) :: iv !! An array containing the initial values for each ODE. logical , intent ( in ), optional :: store_iv !! An optional input that determines whether or not the !! initial values are stored as part of the output.  The !! default is true such that the initial values are stored; !! however, set to false to avoid storing the initial values. !! This can be useful in cases of event detection where a !! restart of the integrator is desired. class ( * ), intent ( inout ), optional , target :: args !! An optional argument that can be used to pass information !! in and out of the differential equation subroutine. ! Local Variables logical :: dense , need_dense , converged , forward , find_events , & event_found integer :: i , j , n , neqn , nsteps , k , nfail , nevents real ( real64 ) :: h , xo , xn , xmax , e , minstep , xe real ( real64 ), allocatable , dimension (:) :: f , y , yn , fn , fnew , ypred , & yerr , yi , ye ! Initialization n = size ( x ) call this % invalidate_dense_output () nevents = sys % get_event_equation_count () find_events = sys % get_is_ode_event_function_defined () . and . nevents > 0 ! Input Checking if ( n < 2 ) error stop DIFFEQ_ARRAY_SIZE_ERROR if (. not . sys % get_is_ode_defined ()) error stop DIFFEQ_MISSING_ARGUMENT_ERROR ! Ensure interpolation is enabled if we're solving for events as well if ( find_events ) call this % set_dense_output_enabled (. true .) ! Additional Initialization neqn = size ( iv ) xo = x ( 1 ) xmax = x ( n ) forward = xmax >= xo j = 2 dense = ( n > 2 ) nsteps = this % get_step_limit () minstep = this % get_minimum_step_size () nfail = 0 ! Memory Allocations allocate ( & f ( neqn ), & y ( neqn ), & yn ( neqn ), & fn ( neqn ), & fnew ( neqn ), & ypred ( neqn ), & yerr ( neqn ), & yi ( neqn ) & ) if ( find_events ) allocate ( ye ( neqn )) ! The method restarts at first order.  A first-order formula needs no ! history beyond the initial condition, so no starting procedure and no ! consistent initial derivative are required. call this % reset_history () call this % prepare_for_solve () call this % initialize_history ( neqn ) y = iv ! Estimate an initial step size ! ! Outputs: ! - f: Value of the derivatives at xo ! - h: Initial step size estimate call this % estimate_inital_step_size ( sys , xo , xmax , iv , f , h , args ) ! Seed the history call this % evaluate_derivative ( sys , xo , y , f , args ) call this % push_history ( xo , y , f ) ! Store the initial conditions if ( present ( store_iv )) then if ( store_iv ) call this % append_to_buffer ( xo , y ) else call this % append_to_buffer ( xo , y ) end if ! Cycle until integration is complete do i = 1 , nsteps call this % invalidate_dense_output () ! The order can never exceed what the stored history will support this % m_order = max ( 1 , min ( this % m_order , this % m_nHist - 1 )) k = this % m_order ! Do not overshoot the end of the integration range if the solver has ! been asked to terminate on it exactly if (. not . this % get_allow_overshoot ()) then if (( xmax - x ( 1 )) * ( xo + h - xmax ) > 0.0d0 ) then h = xmax - xo end if end if ! Predict, then correct call this % predictor ( sys , h , xo , y , f , ypred , fn , args ) call this % correct ( sys , h , xo , ypred , yn , converged , args ) if (. not . converged ) then ! A failure of the corrector is a statement about the step size ! rather than about the accuracy of the result, so retry on a ! shorter step and fall back to the most robust order if failures ! persist. nfail = nfail + 1 this % m_stepsAtOrder = 0 h = 2.5d-1 * h if ( nfail >= 3 ) this % m_order = 1 if ( abs ( h ) < minstep ) error stop DIFFEQ_STEP_SIZE_TOO_SMALL_ERROR call this % log_failed_step () cycle end if ! The difference between the corrected and predicted solutions is ! proportional to the local truncation error of the formula yerr = this % get_error_constant ( k ) * ( yn - ypred ) e = this % compute_error_norm ( y , yn , yerr ) ! The negated test also rejects a step whose error is not a number, ! which is how a non-stiff corrector announces that it has diverged. if (. not .( e <= 1.0d0 )) then ! Reject the step and try again on a shorter one nfail = nfail + 1 this % m_stepsAtOrder = 0 if ( e <= huge ( e )) then h = h * max ( 1.0d-1 , min ( 5.0d-1 , this % get_step_size_factor () * & ( 1.0d0 / max ( e , min_error )) ** ( 1.0d0 / ( k + 1.0d0 )))) else h = 2.5d-1 * h end if if ( nfail >= 3 ) this % m_order = 1 if ( abs ( h ) < minstep ) error stop DIFFEQ_STEP_SIZE_TOO_SMALL_ERROR call this % log_failed_step () cycle end if ! The step was successful nfail = 0 xn = xo + h call this % evaluate_derivative ( sys , xn , yn , fnew , args ) call this % push_history ( xn , yn , fnew ) need_dense = dense . or . this % get_dense_output_enabled () . or . & (( xmax - x ( 1 )) * ( xn - xmax ) > 0.0d0 ) if ( need_dense ) call this % cache_dense_output ( xo , xn ) call this % log_successful_step () ! Detect events if ( find_events ) then event_found = this % event_solver % find_event ( sys % event_function , & this , nevents , xo , y , xn , yn , xe , ye , args = args ) if ( event_found ) then if ( dense ) then interp_event : do while ( j <= n . and . & (( forward . and . x ( j ) < xe ) . or . & (. not . forward . and . x ( j ) > xe ))) call this % evaluate_dense ( x ( j ), yi ) call this % append_to_buffer ( x ( j ), yi ) j = j + 1 end do interp_event end if call this % append_to_buffer ( xe , ye ) return end if end if ! Store the results if ( dense ) then ! Interpolate to each requested point falling within this step interp : do while ( j <= n . and . & (( forward . and . x ( j ) <= xn ) . or . & (. not . forward . and . x ( j ) >= xn ))) call this % evaluate_dense ( x ( j ), yi ) call this % append_to_buffer ( x ( j ), yi ) j = j + 1 if ( j > n ) exit interp end do interp else if (( xmax - x ( 1 )) * ( xn - xmax ) > 0.0d0 ) then ! The step carried past the end of the range, so report the ! solution interpolated back onto the requested end point if ( j <= n ) then call this % evaluate_dense ( xmax , yi ) call this % append_to_buffer ( xmax , yi ) end if else ! Report every successful step call this % append_to_buffer ( xn , yn ) end if ! Are we done? if (( xmax - x ( 1 )) * ( xn - xmax ) >= 0.0d0 ) return ! Choose the order and step size for the next step call this % adjust_order_and_step ( y , yn , e , h ) if ( abs ( h ) > this % get_maximum_step_size ()) then h = sign ( this % get_maximum_step_size (), h ) end if if ( abs ( h ) < minstep ) error stop DIFFEQ_STEP_SIZE_TOO_SMALL_ERROR ! Update for the next step xo = xn y = yn f = fnew end do ! If we're here, the solver has run out of allowable steps error stop DIFFEQ_ITERATION_COUNT_EXCEEDED_ERROR end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_multistep.f90.html"},{"title":"diffeq_tsit45_constants.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_tsit45_constants !! Coefficients for the Tsitouras 5/4 embedded Runge--Kutta method. use iso_fortran_env , only : real64 implicit none private public :: tsit_c , tsit_a , tsit_b , tsit_e real ( real64 ), parameter :: tsit_c ( 7 ) = [ & 0.0d0 , 0.161d0 , 0.327d0 , 0.9d0 , 0.980025540904509685729810680793d0 , & 1.0d0 , 1.0d0 & ] real ( real64 ), parameter :: tsit_a ( 7 , 7 ) = reshape ([ & 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , & 0.161d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , & - 0.008480655492356989d0 , 0.335480655492356989d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , & 2.8971530571054935d0 , - 6.359448489975075d0 , 4.3622954328695815d0 , 0.0d0 , 0.0d0 , 0.0d0 , 0.0d0 , & 5.325864828439257d0 , - 1 1.748883564062828d0 , 7.495539342889836d0 , - 0.09249506636175525d0 , 0.0d0 , 0.0d0 , 0.0d0 , & 5.861455442946420d0 , - 1 2.92096931784711d0 , 8.159367898576159d0 , - 0.071584973281401d0 , & - 0.02826905039406838d0 , 0.0d0 , 0.0d0 , & 0.09646076681806523d0 , 0.01d0 , 0.4798896504144996d0 , 1.379008574103742d0 , - 3.290069515436081d0 , 2.324710524099774d0 , 0.0d0 & ], [ 7 , 7 ], order = [ 2 , 1 ]) real ( real64 ), parameter :: tsit_b ( 7 ) = [ & 0.09646076681806523d0 , 0.01d0 , 0.4798896504144996d0 , 1.379008574103742d0 , & - 3.290069515436081d0 , 2.324710524099774d0 , 0.0d0 & ] real ( real64 ), parameter :: tsit_e ( 7 ) = [ & - 0.001780011052226d0 , - 0.0008164344596567469d0 , 0.007880878010261995d0 , & - 0.1447110071732629d0 , 0.5823571654525552d0 , - 0.45808210592918697d0 , & 0.0151515151515151515151515151515d0 & ] end module diffeq_tsit45_constants","tags":"","url":"sourcefile\\diffeq_tsit45_constants.f90.html"},{"title":"diffeq.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq use iso_fortran_env use diffeq_base use diffeq_multistep use diffeq_bdf use diffeq_pece use diffeq_rosenbrock use diffeq_kennedy_carpenter use diffeq_index_reduction use diffeq_containers use diffeq_container_io use diffeq_singlestep use diffeq_tsitouras use diffeq_rk45 use diffeq_rk23 use diffeq_rk853 use diffeq_auto_diff end module","tags":"","url":"sourcefile\\diffeq.f90.html"},{"title":"diffeq_index_reduction.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_index_reduction !! Stabilized index-1 Gear-Gupta-Leimkuhler-inspired (GGL) reduction !! for mechanical systems with autonomous holonomic constraints. !! !! For autonomous holonomic constraints g(q)=0, this variant uses !! coordinates q, velocities v, force multipliers \\lambda, !! and kinematic multipliers \\mu in the formulation !!  !! \\dot q = v + G(q)&#94;T\\mu, \\qquad !! M(q)\\dot v = F(x,q,v) - G(q)&#94;T\\lambda, !!  !!  !! 0 = G\\dot q + \\alpha g, \\qquad !! 0 = DG(q)[\\dot q]v + GM&#94;{-1}(F-G&#94;T\\lambda) + \\beta Gv, !!  !! where G=\\partial g/\\partial q. Thus \\dot g=-\\alpha g !! and d(Gv)/dx=-\\beta Gv. Consistent constraints remain zero !! in the exact solution; positive gains damp violations. Numerical !! integration and interpolation do not project onto the constraints. !! !! Unlike classical index-2 GGL, the original position and velocity !! constraints are replaced by their stabilized evolution equations. !! The algebraic multipliers are locally determined when GG&#94;T !! and GM&#94;{-1}G&#94;T are nonsingular. Independent constraints and a !! symmetric positive-definite mechanical mass matrix suffice. Explicitly !! moving constraints are not supported: the constraint callbacks must !! not depend on the independent variable. use iso_fortran_env use , intrinsic :: ieee_arithmetic , only : ieee_is_finite use diffeq_base use diffeq_errors use linalg , only : identity , lu_factor , solve_lu implicit none private public :: ggl_container public :: dae_algebraic_constraints public :: dae_constraint_curvature abstract interface subroutine dae_algebraic_constraints ( x , y , g , args ) !! Evaluates algebraic constraint residuals g(x,y). !! !! For N input state components and M constraints, !! the callback represents a mapping !!  !! g : \\mathbb{R}\\times\\mathbb{R}&#94;{N} !! \\longrightarrow \\mathbb{R}&#94;{M}. !!  !! A consistent state satisfies g(x,y)=0. Return the !! residuals themselves, not their derivatives, a Boolean result, !! or a projected state. A nonzero residual is a valid evaluation !! at an inconsistent state, rather than a callback failure. !! !! The caller supplies the input and output array sizes. The !! implementation must interpret the same state ordering as its !! model and write every output element. This interface performs !! no dimension, rank, or initial-consistency checks. Residual !! ordering and physical units are defined by the model; any !! subsequent consistency tolerance must respect that scaling. use iso_fortran_env , only : real64 real ( real64 ), intent ( in ) :: x !! The independent-variable value at which to evaluate the !! constraints, normally time. Autonomous constraints may !! ignore this argument. real ( real64 ), intent ( in ), dimension (:) :: y !! An N-element input state in the ordering defined by the !! model. No particular coordinate, velocity, or multiplier !! partition is imposed by this interface. It must not be !! modified by the callback. real ( real64 ), intent ( out ), dimension (:) :: g !! An M-element output array receiving the constraint !! residuals in the model's declared constraint order. !! Every element must be assigned on every call; incoming !! contents are undefined. Exact constraint satisfaction !! corresponds to a zero vector. class ( * ), intent ( inout ), optional :: args !! Optional user-owned model parameters or evaluation state. !! Check presence and dynamic type before accessing it. !! The callback may update this object, but repeated calls !! with the same inputs should give the same residuals unless !! the user intentionally changes model parameters. This !! argument is not reserved for index-reduction workspace. end subroutine subroutine dae_constraint_curvature ( x , q , direction , v , curvature , args ) !! Evaluates DG(q)[\\mathrm{direction}]v, without including !! G\\dot v. Each component is !! \\mathrm{direction}&#94;T\\nabla&#94;2 g_i(q)v. !! Assign every output element. For linear constraints return !! zeros. The callback must support off-manifold coordinates and !! arbitrary directions used during nonlinear/Jacobian evaluation. import real64 real ( real64 ), intent ( in ) :: x !! Independent-variable value, provided for callback uniformity; !! autonomous constraints must not depend on it. real ( real64 ), intent ( in ), dimension (:) :: q !! N coordinates, in the same order as the force model. real ( real64 ), intent ( in ), dimension (:) :: direction !! N components of the coordinate derivative \\dot q, !! including the kinematic multiplier correction. real ( real64 ), intent ( in ), dimension (:) :: v !! N physical velocity components; these need not equal direction. real ( real64 ), intent ( out ), dimension (:) :: curvature !! M curvature terms in the order of the constraint callback. class ( * ), intent ( inout ), optional :: args !! Optional user-owned parameters, forwarded unchanged. end subroutine end interface type , extends ( ode_container ) :: ggl_container !! Mechanical model adapter implementing stabilized index-1 GGL. !! !! Use this type instead of [[ode_container]] when reducing an index-3 !! holonomically constrained mechanical model. Call `initialize` and !! assign all required callbacks before using an index-1 DAE solver. !! For N coordinates and M constraints, the state and RHS layout is !!  !! z=[q_N,v_N,\\lambda_M,\\mu_M]&#94;T, \\quad !! \\mathcal M=\\operatorname{diag}(I_N,M_N,0_M,0_M), !!  !!  !! \\mathcal f=\\begin{bmatrix} !! v+G&#94;T\\mu \\\\ !! F-G&#94;T\\lambda \\\\ !! G(v+G&#94;T\\mu)+\\alpha g \\\\ !! DG(q)[\\dot q]v+GM&#94;{-1}(F-G&#94;T\\lambda)+\\beta Gv !! \\end{bmatrix}. !!  !! All constraint vectors use the same M-component ordering. !! !! The inherited `fcn` has a specialized contract here: its input is !! [q,v] of length 2N and its output is the applied force F of length N, !! excluding multiplier forces. The optional inherited `mass_matrix` !! receives q of length N and writes the physical N-by-N mass matrix; !! if absent, the physical matrix is identity. Set the inherited mass !! dependency flag true whenever this matrix varies with x or q. !! !! An optional inherited `jacobian` must differentiate the complete !! augmented RHS with respect to z, not just the applied force. Without !! it, the inherited finite-difference implementation differentiates !! this container's `compute_rhs`. User args are never used as internal !! workspace. Callbacks must accept perturbed, off-manifold states. !! The inherited fcn_ad is not supported: differentiating only the !! applied force would omit the real-valued constraint assembly. !! Assigning fcn_ad causes DIFFEQ_INVALID_OPERATION_ERROR. integer , private :: m_coordinates = 0 integer , private :: m_constraints = 0 real ( real64 ), private :: m_alpha = 1.0d0 real ( real64 ), private :: m_beta = 1.0d0 procedure ( dae_algebraic_constraints ), pointer , public , nopass :: constraints => null () !! Required callback receiving N coordinates q and writing M !! autonomous position residuals g(q), including off-manifold values. procedure ( ode_jacobian ), pointer , public , nopass :: constraint_jacobian => null () !! Required callback receiving q and writing the M-by-N matrix !! G=\\partial g/\\partial q. No finite-difference fallback is used. procedure ( dae_constraint_curvature ), pointer , public , nopass :: constraint_curvature => null () !! Required callback for DG(q)[\\dot q]v. contains procedure :: initialize => ggl_initialize procedure :: set_stabilization_parameters => ggl_set_stabilization procedure :: get_state_count => ggl_state_count procedure :: has_mass_matrix => ggl_has_mass procedure :: get_is_ode_defined => ggl_is_defined procedure :: compute_rhs => ggl_rhs procedure :: compute_mass_matrix => ggl_mass procedure :: validate_initial_conditions => ggl_validate procedure :: initialize_multipliers => ggl_initialize_multipliers procedure , private :: check_state => ggl_check_state procedure , private :: physical_mass => ggl_physical_mass end type interface ggl_container module procedure :: ggl_constructor_1 end interface contains ! ------------------------------------------------------------------------------ function ggl_constructor_1 ( coordinate_count , constraint_count , alpha , beta ) & result ( rst ) !! Defines the mechanical dimensions and resets stabilization gains to one !! unless supplied. Callback associations and inherited model options are !! retained. Invalid counts or gains cause DIFFEQ_INVALID_INPUT_ERROR. integer , intent ( in ) :: coordinate_count !! Positive number N of coordinates and physical velocities. integer , intent ( in ) :: constraint_count !! Number M of independent constraints, with 1 <= M <= N. real ( real64 ), intent ( in ), optional :: alpha , beta !! Nonnegative finite position and velocity decay rates, respectively, !! in inverse independent-variable units. Zero disables the respective !! damping term without disabling the differentiated constraint. type ( ggl_container ) :: rst !! The new [[ggl_container]] object. call rst % initialize ( coordinate_count , constraint_count , alpha = alpha , & beta = beta ) end function ! ------------------------------------------------------------------------------ subroutine ggl_initialize ( this , coordinate_count , constraint_count , alpha , beta ) !! Defines the mechanical dimensions and resets stabilization gains to one !! unless supplied. Callback associations and inherited model options are !! retained. Invalid counts or gains cause DIFFEQ_INVALID_INPUT_ERROR. class ( ggl_container ), intent ( inout ) :: this !! Container to configure. integer , intent ( in ) :: coordinate_count !! Positive number N of coordinates and physical velocities. integer , intent ( in ) :: constraint_count !! Number M of independent constraints, with 1 <= M <= N. real ( real64 ), intent ( in ), optional :: alpha , beta !! Nonnegative finite position and velocity decay rates, respectively, !! in inverse independent-variable units. Zero disables the respective !! damping term without disabling the differentiated constraint. real ( real64 ) :: position_rate , velocity_rate if ( coordinate_count < 1 . or . constraint_count < 1 . or . & constraint_count > coordinate_count ) error stop DIFFEQ_INVALID_INPUT_ERROR this % m_coordinates = coordinate_count this % m_constraints = constraint_count position_rate = 1.0d0 velocity_rate = 1.0d0 if ( present ( alpha )) position_rate = alpha if ( present ( beta )) velocity_rate = beta call this % set_stabilization_parameters ( position_rate , velocity_rate ) end subroutine ! ------------------------------------------------------------------------------ subroutine ggl_set_stabilization ( this , alpha , beta ) !! Sets the two independent constraint decay rates. Negative or nonfinite !! values cause DIFFEQ_INVALID_INPUT_ERROR. No state projection is performed. class ( ggl_container ), intent ( inout ) :: this !! Configured or unconfigured container whose gains are to be changed. real ( real64 ), intent ( in ) :: alpha , beta !! Position and velocity decay rates, respectively; both have units !! of inverse time when x is time. Zero preserves rather than damps !! the corresponding residual in the exact solution. if (. not . ieee_is_finite ( alpha ) . or . . not . ieee_is_finite ( beta )) & error stop DIFFEQ_INVALID_INPUT_ERROR if ( alpha < 0.0d0 . or . beta < 0.0d0 ) error stop DIFFEQ_INVALID_INPUT_ERROR this % m_alpha = alpha this % m_beta = beta end subroutine ! ------------------------------------------------------------------------------ function ggl_state_count ( this ) result ( rst ) !! Returns 2N+2M, or zero before dimensions have been initialized. class ( ggl_container ), intent ( in ) :: this !! Container whose augmented state size is queried. integer :: rst !! Required length of the state, initial conditions, and RHS arrays. rst = 2 * ( this % m_coordinates + this % m_constraints ) end function ! ------------------------------------------------------------------------------ function ggl_has_mass ( this ) result ( rst ) !! Always returns true: the augmented matrix is singular even when the !! physical matrix defaults to identity. Explicit ODE paths are unsuitable. class ( ggl_container ), intent ( in ) :: this !! Container being queried; initialization is not required. logical :: rst !! True, indicating that a mass-matrix DAE path is required. rst = . true . end function ! ------------------------------------------------------------------------------ function ggl_is_defined ( this ) result ( rst ) !! Checks configuration and all required callback associations. This does !! not evaluate callbacks or certify constraint rank or mass regularity. class ( ggl_container ), intent ( in ) :: this !! Container whose model definition is inspected. logical :: rst !! True only for initialized dimensions and associated force, position, !! constraint-Jacobian, and curvature callbacks. Mass is optional. if ( associated ( this % fcn_ad )) error stop DIFFEQ_INVALID_OPERATION_ERROR rst = this % m_coordinates > 0 . and . this % m_constraints > 0 . and . & associated ( this % fcn ) . and . associated ( this % constraints ) . and . & associated ( this % constraint_jacobian ) . and . associated ( this % constraint_curvature ) end function ! ------------------------------------------------------------------------------ subroutine ggl_check_state ( this , y ) !! Checks dimensions and finite state values without invoking callbacks. !! Uninitialized dimensions/nonfinite values cause INVALID_INPUT; a wrong !! array length causes DIFFEQ_ARRAY_SIZE_ERROR. class ( ggl_container ), intent ( in ) :: this !! Container defining the required state dimensions. real ( real64 ), intent ( in ), dimension (:) :: y !! Augmented state [q,v,lambda,mu] of length 2N+2M. if ( this % m_coordinates < 1 . or . this % m_constraints < 1 ) & error stop DIFFEQ_INVALID_INPUT_ERROR if ( size ( y ) /= this % get_state_count ()) error stop DIFFEQ_ARRAY_SIZE_ERROR if (. not . all ( ieee_is_finite ( y ))) error stop DIFFEQ_INVALID_INPUT_ERROR end subroutine ! ------------------------------------------------------------------------------ subroutine ggl_physical_mass ( this , x , q , mass , args ) !! Evaluates the physical mass callback, or supplies identity. This private !! helper assumes the caller has checked array dimensions. Singular masses !! are diagnosed by the linear solve, not by this evaluation. class ( ggl_container ), intent ( inout ) :: this !! Container holding the optional mechanical mass callback. real ( real64 ), intent ( in ) :: x !! Independent-variable value for the mechanical mass callback. real ( real64 ), intent ( in ), dimension (:) :: q !! N coordinates, without velocities or multipliers. real ( real64 ), intent ( out ), dimension (:,:) :: mass !! Physical N-by-N matrix, not the augmented singular matrix. class ( * ), intent ( inout ), optional :: args !! Optional user-owned parameters forwarded to the callback. if ( associated ( this % mass_matrix )) then call this % mass_matrix ( x , q , mass , args ) else mass = identity ( size ( q )) end if end subroutine ! ------------------------------------------------------------------------------ subroutine ggl_rhs ( this , x , y , dydx , args ) !! Assembles the four RHS blocks documented on [[ggl_container]]. The !! output is a mass-matrix RHS, not the full derivative z'. Only the !! physical mass is resolved to compute the acceleration residual. !! Missing callbacks cause NULL_POINTER; invalid state/output lengths !! cause INVALID_INPUT/ARRAY_SIZE; singular physical mass causes SINGULAR_MATRIX. class ( ggl_container ), intent ( inout ) :: this !! Initialized container with all required callbacks assigned. real ( real64 ), intent ( in ) :: x !! Current independent-variable value. real ( real64 ), intent ( in ), dimension (:) :: y !! State [q,v,lambda,mu] of length 2N+2M; off-manifold values are allowed. real ( real64 ), intent ( out ), dimension (:) :: dydx !! 2N+2M RHS entries, ordered as kinematics, momentum, stabilized !! position residual, and stabilized velocity residual. class ( * ), intent ( inout ), optional :: args !! Optional user parameters forwarded unchanged to every callback. integer :: coordinates , constraints , physical real ( real64 ), allocatable , dimension (:) :: position , curvature , qdot real ( real64 ), allocatable , dimension (:,:) :: gradient , mass , acceleration call this % check_state ( y ) if (. not . this % get_is_ode_defined ()) error stop DIFFEQ_NULL_POINTER_ERROR if ( size ( dydx ) /= size ( y )) error stop DIFFEQ_ARRAY_SIZE_ERROR coordinates = this % m_coordinates constraints = this % m_constraints physical = 2 * coordinates allocate ( position ( constraints ), curvature ( constraints ), qdot ( coordinates ), & gradient ( constraints , coordinates ), mass ( coordinates , coordinates ), & acceleration ( coordinates , 1 )) call this % constraints ( x , y ( 1 : coordinates ), position , args ) call this % constraint_jacobian ( x , y ( 1 : coordinates ), gradient , args ) qdot = y ( coordinates + 1 : physical ) + & matmul ( transpose ( gradient ), y ( physical + constraints + 1 :)) dydx ( 1 : coordinates ) = qdot call this % fcn ( x , y ( 1 : physical ), dydx ( coordinates + 1 : physical ), args ) dydx ( coordinates + 1 : physical ) = dydx ( coordinates + 1 : physical ) - & matmul ( transpose ( gradient ), y ( physical + 1 : physical + constraints )) call this % physical_mass ( x , y ( 1 : coordinates ), mass , args ) acceleration (:, 1 ) = dydx ( coordinates + 1 : physical ) call ggl_linear_solve ( mass , acceleration ) call this % constraint_curvature ( x , y ( 1 : coordinates ), qdot , & y ( coordinates + 1 : physical ), curvature , args ) dydx ( physical + 1 : physical + constraints ) = matmul ( gradient , qdot ) + this % m_alpha * position dydx ( physical + constraints + 1 :) = curvature + matmul ( gradient , acceleration (:, 1 )) + & this % m_beta * matmul ( gradient , y ( coordinates + 1 : physical )) end subroutine ! ------------------------------------------------------------------------------ subroutine ggl_mass ( this , x , y , m , args ) !! Assembles diag(I,M,0,0). Both multiplier blocks and their cross blocks !! are zero. No constraints or force callbacks are needed for this operation. !! Uninitialized/wrong state sizes or matrix sizes are diagnosed explicitly. class ( ggl_container ), intent ( inout ) :: this !! Container defining dimensions and the optional physical mass. real ( real64 ), intent ( in ) :: x !! Current independent-variable value. real ( real64 ), intent ( in ), dimension (:) :: y !! Augmented state [q,v,lambda,mu] of length 2N+2M. real ( real64 ), intent ( out ), dimension (:,:) :: m !! Square augmented matrix with side length 2N+2M. A wrong shape !! causes DIFFEQ_MATRIX_SIZE_ERROR. class ( * ), intent ( inout ), optional :: args !! Optional user parameters forwarded to the physical mass callback. integer :: coordinates call this % check_state ( y ) if ( size ( m , 1 ) /= size ( y ) . or . size ( m , 2 ) /= size ( y )) & error stop DIFFEQ_MATRIX_SIZE_ERROR coordinates = this % m_coordinates m = 0.0d0 m ( 1 : coordinates , 1 : coordinates ) = identity ( coordinates ) call this % physical_mass ( x , y ( 1 : coordinates ), & m ( coordinates + 1 : 2 * coordinates , coordinates + 1 : 2 * coordinates ), args ) end subroutine ! ------------------------------------------------------------------------------ function ggl_validate ( this , x , y , tolerance , args ) result ( rst ) !! Checks max(abs(g)) and max(abs(Gv)) against one absolute tolerance. !! This tests physical position/velocity consistency, not the multiplier !! equations, and never changes the state. Choose units/scaling so one !! tolerance is meaningful for both residuals. Nonfinite residuals fail. class ( ggl_container ), intent ( inout ) :: this !! Initialized container; only constraints and their Jacobian are needed. real ( real64 ), intent ( in ) :: x !! Independent-variable value passed to the callbacks. real ( real64 ), intent ( in ), dimension (:) :: y !! Augmented initial state of length 2N+2M. real ( real64 ), intent ( in ) :: tolerance !! Finite nonnegative absolute residual threshold; invalid values !! cause DIFFEQ_INVALID_INPUT_ERROR. class ( * ), intent ( inout ), optional :: args !! Optional user parameters forwarded without using internal workspace. logical :: rst !! True when both physical residuals are finite and within tolerance. real ( real64 ), allocatable , dimension (:) :: position , velocity real ( real64 ), allocatable , dimension (:,:) :: gradient call this % check_state ( y ) if (. not . ieee_is_finite ( tolerance )) error stop DIFFEQ_INVALID_INPUT_ERROR if ( tolerance < 0.0d0 ) error stop DIFFEQ_INVALID_INPUT_ERROR if (. not . associated ( this % constraints ) . or . . not . associated ( this % constraint_jacobian )) & error stop DIFFEQ_NULL_POINTER_ERROR allocate ( position ( this % m_constraints ), velocity ( this % m_constraints ), & gradient ( this % m_constraints , this % m_coordinates )) call this % constraints ( x , y ( 1 : this % m_coordinates ), position , args ) call this % constraint_jacobian ( x , y ( 1 : this % m_coordinates ), gradient , args ) velocity = matmul ( gradient , y ( this % m_coordinates + 1 : 2 * this % m_coordinates )) rst = all ( ieee_is_finite ( position )) . and . all ( ieee_is_finite ( velocity )) rst = rst . and . maxval ( abs ( position )) <= tolerance . and . maxval ( abs ( velocity )) <= tolerance end function ! ------------------------------------------------------------------------------ subroutine ggl_initialize_multipliers ( this , x , y , args ) !! Computes mu and lambda to satisfy the two stabilized algebraic rows !! for the supplied q and v. Coordinates and physical velocities are not !! projected or changed, even if they violate the original constraints. !! Singular GG&#94;T, physical mass, or GM&#94;{-1}G&#94;T causes SINGULAR_MATRIX. class ( ggl_container ), intent ( inout ) :: this !! Initialized container with all required callbacks assigned. real ( real64 ), intent ( in ) :: x !! Initial independent-variable value. real ( real64 ), intent ( inout ), dimension (:) :: y !! Full [q,v,lambda,mu] state. Input multipliers are ignored and replaced; !! output multipliers are algebraically consistent to solve accuracy. class ( * ), intent ( inout ), optional :: args !! Optional user-owned parameters forwarded to model callbacks. integer :: coordinates , constraints , physical real ( real64 ), allocatable , dimension (:) :: position , rhs real ( real64 ), allocatable , dimension (:,:) :: gradient , mass , inverse_gradient , multiplier call this % check_state ( y ) if (. not . this % get_is_ode_defined ()) error stop DIFFEQ_NULL_POINTER_ERROR coordinates = this % m_coordinates constraints = this % m_constraints physical = 2 * coordinates allocate ( position ( constraints ), rhs ( size ( y )), gradient ( constraints , coordinates ), & mass ( coordinates , coordinates ), inverse_gradient ( coordinates , constraints ), & multiplier ( constraints , 1 )) call this % constraints ( x , y ( 1 : coordinates ), position , args ) call this % constraint_jacobian ( x , y ( 1 : coordinates ), gradient , args ) multiplier (:, 1 ) = - matmul ( gradient , y ( coordinates + 1 : physical )) - this % m_alpha * position call ggl_linear_solve ( matmul ( gradient , transpose ( gradient )), multiplier ) y ( physical + constraints + 1 :) = multiplier (:, 1 ) y ( physical + 1 : physical + constraints ) = 0.0d0 call this % compute_rhs ( x , y , rhs , args ) call this % physical_mass ( x , y ( 1 : coordinates ), mass , args ) inverse_gradient = transpose ( gradient ) call ggl_linear_solve ( mass , inverse_gradient ) multiplier (:, 1 ) = rhs ( physical + constraints + 1 :) call ggl_linear_solve ( matmul ( gradient , inverse_gradient ), multiplier ) y ( physical + 1 : physical + constraints ) = multiplier (:, 1 ) end subroutine ! ------------------------------------------------------------------------------ subroutine ggl_linear_solve ( matrix , rhs ) !! Resolves a square physical or constraint system by pivoted LU, without !! forming an inverse. Nonfinite data/invalid shapes cause INVALID_INPUT; !! a vanishing or relatively tiny LU pivot causes SINGULAR_MATRIX. real ( real64 ), intent ( in ), dimension (:,:) :: matrix !! Nonempty square coefficient matrix, left unchanged. real ( real64 ), intent ( inout ), dimension (:,:) :: rhs !! Matching-row matrix of one or more RHS columns, replaced by solutions. real ( real64 ), allocatable , dimension (:,:) :: factors integer ( int32 ), allocatable , dimension (:) :: pivots integer :: equations , equation real ( real64 ) :: largest , smallest equations = size ( matrix , 1 ) if ( equations < 1 . or . size ( matrix , 2 ) /= equations . or . & size ( rhs , 1 ) /= equations . or . size ( rhs , 2 ) < 1 ) error stop DIFFEQ_INVALID_INPUT_ERROR if (. not . all ( ieee_is_finite ( matrix )) . or . . not . all ( ieee_is_finite ( rhs ))) & error stop DIFFEQ_INVALID_INPUT_ERROR call lu_factor ( matrix , ipvt = pivots , lu = factors ) if (. not . all ( ieee_is_finite ( factors ))) error stop DIFFEQ_SINGULAR_MATRIX_ERROR largest = 0.0d0 smallest = huge ( 1.0d0 ) do equation = 1 , equations largest = max ( largest , abs ( factors ( equation , equation ))) smallest = min ( smallest , abs ( factors ( equation , equation ))) end do if ( smallest <= equations * epsilon ( 1.0d0 ) * largest ) & error stop DIFFEQ_SINGULAR_MATRIX_ERROR rhs = solve_lu ( factors , pivots , rhs ) if (. not . all ( ieee_is_finite ( rhs ))) error stop DIFFEQ_SINGULAR_MATRIX_ERROR end subroutine ! ------------------------------------------------------------------------------ end module","tags":"","url":"sourcefile\\diffeq_index_reduction.f90.html"},{"title":"diffeq_c_integrators.f90 – DIFFEQ","text":"Source Code ! This file is part of diffeq. ! ! Copyright (c) 2023-2026 Jason Christopherson ! ! Permission is hereby granted, free of charge, to any person obtaining a copy ! of this software and associated documentation files (the \"Software\"), to deal ! in the Software without restriction, including without limitation the rights ! to use, copy, modify, merge, publish, distribute, sublicense, and/or sell ! copies of the Software, and to permit persons to whom the Software is ! furnished to do so, subject to the following conditions: ! ! The above copyright notice and this permission notice shall be included in all ! copies or substantial portions of the Software. ! ! THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR ! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, ! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE ! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER ! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, ! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE ! SOFTWARE. module diffeq_c_integrators use iso_fortran_env use iso_c_binding use diffeq_c_function_pointers use diffeq_c_containers use diffeq_c_errors use diffeq_c_index_reduction use diffeq implicit none private public :: c_ode_settings public :: c_default_ode_settings public :: c_runge_kutta_23 public :: c_runge_kutta_45 public :: c_runge_kutta_853 public :: c_tsitouras public :: c_adams public :: c_rosenbrock public :: c_kennedy_carpenter_4 public :: c_kennedy_carpenter_5 public :: c_bdf public :: c_dae_rosenbrock public :: c_dae_kennedy_carpenter_4 public :: c_dae_kennedy_carpenter_5 public :: c_dae_bdf public :: c_adams_events public :: c_bdf_events public :: c_runge_kutta_23_events public :: c_runge_kutta_45_events public :: c_runge_kutta_853_events public :: c_tsitouras_events public :: c_rosenbrock_events public :: c_kennedy_carpenter_4_events public :: c_kennedy_carpenter_5_events integer , parameter :: C_RK23 = 1 integer , parameter :: C_RK45 = 2 integer , parameter :: C_RK853 = 3 integer , parameter :: C_TSIT = 4 integer , parameter :: C_RBRK = 5 integer , parameter :: C_KCARP4 = 6 integer , parameter :: C_KCARP5 = 7 integer , parameter :: C_BACKDIFF = 8 integer , parameter :: C_ADMS = 9 type , bind ( C ) :: c_ode_settings !! A container for ODE settings. logical ( c_bool ) :: mass_matrix_constant !! True if the mass matrix is constant regardless of state, or !! false if the mass matrix is state-dependent. real ( c_double ) :: minimum_step_size !! The minimum allowed integrator step size. real ( c_double ) :: maximum_step_size !! The maximum allowed integrator step size. integer ( c_int ) :: step_limit !! The limit on the maximum total number of integration steps. logical ( c_bool ) :: allow_overshoot !! True if the solver is allowed to overshoot the final value in !! the integration range and interpolate back; else, false if the !! solver must terminate on the final value. real ( c_double ) :: beta !! PI step size controller exponent.  Set to zero to turn off PI !! step size control. real ( c_double ) :: absolute_tolerance !! The absolute tolerance applied to each equation. real ( c_double ) :: relative_tolerance !! The relative tolerance applied to each equation. integer ( c_int ) :: newton_step_limit !! The maximum number of Newton iterations allowed per implicit !! solve (BDF and Kennedy-Carpenter). real ( c_double ) :: newton_tolerance !! The convergence tolerance for Newton iteration (BDF and !! Kennedy-Carpenter). end type contains ! ------------------------------------------------------------------------------ subroutine c_default_ode_settings ( settings ) & bind ( C , name = \"c_default_ode_settings\" ) !! Fills the supplied [[c_ode_settings]] object with default settings. type ( c_ode_settings ), intent ( inout ) :: settings !! The [[c_ode_settings]] object. settings % absolute_tolerance = 1.0d-6 settings % allow_overshoot = . true . settings % beta = 0.0d0 settings % mass_matrix_constant = . true . settings % maximum_step_size = huge ( 1.0d0 ) settings % minimum_step_size = 1.0d1 * epsilon ( 1.0d0 ) settings % relative_tolerance = 1.0d-6 settings % step_limit = 1000000 settings % newton_step_limit = 12 settings % newton_tolerance = 1.0d-8 end subroutine ! ------------------------------------------------------------------------------ pure function c_valid_newton_settings ( settings ) result ( rst ) !! Determines if the Newton iteration settings are usable. type ( c_ode_settings ), intent ( in ) :: settings !! The [[c_ode_settings]] object. logical :: rst !! True if the settings are valid; else, false. rst = settings % newton_step_limit >= 1 . and . & settings % newton_tolerance > 0.0d0 . and . & settings % newton_tolerance <= huge ( 1.0d0 ) end function ! ------------------------------------------------------------------------------ function c_integrate_ode ( method , nx , nstates , fcn , x , initcond , & settings , output , jac , mass ) result ( rst ) integer ( c_int ), intent ( in ) :: method !! The integrator to use. integer ( c_int ), intent ( in ) :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ) :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. procedure ( c_ode ), intent ( in ), pointer :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. procedure ( c_ode_jacobian ), intent ( in ), pointer , optional :: jac !! A pointer to the Jacobian calculation routine.  If not supplied, !! a finite difference approach is utilized if a Jacobian matrix !! is needed. procedure ( c_ode_mass_matrix ), intent ( in ), pointer , optional :: mass !! A pointer to the mass matrix routine.  If not supplied, no !! mass matrix is utilized. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. class ( ode_integrator ), pointer :: integrator type ( runge_kutta_23 ), target :: rk23 type ( runge_kutta_45 ), target :: rk45 type ( runge_kutta_853 ), target :: rk853 type ( tsitouras_54 ), target :: tsit type ( rosenbrock ), target :: rsbrk type ( kennedy_carpenter_4 ), target :: kc4 type ( kennedy_carpenter_5 ), target :: kc5 type ( bdf ), target :: bdf_i type ( adams ), target :: adams_i type ( ode_container ) :: model logical :: mass_matrix_dependent type ( ode_results ) :: ode_output rst = C_NO_ERROR select case ( method ) case ( C_RK23 ) integrator => rk23 case ( C_RK45 ) integrator => rk45 case ( C_RK853 ) integrator => rk853 case ( C_TSIT ) integrator => tsit case ( C_RBRK ) integrator => rsbrk case ( C_KCARP4 ) if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call kc4 % set_newton_step_limit ( settings % newton_step_limit ) call kc4 % set_newton_tolerance ( settings % newton_tolerance ) integrator => kc4 case ( C_KCARP5 ) if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call kc5 % set_newton_step_limit ( settings % newton_step_limit ) call kc5 % set_newton_tolerance ( settings % newton_tolerance ) integrator => kc5 case ( C_BACKDIFF ) if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call bdf_i % set_newton_step_limit ( settings % newton_step_limit ) call bdf_i % set_newton_tolerance ( settings % newton_tolerance ) integrator => bdf_i case ( C_ADMS ) integrator => adams_i case default rst = C_INVALID_INPUT_ERROR return end select if ( nx < 2 ) then rst = C_INVALID_INPUT_ERROR return end if if ( nstates < 1 ) then rst = C_INVALID_INPUT_ERROR return end if if ( present ( jac )) model % jacobian => internal_jac if ( present ( mass )) model % mass_matrix => internal_mass model % fcn => internal_ode mass_matrix_dependent = . not . settings % mass_matrix_constant call model % set_is_mass_matrix_dependent ( mass_matrix_dependent ) call integrator % set_minimum_step_size ( settings % minimum_step_size ) call integrator % set_maximum_step_size ( settings % maximum_step_size ) call integrator % set_step_limit ( settings % step_limit ) call integrator % set_allow_overshoot ( logical ( settings % allow_overshoot )) call integrator % set_absolute_tolerance ( settings % absolute_tolerance ) call integrator % set_relative_tolerance ( settings % relative_tolerance ) call integrator % set_step_size_control_parameter ( settings % beta ) call integrator % solve ( model , x , initcond ) ode_output = integrator % get_ode_results () call c_create_ode_results ( output , ode_output ) contains subroutine internal_ode ( x_ , y_ , dydx_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:) :: dydx_ class ( * ), intent ( inout ), optional :: args_ call fcn ( size ( y_ ), x_ , y_ , dydx_ ) end subroutine subroutine internal_jac ( x_ , y_ , jac_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:,:) :: jac_ class ( * ), intent ( inout ), optional :: args_ call jac ( size ( jac_ , 1 ), size ( jac_ , 2 ), x_ , y_ , jac_ , size ( jac_ , 1 )) end subroutine subroutine internal_mass ( x_ , y_ , m_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:,:) :: m_ class ( * ), intent ( inout ), optional :: args_ call mass ( size ( m_ , 1 ), x_ , y_ , m_ , size ( m_ , 1 )) end subroutine end function ! ------------------------------------------------------------------------------ function c_runge_kutta_23 ( nx , nstates , fcn , x , initcond , settings , output ) & result ( rst ) bind ( C , name = \"c_runge_kutta_23\" ) !! Utilizes the 3rd order Bogacki-Shampine Runge-Kutta integrator to !! solve a system of first order differential equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) rst = c_integrate_ode ( C_RK23 , nx , nstates , fcn_ptr , x , initcond , & settings , output ) end function ! ------------------------------------------------------------------------------ function c_runge_kutta_45 ( nx , nstates , fcn , x , initcond , settings , output ) & result ( rst ) bind ( C , name = \"c_runge_kutta_45\" ) !! Utilizes the 5th order Dormand-Prince Runge-Kutta integrator to !! solve a system of first order differential equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) rst = c_integrate_ode ( C_RK45 , nx , nstates , fcn_ptr , x , initcond , & settings , output ) end function ! ------------------------------------------------------------------------------ function c_runge_kutta_853 ( nx , nstates , fcn , x , initcond , settings , output ) & result ( rst ) bind ( C , name = \"c_runge_kutta_853\" ) !! Utilizes the 8th order Hairer Runge-Kutta integrator to !! solve a system of first order differential equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) rst = c_integrate_ode ( C_RK853 , nx , nstates , fcn_ptr , x , initcond , & settings , output ) end function ! ------------------------------------------------------------------------------ function c_tsitouras ( nx , nstates , fcn , x , initcond , settings , output ) & result ( rst ) bind ( C , name = \"c_tsitouras\" ) !! Utilizes the 5th order Tsitouras Runge-Kutta integrator to !! solve a system of first order differential equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) rst = c_integrate_ode ( C_TSIT , nx , nstates , fcn_ptr , x , initcond , & settings , output ) end function ! ------------------------------------------------------------------------------ function c_adams ( nx , nstates , fcn , x , initcond , settings , mass , output ) & result ( rst ) bind ( C , name = \"c_adams\" ) !! Utilizes a variable order Adams predictor-corrector integrator to !! solve a system of first order differential equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_funptr ), value , intent ( in ) :: mass !! A pointer to the routine for computing the mass matrix.  Pass !! NULL if no routine is necessary.  This routine cannot handle !! singular mass matrices. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. logical :: use_mass procedure ( c_ode ), pointer :: fcn_ptr procedure ( c_ode_mass_matrix ), pointer :: mass_ptr if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) use_mass = c_associated ( mass ) if ( use_mass ) call c_f_procpointer ( mass , mass_ptr ) if ( use_mass ) then rst = c_integrate_ode ( C_ADMS , nx , nstates , fcn_ptr , x , initcond , & settings , output , mass = mass_ptr ) else rst = c_integrate_ode ( C_ADMS , nx , nstates , fcn_ptr , x , initcond , & settings , output ) end if end function ! ------------------------------------------------------------------------------ function c_rosenbrock ( nx , nstates , fcn , x , initcond , settings , jac , mass , & output ) result ( rst ) bind ( C , name = \"c_rosenbrock\" ) !! Utilizes a 4th order Rosenbrock integrator to solve a system of !! first order differential equations or index-1 differential !! algebraic equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_funptr ), value , intent ( in ) :: jac !! A pointer to the routine for computing the Jacobian matrix. !! Pass NULL if no routine is necessary and allowing the integrator !! to use a finite-difference estimate is acceptable. type ( c_funptr ), value , intent ( in ) :: mass !! A pointer to the routine for computing the mass matrix.  Pass !! NULL if no routine is necessary. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr procedure ( c_ode_jacobian ), pointer :: jac_ptr procedure ( c_ode_mass_matrix ), pointer :: mass_ptr logical :: use_jac , use_mass if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) use_jac = c_associated ( jac ) if ( use_jac ) call c_f_procpointer ( jac , jac_ptr ) use_mass = c_associated ( mass ) if ( use_mass ) call c_f_procpointer ( mass , mass_ptr ) if ( use_jac . and . use_mass ) then rst = c_integrate_ode ( C_RBRK , nx , nstates , fcn_ptr , x , initcond , & settings , output , jac = jac_ptr , mass = mass_ptr ) else if ( use_jac . and . . not . use_mass ) then rst = c_integrate_ode ( C_RBRK , nx , nstates , fcn_ptr , x , initcond , & settings , output , jac = jac_ptr ) else if (. not . use_jac . and . use_mass ) then rst = c_integrate_ode ( C_RBRK , nx , nstates , fcn_ptr , x , initcond , & settings , output , mass = mass_ptr ) else rst = c_integrate_ode ( C_RBRK , nx , nstates , fcn_ptr , x , initcond , & settings , output ) end if end function ! ------------------------------------------------------------------------------ function c_kennedy_carpenter_4 ( nx , nstates , fcn , x , initcond , settings , & jac , mass , output ) result ( rst ) bind ( C , name = \"c_kennedy_carpenter_4\" ) !! Utilizes a 4th order Kennedy-Carpenter integrator to solve a system !! of first order differential equations or index-1 differential !! algebraic equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_funptr ), value , intent ( in ) :: jac !! A pointer to the routine for computing the Jacobian matrix. !! Pass NULL if no routine is necessary and allowing the integrator !! to use a finite-difference estimate is acceptable. type ( c_funptr ), value , intent ( in ) :: mass !! A pointer to the routine for computing the mass matrix.  Pass !! NULL if no routine is necessary. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr procedure ( c_ode_jacobian ), pointer :: jac_ptr procedure ( c_ode_mass_matrix ), pointer :: mass_ptr logical :: use_jac , use_mass if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) use_jac = c_associated ( jac ) if ( use_jac ) call c_f_procpointer ( jac , jac_ptr ) use_mass = c_associated ( mass ) if ( use_mass ) call c_f_procpointer ( mass , mass_ptr ) if ( use_jac . and . use_mass ) then rst = c_integrate_ode ( C_KCARP4 , nx , nstates , fcn_ptr , x , initcond , & settings , output , jac = jac_ptr , mass = mass_ptr ) else if ( use_jac . and . . not . use_mass ) then rst = c_integrate_ode ( C_KCARP4 , nx , nstates , fcn_ptr , x , initcond , & settings , output , jac = jac_ptr ) else if (. not . use_jac . and . use_mass ) then rst = c_integrate_ode ( C_KCARP4 , nx , nstates , fcn_ptr , x , initcond , & settings , output , mass = mass_ptr ) else rst = c_integrate_ode ( C_KCARP4 , nx , nstates , fcn_ptr , x , initcond , & settings , output ) end if end function ! ------------------------------------------------------------------------------ function c_kennedy_carpenter_5 ( nx , nstates , fcn , x , initcond , settings , & jac , mass , output ) result ( rst ) bind ( C , name = \"c_kennedy_carpenter_5\" ) !! Utilizes a 5th order Kennedy-Carpenter integrator to solve a system !! of first order differential equations or index-1 differential !! algebraic equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_funptr ), value , intent ( in ) :: jac !! A pointer to the routine for computing the Jacobian matrix. !! Pass NULL if no routine is necessary and allowing the integrator !! to use a finite-difference estimate is acceptable. type ( c_funptr ), value , intent ( in ) :: mass !! A pointer to the routine for computing the mass matrix.  Pass !! NULL if no routine is necessary. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr procedure ( c_ode_jacobian ), pointer :: jac_ptr procedure ( c_ode_mass_matrix ), pointer :: mass_ptr logical :: use_jac , use_mass if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) use_jac = c_associated ( jac ) if ( use_jac ) call c_f_procpointer ( jac , jac_ptr ) use_mass = c_associated ( mass ) if ( use_mass ) call c_f_procpointer ( mass , mass_ptr ) if ( use_jac . and . use_mass ) then rst = c_integrate_ode ( C_KCARP5 , nx , nstates , fcn_ptr , x , initcond , & settings , output , jac = jac_ptr , mass = mass_ptr ) else if ( use_jac . and . . not . use_mass ) then rst = c_integrate_ode ( C_KCARP5 , nx , nstates , fcn_ptr , x , initcond , & settings , output , jac = jac_ptr ) else if (. not . use_jac . and . use_mass ) then rst = c_integrate_ode ( C_KCARP5 , nx , nstates , fcn_ptr , x , initcond , & settings , output , mass = mass_ptr ) else rst = c_integrate_ode ( C_KCARP5 , nx , nstates , fcn_ptr , x , initcond , & settings , output ) end if end function ! ------------------------------------------------------------------------------ function c_bdf ( nx , nstates , fcn , x , initcond , settings , jac , mass , & output ) result ( rst ) bind ( C , name = \"c_bdf\" ) !! Utilizes a variable order BDF integrator to solve a system of !! first order differential equations or index-1 differential !! algebraic equations. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. type ( c_funptr ), value , intent ( in ) :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_funptr ), value , intent ( in ) :: jac !! A pointer to the routine for computing the Jacobian matrix. !! Pass NULL if no routine is necessary and allowing the integrator !! to use a finite-difference estimate is acceptable. type ( c_funptr ), value , intent ( in ) :: mass !! A pointer to the routine for computing the mass matrix.  Pass !! NULL if no routine is necessary. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. procedure ( c_ode ), pointer :: fcn_ptr procedure ( c_ode_jacobian ), pointer :: jac_ptr procedure ( c_ode_mass_matrix ), pointer :: mass_ptr logical :: use_jac , use_mass if (. not . c_associated ( fcn )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( fcn , fcn_ptr ) use_jac = c_associated ( jac ) if ( use_jac ) call c_f_procpointer ( jac , jac_ptr ) use_mass = c_associated ( mass ) if ( use_mass ) call c_f_procpointer ( mass , mass_ptr ) if ( use_jac . and . use_mass ) then rst = c_integrate_ode ( C_BACKDIFF , nx , nstates , fcn_ptr , x , & initcond , settings , output , jac = jac_ptr , mass = mass_ptr ) else if ( use_jac . and . . not . use_mass ) then rst = c_integrate_ode ( C_BACKDIFF , nx , nstates , fcn_ptr , x , & initcond , settings , output , jac = jac_ptr ) else if (. not . use_jac . and . use_mass ) then rst = c_integrate_ode ( C_BACKDIFF , nx , nstates , fcn_ptr , x , & initcond , settings , output , mass = mass_ptr ) else rst = c_integrate_ode ( C_BACKDIFF , nx , nstates , fcn_ptr , x , & initcond , settings , output ) end if end function ! ****************************************************************************** ! INDEX-REDUCTION DAE SOLVERS ! ------------------------------------------------------------------------------ function c_integrate_dae ( method , model , nx , nstates , x , initcond , & settings , output , estats ) result ( rst ) integer ( c_int ), intent ( in ) :: method !! The integrator to use. type ( c_ggl_container ), intent ( in ) :: model !! The [[c_ggl_container]] containing the constraints and model. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations, including the constraints.  This !! value must be at least 1; else, a C_INVALID_INPUT_ERROR is !! returned. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( inout ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. type ( c_ode_event_statistics ), intent ( out ) :: estats !! Event detection solver results and statistics. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. logical :: use_mass , use_jac procedure ( c_ode ), pointer :: force_ptr procedure ( c_ode_mass_matrix ), pointer :: mass_ptr procedure ( c_ode_jacobian ), pointer :: gradient_ptr , jacobian_ptr procedure ( c_dae_algebraic_constraints ), pointer :: constraint_ptr procedure ( c_dae_constraint_curvature ), pointer :: curvature_ptr procedure ( c_ode_event_function ), pointer :: event_ptr type ( rosenbrock ), target :: rsbrk type ( kennedy_carpenter_4 ), target :: kc4 type ( kennedy_carpenter_5 ), target :: kc5 type ( bdf ), target :: bdf_i class ( ode_integrator ), pointer :: integrator type ( ode_results ) :: ode_output type ( ggl_container ) :: mdl rst = C_NO_ERROR if ( model % constraint_count < 0 ) then rst = C_INVALID_INPUT_ERROR return end if if (. not . c_associated ( model % force )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( model % force , force_ptr ) if ( nx < 2 ) then rst = C_INVALID_INPUT_ERROR return end if if ( nstates < 1 ) then rst = C_INVALID_INPUT_ERROR return end if use_jac = c_associated ( model % jacobian ) if ( use_jac ) then call c_f_procpointer ( model % jacobian , jacobian_ptr ) end if use_mass = c_associated ( model % mass ) if ( use_mass ) then call c_f_procpointer ( model % mass , mass_ptr ) end if if (. not . c_associated ( model % constraints )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( model % constraints , constraint_ptr ) if (. not . c_associated ( model % gradient )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( model % gradient , gradient_ptr ) if (. not . c_associated ( model % curvature )) then rst = C_NULL_POINTER_ERROR return end if call c_f_procpointer ( model % curvature , curvature_ptr ) select case ( method ) case ( C_RBRK ) integrator => rsbrk case ( C_KCARP4 ) if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call kc4 % set_newton_step_limit ( settings % newton_step_limit ) call kc4 % set_newton_tolerance ( settings % newton_tolerance ) integrator => kc4 case ( C_KCARP5 ) if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call kc5 % set_newton_step_limit ( settings % newton_step_limit ) call kc5 % set_newton_tolerance ( settings % newton_tolerance ) integrator => kc5 case default ! BDF if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call bdf_i % set_newton_step_limit ( settings % newton_step_limit ) call bdf_i % set_newton_tolerance ( settings % newton_tolerance ) integrator => bdf_i end select call integrator % set_minimum_step_size ( settings % minimum_step_size ) call integrator % set_maximum_step_size ( settings % maximum_step_size ) call integrator % set_step_limit ( settings % step_limit ) call integrator % set_allow_overshoot ( logical ( settings % allow_overshoot )) call integrator % set_absolute_tolerance ( settings % absolute_tolerance ) call integrator % set_relative_tolerance ( settings % relative_tolerance ) call integrator % set_step_size_control_parameter ( settings % beta ) ! NSTATES is the size of the entire state vector, the constraints, ! the coordinates, the velocity, and the velocity constraints; ! therefore, the number of coordinates is (NSTATES - 2 NCONSTRAINTS)/2 call mdl % initialize (( nstates - 2 * model % constraint_count ) / 2 , & model % constraint_count , alpha = model % alpha , beta = model % beta ) mdl % fcn => force_routine if ( use_jac ) mdl % jacobian => jacobian_routine if ( use_mass ) mdl % mass_matrix => mass_routine mdl % constraint_jacobian => gradient_routine mdl % constraint_curvature => curvature_routine mdl % constraints => constraint_routine if ( c_associated ( model % events ) . and . model % event_equation_count > 0 ) then call c_f_procpointer ( model % events , event_ptr ) mdl % event_function => internal_events call mdl % set_event_equation_count ( model % event_equation_count ) end if call mdl % initialize_multipliers ( 0.0d0 , initcond ) call integrator % solve ( mdl , x , initcond ) ode_output = integrator % get_ode_results () call c_create_ode_results ( output , ode_output ) estats = integrator % event_solver % solver_statistics contains subroutine force_routine ( x_ , y_ , dydx_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:) :: dydx_ class ( * ), intent ( inout ), optional :: args_ call force_ptr ( size ( y_ ), x_ , y_ , dydx_ ) end subroutine subroutine mass_routine ( x_ , y_ , m_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:,:) :: m_ class ( * ), intent ( inout ), optional :: args_ call mass_ptr ( size ( m_ , 1 ), x_ , y_ , m_ , size ( m_ , 1 )) end subroutine subroutine gradient_routine ( x_ , y_ , jac_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:,:) :: jac_ class ( * ), intent ( inout ), optional :: args_ call gradient_ptr ( size ( jac_ , 1 ), size ( jac_ , 2 ), x_ , y_ , jac_ , & size ( jac_ , 1 )) end subroutine subroutine constraint_routine ( x_ , y_ , g_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:) :: g_ class ( * ), intent ( inout ), optional :: args_ call constraint_ptr ( size ( g_ ), size ( y_ ), x_ , y_ , g_ ) end subroutine subroutine curvature_routine ( x_ , q_ , direction_ , v_ , curvature_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: q_ real ( real64 ), intent ( in ), dimension (:) :: direction_ real ( real64 ), intent ( in ), dimension (:) :: v_ real ( real64 ), intent ( out ), dimension (:) :: curvature_ class ( * ), intent ( inout ), optional :: args_ call curvature_ptr ( size ( curvature_ ), size ( q_ ), x_ , q_ , direction_ , & v_ , curvature_ ) end subroutine subroutine jacobian_routine ( x_ , y_ , jac_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:,:) :: jac_ class ( * ), intent ( inout ), optional :: args_ call jacobian_ptr ( size ( jac_ , 1 ), size ( jac_ , 2 ), x_ , y_ , jac_ , & size ( jac_ , 1 )) end subroutine subroutine internal_events ( x_ , y_ , f_ , args_ ) real ( real64 ), intent ( in ) :: x_ real ( real64 ), intent ( in ), dimension (:) :: y_ real ( real64 ), intent ( out ), dimension (:) :: f_ class ( * ), intent ( inout ), optional :: args_ call event_ptr ( size ( f_ ), size ( y_ ), x_ , y_ , f_ ) end subroutine end function ! ------------------------------------------------------------------------------ function c_dae_rosenbrock ( model , nx , nstates , x , initcond , settings , & output , estats ) result ( rst ) bind ( C , name = \"c_dae_rosenbrock\" ) !! Utilizes a 4th order Rosenbrock integrator to solve the system of !! DAE's. type ( c_ggl_container ), intent ( in ) :: model !! The [[c_ggl_container]] containing the constraints and model. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations, including the constraints.  This !! value must be at least 1; else, a C_INVALID_INPUT_ERROR is !! returned. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( inout ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. type ( c_ode_event_statistics ), intent ( out ) :: estats !! Event detection solver results and statistics. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. rst = c_integrate_dae ( C_RBRK , model , nx , nstates , x , initcond , & settings , output , estats ) end function ! ------------------------------------------------------------------------------ function c_dae_kennedy_carpenter_4 ( model , nx , nstates , x , initcond , & settings , output , estats ) result ( rst ) & bind ( C , name = \"c_dae_kennedy_carpenter_4\" ) !! Utilizes a 4th order Kennedy-Carpenter integrator to solve the !! system of DAE's. type ( c_ggl_container ), intent ( in ) :: model !! The [[c_ggl_container]] containing the constraints and model. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations, including the constraints.  This !! value must be at least 1; else, a C_INVALID_INPUT_ERROR is !! returned. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( inout ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. type ( c_ode_event_statistics ), intent ( out ) :: estats !! Event detection solver results and statistics. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. rst = c_integrate_dae ( C_KCARP4 , model , nx , nstates , x , initcond , & settings , output , estats ) end function ! ------------------------------------------------------------------------------ function c_dae_kennedy_carpenter_5 ( model , nx , nstates , x , initcond , & settings , output , estats ) result ( rst ) & bind ( C , name = \"c_dae_kennedy_carpenter_5\" ) !! Utilizes a 5th order Kennedy-Carpenter integrator to solve the !! system of DAE's. type ( c_ggl_container ), intent ( in ) :: model !! The [[c_ggl_container]] containing the constraints and model. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations, including the constraints.  This !! value must be at least 1; else, a C_INVALID_INPUT_ERROR is !! returned. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( inout ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. type ( c_ode_event_statistics ), intent ( out ) :: estats !! Event detection solver results and statistics. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. rst = c_integrate_dae ( C_KCARP5 , model , nx , nstates , x , initcond , & settings , output , estats ) end function ! ------------------------------------------------------------------------------ function c_dae_bdf ( model , nx , nstates , x , initcond , settings , & output , estats ) result ( rst ) bind ( C , name = \"c_dae_bdf\" ) !! Utilizes a variable order BDF integrator to solve the system of !! DAE's. type ( c_ggl_container ), intent ( in ) :: model !! The [[c_ggl_container]] containing the constraints and model. integer ( c_int ), intent ( in ), value :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ), value :: nstates !! The number of state equations, including the constraints.  This !! value must be at least 1; else, a C_INVALID_INPUT_ERROR is !! returned. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( inout ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. type ( c_ode_event_statistics ), intent ( out ) :: estats !! Event detection solver results and statistics. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. rst = c_integrate_dae ( C_BACKDIFF , model , nx , nstates , x , initcond , & settings , output , estats ) end function ! ****************************************************************************** ! EVENT HANDLING ODE SOLVERS ! ------------------------------------------------------------------------------ function c_integrate_ode_events ( method , nx , nstates , nevents , fcn , x , & initcond , settings , esettings , efcn , output , estats , jac , mass ) & result ( rst ) integer ( c_int ), intent ( in ) :: method !! The integrator to use. integer ( c_int ), intent ( in ) :: nx !! The number of solution points.  This value must be at least 2; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ) :: nstates !! The number of state equations.  This value must be at least 1; !! else, a C_INVALID_INPUT_ERROR is returned. integer ( c_int ), intent ( in ) :: nevents !! The number of event equations. procedure ( c_ode ), intent ( in ), pointer :: fcn !! A pointer to the function containing the equations to integrate. real ( c_double ), intent ( in ) :: x ( nx ) !! An NX-element array containing the desired solution points. real ( c_double ), intent ( in ) :: initcond ( nstates ) !! An NSTATES-element array containing the initial conditions. type ( c_ode_settings ), intent ( in ) :: settings !! The integrator settings. type ( c_ode_event_solver_settings ), intent ( in ) :: esettings !! The event solver settings. procedure ( c_ode_event_function ), pointer :: efcn !! A pointer to the function containing the event equations. type ( c_ptr ), intent ( out ) :: output !! The output c_ode_results object.  Memory must be freed by !! c_free_ode_results. type ( c_ode_event_statistics ), intent ( out ) :: estats !! Event detection statistics. procedure ( c_ode_jacobian ), intent ( in ), pointer , optional :: jac !! A pointer to the Jacobian calculation routine.  If not supplied, !! a finite difference approach is utilized if a Jacobian matrix !! is needed. procedure ( c_ode_mass_matrix ), intent ( in ), pointer , optional :: mass !! A pointer to the mass matrix routine.  If not supplied, no !! mass matrix is utilized. integer ( c_int ) :: rst !! An error flag denoting the status of the operation. class ( ode_integrator ), pointer :: integrator type ( runge_kutta_23 ), target :: rk23 type ( runge_kutta_45 ), target :: rk45 type ( runge_kutta_853 ), target :: rk853 type ( tsitouras_54 ), target :: tsit type ( rosenbrock ), target :: rsbrk type ( kennedy_carpenter_4 ), target :: kc4 type ( kennedy_carpenter_5 ), target :: kc5 type ( bdf ), target :: bdf_i type ( adams ), target :: adams_i type ( ode_container ) :: model logical :: mass_matrix_dependent type ( ode_results ) :: ode_output rst = C_NO_ERROR select case ( method ) case ( C_RK23 ) integrator => rk23 case ( C_RK45 ) integrator => rk45 case ( C_RK853 ) integrator => rk853 case ( C_TSIT ) integrator => tsit case ( C_RBRK ) integrator => rsbrk case ( C_KCARP4 ) if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call kc4 % set_newton_step_limit ( settings % newton_step_limit ) call kc4 % set_newton_tolerance ( settings % newton_tolerance ) integrator => kc4 case ( C_KCARP5 ) if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call kc5 % set_newton_step_limit ( settings % newton_step_limit ) call kc5 % set_newton_tolerance ( settings % newton_tolerance ) integrator => kc5 case ( C_BACKDIFF ) if (. not . c_valid_newton_settings ( settings )) then rst = C_INVALID_INPUT_ERROR return end if call bdf_i % set_newton_step_limit ( settings % newton_step_limit ) call bdf_i % set_newton_tolerance ( settings % newton_tolerance ) integrator => bdf_i case ( C_ADMS ) integrator => adams_i case default rst = C_INVALID_INPUT_ERROR return end select if ( nx < 2 ) then rst = C_INVALID_INPUT_ERROR return end if if ( nstates < 1 ) then rst = C_INVALID_INPUT_ERROR return end if if ( present ( jac )) model % jacobian => internal_jac if ( present ( mass )) model % mass_matrix => internal_mass model % fcn => internal_ode mass_matrix_dependent = . not . settings % mass_matrix_constant call model % set_is_mass_matrix_dependent ( mass_matrix_dependent ) if ( associated ( efcn ) . and . nevents > 0 ) then model % event_function => internal_events call model % set_event_equation_count ( nevents ) end if call integrator % event_solver % set_max_allowed_iterations ( esettings % max_allowed_iterations ) call integrator % event_solver % set_solver_tolerance ( esettings % tolerance ) call integrator % set_minimum_step_size ( settings % minimum_step_size ) call integrator % set_maximum_step_size ( settings % maximum_step_size ) call integrator % set_step_limit ( settings % step_limit ) call integrator % set_allow_overshoot ( logical ( settings % allow_overshoot )) call integrator % set_absolute_tolerance ( settings % absolute_tolerance ) call integrator % set_relative_tolerance ( settings % relative_tolerance ) call integrator % set_step_size_control_parameter ( settings % beta ) call integrator % solve ( model , x , initcond ) ode_output = integrator % get_ode_results () call c_create_ode_results ( output , ode_output ) estats = integrator % event_solver % so