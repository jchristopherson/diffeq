f An N-element array containing the derivatives at x. real(kind=real64), intent(in), dimension(:) :: fn An N-element array containing the derivatives at xn. real(kind=real64), intent(inout), dimension(:,:) :: k An N-by-NSTAGES matrix containing the derivatives at each stage. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: pre_step_action => rk45_pre_step Performs any pre-step actions. private  subroutine rk45_pre_step(this, prevs, sys, h, x, y, f, args) Placeholder routine for any pre-step actions. Arguments Type Intent Optional Attributes Name class( runge_kutta_45 ), intent(inout) :: this The runge_kutta_45 object. logical, intent(in) :: prevs Defines the status of the previous step.  The value is true \nif the previous step was successful; else, false if the \nprevious step failed. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current solution at x. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols private  subroutine oi_set_abs_tol(this, x) Sets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_abs_tols(this, x) Sets the absolute error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private  subroutine oi_set_allow_overshoot(this, x) Sets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. logical, intent(in) :: x True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. private  subroutine oi_set_dense_interval(this, x_start, x_end, n) Publishes the interval covered by retained dense-output interpolation\ndata for one accepted step. The endpoints are recorded in integration\norder, which may be increasing or decreasing. The interpolant is marked\nvalid after the interval and state dimension have been recorded.\nAn error stop occurs if either endpoint is non-finite, the endpoints\nare equal, or the state dimension is less than one. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. real(kind=real64), intent(in) :: x_start The first endpoint of the accepted step in integration order. real(kind=real64), intent(in) :: x_end The second endpoint of the accepted step in integration order. integer, intent(in) :: n The number of dependent variables represented by the interpolant. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). private  subroutine oi_set_dense_enabled(this, enabled) Enables or disables explicit dense-output preparation.\nWhen enabled, the integrator prepares dense output for each accepted\nstep independently of whether the requested output grid requires it.\nDisabling this setting does not prevent dense output needed to produce\nrequested solution values. Any previously prepared step is invalidated. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. logical, intent(in) :: enabled True to enable explicit dense-output preparation; false to disable it. procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. private  subroutine oi_set_max_step(this, x) Sets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. private  subroutine oi_set_min_step(this, x) Sets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols private  subroutine oi_set_rel_tol(this, x) Sets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_rel_tols(this, x) Sets the relative error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. private  subroutine oi_set_step_limit(this, x) Sets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in) :: x The step limit. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. private  subroutine oi_set_control_parameter(this, x) Sets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The control parameter procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. private  subroutine oi_set_safety_factor(this, x) Sets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The safety factor. procedure, public :: solve => ssi_ode_solver Solves the supplied system of ODE's. public  subroutine ssi_ode_solver (this, sys, x, iv, store_iv, args) Solves the supplied system of ODE's. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array of independent variable values at which to return the \nthe solution to the ODE's. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine.","tags":"","url":"type\\runge_kutta_45.html"},{"title":"real_ad – DIFFEQ ","text":"type, public :: real_ad A value and its directional derivative. Seed dx with one for an\nindependent variable and zero for constants. Components Type Visibility Attributes Name Initial real(kind=real64), public :: dx Directional derivative with respect to the current seed. real(kind=real64), public :: x Function or independent-variable value.","tags":"","url":"type\\real_ad.html"},{"title":"c_ode_event_solver_settings – DIFFEQ ","text":"type, public, bind(C) :: c_ode_event_solver_settings A container for ODE event solver settings. Components Type Visibility Attributes Name Initial integer(kind=c_int), public :: max_allowed_iterations = 1000 The maximum number of allowed iterations. real(kind=c_double), public :: tolerance = 1.0d-12 The iteration convergence tolerance.","tags":"","url":"type\\c_ode_event_solver_settings.html"},{"title":"c_ode_event_statistics – DIFFEQ ","text":"type, public, bind(C) :: c_ode_event_statistics An ODE event solver statistics container. Components Type Visibility Attributes Name Initial integer(kind=c_int), public :: event_index = -1 The zero-based index of the event equation where an event was \nlocated.  If no event was found, this value is set to -1. integer(kind=c_int), public :: function_evaluations = 0 The number of event function evaluations. integer(kind=c_int), public :: iteration_count = 0 The number of iterations taken by the solver.","tags":"","url":"type\\c_ode_event_statistics.html"},{"title":"c_ode_results_statistics – DIFFEQ ","text":"type, public, bind(C) :: c_ode_results_statistics A container of performance statistics for an\nintegrator. Components Type Visibility Attributes Name Initial integer(kind=c_int), public :: failed_steps = 0 The number of unsuccessful steps taken by the integrator. integer(kind=c_int), public :: function_evaluations = 0 The number of function evaluations. integer(kind=c_int), public :: jacobian_evaluations = 0 The number of Jacobian matrix evaluations. integer(kind=c_int), public :: matrix_factorizations = 0 The number of matrix factorizations. integer(kind=c_int), public :: successful_steps = 0 The number of successful steps taken by the integrator.","tags":"","url":"type\\c_ode_results_statistics.html"},{"title":"tsitouras_54 – DIFFEQ ","text":"type, public, extends( single_step_integrator ) :: tsitouras_54 The Tsitouras fifth-order Runge--Kutta method with an embedded\nfourth-order estimator. The seven-stage FSAL tableau is designed for efficient adaptive\nintegration of non-stiff systems. Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. private  subroutine oi_append_to_buffer(this, x, y) Appends the supplied solution point to the internal solution buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The independent variable value. real(kind=real64), intent(in), dimension(:) :: y The values of the dependent variables corresponding to x. procedure, public :: attempt_step => tsit_attempt_step Attempts an integration step for this integrator. private  subroutine tsit_attempt_step(this, sys, h, x, y, f, yn, fn, yerr, k, args) Attempts an integration step for this integrator. The final stage is evaluated at the endpoint and is reused as the first\nstage of the next accepted step.  The fifth-order solution is paired\nwith an embedded fourth-order solution; their difference supplies the\nlocal error estimate. Arguments Type Intent Optional Attributes Name class( tsitouras_54 ), intent(inout) :: this The tsitouras_54 object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current solution at x. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x. real(kind=real64), intent(out), dimension(:) :: yn An N-element array where this routine will write the next\nsolution estimate at x + h. real(kind=real64), intent(out), dimension(:) :: fn An N-element array where this routine will write the next\nderivative estimate at x + h. real(kind=real64), intent(out), dimension(:) :: yerr An N-element array where this routine will write an estimate\nof the error in each equation. real(kind=real64), intent(out), dimension(:,:) :: k An N-by-NSTAGES matrix containing the derivatives at each stage. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. private  subroutine oi_clear_buffer(this) Clears the contents of the buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. procedure, public :: compute_dense_output => ssi_dense_output private  subroutine ssi_dense_output(this, x, y) Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this real(kind=real64), intent(in) :: x real(kind=real64), intent(out) :: y (:) procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. private pure function oi_estimate_error(this, y, yest, yerr) result(rst) Computes the norm of the scaled error estimate.  A value less than one\nindicates a successful step.  A value greater than one suggests that the\nresults do not meet the requested tolerances. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: y The previously accepted solution array (N-element). real(kind=real64), intent(in), dimension(size(y)) :: yest An N-element array containing the next solution point estimate. real(kind=real64), intent(in), dimension(size(y)) :: yerr An N-element array containing the estimate of error for each\nequation. Return Value real(kind=real64) The norm of the scaled error. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. private  subroutine oi_initial_step(this, sys, xo, xf, yo, fo, h, args) Computes an estimate of an initial step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: xo The initial value of the independent variable. real(kind=real64), intent(in) :: xf The final value of the independent variable. real(kind=real64), intent(in), dimension(:) :: yo The initial values of the dependent variables (N-element). real(kind=real64), intent(out), dimension(size(yo)) :: fo An N-element array where the function values at xo will be written. real(kind=real64), intent(out) :: h The initial step size estimate. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. private  function oi_next_step(this, e, eold, h, x) result(rst) Estimates the next step size based upon the current and previous error\nestimates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: e The norm of the current scaled error estimate. real(kind=real64), intent(inout) :: eold The norm of the previous step's scaled error estimate.  On output,\nthis variable is updated. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current independent variable value. Return Value real(kind=real64) The new step size estimate. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. private  subroutine oi_evaluate_dense(this, x, y) Evaluates the interpolant for the last prepared accepted step at a\nrequested independent-variable value. The query must be finite and\nwithin the step interval, including either endpoint. This operation\ndoes not advance or otherwise change solver state and does not evaluate\nthe ODE function. An error stop occurs if no valid interpolant is\navailable, the output array has the wrong size, or the query is\nnon-finite or outside the interval. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator containing the prepared interpolant. real(kind=real64), intent(in) :: x The independent-variable value at which to evaluate the solution. real(kind=real64), intent(out) :: y (:) Receives the interpolated dependent-variable values. Its size must\nequal the number of dependent variables in the prepared step. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. private pure function oi_get_abs_tol(this, equation) result(rst) Gets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private pure function oi_get_allow_overshoot(this) result(rst) Gets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value logical True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. private  subroutine oi_get_dense_interval(this, x_start, x_end) Gets the endpoints of the currently prepared dense-output interval.\nAn error stop occurs if no valid interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. real(kind=real64), intent(out) :: x_start Receives the first endpoint in integration order. real(kind=real64), intent(out) :: x_end Receives the second endpoint in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. private pure function oi_get_dense_enabled(this) result(rst) Gets the explicit dense-output preparation setting. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if explicit dense-output preparation is enabled; otherwise,\nfalse. This setting is independent of preparation required to\nproduce values on a requested output grid. procedure, public :: get_is_fsal => tsit_get_is_fsal Gets a logical parameter stating if this is a first-same-as-last\n(FSAL) integrator. private pure function tsit_get_is_fsal(this) result(rst) Gets a logical parameter stating if this is a first-same-as-last\n(FSAL) integrator. Arguments Type Intent Optional Attributes Name class( tsitouras_54 ), intent(in) :: this The tsitouras_54 object. Return Value logical True for a FSAL integrator; else, false. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. private pure function oi_get_max_step(this) result(rst) Gets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. private pure function oi_get_min_step(this) result(rst) Gets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. private pure function oi_get_ode_results(this) result(rst) Returns a copy of the solution computed as a ode_results container.\nThe integrator retains the original copy. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value type( ode_results ) The ode_results container. procedure, public :: get_order => tsit_get_order Gets the order of the integrator. private pure function tsit_get_order(this) result(rst) Gets the order of the integrator. Arguments Type Intent Optional Attributes Name class( tsitouras_54 ), intent(in) :: this The tsitouras_54 object. Return Value integer The order. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. private pure function oi_get_rel_tol(this, equation) result(rst) Gets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. private pure function oi_get_solution(this) result(rst) Returns the solution computed by the integrator stored as a matrix with\nthe first column containing the values of the independent variable at\nwhich the solution was computed.  The remaining columns contain the\nsolutions for each of the integrated equations in the order in which they\nappear in the source routine.  Notice, the solve routine must be called\nbefore this routine. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64), allocatable, dimension(:,:) The resulting solution matrix. procedure, public :: get_stage_count => tsit_get_stage_count Gets the stage count for this integrator. private pure function tsit_get_stage_count(this) result(rst) Gets the stage count for this integrator. Arguments Type Intent Optional Attributes Name class( tsitouras_54 ), intent(in) :: this The tsitouras_54 object. Return Value integer The stage count. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. private pure function oi_get_step_limit(this) result(rst) Gets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The step limit. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. private pure function oi_get_control_parameter(this) result(rst) Gets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. private pure function oi_get_safety_factor(this) result(rst) Gets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The safety factor. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. private pure function oi_has_dense_output(this) result(rst) Determines whether a prepared accepted-step interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if dense output is currently valid; otherwise, false. procedure, public :: interpolate => tsit_interpolate Performs the interpolation. private  subroutine tsit_interpolate(this, x, xn, yn, fn, xn1, yn1, fn1, y) Performs the interpolation. A cubic Hermite polynomial is constructed from the solution and\nderivative values at each end of the step. Arguments Type Intent Optional Attributes Name class( tsitouras_54 ), intent(in) :: this The tsitouras_54 object. real(kind=real64), intent(in) :: x The value of the independent variable at which to compute\nthe interpolation. real(kind=real64), intent(in) :: xn The previous value of the independent variable at which the\nsolution is computed. real(kind=real64), intent(in), dimension(:) :: yn An N-element array containing the solution at xn. real(kind=real64), intent(in), dimension(:) :: fn An N-element array containing the derivatives at xn. real(kind=real64), intent(in) :: xn1 The value of the independent variable at xn + h. real(kind=real64), intent(in), dimension(:) :: yn1 An N-element array containing the solution at xn + h. real(kind=real64), intent(in), dimension(:) :: fn1 An N-element array containing the derivatives at xn + h. real(kind=real64), intent(out), dimension(:) :: y An N-element array where this routine will write the\nsolution values interpolated at x. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. private  subroutine oi_invalidate_dense(this) Marks any prepared dense-output interpolant as unavailable. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. private  subroutine oi_log_failed_step(this, n) Logs a failed integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. private  subroutine oi_log_function_eval(this, n) Logs a function evaluation, or evaluations. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one function \nevaluation.  If not supplied, this routine will log a single \nfunction evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. private  subroutine oi_log_jacobian_eval(this, n) Logs a Jacobian matrix evaluation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one Jacobian matrix\nevaluation.  If not supplied, this routine will log a single\nJacobian evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. private  subroutine oi_log_matrix_factorization(this, n) Logs a matrix factorization. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one matrix \nfactorization.  If not supplied, this routine will log a single\nfactorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. private  subroutine oi_log_successful_step(this, n) Logs a successful integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: post_step_action => tsit_post_step Performs any post-step actions. private  subroutine tsit_post_step(this, sys, dense, x, xn, y, yn, f, fn, k, args) Placeholder routine for any post-step actions. The interpolation for this integrator requires only the solution and\nderivative values at each end of the step, so no additional storage is\nrequired here. Arguments Type Intent Optional Attributes Name class( tsitouras_54 ), intent(inout) :: this The tsitouras_54 object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. logical, intent(in) :: dense Determines if dense output is requested (true); else, false. real(kind=real64), intent(in) :: x The previous value of the independent variable. real(kind=real64), intent(in) :: xn The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the solution at x. real(kind=real64), intent(in), dimension(:) :: yn An N-element array containing the solution at xn. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the derivatives at x. real(kind=real64), intent(in), dimension(:) :: fn An N-element array containing the derivatives at xn. real(kind=real64), intent(inout), dimension(:,:) :: k An N-by-NSTAGES matrix containing the derivatives at each stage. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: pre_step_action => tsit_pre_step Performs any pre-step actions. private  subroutine tsit_pre_step(this, prevs, sys, h, x, y, f, args) Placeholder routine for any pre-step actions. Arguments Type Intent Optional Attributes Name class( tsitouras_54 ), intent(inout) :: this The tsitouras_54 object. logical, intent(in) :: prevs Defines the status of the previous step.  The value is true\nif the previous step was successful; else, false if the\nprevious step failed. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current solution at x. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols private  subroutine oi_set_abs_tol(this, x) Sets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_abs_tols(this, x) Sets the absolute error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private  subroutine oi_set_allow_overshoot(this, x) Sets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. logical, intent(in) :: x True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. private  subroutine oi_set_dense_interval(this, x_start, x_end, n) Publishes the interval covered by retained dense-output interpolation\ndata for one accepted step. The endpoints are recorded in integration\norder, which may be increasing or decreasing. The interpolant is marked\nvalid after the interval and state dimension have been recorded.\nAn error stop occurs if either endpoint is non-finite, the endpoints\nare equal, or the state dimension is less than one. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. real(kind=real64), intent(in) :: x_start The first endpoint of the accepted step in integration order. real(kind=real64), intent(in) :: x_end The second endpoint of the accepted step in integration order. integer, intent(in) :: n The number of dependent variables represented by the interpolant. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). private  subroutine oi_set_dense_enabled(this, enabled) Enables or disables explicit dense-output preparation.\nWhen enabled, the integrator prepares dense output for each accepted\nstep independently of whether the requested output grid requires it.\nDisabling this setting does not prevent dense output needed to produce\nrequested solution values. Any previously prepared step is invalidated. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. logical, intent(in) :: enabled True to enable explicit dense-output preparation; false to disable it. procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. private  subroutine oi_set_max_step(this, x) Sets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. private  subroutine oi_set_min_step(this, x) Sets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols private  subroutine oi_set_rel_tol(this, x) Sets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_rel_tols(this, x) Sets the relative error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. private  subroutine oi_set_step_limit(this, x) Sets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in) :: x The step limit. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. private  subroutine oi_set_control_parameter(this, x) Sets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The control parameter procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. private  subroutine oi_set_safety_factor(this, x) Sets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The safety factor. procedure, public :: solve => ssi_ode_solver Solves the supplied system of ODE's. public  subroutine ssi_ode_solver (this, sys, x, iv, store_iv, args) Solves the supplied system of ODE's. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array of independent variable values at which to return the \nthe solution to the ODE's. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine.","tags":"","url":"type\\tsitouras_54.html"},{"title":"multistep_integrator – DIFFEQ ","text":"type, public, abstract, extends( ode_integrator ) :: multistep_integrator Defines the structure of a multi-step integrator. Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. private  subroutine oi_append_to_buffer(this, x, y) Appends the supplied solution point to the internal solution buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The independent variable value. real(kind=real64), intent(in), dimension(:) :: y The values of the dependent variables corresponding to x. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. private  subroutine oi_clear_buffer(this) Clears the contents of the buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. procedure, public :: compute_dense_output => mi_dense_output private  subroutine mi_dense_output(this, x, y) Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this real(kind=real64), intent(in) :: x real(kind=real64), intent(out) :: y (:) procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. private pure function oi_estimate_error(this, y, yest, yerr) result(rst) Computes the norm of the scaled error estimate.  A value less than one\nindicates a successful step.  A value greater than one suggests that the\nresults do not meet the requested tolerances. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: y The previously accepted solution array (N-element). real(kind=real64), intent(in), dimension(size(y)) :: yest An N-element array containing the next solution point estimate. real(kind=real64), intent(in), dimension(size(y)) :: yerr An N-element array containing the estimate of error for each\nequation. Return Value real(kind=real64) The norm of the scaled error. procedure( multistep_corrector ), public, deferred, pass :: correct Refines the prediction by applying the implicit formula. subroutine multistep_corrector(this, sys, h, x, ypred, ynew, converged, args) Prototype Refines the prediction by applying the implicit formula. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: ypred The N-element array containing the predicted values at x + h. real(kind=real64), intent(out), dimension(:) :: ynew The new estimate of the dependent variables. logical, intent(out) :: converged True if the corrector succeeded; else, false, in which case\nthe step is retried on a shorter step size. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. private  subroutine oi_initial_step(this, sys, xo, xf, yo, fo, h, args) Computes an estimate of an initial step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: xo The initial value of the independent variable. real(kind=real64), intent(in) :: xf The final value of the independent variable. real(kind=real64), intent(in), dimension(:) :: yo The initial values of the dependent variables (N-element). real(kind=real64), intent(out), dimension(size(yo)) :: fo An N-element array where the function values at xo will be written. real(kind=real64), intent(out) :: h The initial step size estimate. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. private  function oi_next_step(this, e, eold, h, x) result(rst) Estimates the next step size based upon the current and previous error\nestimates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: e The norm of the current scaled error estimate. real(kind=real64), intent(inout) :: eold The norm of the previous step's scaled error estimate.  On output,\nthis variable is updated. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current independent variable value. Return Value real(kind=real64) The new step size estimate. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. private  subroutine oi_evaluate_dense(this, x, y) Evaluates the interpolant for the last prepared accepted step at a\nrequested independent-variable value. The query must be finite and\nwithin the step interval, including either endpoint. This operation\ndoes not advance or otherwise change solver state and does not evaluate\nthe ODE function. An error stop occurs if no valid interpolant is\navailable, the output array has the wrong size, or the query is\nnon-finite or outside the interval. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator containing the prepared interpolant. real(kind=real64), intent(in) :: x The independent-variable value at which to evaluate the solution. real(kind=real64), intent(out) :: y (:) Receives the interpolated dependent-variable values. Its size must\nequal the number of dependent variables in the prepared step. procedure, public :: evaluate_derivative => mi_evaluate_derivative Evaluates the derivative stored in the solution history. private  subroutine mi_evaluate_derivative(this, sys, x, y, dydx, args) Evaluates the derivative that the solution history stores. The default implementation simply evaluates the right-hand side, which\nis correct whenever the mass matrix is the identity.  An integrator that\nrequires itself, rather than , overrides this routine to\nresolve the mass matrix. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: x The value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the solution at x. real(kind=real64), intent(out), dimension(:) :: dydx An N-element array where the derivative will be written. class(*), intent(inout), optional :: args An optional argument that can be used to pass information in and out\nof the differential equation subroutine. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. private pure function oi_get_abs_tol(this, equation) result(rst) Gets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private pure function oi_get_allow_overshoot(this) result(rst) Gets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value logical True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. private  subroutine oi_get_dense_interval(this, x_start, x_end) Gets the endpoints of the currently prepared dense-output interval.\nAn error stop occurs if no valid interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. real(kind=real64), intent(out) :: x_start Receives the first endpoint in integration order. real(kind=real64), intent(out) :: x_end Receives the second endpoint in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. private pure function oi_get_dense_enabled(this) result(rst) Gets the explicit dense-output preparation setting. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if explicit dense-output preparation is enabled; otherwise,\nfalse. This setting is independent of preparation required to\nproduce values on a requested output grid. procedure( multistep_error_constant ), public, deferred, pass :: get_error_constant Gets the error constant for the requested order. pure function multistep_error_constant(this, k) result(rst) Prototype Returns the constant relating the difference between the\ncorrected and predicted solutions to the local truncation error\nof the method at the requested order. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: k The order of interest. Return Value real(kind=real64) The error constant. procedure, public :: get_maximum_order => mi_get_max_order Gets the upper limit on the order of the method. private pure function mi_get_max_order(this) result(rst) Gets the upper limit on the order of the method. The value reported is the limit actually in force, which is the lesser\nof any limit requested by the caller and the highest order the method\nsupports. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The order limit. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. private pure function oi_get_max_step(this) result(rst) Gets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure( multistep_integer_inquiry ), public, deferred, pass :: get_maximum_supported_order Gets the highest order the method is permitted to use. pure function multistep_integer_inquiry(this) result(rst) Prototype Returns an integer value from the multistep_integrator object. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The requested value. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. private pure function oi_get_min_step(this) result(rst) Gets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. private pure function oi_get_ode_results(this) result(rst) Returns a copy of the solution computed as a ode_results container.\nThe integrator retains the original copy. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value type( ode_results ) The ode_results container. procedure, public :: get_order => mi_get_order Gets the order currently in use. private pure function mi_get_order(this) result(rst) Gets the order of the integrator currently in use. A variable-order method changes this value as the integration proceeds,\nso it reports the order of the most recently attempted step. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The order. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. private pure function oi_get_rel_tol(this, equation) result(rst) Gets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. private pure function oi_get_solution(this) result(rst) Returns the solution computed by the integrator stored as a matrix with\nthe first column containing the values of the independent variable at\nwhich the solution was computed.  The remaining columns contain the\nsolutions for each of the integrated equations in the order in which they\nappear in the source routine.  Notice, the solve routine must be called\nbefore this routine. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64), allocatable, dimension(:,:) The resulting solution matrix. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. private pure function oi_get_step_limit(this) result(rst) Gets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The step limit. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. private pure function oi_get_control_parameter(this) result(rst) Gets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. private pure function oi_get_safety_factor(this) result(rst) Gets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The safety factor. procedure, public :: get_stored_derivative => mi_get_stored_f Gets a stored derivative vector. private pure function mi_get_stored_f(this, i) result(rst) Gets a stored derivative vector, where an index of one denotes the most\nrecently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64), allocatable, dimension(:) The stored derivative. procedure, public :: get_stored_solution => mi_get_stored_y Gets a stored solution vector. private pure function mi_get_stored_y(this, i) result(rst) Gets a stored solution vector, where an index of one denotes the most\nrecently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64), allocatable, dimension(:) The stored solution. procedure, public :: get_stored_step_count => mi_get_stored_count Gets the number of solution points held in the history. private pure function mi_get_stored_count(this) result(rst) Gets the number of previously accepted solution points currently held in\nthe history. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The number of stored points. procedure, public :: get_stored_variable => mi_get_stored_x Gets a stored independent variable value. private pure function mi_get_stored_x(this, i) result(rst) Gets a stored value of the independent variable, where an index of one\ndenotes the most recently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64) The stored value. procedure( multistep_error_constant ), public, deferred, pass :: get_truncation_constant Gets the truncation error constant for the requested order. pure function multistep_error_constant(this, k) result(rst) Prototype Returns the constant relating the difference between the\ncorrected and predicted solutions to the local truncation error\nof the method at the requested order. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: k The order of interest. Return Value real(kind=real64) The error constant. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. private pure function oi_has_dense_output(this) result(rst) Determines whether a prepared accepted-step interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if dense output is currently valid; otherwise, false. procedure, public :: interpolate => mi_interpolate Interpolates the solution history to the requested point. private  subroutine mi_interpolate(this, x, y) Interpolates the stored solution history to the requested value of the\nindependent variable. The polynomial passing through the most recently accepted points is the\nsame polynomial on which the method itself is based, so dense output\ncarries the accuracy of the current order and costs no additional\nfunction evaluations. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. real(kind=real64), intent(in) :: x The value of the independent variable at which to compute the\ninterpolation. real(kind=real64), intent(out), dimension(:) :: y An N-element array where the interpolated solution is written. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. private  subroutine oi_invalidate_dense(this) Marks any prepared dense-output interpolant as unavailable. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. private  subroutine oi_log_failed_step(this, n) Logs a failed integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. private  subroutine oi_log_function_eval(this, n) Logs a function evaluation, or evaluations. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one function \nevaluation.  If not supplied, this routine will log a single \nfunction evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. private  subroutine oi_log_jacobian_eval(this, n) Logs a Jacobian matrix evaluation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one Jacobian matrix\nevaluation.  If not supplied, this routine will log a single\nJacobian evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. private  subroutine oi_log_matrix_factorization(this, n) Logs a matrix factorization. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one matrix \nfactorization.  If not supplied, this routine will log a single\nfactorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. private  subroutine oi_log_successful_step(this, n) Logs a successful integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure( predictor_step ), public, deferred, pass :: predictor Evaluates the predictor. subroutine predictor_step(this, sys, h, x, y, f, yn, fn, args) Prototype Evaluates the predictor. Besides supplying the initial estimate for the Newton iteration,\nthis routine is the natural place for a concrete integrator to\ncompute any step-dependent quantities, such as method\ncoefficients, that the corrector requires.  It is called exactly\nonce per step attempt. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y The current value(s) of the dependent variable(s). real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x.  For a system carrying a mass matrix these are the\nvalues of rather than of . real(kind=real64), intent(out), dimension(:) :: yn An N-element array where this routine will write the next\nsolution estimate at x + h. real(kind=real64), intent(out), dimension(:) :: fn An N-element array where this routine will write the next\nderivative estimate at x + h. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: prepare_for_solve => mi_prepare_for_solve Prepares internal state for the beginning of an integration. private  subroutine mi_prepare_for_solve(this) Performs whatever preparation the integrator requires at the beginning\nof an integration. The default implementation does nothing.  An integrator that caches a\nmatrix factorization between steps overrides this routine to discard it,\nso that reusing the object with a different model cannot pick up stale\ninformation. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. procedure, public :: reset_history => mi_reset_history Clears the stored solution history. private  subroutine mi_reset_history(this) Clears the stored solution history. The integrator restarts at first order the next time it is used. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols private  subroutine oi_set_abs_tol(this, x) Sets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_abs_tols(this, x) Sets the absolute error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private  subroutine oi_set_allow_overshoot(this, x) Sets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. logical, intent(in) :: x True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. private  subroutine oi_set_dense_interval(this, x_start, x_end, n) Publishes the interval covered by retained dense-output interpolation\ndata for one accepted step. The endpoints are recorded in integration\norder, which may be increasing or decreasing. The interpolant is marked\nvalid after the interval and state dimension have been recorded.\nAn error stop occurs if either endpoint is non-finite, the endpoints\nare equal, or the state dimension is less than one. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. real(kind=real64), intent(in) :: x_start The first endpoint of the accepted step in integration order. real(kind=real64), intent(in) :: x_end The second endpoint of the accepted step in integration order. integer, intent(in) :: n The number of dependent variables represented by the interpolant. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). private  subroutine oi_set_dense_enabled(this, enabled) Enables or disables explicit dense-output preparation.\nWhen enabled, the integrator prepares dense output for each accepted\nstep independently of whether the requested output grid requires it.\nDisabling this setting does not prevent dense output needed to produce\nrequested solution values. Any previously prepared step is invalidated. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. logical, intent(in) :: enabled True to enable explicit dense-output preparation; false to disable it. procedure, public :: set_maximum_order => mi_set_max_order Sets the upper limit on the order of the method. private  subroutine mi_set_max_order(this, x) Sets the upper limit on the order of the method. The value is constrained to the range supported by the method. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. integer, intent(in) :: x The order limit. procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. private  subroutine oi_set_max_step(this, x) Sets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. private  subroutine oi_set_min_step(this, x) Sets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols private  subroutine oi_set_rel_tol(this, x) Sets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_rel_tols(this, x) Sets the relative error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. private  subroutine oi_set_step_limit(this, x) Sets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in) :: x The step limit. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. private  subroutine oi_set_control_parameter(this, x) Sets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The control parameter procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. private  subroutine oi_set_safety_factor(this, x) Sets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The safety factor. procedure, public :: solve => mi_ode_solver Solves the supplied system of ODE's. private  subroutine mi_ode_solver(this, sys, x, iv, store_iv, args) Solves the supplied system of ODE's. The integration is driven by a predictor-corrector cycle.  Each step\nextrapolates the solution history to form a prediction, refines that\nprediction with Newton iteration on the implicit formula, and compares\nthe two to estimate the local error.  A step whose error satisfies the\nrequested tolerances is accepted and appended to the history; otherwise\nit is retried on a shorter step. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array of independent variable values at which to return the\nsolution to the ODE's.  If only two values are supplied, the\nsolution is returned at every successful integration step. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine.","tags":"","url":"type\\multistep_integrator.html"},{"title":"newton_multistep_integrator – DIFFEQ ","text":"type, public, abstract, extends( multistep_integrator ) :: newton_multistep_integrator Defines the structure of a multi-step integrator whose corrector\nequation is solved by Newton iteration. Solving the corrector by Newton iteration requires a Jacobian, but\nin return it places no restriction upon the stiffness of the problem\nand permits a singular mass matrix, as the mass matrix then appears\nonly as a factor within the iteration matrix. Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. private  subroutine oi_append_to_buffer(this, x, y) Appends the supplied solution point to the internal solution buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The independent variable value. real(kind=real64), intent(in), dimension(:) :: y The values of the dependent variables corresponding to x. procedure( build_linearized_system ), public, deferred, pass :: build_linear_system Builds the linearized system for the implicit corrector. subroutine build_linearized_system(this, sys, h, x, y, A, b, args) Prototype Builds the linearized system used to compute the solution for the\nimplicit step via Newton iteration.  This routine forms matrices and of the system . Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y The current value(s) of the dependent variable(s). real(kind=real64), intent(out), dimension(:,:) :: A The N-by-N matrix , where, for BDF methods at least, . real(kind=real64), intent(out), dimension(:) :: b The N-element right-hand-side vector for the linear system.\nThis vector is the negative of the corrector residual so\nthat the Newton update is . class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. private  subroutine oi_clear_buffer(this) Clears the contents of the buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. procedure, public :: compute_dense_output => mi_dense_output private  subroutine mi_dense_output(this, x, y) Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this real(kind=real64), intent(in) :: x real(kind=real64), intent(out) :: y (:) procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. private pure function oi_estimate_error(this, y, yest, yerr) result(rst) Computes the norm of the scaled error estimate.  A value less than one\nindicates a successful step.  A value greater than one suggests that the\nresults do not meet the requested tolerances. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: y The previously accepted solution array (N-element). real(kind=real64), intent(in), dimension(size(y)) :: yest An N-element array containing the next solution point estimate. real(kind=real64), intent(in), dimension(size(y)) :: yerr An N-element array containing the estimate of error for each\nequation. Return Value real(kind=real64) The norm of the scaled error. procedure, public :: correct => mi_newton_iteration Performs the Newton iteration process. private  subroutine mi_newton_iteration(this, sys, h, x, ypred, ynew, converged, args) Performs the Newton iteration process. The iteration solves the implicit corrector equation supplied by\nbuild_linear_system.  That system is solved by means of a\nrank-revealing orthogonal factorization, so a singular mass matrix is\ntolerated provided the iteration matrix itself remains nonsingular, as\nis the case for an index-1 problem. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: ypred The N-element array containing the predicted values at x + h. real(kind=real64), intent(out), dimension(:) :: ynew The new estimate of the dependent variables. logical, intent(out) :: converged True if the Newton iteration process converged; else, false. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information in and \nout of the differential equation subroutine. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. private  subroutine oi_initial_step(this, sys, xo, xf, yo, fo, h, args) Computes an estimate of an initial step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: xo The initial value of the independent variable. real(kind=real64), intent(in) :: xf The final value of the independent variable. real(kind=real64), intent(in), dimension(:) :: yo The initial values of the dependent variables (N-element). real(kind=real64), intent(out), dimension(size(yo)) :: fo An N-element array where the function values at xo will be written. real(kind=real64), intent(out) :: h The initial step size estimate. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. private  function oi_next_step(this, e, eold, h, x) result(rst) Estimates the next step size based upon the current and previous error\nestimates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: e The norm of the current scaled error estimate. real(kind=real64), intent(inout) :: eold The norm of the previous step's scaled error estimate.  On output,\nthis variable is updated. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current independent variable value. Return Value real(kind=real64) The new step size estimate. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. private  subroutine oi_evaluate_dense(this, x, y) Evaluates the interpolant for the last prepared accepted step at a\nrequested independent-variable value. The query must be finite and\nwithin the step interval, including either endpoint. This operation\ndoes not advance or otherwise change solver state and does not evaluate\nthe ODE function. An error stop occurs if no valid interpolant is\navailable, the output array has the wrong size, or the query is\nnon-finite or outside the interval. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator containing the prepared interpolant. real(kind=real64), intent(in) :: x The independent-variable value at which to evaluate the solution. real(kind=real64), intent(out) :: y (:) Receives the interpolated dependent-variable values. Its size must\nequal the number of dependent variables in the prepared step. procedure, public :: evaluate_derivative => mi_evaluate_derivative Evaluates the derivative stored in the solution history. private  subroutine mi_evaluate_derivative(this, sys, x, y, dydx, args) Evaluates the derivative that the solution history stores. The default implementation simply evaluates the right-hand side, which\nis correct whenever the mass matrix is the identity.  An integrator that\nrequires itself, rather than , overrides this routine to\nresolve the mass matrix. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: x The value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the solution at x. real(kind=real64), intent(out), dimension(:) :: dydx An N-element array where the derivative will be written. class(*), intent(inout), optional :: args An optional argument that can be used to pass information in and out\nof the differential equation subroutine. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. private pure function oi_get_abs_tol(this, equation) result(rst) Gets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private pure function oi_get_allow_overshoot(this) result(rst) Gets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value logical True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. private  subroutine oi_get_dense_interval(this, x_start, x_end) Gets the endpoints of the currently prepared dense-output interval.\nAn error stop occurs if no valid interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. real(kind=real64), intent(out) :: x_start Receives the first endpoint in integration order. real(kind=real64), intent(out) :: x_end Receives the second endpoint in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. private pure function oi_get_dense_enabled(this) result(rst) Gets the explicit dense-output preparation setting. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if explicit dense-output preparation is enabled; otherwise,\nfalse. This setting is independent of preparation required to\nproduce values on a requested output grid. procedure( multistep_error_constant ), public, deferred, pass :: get_error_constant Gets the error constant for the requested order. pure function multistep_error_constant(this, k) result(rst) Prototype Returns the constant relating the difference between the\ncorrected and predicted solutions to the local truncation error\nof the method at the requested order. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: k The order of interest. Return Value real(kind=real64) The error constant. procedure, public :: get_maximum_order => mi_get_max_order Gets the upper limit on the order of the method. private pure function mi_get_max_order(this) result(rst) Gets the upper limit on the order of the method. The value reported is the limit actually in force, which is the lesser\nof any limit requested by the caller and the highest order the method\nsupports. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The order limit. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. private pure function oi_get_max_step(this) result(rst) Gets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure( multistep_integer_inquiry ), public, deferred, pass :: get_maximum_supported_order Gets the highest order the method is permitted to use. pure function multistep_integer_inquiry(this) result(rst) Prototype Returns an integer value from the multistep_integrator object. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The requested value. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. private pure function oi_get_min_step(this) result(rst) Gets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_newton_step_limit => mi_get_newton_step_limit Gets the maximum number of Newton iterations allowed. private pure function mi_get_newton_step_limit(this) result(rst) Gets the maximum number of Newton iterations allowed. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(in) :: this The newton_multistep_integrator object. Return Value integer The iteration limit. procedure, public :: get_newton_tolerance => mi_get_newton_tolerance Gets the Newton iteration convergence tolerance. private pure function mi_get_newton_tolerance(this) result(rst) Gets the convergence tolerance on the Euclidean norm of the residual\nfor the Newton iteration process. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(in) :: this The newton_multistep_integrator object. Return Value real(kind=real64) The convergence tolerance. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. private pure function oi_get_ode_results(this) result(rst) Returns a copy of the solution computed as a ode_results container.\nThe integrator retains the original copy. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value type( ode_results ) The ode_results container. procedure, public :: get_order => mi_get_order Gets the order currently in use. private pure function mi_get_order(this) result(rst) Gets the order of the integrator currently in use. A variable-order method changes this value as the integration proceeds,\nso it reports the order of the most recently attempted step. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The order. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. private pure function oi_get_rel_tol(this, equation) result(rst) Gets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. private pure function oi_get_solution(this) result(rst) Returns the solution computed by the integrator stored as a matrix with\nthe first column containing the values of the independent variable at\nwhich the solution was computed.  The remaining columns contain the\nsolutions for each of the integrated equations in the order in which they\nappear in the source routine.  Notice, the solve routine must be called\nbefore this routine. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64), allocatable, dimension(:,:) The resulting solution matrix. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. private pure function oi_get_step_limit(this) result(rst) Gets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The step limit. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. private pure function oi_get_control_parameter(this) result(rst) Gets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. private pure function oi_get_safety_factor(this) result(rst) Gets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The safety factor. procedure, public :: get_stored_derivative => mi_get_stored_f Gets a stored derivative vector. private pure function mi_get_stored_f(this, i) result(rst) Gets a stored derivative vector, where an index of one denotes the most\nrecently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64), allocatable, dimension(:) The stored derivative. procedure, public :: get_stored_solution => mi_get_stored_y Gets a stored solution vector. private pure function mi_get_stored_y(this, i) result(rst) Gets a stored solution vector, where an index of one denotes the most\nrecently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64), allocatable, dimension(:) The stored solution. procedure, public :: get_stored_step_count => mi_get_stored_count Gets the number of solution points held in the history. private pure function mi_get_stored_count(this) result(rst) Gets the number of previously accepted solution points currently held in\nthe history. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The number of stored points. procedure, public :: get_stored_variable => mi_get_stored_x Gets a stored independent variable value. private pure function mi_get_stored_x(this, i) result(rst) Gets a stored value of the independent variable, where an index of one\ndenotes the most recently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64) The stored value. procedure( multistep_error_constant ), public, deferred, pass :: get_truncation_constant Gets the truncation error constant for the requested order. pure function multistep_error_constant(this, k) result(rst) Prototype Returns the constant relating the difference between the\ncorrected and predicted solutions to the local truncation error\nof the method at the requested order. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: k The order of interest. Return Value real(kind=real64) The error constant. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. private pure function oi_has_dense_output(this) result(rst) Determines whether a prepared accepted-step interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if dense output is currently valid; otherwise, false. procedure, public :: interpolate => mi_interpolate Interpolates the solution history to the requested point. private  subroutine mi_interpolate(this, x, y) Interpolates the stored solution history to the requested value of the\nindependent variable. The polynomial passing through the most recently accepted points is the\nsame polynomial on which the method itself is based, so dense output\ncarries the accuracy of the current order and costs no additional\nfunction evaluations. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. real(kind=real64), intent(in) :: x The value of the independent variable at which to compute the\ninterpolation. real(kind=real64), intent(out), dimension(:) :: y An N-element array where the interpolated solution is written. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. private  subroutine oi_invalidate_dense(this) Marks any prepared dense-output interpolant as unavailable. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. private  subroutine oi_log_failed_step(this, n) Logs a failed integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. private  subroutine oi_log_function_eval(this, n) Logs a function evaluation, or evaluations. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one function \nevaluation.  If not supplied, this routine will log a single \nfunction evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. private  subroutine oi_log_jacobian_eval(this, n) Logs a Jacobian matrix evaluation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one Jacobian matrix\nevaluation.  If not supplied, this routine will log a single\nJacobian evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. private  subroutine oi_log_matrix_factorization(this, n) Logs a matrix factorization. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one matrix \nfactorization.  If not supplied, this routine will log a single\nfactorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. private  subroutine oi_log_successful_step(this, n) Logs a successful integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: newton_iteration => mi_newton_iteration Performs the Newton iteration process. private  subroutine mi_newton_iteration(this, sys, h, x, ypred, ynew, converged, args) Performs the Newton iteration process. The iteration solves the implicit corrector equation supplied by\nbuild_linear_system.  That system is solved by means of a\nrank-revealing orthogonal factorization, so a singular mass matrix is\ntolerated provided the iteration matrix itself remains nonsingular, as\nis the case for an index-1 problem. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: ypred The N-element array containing the predicted values at x + h. real(kind=real64), intent(out), dimension(:) :: ynew The new estimate of the dependent variables. logical, intent(out) :: converged True if the Newton iteration process converged; else, false. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information in and \nout of the differential equation subroutine. procedure( predictor_step ), public, deferred, pass :: predictor Evaluates the predictor. subroutine predictor_step(this, sys, h, x, y, f, yn, fn, args) Prototype Evaluates the predictor. Besides supplying the initial estimate for the Newton iteration,\nthis routine is the natural place for a concrete integrator to\ncompute any step-dependent quantities, such as method\ncoefficients, that the corrector requires.  It is called exactly\nonce per step attempt. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y The current value(s) of the dependent variable(s). real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x.  For a system carrying a mass matrix these are the\nvalues of rather than of . real(kind=real64), intent(out), dimension(:) :: yn An N-element array where this routine will write the next\nsolution estimate at x + h. real(kind=real64), intent(out), dimension(:) :: fn An N-element array where this routine will write the next\nderivative estimate at x + h. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: prepare_for_solve => mi_prepare_for_solve Prepares internal state for the beginning of an integration. private  subroutine mi_prepare_for_solve(this) Performs whatever preparation the integrator requires at the beginning\nof an integration. The default implementation does nothing.  An integrator that caches a\nmatrix factorization between steps overrides this routine to discard it,\nso that reusing the object with a different model cannot pick up stale\ninformation. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. procedure, public :: reset_history => mi_reset_history Clears the stored solution history. private  subroutine mi_reset_history(this) Clears the stored solution history. The integrator restarts at first order the next time it is used. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols private  subroutine oi_set_abs_tol(this, x) Sets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_abs_tols(this, x) Sets the absolute error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private  subroutine oi_set_allow_overshoot(this, x) Sets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. logical, intent(in) :: x True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. private  subroutine oi_set_dense_interval(this, x_start, x_end, n) Publishes the interval covered by retained dense-output interpolation\ndata for one accepted step. The endpoints are recorded in integration\norder, which may be increasing or decreasing. The interpolant is marked\nvalid after the interval and state dimension have been recorded.\nAn error stop occurs if either endpoint is non-finite, the endpoints\nare equal, or the state dimension is less than one. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. real(kind=real64), intent(in) :: x_start The first endpoint of the accepted step in integration order. real(kind=real64), intent(in) :: x_end The second endpoint of the accepted step in integration order. integer, intent(in) :: n The number of dependent variables represented by the interpolant. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). private  subroutine oi_set_dense_enabled(this, enabled) Enables or disables explicit dense-output preparation.\nWhen enabled, the integrator prepares dense output for each accepted\nstep independently of whether the requested output grid requires it.\nDisabling this setting does not prevent dense output needed to produce\nrequested solution values. Any previously prepared step is invalidated. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. logical, intent(in) :: enabled True to enable explicit dense-output preparation; false to disable it. procedure, public :: set_maximum_order => mi_set_max_order Sets the upper limit on the order of the method. private  subroutine mi_set_max_order(this, x) Sets the upper limit on the order of the method. The value is constrained to the range supported by the method. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. integer, intent(in) :: x The order limit. procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. private  subroutine oi_set_max_step(this, x) Sets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. private  subroutine oi_set_min_step(this, x) Sets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_newton_step_limit => mi_set_newton_step_limit Sets the maximum number of Newton iterations allowed. private  subroutine mi_set_newton_step_limit(this, x) Sets the maximum number of Newton iterations allowed. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. integer, intent(in) :: x The iteration limit. procedure, public :: set_newton_tolerance => mi_set_newton_tolerance Sets the Newton iteration convergence tolerance. private  subroutine mi_set_newton_tolerance(this, x) Sets the convergence tolerance on the Euclidean norm of the residual\nfor the Newton iteration process. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. real(kind=real64), intent(in) :: x The convergence tolerance. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols private  subroutine oi_set_rel_tol(this, x) Sets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_rel_tols(this, x) Sets the relative error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. private  subroutine oi_set_step_limit(this, x) Sets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in) :: x The step limit. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. private  subroutine oi_set_control_parameter(this, x) Sets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The control parameter procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. private  subroutine oi_set_safety_factor(this, x) Sets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The safety factor. procedure, public :: solve => mi_ode_solver Solves the supplied system of ODE's. private  subroutine mi_ode_solver(this, sys, x, iv, store_iv, args) Solves the supplied system of ODE's. The integration is driven by a predictor-corrector cycle.  Each step\nextrapolates the solution history to form a prediction, refines that\nprediction with Newton iteration on the implicit formula, and compares\nthe two to estimate the local error.  A step whose error satisfies the\nrequested tolerances is accepted and appended to the history; otherwise\nit is retried on a shorter step. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array of independent variable values at which to return the\nsolution to the ODE's.  If only two values are supplied, the\nsolution is returned at every successful integration step. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine.","tags":"","url":"type\\newton_multistep_integrator.html"},{"title":"ggl_container – DIFFEQ ","text":"type, public, extends( ode_container ) :: ggl_container Mechanical model adapter implementing stabilized index-1 GGL. Use this type instead of ode_container when reducing an index-3\nholonomically constrained mechanical model. Call initialize and\nassign all required callbacks before using an index-1 DAE solver.\nFor N coordinates and M constraints, the state and RHS layout is All constraint vectors use the same M-component ordering. The inherited fcn has a specialized contract here: its input is\n[q,v] of length 2N and its output is the applied force F of length N,\nexcluding multiplier forces. The optional inherited mass_matrix receives q of length N and writes the physical N-by-N mass matrix;\nif absent, the physical matrix is identity. Set the inherited mass\ndependency flag true whenever this matrix varies with x or q. An optional inherited jacobian must differentiate the complete\naugmented RHS with respect to z, not just the applied force. Without\nit, the inherited finite-difference implementation differentiates\nthis container's compute_rhs . User args are never used as internal\nworkspace. Callbacks must accept perturbed, off-manifold states.\nThe inherited fcn_ad is not supported: differentiating only the\napplied force would omit the real-valued constraint assembly.\nAssigning fcn_ad causes DIFFEQ_INVALID_OPERATION_ERROR. Components Type Visibility Attributes Name Initial procedure( dae_constraint_curvature ), public, pointer, nopass :: constraint_curvature => null() Required callback for . procedure( ode_jacobian ), public, pointer, nopass :: constraint_jacobian => null() Required callback receiving q and writing the M-by-N matrix . No finite-difference fallback is used. procedure( dae_algebraic_constraints ), public, pointer, nopass :: constraints => null() Required callback receiving N coordinates q and writing M\nautonomous position residuals g(q), including off-manifold values. procedure( ode_event_function ), public, pointer, nopass :: event_function => null() A pointer to the event function. procedure( ode ), public, pointer, nopass :: fcn => null() A pointer to the routine containing the ODEs to integrate. procedure( ode_ad ), public, pointer, nopass :: fcn_ad => null() A pointer to the routine containing the ODEs to integrate.  Use\nthis pointer instead of fcn when automatic differentiation is\ndesired for calculation of the Jacobian.  Do not use both\npointers as this will produce an error.  If fcn is utilized,\nthen the Jacobian will be computed by either a user-supplied\nJacobian callback or by finite differences.  If this pointer\nis utilized, then the Jacobian will be computed by either a\nuser-supplied Jacobian callback or automatic differentiation.\nIn either case a user-supplied Jacobian callback is the preferred\noption falling back to either finite differences or automatic\ndifferentiation in its absence. procedure( ode_jacobian ), public, pointer, nopass :: jacobian => null() A pointer to the routine containing the analytical Jacobian.\nTakes precedence over AD and finite differences. If null, the\nselected RHS representation determines the differentiation method. procedure( ode_mass_matrix ), public, pointer, nopass :: mass_matrix => null() A pointer to the routine containing the mass matrix for the\nsystem.  If set to null (the default), an identity mass matrix \nwill be assumed. Constructor public        interface ggl_container private  function ggl_constructor_1(coordinate_count, constraint_count, alpha, beta) result(rst) Defines the mechanical dimensions and resets stabilization gains to one\nunless supplied. Callback associations and inherited model options are\nretained. Invalid counts or gains cause DIFFEQ_INVALID_INPUT_ERROR. Arguments Type Intent Optional Attributes Name integer, intent(in) :: coordinate_count Positive number N of coordinates and physical velocities. integer, intent(in) :: constraint_count Number M of independent constraints, with 1 <= M <= N. real(kind=real64), intent(in), optional :: alpha Nonnegative finite position and velocity decay rates, respectively,\nin inverse independent-variable units. Zero disables the respective\ndamping term without disabling the differentiated constraint. real(kind=real64), intent(in), optional :: beta Nonnegative finite position and velocity decay rates, respectively,\nin inverse independent-variable units. Zero disables the respective\ndamping term without disabling the differentiated constraint. Return Value type( ggl_container ) The new ggl_container object. Type-Bound Procedures procedure, public :: compute_jacobian => oc_jacobian private  subroutine oc_jacobian(this, x, y, jac, args) Computes df/dy, holding x fixed. Uses an explicit Jacobian if supplied,\notherwise AD (N RHS calls) or forward differences (N+1 RHS calls).\nThe most recent callback count is available through\nget_jacobian_function_evaluations. An explicit Jacobian counts as zero\nRHS calls; calls made inside user-owned Jacobian code are not tracked. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. real(kind=real64), intent(in) :: x The current independent variable value. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current dependent\nvariable values. real(kind=real64), intent(out), dimension(:,:) :: jac An N-by-N matrix where the Jacobian will be written. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: compute_mass_matrix => ggl_mass private  subroutine ggl_mass(this, x, y, m, args) Assembles diag(I,M,0,0). Both multiplier blocks and their cross blocks\nare zero. No constraints or force callbacks are needed for this operation.\nUninitialized/wrong state sizes or matrix sizes are diagnosed explicitly. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(inout) :: this Container defining dimensions and the optional physical mass. real(kind=real64), intent(in) :: x Current independent-variable value. real(kind=real64), intent(in), dimension(:) :: y Augmented state [q,v,lambda,mu] of length 2N+2M. real(kind=real64), intent(out), dimension(:,:) :: m Square augmented matrix with side length 2N+2M. A wrong shape\ncauses DIFFEQ_MATRIX_SIZE_ERROR. class(*), intent(inout), optional :: args Optional user parameters forwarded to the physical mass callback. procedure, public :: compute_rhs => ggl_rhs private  subroutine ggl_rhs(this, x, y, dydx, args) Assembles the four RHS blocks documented on ggl_container . The\noutput is a mass-matrix RHS, not the full derivative z'. Only the\nphysical mass is resolved to compute the acceleration residual.\nMissing callbacks cause NULL_POINTER; invalid state/output lengths\ncause INVALID_INPUT/ARRAY_SIZE; singular physical mass causes SINGULAR_MATRIX. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(inout) :: this Initialized container with all required callbacks assigned. real(kind=real64), intent(in) :: x Current independent-variable value. real(kind=real64), intent(in), dimension(:) :: y State [q,v,lambda,mu] of length 2N+2M; off-manifold values are allowed. real(kind=real64), intent(out), dimension(:) :: dydx 2N+2M RHS entries, ordered as kinematics, momentum, stabilized\nposition residual, and stabilized velocity residual. class(*), intent(inout), optional :: args Optional user parameters forwarded unchanged to every callback. procedure, public :: compute_time_derivative => oc_time_derivative private  subroutine oc_time_derivative(this, x, y, f, dfdx, args) Computes partial df/dx with y fixed, using one RHS callback evaluation.\nAD seeds x only. Real callbacks use a forward difference with the\nsupplied unperturbed RHS f. Mass-matrix derivatives are not included. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The model to differentiate. real(kind=real64), intent(in) :: x Independent-variable value. real(kind=real64), intent(in) :: y (:) State and the previously computed RHS at (x,y). real(kind=real64), intent(in) :: f (:) State and the previously computed RHS at (x,y). real(kind=real64), intent(out) :: dfdx (:) Partial time derivative, with the same length as y. class(*), intent(inout), optional :: args User-owned callback data, forwarded unchanged. procedure, public :: get_event_equation_count => oc_get_event_eqn_count private pure function oc_get_event_eqn_count(this) result(rst) Gets the number of event functions. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value integer The equation count. procedure, public :: get_finite_difference_step => oc_get_fd_step private pure function oc_get_fd_step(this) result(rst) Gets the size of the step to use for the finite difference\ncalculations used to estimate the Jacobian. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value real(kind=real64) The step size. procedure, public :: get_is_mass_matrix_dependent => oc_get_is_mass_dependent private pure function oc_get_is_mass_dependent(this) result(rst) Gets a value determining if the mass matrix is state-dependent\nsuch that it requires updating at every integration step. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value logical True if the mass matrix is state-dependent such that it \nrequires updating at each integration step; else, false if the\nmass matrix is not state-dependent and can be treated as constant\nfor all integration steps. procedure, public :: get_is_ode_defined => ggl_is_defined private  function ggl_is_defined(this) result(rst) Checks configuration and all required callback associations. This does\nnot evaluate callbacks or certify constraint rank or mass regularity. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(in) :: this Container whose model definition is inspected. Return Value logical True only for initialized dimensions and associated force, position,\nconstraint-Jacobian, and curvature callbacks. Mass is optional. procedure, public :: get_is_ode_event_function_defined => oc_is_event_fcn_defined private  function oc_is_event_fcn_defined(this) result(rst) Tests to see if the event function has been defined. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value logical True if the event function has been defined; else, false. procedure, public :: get_jacobian_function_evaluations => oc_get_jacobian_calls private  function oc_get_jacobian_calls(this) result(rst) Returns RHS calls made by the last compute_jacobian (initially zero).\nSolvers use this count for both AD and finite-difference statistics.\nExtensions overriding compute_jacobian should override this query if\ntheir implementation makes additional RHS calls. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The model whose most recent Jacobian work is queried. Return Value integer Number of RHS calls, excluding the explicit Jacobian callback. procedure, public :: get_state_count => ggl_state_count private  function ggl_state_count(this) result(rst) Returns 2N+2M, or zero before dimensions have been initialized. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(in) :: this Container whose augmented state size is queried. Return Value integer Required length of the state, initial conditions, and RHS arrays. procedure, public :: has_mass_matrix => ggl_has_mass private  function ggl_has_mass(this) result(rst) Always returns true: the augmented matrix is singular even when the\nphysical matrix defaults to identity. Explicit ODE paths are unsuitable. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(in) :: this Container being queried; initialization is not required. Return Value logical True, indicating that a mass-matrix DAE path is required. procedure, public :: initialize => ggl_initialize private  subroutine ggl_initialize(this, coordinate_count, constraint_count, alpha, beta) Defines the mechanical dimensions and resets stabilization gains to one\nunless supplied. Callback associations and inherited model options are\nretained. Invalid counts or gains cause DIFFEQ_INVALID_INPUT_ERROR. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(inout) :: this Container to configure. integer, intent(in) :: coordinate_count Positive number N of coordinates and physical velocities. integer, intent(in) :: constraint_count Number M of independent constraints, with 1 <= M <= N. real(kind=real64), intent(in), optional :: alpha Nonnegative finite position and velocity decay rates, respectively,\nin inverse independent-variable units. Zero disables the respective\ndamping term without disabling the differentiated constraint. real(kind=real64), intent(in), optional :: beta Nonnegative finite position and velocity decay rates, respectively,\nin inverse independent-variable units. Zero disables the respective\ndamping term without disabling the differentiated constraint. procedure, public :: initialize_multipliers => ggl_initialize_multipliers private  subroutine ggl_initialize_multipliers(this, x, y, args) Computes mu and lambda to satisfy the two stabilized algebraic rows\nfor the supplied q and v. Coordinates and physical velocities are not\nprojected or changed, even if they violate the original constraints.\nSingular GG&#94;T, physical mass, or GM&#94;{-1}G&#94;T causes SINGULAR_MATRIX. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(inout) :: this Initialized container with all required callbacks assigned. real(kind=real64), intent(in) :: x Initial independent-variable value. real(kind=real64), intent(inout), dimension(:) :: y Full [q,v,lambda,mu] state. Input multipliers are ignored and replaced;\noutput multipliers are algebraically consistent to solve accuracy. class(*), intent(inout), optional :: args Optional user-owned parameters forwarded to model callbacks. procedure, public :: set_event_equation_count => oc_set_event_eqn_count private  subroutine oc_set_event_eqn_count(this, x) Sets the number of event functions. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. integer, intent(in) :: x The equation count. procedure, public :: set_finite_difference_step => oc_set_fd_step private  subroutine oc_set_fd_step(this, x) Sets the size of the step to use for the finite difference\ncalculations used to estimate the Jacobian. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. real(kind=real64), intent(in) :: x The step size. procedure, public :: set_is_mass_matrix_dependent => oc_set_is_mass_dependent private  subroutine oc_set_is_mass_dependent(this, x) Sets a value determining if the mass matrix is state-dependent\nsuch that it requires updating at every integration step. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. logical :: x True if the mass matrix is state-dependent such that it \nrequires updating at each integration step; else, false if the\nmass matrix is not state-dependent and can be treated as constant\nfor all integration steps. procedure, public :: set_stabilization_parameters => ggl_set_stabilization private  subroutine ggl_set_stabilization(this, alpha, beta) Sets the two independent constraint decay rates. Negative or nonfinite\nvalues cause DIFFEQ_INVALID_INPUT_ERROR. No state projection is performed. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(inout) :: this Configured or unconfigured container whose gains are to be changed. real(kind=real64), intent(in) :: alpha Position and velocity decay rates, respectively; both have units\nof inverse time when x is time. Zero preserves rather than damps\nthe corresponding residual in the exact solution. real(kind=real64), intent(in) :: beta Position and velocity decay rates, respectively; both have units\nof inverse time when x is time. Zero preserves rather than damps\nthe corresponding residual in the exact solution. procedure, public :: use_finite_difference_jacobian => oc_use_finite_difference_jacobian private  function oc_use_finite_difference_jacobian(this) result(rst) States if a finite difference approximation to the Jacobian is utilized. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value logical True if a finite difference approximation is being utilized; else,\nfalse. procedure, public :: validate_initial_conditions => ggl_validate private  function ggl_validate(this, x, y, tolerance, args) result(rst) Checks max(abs(g)) and max(abs(Gv)) against one absolute tolerance.\nThis tests physical position/velocity consistency, not the multiplier\nequations, and never changes the state. Choose units/scaling so one\ntolerance is meaningful for both residuals. Nonfinite residuals fail. Arguments Type Intent Optional Attributes Name class( ggl_container ), intent(inout) :: this Initialized container; only constraints and their Jacobian are needed. real(kind=real64), intent(in) :: x Independent-variable value passed to the callbacks. real(kind=real64), intent(in), dimension(:) :: y Augmented initial state of length 2N+2M. real(kind=real64), intent(in) :: tolerance Finite nonnegative absolute residual threshold; invalid values\ncause DIFFEQ_INVALID_INPUT_ERROR. class(*), intent(inout), optional :: args Optional user parameters forwarded without using internal workspace. Return Value logical True when both physical residuals are finite and within tolerance.","tags":"","url":"type\\ggl_container.html"},{"title":"c_ode_settings – DIFFEQ ","text":"type, public, bind(C) :: c_ode_settings A container for ODE settings. Components Type Visibility Attributes Name Initial real(kind=c_double), public :: absolute_tolerance The absolute tolerance applied to each equation. logical(kind=c_bool), public :: allow_overshoot True if the solver is allowed to overshoot the final value in\nthe integration range and interpolate back; else, false if the\nsolver must terminate on the final value. real(kind=c_double), public :: beta PI step size controller exponent.  Set to zero to turn off PI\nstep size control. logical(kind=c_bool), public :: mass_matrix_constant True if the mass matrix is constant regardless of state, or\nfalse if the mass matrix is state-dependent. real(kind=c_double), public :: maximum_step_size The maximum allowed integrator step size. real(kind=c_double), public :: minimum_step_size The minimum allowed integrator step size. integer(kind=c_int), public :: newton_step_limit The maximum number of Newton iterations allowed per implicit\nsolve (BDF and Kennedy-Carpenter). real(kind=c_double), public :: newton_tolerance The convergence tolerance for Newton iteration (BDF and\nKennedy-Carpenter). real(kind=c_double), public :: relative_tolerance The relative tolerance applied to each equation. integer(kind=c_int), public :: step_limit The limit on the maximum total number of integration steps.","tags":"","url":"type\\c_ode_settings.html"},{"title":"single_step_integrator – DIFFEQ ","text":"type, public, abstract, extends( ode_integrator ) :: single_step_integrator The most basic, single-step integrator object capable of integrating\nsystems of ODE's. Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. private  subroutine oi_append_to_buffer(this, x, y) Appends the supplied solution point to the internal solution buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The independent variable value. real(kind=real64), intent(in), dimension(:) :: y The values of the dependent variables corresponding to x. procedure( attempt_single_step ), public, deferred, pass :: attempt_step Attempts an integration step for a single-step integrator. subroutine attempt_single_step(this, sys, h, x, y, f, yn, fn, yerr, k, args) Prototype Attempts an integration step for a single-step integrator. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current solution at x. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x. real(kind=real64), intent(out), dimension(:) :: yn An N-element array where this routine will write the next\nsolution estimate at x + h. real(kind=real64), intent(out), dimension(:) :: fn An N-element array where this routine will write the next\nderivative estimate at x + h. real(kind=real64), intent(out), dimension(:) :: yerr An N-element array where this routine will write an estimate\nof the error in each equation. real(kind=real64), intent(out), dimension(:,:) :: k An N-by-NSTAGES matrix containing the derivatives at each\nstage. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. private  subroutine oi_clear_buffer(this) Clears the contents of the buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. procedure, public :: compute_dense_output => ssi_dense_output private  subroutine ssi_dense_output(this, x, y) Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this real(kind=real64), intent(in) :: x real(kind=real64), intent(out) :: y (:) procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. private pure function oi_estimate_error(this, y, yest, yerr) result(rst) Computes the norm of the scaled error estimate.  A value less than one\nindicates a successful step.  A value greater than one suggests that the\nresults do not meet the requested tolerances. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: y The previously accepted solution array (N-element). real(kind=real64), intent(in), dimension(size(y)) :: yest An N-element array containing the next solution point estimate. real(kind=real64), intent(in), dimension(size(y)) :: yerr An N-element array containing the estimate of error for each\nequation. Return Value real(kind=real64) The norm of the scaled error. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. private  subroutine oi_initial_step(this, sys, xo, xf, yo, fo, h, args) Computes an estimate of an initial step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: xo The initial value of the independent variable. real(kind=real64), intent(in) :: xf The final value of the independent variable. real(kind=real64), intent(in), dimension(:) :: yo The initial values of the dependent variables (N-element). real(kind=real64), intent(out), dimension(size(yo)) :: fo An N-element array where the function values at xo will be written. real(kind=real64), intent(out) :: h The initial step size estimate. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. private  function oi_next_step(this, e, eold, h, x) result(rst) Estimates the next step size based upon the current and previous error\nestimates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: e The norm of the current scaled error estimate. real(kind=real64), intent(inout) :: eold The norm of the previous step's scaled error estimate.  On output,\nthis variable is updated. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current independent variable value. Return Value real(kind=real64) The new step size estimate. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. private  subroutine oi_evaluate_dense(this, x, y) Evaluates the interpolant for the last prepared accepted step at a\nrequested independent-variable value. The query must be finite and\nwithin the step interval, including either endpoint. This operation\ndoes not advance or otherwise change solver state and does not evaluate\nthe ODE function. An error stop occurs if no valid interpolant is\navailable, the output array has the wrong size, or the query is\nnon-finite or outside the interval. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator containing the prepared interpolant. real(kind=real64), intent(in) :: x The independent-variable value at which to evaluate the solution. real(kind=real64), intent(out) :: y (:) Receives the interpolated dependent-variable values. Its size must\nequal the number of dependent variables in the prepared step. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. private pure function oi_get_abs_tol(this, equation) result(rst) Gets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private pure function oi_get_allow_overshoot(this) result(rst) Gets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value logical True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. private  subroutine oi_get_dense_interval(this, x_start, x_end) Gets the endpoints of the currently prepared dense-output interval.\nAn error stop occurs if no valid interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. real(kind=real64), intent(out) :: x_start Receives the first endpoint in integration order. real(kind=real64), intent(out) :: x_end Receives the second endpoint in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. private pure function oi_get_dense_enabled(this) result(rst) Gets the explicit dense-output preparation setting. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if explicit dense-output preparation is enabled; otherwise,\nfalse. This setting is independent of preparation required to\nproduce values on a requested output grid. procedure( get_single_step_logical_parameter ), public, deferred, pass :: get_is_fsal Gets a logical parameter stating if this is a first-same-as-last\n(FSAL) integrator. pure function get_single_step_logical_parameter(this) result(rst) Prototype Returns a logical parameter from a single_step_integrator object. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this The single_step_integrator object. Return Value logical The parameter. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. private pure function oi_get_max_step(this) result(rst) Gets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. private pure function oi_get_min_step(this) result(rst) Gets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. private pure function oi_get_ode_results(this) result(rst) Returns a copy of the solution computed as a ode_results container.\nThe integrator retains the original copy. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value type( ode_results ) The ode_results container. procedure( ode_integer_inquiry ), public, deferred, pass :: get_order Returns the order of the integrator. pure function ode_integer_inquiry(this) result(rst) Prototype Returns an integer value from the ode_integrator object. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The requested value. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. private pure function oi_get_rel_tol(this, equation) result(rst) Gets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. private pure function oi_get_solution(this) result(rst) Returns the solution computed by the integrator stored as a matrix with\nthe first column containing the values of the independent variable at\nwhich the solution was computed.  The remaining columns contain the\nsolutions for each of the integrated equations in the order in which they\nappear in the source routine.  Notice, the solve routine must be called\nbefore this routine. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64), allocatable, dimension(:,:) The resulting solution matrix. procedure( single_step_integer_inquiry ), public, deferred, pass :: get_stage_count Gets the number of stages used by the integrator. pure function single_step_integer_inquiry(this) result(rst) Prototype Gets an integer from the integrator. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this The single_step_integrator object. Return Value integer The integer value. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. private pure function oi_get_step_limit(this) result(rst) Gets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The step limit. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. private pure function oi_get_control_parameter(this) result(rst) Gets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. private pure function oi_get_safety_factor(this) result(rst) Gets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The safety factor. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. private pure function oi_has_dense_output(this) result(rst) Determines whether a prepared accepted-step interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if dense output is currently valid; otherwise, false. procedure( single_step_interpolate ), public, deferred, pass :: interpolate Performs an interpolation to estimate the solution at the\nrequested point. subroutine single_step_interpolate(this, x, xn, yn, fn, xn1, yn1, fn1, y) Prototype Provides a routine for interpolation. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this The single_step_integrator object. real(kind=real64), intent(in) :: x The value of the independent variable at which to compute\nthe interpolation. real(kind=real64), intent(in) :: xn The previous value of the independent variable at which the\nsolution is computed. real(kind=real64), intent(in), dimension(:) :: yn An N-element array containing the solution at xn. real(kind=real64), intent(in), dimension(:) :: fn An N-element array containing the derivatives at xn. real(kind=real64), intent(in) :: xn1 The value of the independent variable at xn + h. real(kind=real64), intent(in), dimension(:) :: yn1 An N-element array containing the solution at xn + h. real(kind=real64), intent(in), dimension(:) :: fn1 An N-element array containing the derivatives at xn + h. real(kind=real64), intent(out), dimension(:) :: y An N-element array where this routine will write the \nsolution values interpolated at x. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. private  subroutine oi_invalidate_dense(this) Marks any prepared dense-output interpolant as unavailable. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. private  subroutine oi_log_failed_step(this, n) Logs a failed integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. private  subroutine oi_log_function_eval(this, n) Logs a function evaluation, or evaluations. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one function \nevaluation.  If not supplied, this routine will log a single \nfunction evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. private  subroutine oi_log_jacobian_eval(this, n) Logs a Jacobian matrix evaluation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one Jacobian matrix\nevaluation.  If not supplied, this routine will log a single\nJacobian evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. private  subroutine oi_log_matrix_factorization(this, n) Logs a matrix factorization. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one matrix \nfactorization.  If not supplied, this routine will log a single\nfactorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. private  subroutine oi_log_successful_step(this, n) Logs a successful integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure( single_step_post_step_routine ), public, deferred, pass :: post_step_action Performs actions such as setting up interpolation after \ncompletion of a successful integration step. subroutine single_step_post_step_routine(this, sys, dense, x, xn, y, yn, f, fn, k, args) Prototype Provides a routine for performing any actions, such as setting\nup interpolation, after successful completion of a step. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. logical, intent(in) :: dense Determines if dense output is requested (true); else, false. real(kind=real64), intent(in) :: x The previous value of the independent variable. real(kind=real64), intent(in) :: xn The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the solution at x. real(kind=real64), intent(in), dimension(:) :: yn An N-element array containing the solution at xn. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the derivatives at x. real(kind=real64), intent(in), dimension(:) :: fn An N-element array containing the derivatives at xn. real(kind=real64), intent(inout), dimension(:,:) :: k An N-by-NSTAGES matrix containing the derivatives at each\nstage. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure( single_step_pre_step_routine ), public, deferred, pass :: pre_step_action Provides a routine for performing any actions, such as setting\nup Jacobian calculations. subroutine single_step_pre_step_routine(this, prevs, sys, h, x, y, f, args) Prototype Provides a routine for performing any actions, such as setting\nup Jacobian calculations. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. logical, intent(in) :: prevs Defines the status of the previous step.  The value is true \nif the previous step was successful; else, false if the \nprevious step failed. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current solution at x. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols private  subroutine oi_set_abs_tol(this, x) Sets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_abs_tols(this, x) Sets the absolute error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private  subroutine oi_set_allow_overshoot(this, x) Sets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. logical, intent(in) :: x True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. private  subroutine oi_set_dense_interval(this, x_start, x_end, n) Publishes the interval covered by retained dense-output interpolation\ndata for one accepted step. The endpoints are recorded in integration\norder, which may be increasing or decreasing. The interpolant is marked\nvalid after the interval and state dimension have been recorded.\nAn error stop occurs if either endpoint is non-finite, the endpoints\nare equal, or the state dimension is less than one. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. real(kind=real64), intent(in) :: x_start The first endpoint of the accepted step in integration order. real(kind=real64), intent(in) :: x_end The second endpoint of the accepted step in integration order. integer, intent(in) :: n The number of dependent variables represented by the interpolant. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). private  subroutine oi_set_dense_enabled(this, enabled) Enables or disables explicit dense-output preparation.\nWhen enabled, the integrator prepares dense output for each accepted\nstep independently of whether the requested output grid requires it.\nDisabling this setting does not prevent dense output needed to produce\nrequested solution values. Any previously prepared step is invalidated. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. logical, intent(in) :: enabled True to enable explicit dense-output preparation; false to disable it. procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. private  subroutine oi_set_max_step(this, x) Sets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. private  subroutine oi_set_min_step(this, x) Sets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols private  subroutine oi_set_rel_tol(this, x) Sets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_rel_tols(this, x) Sets the relative error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. private  subroutine oi_set_step_limit(this, x) Sets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in) :: x The step limit. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. private  subroutine oi_set_control_parameter(this, x) Sets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The control parameter procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. private  subroutine oi_set_safety_factor(this, x) Sets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The safety factor. procedure, public :: solve => ssi_ode_solver Solves the supplied system of ODE's. public  subroutine ssi_ode_solver (this, sys, x, iv, store_iv, args) Solves the supplied system of ODE's. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array of independent variable values at which to return the \nthe solution to the ODE's. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine.","tags":"","url":"type\\single_step_integrator.html"},{"title":"ode_container – DIFFEQ ","text":"type, public :: ode_container Defines the callbacks and model options for an ODE problem. The required right-hand-side callback describes . Optional callbacks provide an analytical\nJacobian and a mass matrix for\nsystems of the form . If no Jacobian is\nsupplied, DIFFEQ uses AD when fcn_ad is assigned, or finite differences\nwhen fcn is assigned. Assign exactly one RHS callback. A null\nmass-matrix callback means that . Components Type Visibility Attributes Name Initial procedure( ode_event_function ), public, pointer, nopass :: event_function => null() A pointer to the event function. procedure( ode ), public, pointer, nopass :: fcn => null() A pointer to the routine containing the ODEs to integrate. procedure( ode_ad ), public, pointer, nopass :: fcn_ad => null() A pointer to the routine containing the ODEs to integrate.  Use\nthis pointer instead of fcn when automatic differentiation is\ndesired for calculation of the Jacobian.  Do not use both\npointers as this will produce an error.  If fcn is utilized,\nthen the Jacobian will be computed by either a user-supplied\nJacobian callback or by finite differences.  If this pointer\nis utilized, then the Jacobian will be computed by either a\nuser-supplied Jacobian callback or automatic differentiation.\nIn either case a user-supplied Jacobian callback is the preferred\noption falling back to either finite differences or automatic\ndifferentiation in its absence. procedure( ode_jacobian ), public, pointer, nopass :: jacobian => null() A pointer to the routine containing the analytical Jacobian.\nTakes precedence over AD and finite differences. If null, the\nselected RHS representation determines the differentiation method. procedure( ode_mass_matrix ), public, pointer, nopass :: mass_matrix => null() A pointer to the routine containing the mass matrix for the\nsystem.  If set to null (the default), an identity mass matrix \nwill be assumed. Type-Bound Procedures procedure, public :: compute_jacobian => oc_jacobian private  subroutine oc_jacobian(this, x, y, jac, args) Computes df/dy, holding x fixed. Uses an explicit Jacobian if supplied,\notherwise AD (N RHS calls) or forward differences (N+1 RHS calls).\nThe most recent callback count is available through\nget_jacobian_function_evaluations. An explicit Jacobian counts as zero\nRHS calls; calls made inside user-owned Jacobian code are not tracked. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. real(kind=real64), intent(in) :: x The current independent variable value. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current dependent\nvariable values. real(kind=real64), intent(out), dimension(:,:) :: jac An N-by-N matrix where the Jacobian will be written. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: compute_mass_matrix => oc_eval_mass_matrix private  subroutine oc_eval_mass_matrix(this, x, y, m, args) Evaluates the mass matrix defined by the function pointer 'mass_matrix'.\nIf no function is assigned to 'mass_matrix' this routine returns an\nappropriately sized identity matrix. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current values of the\ndependent variables. real(kind=real64), intent(out), dimension(:,:) :: m An N-by-N matrix where the class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the routine. procedure, public :: compute_rhs => oc_eval_rhs private  subroutine oc_eval_rhs(this, x, y, dydx, args) Evaluates fcn or fcn_ad. AD inputs have zero seeds and only output values\nare extracted. Missing callbacks cause DIFFEQ_NULL_POINTER_ERROR;\nassigning both representations causes DIFFEQ_INVALID_OPERATION_ERROR. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current values of the\ndependent variables. real(kind=real64), intent(out), dimension(:) :: dydx An N-element array where the derivative values will be\nwritten. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the routine. procedure, public :: compute_time_derivative => oc_time_derivative private  subroutine oc_time_derivative(this, x, y, f, dfdx, args) Computes partial df/dx with y fixed, using one RHS callback evaluation.\nAD seeds x only. Real callbacks use a forward difference with the\nsupplied unperturbed RHS f. Mass-matrix derivatives are not included. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The model to differentiate. real(kind=real64), intent(in) :: x Independent-variable value. real(kind=real64), intent(in) :: y (:) State and the previously computed RHS at (x,y). real(kind=real64), intent(in) :: f (:) State and the previously computed RHS at (x,y). real(kind=real64), intent(out) :: dfdx (:) Partial time derivative, with the same length as y. class(*), intent(inout), optional :: args User-owned callback data, forwarded unchanged. procedure, public :: get_event_equation_count => oc_get_event_eqn_count private pure function oc_get_event_eqn_count(this) result(rst) Gets the number of event functions. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value integer The equation count. procedure, public :: get_finite_difference_step => oc_get_fd_step private pure function oc_get_fd_step(this) result(rst) Gets the size of the step to use for the finite difference\ncalculations used to estimate the Jacobian. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value real(kind=real64) The step size. procedure, public :: get_is_mass_matrix_dependent => oc_get_is_mass_dependent private pure function oc_get_is_mass_dependent(this) result(rst) Gets a value determining if the mass matrix is state-dependent\nsuch that it requires updating at every integration step. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value logical True if the mass matrix is state-dependent such that it \nrequires updating at each integration step; else, false if the\nmass matrix is not state-dependent and can be treated as constant\nfor all integration steps. procedure, public :: get_is_ode_defined => oc_get_is_ode_defined private  function oc_get_is_ode_defined(this) result(rst) Gets a logical value determining if the ODE routine has been defined.\nThis function also ensures that only either fcn or fcn_ad has been\ndefined.  If both have been defined a DIFFEQ_INVALID_OPERATION_ERROR\nis thrown. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value logical True if the ODE routine has been defined; else, false. procedure, public :: get_is_ode_event_function_defined => oc_is_event_fcn_defined private  function oc_is_event_fcn_defined(this) result(rst) Tests to see if the event function has been defined. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value logical True if the event function has been defined; else, false. procedure, public :: get_jacobian_function_evaluations => oc_get_jacobian_calls private  function oc_get_jacobian_calls(this) result(rst) Returns RHS calls made by the last compute_jacobian (initially zero).\nSolvers use this count for both AD and finite-difference statistics.\nExtensions overriding compute_jacobian should override this query if\ntheir implementation makes additional RHS calls. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The model whose most recent Jacobian work is queried. Return Value integer Number of RHS calls, excluding the explicit Jacobian callback. procedure, public :: has_mass_matrix => oc_has_mass_matrix private  function oc_has_mass_matrix(this) result(rst) Returns true if the problem utilizes a mass matrix. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value logical True if a mass matrix is utilized; else, false. procedure, public :: set_event_equation_count => oc_set_event_eqn_count private  subroutine oc_set_event_eqn_count(this, x) Sets the number of event functions. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. integer, intent(in) :: x The equation count. procedure, public :: set_finite_difference_step => oc_set_fd_step private  subroutine oc_set_fd_step(this, x) Sets the size of the step to use for the finite difference\ncalculations used to estimate the Jacobian. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. real(kind=real64), intent(in) :: x The step size. procedure, public :: set_is_mass_matrix_dependent => oc_set_is_mass_dependent private  subroutine oc_set_is_mass_dependent(this, x) Sets a value determining if the mass matrix is state-dependent\nsuch that it requires updating at every integration step. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(inout) :: this The ode_container object. logical :: x True if the mass matrix is state-dependent such that it \nrequires updating at each integration step; else, false if the\nmass matrix is not state-dependent and can be treated as constant\nfor all integration steps. procedure, public :: use_finite_difference_jacobian => oc_use_finite_difference_jacobian private  function oc_use_finite_difference_jacobian(this) result(rst) States if a finite difference approximation to the Jacobian is utilized. Arguments Type Intent Optional Attributes Name class( ode_container ), intent(in) :: this The ode_container object. Return Value logical True if a finite difference approximation is being utilized; else,\nfalse.","tags":"","url":"type\\ode_container.html"},{"title":"ode_event_solver – DIFFEQ ","text":"type, public :: ode_event_solver Provides a mechanism for event detection. Components Type Visibility Attributes Name Initial type( ode_event_statistics ), public :: solver_statistics Event solver information. Type-Bound Procedures procedure, public :: find_event => oes_find_event Attempts to find any events within a specified bracket. private  function oes_find_event(this, fcn, integrator, neqn, x1, y1, x2, y2, x, y, args) result(rst) Attempts to find an event via Brent's method for root finding for each\nof the M event equations (M does not have to be equal to the number\nof state equations).  If no events are found, this function simply\nreturns false.  If a root, or roots, are found, the first occurring\nroot is returned, and iteration statistics are updated in the ode_event_solver . A root at the initial bound is ignored so an\nintegration restarted at an event can advance; a root at the terminal\nbound is still reported. If no event function has been defined a DIFFEQ_NULL_POINTER_ERROR is\nthrown. Arguments Type Intent Optional Attributes Name class( ode_event_solver ), intent(inout) :: this The ode_event_solver object. procedure( ode_event_function ), intent(in), pointer :: fcn The ode_event_function . class( ode_integrator ), intent(in) :: integrator The ode_integrator being used to integrate the ODE's. integer, intent(in) :: neqn The number of event equations.  This value must be at least 1; else,\na DIFFEQ_INVALID_INPUT_ERROR is thrown. real(kind=real64), intent(in) :: x1 The initial bound of the search region. real(kind=real64), intent(in), dimension(:) :: y1 The N-element state vector at x1. real(kind=real64), intent(in) :: x2 The terminal bound of the search region.  This value must be\ndifferent than x2 by an amount larger than machine epsilon; else,\na DIFFEQ_INVALID_OPERATION_ERROR is thrown. real(kind=real64), intent(in), dimension(:) :: y2 The N-element state vector at x2.  This array must be sized to match\nx1; else, a DIFFEQ_ARRAY_SIZE_ERROR is thrown. real(kind=real64), intent(out) :: x The value of the independent variable at which the root is found.\nIf no root is found, this value is returned as a NaN. real(kind=real64), intent(out), dimension(:) :: y The N-element array containing the state vector at x.  If no root\nis found, this array is populated with NaN.  This array must be\nsized to match x1; else, a DIFFEQ_ARRAY_SIZE_ERROR is thrown. class(*), intent(inout), optional :: args An optional argument that can be used to pass information in and out\nof the routine. Return Value logical True if the process converged to a root; else, false. procedure, public :: get_max_allowed_iterations => oes_get_max_iter Gets the number of iterations the solver is allowed to take. private pure function oes_get_max_iter(this) result(rst) Gets the maximum number of iterations allowed for the root-finding solver. Arguments Type Intent Optional Attributes Name class( ode_event_solver ), intent(in) :: this The ode_event_solver object. Return Value integer The iteration count limit. procedure, public :: get_solver_tolerance => oes_get_tol Gets the solver tolerance. private pure function oes_get_tol(this) result(rst) Gets the root-finding solver tolerance. Arguments Type Intent Optional Attributes Name class( ode_event_solver ), intent(in) :: this The ode_event_solver object. Return Value real(kind=real64) The tolerance value. procedure, public :: is_event_suspected => oes_event_in_bracket Determines if an event is suspected to exist within the &\nspecified bracket. private pure function oes_event_in_bracket(this, f1, f2, index) result(rst) Tests to see if a root is likely to exist in the given bracket. Arguments Type Intent Optional Attributes Name class( ode_event_solver ), intent(in) :: this The ode_event_solver object. real(kind=real64), intent(in), dimension(:) :: f1 An M-element array containing the values of the M event functions at\nthe initial interval point. real(kind=real64), intent(in), dimension(:) :: f2 An M-element array containing the values of the M event functions at\nthe terminal interval point.  An DIFFEQ_ARRAY_SIZE_ERROR is thrown\nif this array is not the same size as f1. integer(kind=int32), intent(in) :: index The index of the event function to validate.  The index must exist\non the interval [1, M], where M is the number of event functions.  A\nDIFFEQ_INVALID_INPUT_ERROR is thrown if index is outside this \ninterval. Return Value logical True if an event is suspected to exist within the bracket; else,\nfalse. procedure, public :: set_max_allowed_iterations => oes_set_max_iter Sets the number of iterations the solver is allowed to take. private  subroutine oes_set_max_iter(this, x) Sets the maximum number of iterations allowed for the root-finding solver. Arguments Type Intent Optional Attributes Name class( ode_event_solver ), intent(inout) :: this The ode_event_solver object. integer, intent(in) :: x The iteration count limit. procedure, public :: set_solver_tolerance => oes_set_tol Sets the solver tolerance. private  subroutine oes_set_tol(this, x) Sets the root-finding solver tolerance. Arguments Type Intent Optional Attributes Name class( ode_event_solver ), intent(inout) :: this The ode_event_solver object. real(kind=real64), intent(in) :: x The tolerance value.","tags":"","url":"type\\ode_event_solver.html"},{"title":"ode_event_statistics – DIFFEQ ","text":"type, public :: ode_event_statistics An ODE event solver statistics container. Components Type Visibility Attributes Name Initial integer, public :: event_index = 0 The index of the event equation where an event was located. integer, public :: function_evaluations = 0 The number of event function evaluations. integer, public :: iteration_count = 0 The number of iterations taken by the solver.","tags":"","url":"type\\ode_event_statistics.html"},{"title":"ode_integrator – DIFFEQ ","text":"type, public, abstract :: ode_integrator Abstract base class for all DIFFEQ ODE integrators. Every concrete integrator accepts an ode_container , an array of\noutput coordinates, and an initial state. Adaptive solvers use a\nscaled local error such as to choose their step sizes. Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. private  subroutine oi_append_to_buffer(this, x, y) Appends the supplied solution point to the internal solution buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The independent variable value. real(kind=real64), intent(in), dimension(:) :: y The values of the dependent variables corresponding to x. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. private  subroutine oi_clear_buffer(this) Clears the contents of the buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. procedure( ode_dense_output ), public, deferred, pass :: compute_dense_output Implementation hook for evaluating a validated dense-output query. subroutine ode_dense_output(this, x, y) Prototype Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this real(kind=real64), intent(in) :: x real(kind=real64), intent(out) :: y (:) procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. private pure function oi_estimate_error(this, y, yest, yerr) result(rst) Computes the norm of the scaled error estimate.  A value less than one\nindicates a successful step.  A value greater than one suggests that the\nresults do not meet the requested tolerances. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: y The previously accepted solution array (N-element). real(kind=real64), intent(in), dimension(size(y)) :: yest An N-element array containing the next solution point estimate. real(kind=real64), intent(in), dimension(size(y)) :: yerr An N-element array containing the estimate of error for each\nequation. Return Value real(kind=real64) The norm of the scaled error. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. private  subroutine oi_initial_step(this, sys, xo, xf, yo, fo, h, args) Computes an estimate of an initial step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: xo The initial value of the independent variable. real(kind=real64), intent(in) :: xf The final value of the independent variable. real(kind=real64), intent(in), dimension(:) :: yo The initial values of the dependent variables (N-element). real(kind=real64), intent(out), dimension(size(yo)) :: fo An N-element array where the function values at xo will be written. real(kind=real64), intent(out) :: h The initial step size estimate. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. private  function oi_next_step(this, e, eold, h, x) result(rst) Estimates the next step size based upon the current and previous error\nestimates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: e The norm of the current scaled error estimate. real(kind=real64), intent(inout) :: eold The norm of the previous step's scaled error estimate.  On output,\nthis variable is updated. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current independent variable value. Return Value real(kind=real64) The new step size estimate. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. private  subroutine oi_evaluate_dense(this, x, y) Evaluates the interpolant for the last prepared accepted step at a\nrequested independent-variable value. The query must be finite and\nwithin the step interval, including either endpoint. This operation\ndoes not advance or otherwise change solver state and does not evaluate\nthe ODE function. An error stop occurs if no valid interpolant is\navailable, the output array has the wrong size, or the query is\nnon-finite or outside the interval. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator containing the prepared interpolant. real(kind=real64), intent(in) :: x The independent-variable value at which to evaluate the solution. real(kind=real64), intent(out) :: y (:) Receives the interpolated dependent-variable values. Its size must\nequal the number of dependent variables in the prepared step. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. private pure function oi_get_abs_tol(this, equation) result(rst) Gets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private pure function oi_get_allow_overshoot(this) result(rst) Gets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value logical True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. private  subroutine oi_get_dense_interval(this, x_start, x_end) Gets the endpoints of the currently prepared dense-output interval.\nAn error stop occurs if no valid interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. real(kind=real64), intent(out) :: x_start Receives the first endpoint in integration order. real(kind=real64), intent(out) :: x_end Receives the second endpoint in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. private pure function oi_get_dense_enabled(this) result(rst) Gets the explicit dense-output preparation setting. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if explicit dense-output preparation is enabled; otherwise,\nfalse. This setting is independent of preparation required to\nproduce values on a requested output grid. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. private pure function oi_get_max_step(this) result(rst) Gets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. private pure function oi_get_min_step(this) result(rst) Gets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. private pure function oi_get_ode_results(this) result(rst) Returns a copy of the solution computed as a ode_results container.\nThe integrator retains the original copy. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value type( ode_results ) The ode_results container. procedure( ode_integer_inquiry ), public, deferred, pass :: get_order Returns the order of the integrator. pure function ode_integer_inquiry(this) result(rst) Prototype Returns an integer value from the ode_integrator object. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The requested value. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. private pure function oi_get_rel_tol(this, equation) result(rst) Gets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. private pure function oi_get_solution(this) result(rst) Returns the solution computed by the integrator stored as a matrix with\nthe first column containing the values of the independent variable at\nwhich the solution was computed.  The remaining columns contain the\nsolutions for each of the integrated equations in the order in which they\nappear in the source routine.  Notice, the solve routine must be called\nbefore this routine. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64), allocatable, dimension(:,:) The resulting solution matrix. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. private pure function oi_get_step_limit(this) result(rst) Gets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The step limit. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. private pure function oi_get_control_parameter(this) result(rst) Gets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. private pure function oi_get_safety_factor(this) result(rst) Gets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The safety factor. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. private pure function oi_has_dense_output(this) result(rst) Determines whether a prepared accepted-step interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if dense output is currently valid; otherwise, false. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. private  subroutine oi_invalidate_dense(this) Marks any prepared dense-output interpolant as unavailable. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. private  subroutine oi_log_failed_step(this, n) Logs a failed integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. private  subroutine oi_log_function_eval(this, n) Logs a function evaluation, or evaluations. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one function \nevaluation.  If not supplied, this routine will log a single \nfunction evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. private  subroutine oi_log_jacobian_eval(this, n) Logs a Jacobian matrix evaluation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one Jacobian matrix\nevaluation.  If not supplied, this routine will log a single\nJacobian evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. private  subroutine oi_log_matrix_factorization(this, n) Logs a matrix factorization. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one matrix \nfactorization.  If not supplied, this routine will log a single\nfactorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. private  subroutine oi_log_successful_step(this, n) Logs a successful integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols Sets the absolute error tolerance. private  subroutine oi_set_abs_tol(this, x) Sets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_abs_tols(this, x) Sets the absolute error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private  subroutine oi_set_allow_overshoot(this, x) Sets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. logical, intent(in) :: x True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. private  subroutine oi_set_dense_interval(this, x_start, x_end, n) Publishes the interval covered by retained dense-output interpolation\ndata for one accepted step. The endpoints are recorded in integration\norder, which may be increasing or decreasing. The interpolant is marked\nvalid after the interval and state dimension have been recorded.\nAn error stop occurs if either endpoint is non-finite, the endpoints\nare equal, or the state dimension is less than one. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. real(kind=real64), intent(in) :: x_start The first endpoint of the accepted step in integration order. real(kind=real64), intent(in) :: x_end The second endpoint of the accepted step in integration order. integer, intent(in) :: n The number of dependent variables represented by the interpolant. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). private  subroutine oi_set_dense_enabled(this, enabled) Enables or disables explicit dense-output preparation.\nWhen enabled, the integrator prepares dense output for each accepted\nstep independently of whether the requested output grid requires it.\nDisabling this setting does not prevent dense output needed to produce\nrequested solution values. Any previously prepared step is invalidated. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. logical, intent(in) :: enabled True to enable explicit dense-output preparation; false to disable it. procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. private  subroutine oi_set_max_step(this, x) Sets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. private  subroutine oi_set_min_step(this, x) Sets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols Sets the relative error tolerance. private  subroutine oi_set_rel_tol(this, x) Sets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_rel_tols(this, x) Sets the relative error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. private  subroutine oi_set_step_limit(this, x) Sets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in) :: x The step limit. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. private  subroutine oi_set_control_parameter(this, x) Sets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The control parameter procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. private  subroutine oi_set_safety_factor(this, x) Sets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The safety factor. procedure( ode_solver ), public, deferred, pass :: solve Solves the supplied system of ODE's. subroutine ode_solver(this, sys, x, iv, store_iv, args) Prototype Solves the supplied system of ODE's. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array, of at least 2 values, defining at a minimum\nthe starting and ending values of the independent variable \nintegration range.  If more than two values are specified, \nthe integration results will be returned at the supplied \nvalues. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine.","tags":"","url":"type\\ode_integrator.html"},{"title":"bdf – DIFFEQ ","text":"type, public, extends( newton_multistep_integrator ) :: bdf A variable step-size, variable order (1-5) BDF integrator for stiff\nsystems and index-1 differential-algebraic equations. The iteration matrix formed for the Newton corrector is which is assembled and factored rather than requiring to be\ninverted.  A singular mass matrix is therefore permitted: rows of that are identically zero impose algebraic constraints, and\nthe problem becomes a differential-algebraic equation.  So long as\nthat system is of index one, remains nonsingular and the\nsolver proceeds normally. The method restarts at first order, so it does not require a\nconsistent initial derivative.  Initial conditions that satisfy the\nalgebraic constraints are still recommended, as the first step must\notherwise absorb the inconsistency. Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. private  subroutine oi_append_to_buffer(this, x, y) Appends the supplied solution point to the internal solution buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The independent variable value. real(kind=real64), intent(in), dimension(:) :: y The values of the dependent variables corresponding to x. procedure, public :: build_linear_system => bdf_build_linear_system Builds the linearized system for the implicit corrector. private  subroutine bdf_build_linear_system(this, sys, h, x, y, A, b, args) Builds the linearized system used to compute the solution for the\nimplicit step via Newton iteration. The corrector residual is where collects the contribution of the stored history, and its\nJacobian is .  The mass matrix appears only as a factor\nand is never inverted, which is what allows a singular to be used. Arguments Type Intent Optional Attributes Name class( bdf ), intent(inout) :: this The bdf object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size.  The step size is already carried by the\ncoefficients formed by the predictor, so it is not used here. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y The current value(s) of the dependent variable(s). real(kind=real64), intent(out), dimension(:,:) :: A The N-by-N matrix , where . real(kind=real64), intent(out), dimension(:) :: b The N-element right-hand-side vector for the linear system. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information in and out\nof the differential equation subroutine. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. private  subroutine oi_clear_buffer(this) Clears the contents of the buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. procedure, public :: compute_dense_output => mi_dense_output private  subroutine mi_dense_output(this, x, y) Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this real(kind=real64), intent(in) :: x real(kind=real64), intent(out) :: y (:) procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. private pure function oi_estimate_error(this, y, yest, yerr) result(rst) Computes the norm of the scaled error estimate.  A value less than one\nindicates a successful step.  A value greater than one suggests that the\nresults do not meet the requested tolerances. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: y The previously accepted solution array (N-element). real(kind=real64), intent(in), dimension(size(y)) :: yest An N-element array containing the next solution point estimate. real(kind=real64), intent(in), dimension(size(y)) :: yerr An N-element array containing the estimate of error for each\nequation. Return Value real(kind=real64) The norm of the scaled error. procedure, public :: correct => mi_newton_iteration Performs the Newton iteration process. private  subroutine mi_newton_iteration(this, sys, h, x, ypred, ynew, converged, args) Performs the Newton iteration process. The iteration solves the implicit corrector equation supplied by\nbuild_linear_system.  That system is solved by means of a\nrank-revealing orthogonal factorization, so a singular mass matrix is\ntolerated provided the iteration matrix itself remains nonsingular, as\nis the case for an index-1 problem. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: ypred The N-element array containing the predicted values at x + h. real(kind=real64), intent(out), dimension(:) :: ynew The new estimate of the dependent variables. logical, intent(out) :: converged True if the Newton iteration process converged; else, false. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information in and \nout of the differential equation subroutine. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. private  subroutine oi_initial_step(this, sys, xo, xf, yo, fo, h, args) Computes an estimate of an initial step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: xo The initial value of the independent variable. real(kind=real64), intent(in) :: xf The final value of the independent variable. real(kind=real64), intent(in), dimension(:) :: yo The initial values of the dependent variables (N-element). real(kind=real64), intent(out), dimension(size(yo)) :: fo An N-element array where the function values at xo will be written. real(kind=real64), intent(out) :: h The initial step size estimate. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. private  function oi_next_step(this, e, eold, h, x) result(rst) Estimates the next step size based upon the current and previous error\nestimates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: e The norm of the current scaled error estimate. real(kind=real64), intent(inout) :: eold The norm of the previous step's scaled error estimate.  On output,\nthis variable is updated. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current independent variable value. Return Value real(kind=real64) The new step size estimate. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. private  subroutine oi_evaluate_dense(this, x, y) Evaluates the interpolant for the last prepared accepted step at a\nrequested independent-variable value. The query must be finite and\nwithin the step interval, including either endpoint. This operation\ndoes not advance or otherwise change solver state and does not evaluate\nthe ODE function. An error stop occurs if no valid interpolant is\navailable, the output array has the wrong size, or the query is\nnon-finite or outside the interval. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator containing the prepared interpolant. real(kind=real64), intent(in) :: x The independent-variable value at which to evaluate the solution. real(kind=real64), intent(out) :: y (:) Receives the interpolated dependent-variable values. Its size must\nequal the number of dependent variables in the prepared step. procedure, public :: evaluate_derivative => mi_evaluate_derivative Evaluates the derivative stored in the solution history. private  subroutine mi_evaluate_derivative(this, sys, x, y, dydx, args) Evaluates the derivative that the solution history stores. The default implementation simply evaluates the right-hand side, which\nis correct whenever the mass matrix is the identity.  An integrator that\nrequires itself, rather than , overrides this routine to\nresolve the mass matrix. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: x The value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the solution at x. real(kind=real64), intent(out), dimension(:) :: dydx An N-element array where the derivative will be written. class(*), intent(inout), optional :: args An optional argument that can be used to pass information in and out\nof the differential equation subroutine. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. private pure function oi_get_abs_tol(this, equation) result(rst) Gets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private pure function oi_get_allow_overshoot(this) result(rst) Gets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value logical True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. private  subroutine oi_get_dense_interval(this, x_start, x_end) Gets the endpoints of the currently prepared dense-output interval.\nAn error stop occurs if no valid interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. real(kind=real64), intent(out) :: x_start Receives the first endpoint in integration order. real(kind=real64), intent(out) :: x_end Receives the second endpoint in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. private pure function oi_get_dense_enabled(this) result(rst) Gets the explicit dense-output preparation setting. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if explicit dense-output preparation is enabled; otherwise,\nfalse. This setting is independent of preparation required to\nproduce values on a requested output grid. procedure, public :: get_error_constant => bdf_error_constant Gets the error constant for the requested order. private pure function bdf_error_constant(this, k) result(rst) Gets the constant relating the difference between the corrected and\npredicted solutions to the local truncation error of the formula. The predictor of order and the corrector of order differ by\na quantity proportional to the leading error term of the formula, and\nfor a BDF method that constant of proportionality is . For a BDF method the predictor is precisely the extrapolation of the\nsolution history, so that same constant also relates the -th\ndifference of the solution to the truncation error.  One routine\ntherefore serves as both the error and the truncation constant. Arguments Type Intent Optional Attributes Name class( bdf ), intent(in) :: this The bdf object. integer, intent(in) :: k The order of interest. Return Value real(kind=real64) The error constant. procedure, public :: get_maximum_order => mi_get_max_order Gets the upper limit on the order of the method. private pure function mi_get_max_order(this) result(rst) Gets the upper limit on the order of the method. The value reported is the limit actually in force, which is the lesser\nof any limit requested by the caller and the highest order the method\nsupports. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The order limit. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. private pure function oi_get_max_step(this) result(rst) Gets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_maximum_supported_order => bdf_max_order Gets the highest order the method is permitted to use. private pure function bdf_max_order(this) result(rst) Gets the highest order this integrator is permitted to use. Arguments Type Intent Optional Attributes Name class( bdf ), intent(in) :: this The bdf object. Return Value integer The order limit. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. private pure function oi_get_min_step(this) result(rst) Gets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_newton_step_limit => mi_get_newton_step_limit Gets the maximum number of Newton iterations allowed. private pure function mi_get_newton_step_limit(this) result(rst) Gets the maximum number of Newton iterations allowed. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(in) :: this The newton_multistep_integrator object. Return Value integer The iteration limit. procedure, public :: get_newton_tolerance => mi_get_newton_tolerance Gets the Newton iteration convergence tolerance. private pure function mi_get_newton_tolerance(this) result(rst) Gets the convergence tolerance on the Euclidean norm of the residual\nfor the Newton iteration process. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(in) :: this The newton_multistep_integrator object. Return Value real(kind=real64) The convergence tolerance. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. private pure function oi_get_ode_results(this) result(rst) Returns a copy of the solution computed as a ode_results container.\nThe integrator retains the original copy. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value type( ode_results ) The ode_results container. procedure, public :: get_order => mi_get_order Gets the order currently in use. private pure function mi_get_order(this) result(rst) Gets the order of the integrator currently in use. A variable-order method changes this value as the integration proceeds,\nso it reports the order of the most recently attempted step. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The order. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. private pure function oi_get_rel_tol(this, equation) result(rst) Gets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. private pure function oi_get_solution(this) result(rst) Returns the solution computed by the integrator stored as a matrix with\nthe first column containing the values of the independent variable at\nwhich the solution was computed.  The remaining columns contain the\nsolutions for each of the integrated equations in the order in which they\nappear in the source routine.  Notice, the solve routine must be called\nbefore this routine. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64), allocatable, dimension(:,:) The resulting solution matrix. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. private pure function oi_get_step_limit(this) result(rst) Gets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The step limit. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. private pure function oi_get_control_parameter(this) result(rst) Gets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. private pure function oi_get_safety_factor(this) result(rst) Gets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The safety factor. procedure, public :: get_stored_derivative => mi_get_stored_f Gets a stored derivative vector. private pure function mi_get_stored_f(this, i) result(rst) Gets a stored derivative vector, where an index of one denotes the most\nrecently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64), allocatable, dimension(:) The stored derivative. procedure, public :: get_stored_solution => mi_get_stored_y Gets a stored solution vector. private pure function mi_get_stored_y(this, i) result(rst) Gets a stored solution vector, where an index of one denotes the most\nrecently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64), allocatable, dimension(:) The stored solution. procedure, public :: get_stored_step_count => mi_get_stored_count Gets the number of solution points held in the history. private pure function mi_get_stored_count(this) result(rst) Gets the number of previously accepted solution points currently held in\nthe history. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. Return Value integer The number of stored points. procedure, public :: get_stored_variable => mi_get_stored_x Gets a stored independent variable value. private pure function mi_get_stored_x(this, i) result(rst) Gets a stored value of the independent variable, where an index of one\ndenotes the most recently accepted point. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. integer, intent(in) :: i The one-based index into the history. Return Value real(kind=real64) The stored value. procedure, public :: get_truncation_constant => bdf_error_constant Gets the truncation error constant for the requested order. private pure function bdf_error_constant(this, k) result(rst) Gets the constant relating the difference between the corrected and\npredicted solutions to the local truncation error of the formula. The predictor of order and the corrector of order differ by\na quantity proportional to the leading error term of the formula, and\nfor a BDF method that constant of proportionality is . For a BDF method the predictor is precisely the extrapolation of the\nsolution history, so that same constant also relates the -th\ndifference of the solution to the truncation error.  One routine\ntherefore serves as both the error and the truncation constant. Arguments Type Intent Optional Attributes Name class( bdf ), intent(in) :: this The bdf object. integer, intent(in) :: k The order of interest. Return Value real(kind=real64) The error constant. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. private pure function oi_has_dense_output(this) result(rst) Determines whether a prepared accepted-step interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if dense output is currently valid; otherwise, false. procedure, public :: interpolate => mi_interpolate Interpolates the solution history to the requested point. private  subroutine mi_interpolate(this, x, y) Interpolates the stored solution history to the requested value of the\nindependent variable. The polynomial passing through the most recently accepted points is the\nsame polynomial on which the method itself is based, so dense output\ncarries the accuracy of the current order and costs no additional\nfunction evaluations. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(in) :: this The multistep_integrator object. real(kind=real64), intent(in) :: x The value of the independent variable at which to compute the\ninterpolation. real(kind=real64), intent(out), dimension(:) :: y An N-element array where the interpolated solution is written. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. private  subroutine oi_invalidate_dense(this) Marks any prepared dense-output interpolant as unavailable. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. private  subroutine oi_log_failed_step(this, n) Logs a failed integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. private  subroutine oi_log_function_eval(this, n) Logs a function evaluation, or evaluations. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one function \nevaluation.  If not supplied, this routine will log a single \nfunction evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. private  subroutine oi_log_jacobian_eval(this, n) Logs a Jacobian matrix evaluation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one Jacobian matrix\nevaluation.  If not supplied, this routine will log a single\nJacobian evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. private  subroutine oi_log_matrix_factorization(this, n) Logs a matrix factorization. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one matrix \nfactorization.  If not supplied, this routine will log a single\nfactorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. private  subroutine oi_log_successful_step(this, n) Logs a successful integration step. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in), optional :: n An optional input useful for logging more than one step.  If not\nsupplied, this routine will log a single step. procedure, public :: newton_iteration => mi_newton_iteration Performs the Newton iteration process. private  subroutine mi_newton_iteration(this, sys, h, x, ypred, ynew, converged, args) Performs the Newton iteration process. The iteration solves the implicit corrector equation supplied by\nbuild_linear_system.  That system is solved by means of a\nrank-revealing orthogonal factorization, so a singular mass matrix is\ntolerated provided the iteration matrix itself remains nonsingular, as\nis the case for an index-1 problem. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: ypred The N-element array containing the predicted values at x + h. real(kind=real64), intent(out), dimension(:) :: ynew The new estimate of the dependent variables. logical, intent(out) :: converged True if the Newton iteration process converged; else, false. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information in and \nout of the differential equation subroutine. procedure, public :: predictor => bdf_predictor Evaluates the predictor and forms the coefficients of the step. private  subroutine bdf_predictor(this, sys, h, x, y, f, yn, fn, args) Evaluates the predictor and forms the coefficients for the step. The prediction is the extrapolation to of the polynomial\npassing through the stored solution history.  This routine also builds\nthe BDF coefficients for the step and collapses the history into the\nsingle vector the corrector requires, both of which are fixed for the\nduration of the step and so are computed only once here rather than on\nevery Newton iteration. Arguments Type Intent Optional Attributes Name class( bdf ), intent(inout) :: this The bdf object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y The current value(s) of the dependent variable(s). real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives at x. real(kind=real64), intent(out), dimension(:) :: yn An N-element array where this routine will write the next solution\nestimate at x + h. real(kind=real64), intent(out), dimension(:) :: fn An N-element array where this routine will write the next\nderivative estimate at x + h. class(*), intent(inout), optional :: args An optional argument that can be used to pass information in and out\nof the differential equation subroutine. procedure, public :: prepare_for_solve => bdf_prepare_for_solve private  subroutine bdf_prepare_for_solve(this) Arguments Type Intent Optional Attributes Name class( bdf ), intent(inout) :: this procedure, public :: reset_history => mi_reset_history Clears the stored solution history. private  subroutine mi_reset_history(this) Clears the stored solution history. The integrator restarts at first order the next time it is used. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols private  subroutine oi_set_abs_tol(this, x) Sets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_abs_tols(this, x) Sets the absolute error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private  subroutine oi_set_allow_overshoot(this, x) Sets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. logical, intent(in) :: x True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. private  subroutine oi_set_dense_interval(this, x_start, x_end, n) Publishes the interval covered by retained dense-output interpolation\ndata for one accepted step. The endpoints are recorded in integration\norder, which may be increasing or decreasing. The interpolant is marked\nvalid after the interval and state dimension have been recorded.\nAn error stop occurs if either endpoint is non-finite, the endpoints\nare equal, or the state dimension is less than one. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. real(kind=real64), intent(in) :: x_start The first endpoint of the accepted step in integration order. real(kind=real64), intent(in) :: x_end The second endpoint of the accepted step in integration order. integer, intent(in) :: n The number of dependent variables represented by the interpolant. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). private  subroutine oi_set_dense_enabled(this, enabled) Enables or disables explicit dense-output preparation.\nWhen enabled, the integrator prepares dense output for each accepted\nstep independently of whether the requested output grid requires it.\nDisabling this setting does not prevent dense output needed to produce\nrequested solution values. Any previously prepared step is invalidated. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ODE integrator. logical, intent(in) :: enabled True to enable explicit dense-output preparation; false to disable it. procedure, public :: set_maximum_order => mi_set_max_order Sets the upper limit on the order of the method. private  subroutine mi_set_max_order(this, x) Sets the upper limit on the order of the method. The value is constrained to the range supported by the method. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. integer, intent(in) :: x The order limit. procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. private  subroutine oi_set_max_step(this, x) Sets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. private  subroutine oi_set_min_step(this, x) Sets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The step size limit. procedure, public :: set_newton_step_limit => mi_set_newton_step_limit Sets the maximum number of Newton iterations allowed. private  subroutine mi_set_newton_step_limit(this, x) Sets the maximum number of Newton iterations allowed. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. integer, intent(in) :: x The iteration limit. procedure, public :: set_newton_tolerance => mi_set_newton_tolerance Sets the Newton iteration convergence tolerance. private  subroutine mi_set_newton_tolerance(this, x) Sets the convergence tolerance on the Euclidean norm of the residual\nfor the Newton iteration process. Arguments Type Intent Optional Attributes Name class( newton_multistep_integrator ), intent(inout) :: this The newton_multistep_integrator object. real(kind=real64), intent(in) :: x The convergence tolerance. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols private  subroutine oi_set_rel_tol(this, x) Sets the relative error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The tolerance value. private  subroutine oi_set_rel_tols(this, x) Sets the relative error tolerance for each equation. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: x The tolerance values. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. private  subroutine oi_set_step_limit(this, x) Sets the limit on the number of integration steps that may be taken \nbefore the solver terminates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. integer, intent(in) :: x The step limit. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. private  subroutine oi_set_control_parameter(this, x) Sets the step size control parameter used for PI control of \nthe step size.  A value of 0 provides a default step size controller\n(non-PI); however, a nonzero value of provides PI control \nthat improves stability, but comes with a potential for efficiency loss.\nA good estimate for a starting point for this parameter is where is the order of the integrator. The PI controller for step size is defined as follows. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The control parameter procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. private  subroutine oi_set_safety_factor(this, x) Sets the safety factor (step size multiplier) used to provide a measure\nof control to the step size estimate such that ,\nwhere is this safety factor. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The safety factor. procedure, public :: solve => mi_ode_solver Solves the supplied system of ODE's. private  subroutine mi_ode_solver(this, sys, x, iv, store_iv, args) Solves the supplied system of ODE's. The integration is driven by a predictor-corrector cycle.  Each step\nextrapolates the solution history to form a prediction, refines that\nprediction with Newton iteration on the implicit formula, and compares\nthe two to estimate the local error.  A step whose error satisfies the\nrequested tolerances is accepted and appended to the history; otherwise\nit is retried on a shorter step. Arguments Type Intent Optional Attributes Name class( multistep_integrator ), intent(inout) :: this The multistep_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array of independent variable values at which to return the\nsolution to the ODE's.  If only two values are supplied, the\nsolution is returned at every successful integration step. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine.","tags":"","url":"type\\bdf.html"},{"title":"kennedy_carpenter – DIFFEQ ","text":"type, public, abstract, extends( single_step_integrator ) :: kennedy_carpenter Shared implementation for Kennedy--Carpenter ESDIRK methods. The stage equations are solved with a simplified Newton iteration.\nA supplied mass matrix is incorporated in each stage system as , while the embedded tableau supplies the error\nestimate used by the inherited adaptive driver.  These solvers use\nthe inherited configurable PI step-size controller. Every implicit stage shares the diagonal coefficient , so\na single factorization of serves every stage and\nNewton iteration within a step.  The factorization is retained\nuntil the step size changes, and the Jacobian is retained across\nsteps until the Newton iteration converges slowly or fails.  A\nfailed iteration first refreshes any stale Jacobian or\nfactorization; if the iteration still fails, the step is rejected\nand retried with a smaller step size. The Newton iteration is governed by a user-defined iteration limit\nand convergence tolerance.  The applied tolerance never exceeds one\npercent of the smallest positive integration tolerance. Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. private  subroutine oi_append_to_buffer(this, x, y) Appends the supplied solution point to the internal solution buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: x The independent variable value. real(kind=real64), intent(in), dimension(:) :: y The values of the dependent variables corresponding to x. procedure, public :: attempt_step => kc_attempt_step Attempts an integration step for this integrator. private  subroutine kc_attempt_step(this, sys, h, x, y, f, yn, fn, yerr, k, args) Attempts an integration step for this integrator. The state at each stage is solved from using Newton iteration.  The high- and embedded-order solutions are and , respectively. Arguments Type Intent Optional Attributes Name class( kennedy_carpenter ), intent(inout) :: this The kennedy_carpenter object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current solution at x. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x. real(kind=real64), intent(out), dimension(:) :: yn An N-element array where this routine will write the next\nsolution estimate at x + h. real(kind=real64), intent(out), dimension(:) :: fn An N-element array where this routine will write the next\nderivative estimate at x + h. real(kind=real64), intent(out), dimension(:) :: yerr An N-element array where this routine will write an estimate\nof the error in each equation. real(kind=real64), intent(out), dimension(:,:) :: k An N-by-NSTAGES matrix containing the derivatives at each stage. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. private  subroutine oi_clear_buffer(this) Clears the contents of the buffer. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. procedure, public :: compute_dense_output => ssi_dense_output private  subroutine ssi_dense_output(this, x, y) Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this real(kind=real64), intent(in) :: x real(kind=real64), intent(out) :: y (:) procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. private pure function oi_estimate_error(this, y, yest, yerr) result(rst) Computes the norm of the scaled error estimate.  A value less than one\nindicates a successful step.  A value greater than one suggests that the\nresults do not meet the requested tolerances. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. real(kind=real64), intent(in), dimension(:) :: y The previously accepted solution array (N-element). real(kind=real64), intent(in), dimension(size(y)) :: yest An N-element array containing the next solution point estimate. real(kind=real64), intent(in), dimension(size(y)) :: yerr An N-element array containing the estimate of error for each\nequation. Return Value real(kind=real64) The norm of the scaled error. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. private  subroutine oi_initial_step(this, sys, xo, xf, yo, fo, h, args) Computes an estimate of an initial step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: xo The initial value of the independent variable. real(kind=real64), intent(in) :: xf The final value of the independent variable. real(kind=real64), intent(in), dimension(:) :: yo The initial values of the dependent variables (N-element). real(kind=real64), intent(out), dimension(size(yo)) :: fo An N-element array where the function values at xo will be written. real(kind=real64), intent(out) :: h The initial step size estimate. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. private  function oi_next_step(this, e, eold, h, x) result(rst) Estimates the next step size based upon the current and previous error\nestimates. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. real(kind=real64), intent(in) :: e The norm of the current scaled error estimate. real(kind=real64), intent(inout) :: eold The norm of the previous step's scaled error estimate.  On output,\nthis variable is updated. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current independent variable value. Return Value real(kind=real64) The new step size estimate. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. private  subroutine oi_evaluate_dense(this, x, y) Evaluates the interpolant for the last prepared accepted step at a\nrequested independent-variable value. The query must be finite and\nwithin the step interval, including either endpoint. This operation\ndoes not advance or otherwise change solver state and does not evaluate\nthe ODE function. An error stop occurs if no valid interpolant is\navailable, the output array has the wrong size, or the query is\nnon-finite or outside the interval. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator containing the prepared interpolant. real(kind=real64), intent(in) :: x The independent-variable value at which to evaluate the solution. real(kind=real64), intent(out) :: y (:) Receives the interpolated dependent-variable values. Its size must\nequal the number of dependent variables in the prepared step. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. private pure function oi_get_abs_tol(this, equation) result(rst) Gets the absolute error tolerance. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. integer, intent(in), optional :: equation The equation index. If omitted, the scalar tolerance is returned. Return Value real(kind=real64) The tolerance value. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. private pure function oi_get_allow_overshoot(this) result(rst) Gets a value determining if the solver is allowed to overshoot the final\nvalue in the integration range. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value logical True if the solver can overshoot, and then interpolate to achieve the\nrequired final value; else, false thereby indicating the solver \ncannot overshoot. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. private  subroutine oi_get_dense_interval(this, x_start, x_end) Gets the endpoints of the currently prepared dense-output interval.\nAn error stop occurs if no valid interpolant is available. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. real(kind=real64), intent(out) :: x_start Receives the first endpoint in integration order. real(kind=real64), intent(out) :: x_end Receives the second endpoint in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. private pure function oi_get_dense_enabled(this) result(rst) Gets the explicit dense-output preparation setting. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ODE integrator. Return Value logical True if explicit dense-output preparation is enabled; otherwise,\nfalse. This setting is independent of preparation required to\nproduce values on a requested output grid. procedure, public :: get_is_fsal => kc_get_is_fsal Gets a logical parameter stating if this is a first-same-as-last\n(FSAL) integrator. private pure function kc_get_is_fsal(this) result(rst) Gets a logical parameter stating if this is a first-same-as-last\n(FSAL) integrator. Arguments Type Intent Optional Attributes Name class( kennedy_carpenter ), intent(in) :: this The kennedy_carpenter object. Return Value logical True for a FSAL integrator; else, false. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. private pure function oi_get_max_step(this) result(rst) Gets the magnitude of the maximum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. private pure function oi_get_min_step(this) result(rst) Gets the magnitude of the minimum allowed step size. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value real(kind=real64) The step size limit. procedure, public :: get_newton_step_limit => kc_get_newton_step_limit Gets the maximum number of Newton iterations allowed per stage. private pure function kc_get_newton_step_limit(this) result(rst) Gets the maximum number of Newton iterations allowed per stage. Arguments Type Intent Optional Attributes Name class( kennedy_carpenter ), intent(in) :: this The kennedy_carpenter object. Return Value integer The iteration limi