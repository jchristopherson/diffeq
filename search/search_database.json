the routine for computing the mass matrix.  Pass\nNULL if no routine is necessary. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. type( c_ode_event_statistics ), intent(out) :: estats Event detection solver results and statistics. Return Value integer(kind=c_int) An error flag denoting the status of the operation.","tags":"","url":"proc\\c_kennedy_carpenter_5_events.html"},{"title":"c_rosenbrock – DIFFEQ","text":"public  function c_rosenbrock(nx, nstates, fcn, x, initcond, settings, jac, mass, output) result(rst) bind(C, name = \"c_rosenbrock\") Utilizes a 4th order Rosenbrock integrator to solve a system of \nfirst order differential equations or index-1 differential \nalgebraic equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to integrate. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(in) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type(c_funptr), intent(in), value :: jac A pointer to the routine for computing the Jacobian matrix.\nPass NULL if no routine is necessary and allowing the integrator\nto use a finite-difference estimate is acceptable. type(c_funptr), intent(in), value :: mass A pointer to the routine for computing the mass matrix.  Pass\nNULL if no routine is necessary. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. Return Value integer(kind=c_int) An error flag denoting the status of the operation.","tags":"","url":"proc\\c_rosenbrock.html"},{"title":"c_rosenbrock_events – DIFFEQ","text":"public  function c_rosenbrock_events(nx, nstates, nevents, fcn, x, initcond, settings, esettings, efcn, jac, mass, output, estats) result(rst) bind(C, name = \"c_rosenbrock_events\") Utilizes a 4th order Rosenbrock integrator to solve a system of \nfirst order differential equations or index-1 differential \nalgebraic equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nevents The number of event equations. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to integrate. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(in) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type( c_ode_event_solver_settings ), intent(in) :: esettings The event solver settings. type(c_funptr), intent(in), value :: efcn A pointer to the function containing the event equations. type(c_funptr), intent(in), value :: jac A pointer to the routine for computing the Jacobian matrix.\nPass NULL if no routine is necessary and allowing the integrator\nto use a finite-difference estimate is acceptable. type(c_funptr), intent(in), value :: mass A pointer to the routine for computing the mass matrix.  Pass\nNULL if no routine is necessary. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. type( c_ode_event_statistics ), intent(out) :: estats Event detection solver results and statistics. Return Value integer(kind=c_int) An error flag denoting the status of the operation.","tags":"","url":"proc\\c_rosenbrock_events.html"},{"title":"c_runge_kutta_23 – DIFFEQ","text":"public  function c_runge_kutta_23(nx, nstates, fcn, x, initcond, settings, output) result(rst) bind(C, name = \"c_runge_kutta_23\") Utilizes the 3rd order Bogacki-Shampine Runge-Kutta integrator to \nsolve a system of first order differential equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to integrate. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(in) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. Return Value integer(kind=c_int) An error flag denoting the status of the operation.","tags":"","url":"proc\\c_runge_kutta_23.html"},{"title":"c_runge_kutta_23_events – DIFFEQ","text":"public  function c_runge_kutta_23_events(nx, nstates, nevents, fcn, x, initcond, settings, esettings, efcn, output, estats) result(rst) bind(C, name = \"c_runge_kutta_23_events\") Utilizes the 3rd order Bogacki-Shampine Runge-Kutta integrator to \nsolve a system of first order differential equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nevents The number of event equations. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to integrate. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(in) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type( c_ode_event_solver_settings ), intent(in) :: esettings The event solver settings. type(c_funptr), intent(in), value :: efcn A pointer to the function containing the event equations. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. type( c_ode_event_statistics ), intent(out) :: estats Event detection solver results and statistics. Return Value integer(kind=c_int) An error flag denoting the status of the operation.","tags":"","url":"proc\\c_runge_kutta_23_events.html"},{"title":"c_runge_kutta_45 – DIFFEQ","text":"public  function c_runge_kutta_45(nx, nstates, fcn, x, initcond, settings, output) result(rst) bind(C, name = \"c_runge_kutta_45\") Utilizes the 5th order Dormand-Prince Runge-Kutta integrator to \nsolve a system of first order differential equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to 