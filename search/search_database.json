tings (settings) bind(C, name = \"c_default_ode_settings\") Fills the supplied c_ode_settings object with default settings. Arguments Type Intent Optional Attributes Name type( c_ode_settings ), intent(inout) :: settings The c_ode_settings object.","tags":"","url":"module\\diffeq_c_integrators.html"},{"title":"diffeq_singlestep – DIFFEQ","text":"Uses diffeq_base diffeq_errors iso_fortran_env Interfaces interface public  subroutine attempt_single_step(this, sys, h, x, y, f, yn, fn, yerr, k, args) Attempts an integration step for a single-step integrator. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current solution at x. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x. real(kind=real64), intent(out), dimension(:) :: yn An N-element array where this routine will write the next\nsolution estimate at x + h. real(kind=real64), intent(out), dimension(:) :: fn An N-element array where this routine will write the next\nderivative estimate at x + h. real(kind=real64), intent(out), dimension(:) :: yerr An N-element array where this routine will write an estimate\nof the error in each equation. real(kind=real64), intent(out), dimension(:,:) :: k An N-by-NSTAGES matrix containing the derivatives at each\nstage. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. interface public pure function get_single_step_logical_parameter(this) result(rst) Returns a logical parameter from a single_step_integrator object. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this The single_step_integrator object. Return Value logical The parameter. interface public pure function single_step_integer_inquiry(this) result(rst) Gets an integer from the integrator. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this The single_step_integrator object. Return Value integer The integer value. interface public  subroutine single_step_interpolate(this, x, xn, yn, fn, xn1, yn1, fn1, y) Provides a routine for interpolation. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(in) :: this The single_step_integrator object. real(kind=real64), intent(in) :: x The value of the independent variable at which to compute\nthe interpolation. real(kind=real64), intent(in) :: xn The previous value of the independent variable at which the\nsolution is computed. real(kind=real64), intent(in), dimension(:) :: yn An N-element array containing the solution at xn. real(kind=real64), intent(in), dimension(:) :: fn An N-element array containing the derivatives at xn. real(kind=real64), intent(in) :: xn1 The value of the independent variable at xn + h. real(kind=real64), intent(in), dimension(:) :: yn1 An N-element array containing the solution at xn + h. real(kind=real64), intent(in), dimension(:) :: fn1 An N-element array containing the derivatives at xn + h. real(kind=real64), intent(out), dimension(:) :: y An N-element array where this routine will write the \nsolution values interpolated at x. interface public  subroutine single_step_post_step_routine(this, sys, dense, x, xn, y, yn, f, fn, k, args) Provides a routine for performing any actions, such as setting\nup interpolation, after successful completion of a step. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. logical, intent(in) :: dense Determines if dense output is requested (true); else, false. real(kind=real64), intent(in) :: x The previous value of the independent variable. real(kind=real64), intent(in) :: xn The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the solution at x. real(kind=real64), intent(in), dimension(:) :: yn An N-element array containing the solution at xn. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the derivatives at x. real(kind=real64), intent(in), dimension(:) :: fn An N-element array containing the derivatives at xn. real(kind=real64), intent(inout), dimension(:,:) :: k An N-by-NSTAGES matrix containing the derivatives at each\nstage. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. interface public  subroutine single_step_pre_step_routine(this, prevs, sys, h, x, y, f, args) Provides a routine for performing any actions, such as setting\nup Jacobian calculations. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. logical, intent(in) :: prevs Defines the status of the previous step.  The value is true \nif the previous step was successful; else, false if the \nprevious step failed. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in) :: h The current step size. real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current solution at x. real(kind=real64), intent(in), dimension(:) :: f An N-element array containing the values of the derivatives\nat x. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. Derived Types type, public, abstract, extends( ode_integrator ) :: single_step_integrator The most basic, single-step integrator object capable of integrating\nsystems of ODE's. Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. procedure( attempt_single_step ), public, deferred, pass :: attempt_step Attempts an integration step for a single-step integrator. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. procedure, public :: compute_dense_output => ssi_dense_output procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. procedure( get_single_step_logical_parameter ), public, deferred, pass :: get_is_fsal Gets a logical parameter stating if this is a first-same-as-last\n(FSAL) integrator. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. procedure( ode_integer_inquiry ), public, deferred, pass :: get_order Returns the order of the integrator. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. procedure( single_step_integer_inquiry ), public, deferred, pass :: get_stage_count Gets the number of stages used by the integrator. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. procedure( single_step_interpolate ), public, deferred, pass :: interpolate Performs an interpolation to estimate the solution at the\nrequested point. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. procedure( single_step_post_step_routine ), public, deferred, pass :: post_step_action Performs actions such as setting up interpolation after \ncompletion of a successful integration step. procedure( single_step_pre_step_routine ), public, deferred, pass :: pre_step_action Provides a routine for performing any actions, such as setting\nup Jacobian calculations. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols Sets the absolute error tolerance. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols Sets the relative error tolerance. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. procedure, public :: solve => ssi_ode_solver Solves the supplied system of ODE's. Subroutines public  subroutine ssi_ode_solver (this, sys, x, iv, store_iv, args) Solves the supplied system of ODE's. Arguments Type Intent Optional Attributes Name class( single_step_integrator ), intent(inout) :: this The single_step_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array of independent variable values at which to return the \nthe solution to the ODE's. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine.","tags":"","url":"module\\diffeq_singlestep.html"},{"title":"diffeq_base – DIFFEQ","text":"A collection of base types for the DIFFEQ library. Uses ieee_arithmetic diffeq_auto_diff iso_fortran_env diffeq_containers diffeq_errors Interfaces interface public  subroutine ode(x, y, dydx, args) An interface to a routine containing a system of first order\nODE's to integrate. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current state vector. real(kind=real64), intent(out), dimension(:) :: dydx An N-element array where the derivative values will be\nwritten. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the routine. interface public  subroutine ode_ad(x, y, dydx, args) An interface to a routine containing a system of first order\nODE's to integrate leveraging automatic differentiation for\nJacobian evaluations, where appropriate. Arguments Type Intent Optional Attributes Name type( real_ad ), intent(in) :: x The current value of the independent variable. type( real_ad ), intent(in), dimension(:) :: y An N-element array containing the current state vector. type( real_ad ), intent(out), dimension(:) :: dydx An N-element array where the derivative values will be\nwritten. Assign both components of every element, using AD\nexpressions or constant assignment rather than setting x alone. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the routine. Repeated evaluations at the same\nvalues must describe the same function, regardless of seeds. interface public  subroutine ode_event_function(x, y, f, args) A callback routine for evaluating event status. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current state vector. real(kind=real64), intent(out), dimension(:) :: f An M-element array containing the values of the event\nfunctions.  The solver attempts to find the situation \nwhere f equals zero thereby signaling an event.  Notice, M \nneed not equal N (N is the number of state variables). class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the routine. interface public  subroutine ode_jacobian(x, y, jac, args) An interface to a routine capable of computing the Jacobian\nmatrix of a system of first order ODE's. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current state vector. real(kind=real64), intent(out), dimension(:,:) :: jac An M-by-N matrix where the Jacobian will be written. class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the routine. interface public  subroutine ode_mass_matrix(x, y, m, args) An interface to a routine capable of computing a mass matrix\nfor a system of differential equations. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x The current value of the independent variable. real(kind=real64), intent(in), dimension(:) :: y An N-element array containing the current state vector. real(kind=real64), intent(out), dimension(:,:) :: m An N-by-N matrix where the class(*), intent(inout), optional :: args An optional argument that can be used to pass information\nin and out of the routine. Abstract Interfaces abstract interface public  subroutine ode_dense_output(this, x, y) Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this real(kind=real64), intent(in) :: x real(kind=real64), intent(out) :: y (:) abstract interface public pure function ode_integer_inquiry(this) result(rst) Returns an integer value from the ode_integrator object. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(in) :: this The ode_integrator object. Return Value integer The requested value. abstract interface public  subroutine ode_solver(this, sys, x, iv, store_iv, args) Solves the supplied system of ODE's. Arguments Type Intent Optional Attributes Name class( ode_integrator ), intent(inout) :: this The ode_integrator object. class( ode_container ), intent(inout) :: sys The ode_container object containing the ODE's to integrate. real(kind=real64), intent(in), dimension(:) :: x An array, of at least 2 values, defining at a minimum\nthe starting and ending values of the independent variable \nintegration range.  If more than two values are specified, \nthe integration results will be returned at the supplied \nvalues. real(kind=real64), intent(in), dimension(:) :: iv An array containing the initial values for each ODE. logical, intent(in), optional :: store_iv An optional input that determines whether or not the \ninitial values are stored as part of the output.  The\ndefault is true such that the initial values are stored;\nhowever, set to false to avoid storing the initial values.\nThis can be useful in cases of event detection where a \nrestart of the integrator is desired. class(*), intent(inout), optional, target :: args An optional argument that can be used to pass information\nin and out of the differential equation subroutine. Derived Types type, public :: ode_container Defines the callbacks and model options for an ODE problem. Read more… Components Type Visibility Attributes Name Initial procedure( ode_event_function ), public, pointer, nopass :: event_function => null() A pointer to the event function. procedure( ode ), public, pointer, nopass :: fcn => null() A pointer to the routine containing the ODEs to integrate. procedure( ode_ad ), public, pointer, nopass :: fcn_ad => null() A pointer to the routine containing the ODEs to integrate.  Use\nthis pointer instead of fcn when automatic differentiation is\ndesired for calculation of the Jacobian.  Do not use both\npointers as this will produce an error.  If fcn is utilized,\nthen the Jacobian will be computed by either a user-supplied\nJacobian callback or by finite differences.  If this pointer\nis utilized, then the Jacobian will be computed by either a\nuser-supplied Jacobian callback or automatic differentiation.\nIn either case a user-supplied Jacobian callback is the preferred\noption falling back to either finite differences or automatic\ndifferentiation in its absence. procedure( ode_jacobian ), public, pointer, nopass :: jacobian => null() A pointer to the routine containing the analytical Jacobian.\nTakes precedence over AD and finite differences. If null, the\nselected RHS representation determines the differentiation method. procedure( ode_mass_matrix ), public, pointer, nopass :: mass_matrix => null() A pointer to the routine containing the mass matrix for the\nsystem.  If set to null (the default), an identity mass matrix \nwill be assumed. Type-Bound Procedures procedure, public :: compute_jacobian => oc_jacobian procedure, public :: compute_mass_matrix => oc_eval_mass_matrix procedure, public :: compute_rhs => oc_eval_rhs procedure, public :: compute_time_derivative => oc_time_derivative procedure, public :: get_event_equation_count => oc_get_event_eqn_count procedure, public :: get_finite_difference_step => oc_get_fd_step procedure, public :: get_is_mass_matrix_dependent => oc_get_is_mass_dependent procedure, public :: get_is_ode_defined => oc_get_is_ode_defined procedure, public :: get_is_ode_event_function_defined => oc_is_event_fcn_defined procedure, public :: get_jacobian_function_evaluations => oc_get_jacobian_calls procedure, public :: has_mass_matrix => oc_has_mass_matrix procedure, public :: set_event_equation_count => oc_set_event_eqn_count procedure, public :: set_finite_difference_step => oc_set_fd_step procedure, public :: set_is_mass_matrix_dependent => oc_set_is_mass_dependent procedure, public :: use_finite_difference_jacobian => oc_use_finite_difference_jacobian type, public :: ode_event_solver Provides a mechanism for event detection. Components Type Visibility Attributes Name Initial type( ode_event_statistics ), public :: solver_statistics Event solver information. Type-Bound Procedures procedure, public :: find_event => oes_find_event Attempts to find any events within a specified bracket. procedure, public :: get_max_allowed_iterations => oes_get_max_iter Gets the number of iterations the solver is allowed to take. procedure, public :: get_solver_tolerance => oes_get_tol Gets the solver tolerance. procedure, public :: is_event_suspected => oes_event_in_bracket Determines if an event is suspected to exist within the &\nspecified bracket. procedure, public :: set_max_allowed_iterations => oes_set_max_iter Sets the number of iterations the solver is allowed to take. procedure, public :: set_solver_tolerance => oes_set_tol Sets the solver tolerance. type, public :: ode_event_statistics An ODE event solver statistics container. Components Type Visibility Attributes Name Initial integer, public :: event_index = 0 The index of the event equation where an event was located. integer, public :: function_evaluations = 0 The number of event function evaluations. integer, public :: iteration_count = 0 The number of iterations taken by the solver. type, public, abstract :: ode_integrator Abstract base class for all DIFFEQ ODE integrators. Read more… Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. procedure( ode_dense_output ), public, deferred, pass :: compute_dense_output Implementation hook for evaluating a validated dense-output query. procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. procedure, public :: get_absolute_tolerance => oi_get_abs_tol Gets the absolute error tolerance. procedure, public :: get_allow_overshoot => oi_get_allow_overshoot Gets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. procedure, public :: get_dense_interval => oi_get_dense_interval Gets the prepared step's start and end in integration order. procedure, public :: get_dense_output_enabled => oi_get_dense_enabled Gets the explicit dense-output preparation setting. procedure, public :: get_maximum_step_size => oi_get_max_step Gets the magnitude of the maximum allowed step size. procedure, public :: get_minimum_step_size => oi_get_min_step Gets the magnitude of the minimum allowed step size. procedure, public :: get_ode_results => oi_get_ode_results Returns the solution stored within an ode_results object. procedure( ode_integer_inquiry ), public, deferred, pass :: get_order Returns the order of the integrator. procedure, public :: get_relative_tolerance => oi_get_rel_tol Gets the relative error tolerance. procedure, public :: get_solution => oi_get_solution Returns the solution computed by the integrator. procedure, public :: get_step_limit => oi_get_step_limit Gets the limit on the number of integration steps. procedure, public :: get_step_size_control_parameter => oi_get_control_parameter Gets the step size PI control parameter. procedure, public :: get_step_size_factor => oi_get_safety_factor Gets the step size safety factor. procedure, public :: has_dense_output => oi_has_dense_output Tests whether a prepared accepted-step interpolant is available. procedure, public :: invalidate_dense_output => oi_invalidate_dense Invalidates the prepared interpolant before stepping or resetting. procedure, public :: log_failed_step => oi_log_failed_step Logs a failed integration step. procedure, public :: log_function_evaluation => oi_log_function_eval Logs a function evaluation. procedure, public :: log_jacobian_evaluation => oi_log_jacobian_eval Logs a Jacobian matrix evaluation. procedure, public :: log_matrix_factorization => oi_log_matrix_factorization Logs a matrix factorization. procedure, public :: log_successful_step => oi_log_successful_step Logs a successful integration step. generic, public :: set_absolute_tolerance => oi_set_abs_tol, oi_set_abs_tols Sets the absolute error tolerance. procedure, public :: set_allow_overshoot => oi_set_allow_overshoot Sets a value determining if the solver is allowed to overshoot \nthe final value in the integration range. procedure, public :: set_dense_interval => oi_set_dense_interval Implementation hook publishing a prepared accepted step. procedure, public :: set_dense_output_enabled => oi_set_dense_enabled Enables dense output on every accepted step (default: false). procedure, public :: set_maximum_step_size => oi_set_max_step Sets the magnitude of the maximum allowed step size. procedure, public :: set_minimum_step_size => oi_set_min_step Sets the magnitude of the minimum allowed step size. generic, public :: set_relative_tolerance => oi_set_rel_tol, oi_set_rel_tols Sets the relative error tolerance. procedure, public :: set_step_limit => oi_set_step_limit Sets the limit on the number of integration steps. procedure, public :: set_step_size_control_parameter => oi_set_control_parameter Sets the step size PI control parameter. procedure, public :: set_step_size_factor => oi_set_safety_factor Sets the step size safety factor. procedure( ode_solver ), public, deferred, pass :: solve Solves the supplied system of ODE's.","tags":"","url":"module\\diffeq_base.html"},{"title":"diffeq_c_function_pointers – DIFFEQ","text":"Uses iso_c_binding Abstract Interfaces abstract interface public  subroutine c_dae_algebraic_constraints(nconstraints, nstates, x, y, g) bind(C) Evaluates algebraic constraint residuals . For input state components and constraints,\nthe callback represents a mapping A consistent state satisfies . Return the\nresiduals themselves, not their derivatives, a Boolean result,\nor a projected state. A nonzero residual is a valid evaluation\nat an inconsistent state, rather than a callback failure. The caller supplies the input and output array sizes. The\nimplementation must interpret the same state ordering as its\nmodel and write every output element. This interface performs\nno dimension, rank, or initial-consistency checks. Residual\nordering and physical units are defined by the model; any\nsubsequent consistency tolerance must respect that scaling. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nconstraints The number of constraint equations. integer(kind=c_int), intent(in), value :: nstates The number of state variables. real(kind=c_double), intent(in), value :: x The current value of the independent variable. real(kind=c_double), intent(in) :: y (nstates) The current state vector. real(kind=c_double), intent(out) :: g (nconstraints) The constraint vector. abstract interface public  subroutine c_dae_constraint_curvature(nconstraints, ncoord, x, q, direction, v, curvature) bind(C) Evaluates , without including . Each component is .\nAssign every output element. For linear constraints return\nzeros. The callback must support off-manifold coordinates and\narbitrary directions used during nonlinear/Jacobian evaluation. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nconstraints The number of constraint equations. integer(kind=c_int), intent(in), value :: ncoord The number of coordinate variables. real(kind=c_double), intent(in), value :: x The current value of the independent variable. real(kind=c_double), intent(in) :: q (ncoord) The current coordinate vector. real(kind=c_double), intent(in) :: direction (ncoord) The coordinate derivative , including the \nkinematic multiplier correction. real(kind=c_double), intent(in) :: v (ncoord) The physical velocity components. real(kind=c_double), intent(out) :: curvature (nconstraints) The curvature terms in the order of teh constraint callback. abstract interface public  subroutine c_ode(n, x, y, dydx) bind(C) ODE callback routine. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: n The number of state variables. real(kind=c_double), intent(in), value :: x The current value of the independent variable. real(kind=c_double), intent(in) :: y (n) The current state vector. real(kind=c_double), intent(out) :: dydx (n) The state vector derivatives. abstract interface public  subroutine c_ode_event_function(neqn, nstates, x, y, f) bind(C) Evaluates event functions for ODE event detection.  The solver\nseeks to locate roots for each equation. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: neqn The number of event equations. integer(kind=c_int), intent(in), value :: nstates The number of state equations. real(kind=c_double), intent(in), value :: x The current value of the independent variable. real(kind=c_double), intent(in) :: y (nstates) The current state vector. real(kind=c_double), intent(out) :: f (neqn) The event function values. abstract interface public  subroutine c_ode_jacobian(m, n, x, y, jac, ldj) bind(C) ODE Jacobian callback routine. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: m The number of equations. integer(kind=c_int), intent(in), value :: n The state vector length. real(kind=c_double), intent(in), value :: x The current value of the independent variable. real(kind=c_double), intent(in) :: y (n) The current state vector. real(kind=c_double), intent(out) :: jac (ldj,n) The M-by-N Jacobian matrix. integer(kind=c_int), intent(in), value :: ldj The leading dimension of the Jacobian matrix. abstract interface public  subroutine c_ode_mass_matrix(n, x, y, m, ldm) bind(C) ODE mass matrix callback routine. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: n The number of state variables. real(kind=c_double), intent(in), value :: x The current value of the independent variable. real(kind=c_double), intent(in) :: y (n) The current state vector. real(kind=c_double), intent(out) :: m (ldm,n) The mass matrix. integer(kind=c_int), intent(in), value :: ldm The leading dimension of the mass matrix.","tags":"","url":"module\\diffeq_c_function_pointers.html"},{"title":"diffeq_bdf – DIFFEQ","text":"Implicit BDF solvers. Backward differentiation formulae replace the derivative in with the derivative, evaluated at , of the polynomial that\ninterpolates the new solution point together with the points\npreceding it.  The resulting formula is implicit in and is solved by Newton iteration.  Because\nthe coefficients are derived from the actual spacing of the stored\npoints, a change of step size is handled exactly rather than by\ninterpolating the history onto a uniform grid. Uses diffeq_base diffeq_multistep diffeq_errors iso_fortran_env Derived Types type, public, extends( newton_multistep_integrator ) :: bdf A variable step-size, variable order (1-5) BDF integrator for stiff\nsystems and index-1 differential-algebraic equations. Read more… Components Type Visibility Attributes Name Initial type( ode_event_solver ), public :: event_solver The ODE event solver.  Enable event detection by defining the\nevent_function in the ode_container object. Type-Bound Procedures procedure, public :: append_to_buffer => oi_append_to_buffer Appends the supplied solution point to the internal solution \nbuffer. procedure, public :: build_linear_system => bdf_build_linear_system Builds the linearized system for the implicit corrector. procedure, public :: clear_buffer => oi_clear_buffer Clears the contents of the buffer. procedure, public :: compute_dense_output => mi_dense_output procedure, public :: compute_error_norm => oi_estimate_error Computes the norm of the scaled error estimate. procedure, public :: correct => mi_newton_iteration Performs the Newton iteration process. procedure, public :: estimate_inital_step_size => oi_initial_step Computes an estimate of an initial step size. procedure, public :: estimate_next_step_size => oi_next_step Estimates the next step size. procedure, public :: evaluate_dense => oi_evaluate_dense Evaluates the prepared step without advancing integration. procedure, public :: evaluate_derivative => mi_evaluate_derivative Evaluates the derivative stored in the solution history. procedu