6681806523d0, 0.01d0, 0.4798896504144996d0, 1.379008574103742d0, -3.290069515436081d0, 2.324710524099774d0, 0.0d0], [7, 7], order=[2, 1]) real(kind=real64), public, parameter :: tsit_b (7) = [0.09646076681806523d0, 0.01d0, 0.4798896504144996d0, 1.379008574103742d0, -3.290069515436081d0, 2.324710524099774d0, 0.0d0] real(kind=real64), public, parameter :: tsit_c (7) = [0.0d0, 0.161d0, 0.327d0, 0.9d0, 0.980025540904509685729810680793d0, 1.0d0, 1.0d0] real(kind=real64), public, parameter :: tsit_e (7) = [-0.001780011052226d0, -0.0008164344596567469d0, 0.007880878010261995d0, -0.1447110071732629d0, 0.5823571654525552d0, -0.45808210592918697d0, 0.0151515151515151515151515151515d0]","tags":"","url":"module\\diffeq_tsit45_constants.html"},{"title":"diffeq – DIFFEQ","text":"Uses diffeq_pece diffeq_base diffeq_tsitouras diffeq_multistep diffeq_kennedy_carpenter diffeq_container_io diffeq_rosenbrock diffeq_rk23 diffeq_rk853 diffeq_auto_diff diffeq_singlestep iso_fortran_env diffeq_containers diffeq_bdf diffeq_rk45 diffeq_index_reduction","tags":"","url":"module\\diffeq.html"},{"title":"diffeq_index_reduction – DIFFEQ","text":"Stabilized index-1 Gear-Gupta-Leimkuhler-inspired (GGL) reduction\nfor mechanical systems with autonomous holonomic constraints. For autonomous holonomic constraints , this variant uses\ncoordinates , velocities , force multipliers ,\nand kinematic multipliers in the formulation where . Thus and . Consistent constraints remain zero\nin the exact solution; positive gains damp violations. Numerical\nintegration and interpolation do not project onto the constraints. Unlike classical index-2 GGL, the original position and velocity\nconstraints are replaced by their stabilized evolution equations.\nThe algebraic multipliers are locally determined when and are nonsingular. Independent constraints and a\nsymmetric positive-definite mechanical mass matrix suffice. Explicitly\nmoving constraints are not supported: the constraint callbacks must\nnot depend on the independent variable. Uses diffeq_base ieee_arithmetic iso_fortran_env diffeq_errors linalg Interfaces public        interface ggl_container private  function ggl_constructor_1(coordinate_count, constraint_count, alpha, beta) result(rst) Defines the mechanical dimensions and resets stabilization gains to one\nunless supplied. Callback associations and inherited model options are\nretained. Invalid counts or gains cause DIFFEQ_INVALID_INPUT_ERROR. Arguments Type Intent Optional Attributes Name integer, intent(in) :: coordinate_count Positive number N of coordinates and physical velocities. integer, intent(in) :: constraint_count Number M of independent constraints, with 1 <= M <= N. real(kind=real64), intent(in), optional :: alpha Nonnegative finite position and velocity decay rates, respectively,\nin inverse independent-variable units. Zero disables the respective\ndamping term without disabling the differentiated constraint. real(kind=real64), intent(in), optional :: beta Nonnegative finite position and velocity decay rates, respectively,\nin inverse independent-variable units. Zero disables the respective\ndamping term without disabling the differentiated constraint. Return Value type( ggl_container ) The new ggl_container object. Abstract Interfaces abstract interface public  subroutine dae_algebraic_constraints(x, y, g, args) Evaluates algebraic constraint residuals . For input state components and constraints,\nthe callback represents a mapping A consistent state satisfies . Return the\nresiduals themselves, not their derivatives, a Boolean result,\nor a projected state. A nonzero residual is a valid evaluation\nat an inconsistent state, rather than a callback failure. The caller supplies the input and output array sizes. The\nimplementation must interpret the same state ordering as its\nmodel and write every output element. This interface performs\nno dimension, rank, or initial-consistency checks. Residual\nordering and physical units are defined by the model; any\nsubsequent consistency tolerance must respect that scaling. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x The independent-variable value at which to evaluate the\nconstraints, normally time. Autonomous constraints may\nignore this argument. real(kind=real64), intent(in), dimension(:) :: y An N-element input state in the ordering defined by the\nmodel. No particular coordinate, velocity, or multiplier\npartition is imposed by this interface. It must not be\nmodified by the callback. real(kind=real64), intent(out), dimension(:) :: g An M-element output array receiving the constraint\nresiduals in the model's declared constraint order.\nEvery element must be assigned on every call; incoming\ncontents are undefined. Exact constraint satisfaction\ncorresponds to a zero vector. class(*), intent(inout), optional :: args Optional user-owned model parameters or evaluation state.\nCheck presence and dynamic type before accessing it.\nThe callback may update this object, but repeated calls\nwith the same inputs should give the same residuals unless\nthe user intentionally changes model parameters. This\nargument is not reserved for index-reduction workspace. abstract interface public  subroutine dae_constraint_curvature(x, q, direction, v, curvature, args) Evaluates , without including . Each component is .\nAssign every output element. For linear constraints return\nzeros. The callback must support off-manifold coordinates and\narbitrary directions used during nonlinear/Jacobian evaluation. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x Independent-variable value, provided for callback uniformity;\nautonomous constraints must not depend on it. real(kind=real64), intent(in), dimension(:) :: q N coordinates, in the same order as the force model. real(kind=real64), intent(in), dimension(:) :: direction N components of the coordinate derivative ,\nincluding the kinematic multiplier correction. real(kind=real64), intent(in), dimension(:) :: v N physical velocity components; these need not equal direction. real(kind=real64), intent(out), dimension(:) :: curvature M curvature terms in the order of the constraint callback. class(*), intent(inout), optional :: args Optional user-owned parameters, forwarded unchanged. Derived Types type, public, extends( ode_container ) :: ggl_container Mechanical model adapter implementing stabilized index-1 GGL. Read more… Components Type Visibility Attributes Name Initial procedure( dae_constraint_curvature ), public, pointer, nopass :: constraint_curvature => null() Required callback for . procedure( ode_jacobian ), public, pointer, nopass :: constraint_jacobian => null() Required callback receiving q and writing the M-by-N matrix . No finite-difference fallback is used. procedure( dae_algebraic_constraints ), public, pointer, nopass :: constraints => null() Required callback receiving N coordinates q and writing M\nautonomous position residuals g(q), including off-manifold values. procedure( ode_event_function ), public, pointer, nopass :: event_function => null() A pointer to the event function. procedure( ode ), public, pointer, nopass :: fcn => null() A pointer to the routine containing the ODEs to integrate. procedure( ode_ad ), public, pointer, nopass :: fcn_ad => null() A pointer to the routine containing the ODEs to integrate.  Use\nthis pointer instead of fcn when automatic differentiation is\ndesired for calculation of the Jacobian.  Do not use both\npointers as this will produce an error.  If fcn is utilized,\nthen the Jacobian will be computed by either a user-supplied\nJacobian callback or by finite differences.  If this pointer\nis utilized, then the Jacobian will be computed by either a\nuser-supplied Jacobian callback or automatic differentiation.\nIn either case a user-supplied Jacobian callback is the preferred\noption falling back to either finite differences or automatic\ndifferentiation in its absence. procedure( ode_jacobian ), public, pointer, nopass :: jacobian => null() A pointer to the routine containing the analytical Jacobian.\nTakes precedence over AD and finite differences. If null, the\nselected RHS representation determines the differentiation method. procedure( ode_mass_matrix ), public, pointer, nopass :: mass_matrix => null() A pointer to the routine containing the mass matrix for the\nsystem.  If set to null (the default), an identity mass matrix \nwill be assumed. Constructor private\n\n                    \n                    function ggl_constructor_1 (coordinate_count, constraint_count, alpha, beta) Defines the mechanical dimensions and resets stabilization gains to one\nunless supplied. Callback associations and inherited model options are\nretained. Invalid counts or gains cause DIFFEQ_INVALID_INPUT_ERROR. Type-Bound Procedures procedure, public :: compute_jacobian => oc_jacobian procedure, public :: compute_mass_matrix => ggl_mass procedure, public :: compute_rhs => ggl_rhs procedure, public :: compute_time_derivative => oc_time_derivative procedure, public :: get_event_equation_count => oc_get_event_eqn_count procedure, public :: get_finite_difference_step => oc_get_fd_step procedure, public :: get_is_mass_matrix_dependent => oc_get_is_mass_dependent procedure, public :: get_is_ode_defined => ggl_is_defined procedure, public :: get_is_ode_event_function_defined => oc_is_event_fcn_defined procedure, public :: get_jacobian_function_evaluations => oc_get_jacobian_calls procedure, public :: get_state_count => ggl_state_count procedure, public :: has_mass_matrix => ggl_has_mass procedure, public :: initialize => ggl_initialize procedure, public :: initialize_multipliers => ggl_initialize_multipliers procedure, public :: set_event_equation_count => oc_set_event_eqn_count procedure, public :: set_finite_difference_step => oc_set_fd_step procedure, public :: set_is_mass_matrix_dependent => oc_set_is_mass_dependent procedure, public :: set_stabilization_parameters => ggl_set_stabilization procedure, public :: use_finite_difference_jacobian => oc_use_finite_difference_jacobian procedure, public :: validate_initial_conditions => ggl_validate","tags":"","url":"module\\diffeq_index_reduction.html"},{"title":"diffeq_c_integrators – DIFFEQ","text":"Uses diffeq_c_function_pointers diffeq_c_index_reduction diffeq_c_containers iso_fortran_env iso_c_binding diffeq diffeq_c_errors Derived Types type, public, bind(C) :: c_ode_settings A container for ODE settings. Components Type Visibility Attributes Name Initial real(kind=c_double), public :: absolute_tolerance The absolute tolerance applied to each equation. logical(kind=c_bool), public :: allow_overshoot True if the solver is allowed to overshoot the final value in\nthe integration range and interpolate back; else, false if the\nsolver must terminate on the final value. real(kind=c_double), public :: beta PI step size controller exponent.  Set to zero to turn off PI\nstep size control. logical(kind=c_bool), public :: mass_matrix_constant True if the mass matrix is constant regardless of state, or\nfalse if the mass matrix is state-dependent. real(kind=c_double), public :: maximum_step_size The maximum allowed integrator step size. real(kind=c_double), public :: minimum_step_size The minimum allowed integrator step size. integer(kind=c_int), public :: newton_step_limit The maximum number of Newton iterations allowed per implicit\nsolve (BDF and Kennedy-Carpenter). real(kind=c_double), public :: newton_tolerance The convergence tolerance for Newton iteration (BDF and\nKennedy-Carpenter). real(kind=c_double), public :: relative_tolerance The relative tolerance applied to each equation. integer(kind=c_int), public :: step_limit The limit on the maximum total number of integration steps. Functions public  function c_adams (nx, nstates, fcn, x, initcond, settings, mass, output) result(rst) bind(C, name = \"c_adams\") Utilizes a variable order Adams predictor-corrector integrator to \nsolve a system of first order differential equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to integrate. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(in) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type(c_funptr), intent(in), value :: mass A pointer to the routine for computing the mass matrix.  Pass\nNULL if no routine is necessary.  This routine cannot handle\nsingular mass matrices. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. Return Value integer(kind=c_int) An error flag denoting the status of the operation. public  function c_adams_events (nx, nstates, nevents, fcn, x, initcond, settings, esettings, efcn, mass, output, estats) result(rst) bind(C, name = \"c_adams_events\") Utilizes a variable order Adams predictor-corrector integrator to \nsolve a system of first order differential equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nevents The number of event equations. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to integrate. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(in) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type( c_ode_event_solver_settings ), intent(in) :: esettings The event solver settings. type(c_funptr), intent(in), value :: efcn A pointer to the function containing the event equations. type(c_funptr), intent(in), value :: mass A pointer to the routine for computing the mass matrix.  Pass\nNULL if no routine is necessary.  This routine cannot handle\nsingular mass matrices. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. type( c_ode_event_statistics ), intent(out) :: estats Event detection solver results and statistics. Return Value integer(kind=c_int) An error flag denoting the status of the operation. public  function c_bdf (nx, nstates, fcn, x, initcond, settings, jac, mass, output) result(rst) bind(C, name = \"c_bdf\") Utilizes a variable order BDF integrator to solve a system of \nfirst order differential equations or index-1 differential \nalgebraic equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to integrate. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(in) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type(c_funptr), intent(in), value :: jac A pointer to the routine for computing the Jacobian matrix.\nPass NULL if no routine is necessary and allowing the integrator\nto use a finite-difference estimate is acceptable. type(c_funptr), intent(in), value :: mass A pointer to the routine for computing the mass matrix.  Pass\nNULL if no routine is necessary. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. Return Value integer(kind=c_int) An error flag denoting the status of the operation. public  function c_bdf_events (nx, nstates, nevents, fcn, x, initcond, settings, esettings, efcn, jac, mass, output, estats) result(rst) bind(C, name = \"c_bdf_events\") Utilizes a variable order BDF integrator to solve a system of \nfirst order differential equations or index-1 differential \nalgebraic equations. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations.  This value must be at least 1;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nevents The number of event equations. type(c_funptr), intent(in), value :: fcn A pointer to the function containing the equations to integrate. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(in) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type( c_ode_event_solver_settings ), intent(in) :: esettings The event solver settings. type(c_funptr), intent(in), value :: efcn A pointer to the function containing the event equations. type(c_funptr), intent(in), value :: jac A pointer to the routine for computing the Jacobian matrix.\nPass NULL if no routine is necessary and allowing the integrator\nto use a finite-difference estimate is acceptable. type(c_funptr), intent(in), value :: mass A pointer to the routine for computing the mass matrix.  Pass\nNULL if no routine is necessary. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. type( c_ode_event_statistics ), intent(out) :: estats Event detection solver results and statistics. Return Value integer(kind=c_int) An error flag denoting the status of the operation. public  function c_dae_bdf (model, nx, nstates, x, initcond, settings, output, estats) result(rst) bind(C, name = \"c_dae_bdf\") Utilizes a variable order BDF integrator to solve the system of\nDAE's. Arguments Type Intent Optional Attributes Name type( c_ggl_container ), intent(in) :: model The c_ggl_container containing the constraints and model. integer(kind=c_int), intent(in), value :: nx The number of solution points.  This value must be at least 2;\nelse, a C_INVALID_INPUT_ERROR is returned. integer(kind=c_int), intent(in), value :: nstates The number of state equations, including the constraints.  This \nvalue must be at least 1; else, a C_INVALID_INPUT_ERROR is \nreturned. real(kind=c_double), intent(in) :: x (nx) An NX-element array containing the desired solution points. real(kind=c_double), intent(inout) :: initcond (nstates) An NSTATES-element array containing the initial conditions. type( c_ode_settings ), intent(in) :: settings The integrator settings. type(c_ptr), intent(out) :: output The output c_ode_results object.  Memory must be freed by \nc_free_ode_results. type( c_ode_event_statistics ), intent(out) :: estats Event detection solver results and statistics. Return Value integer(kind=c_int) An error flag denoting the status of the operation. public  function c_dae_kennedy_carpenter_4 (model, nx, nstates, x, initcond, settings, output, estats) result(rst) bind(C, name = \"c_dae_kennedy_carpen